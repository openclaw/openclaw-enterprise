title: Proposed credential renewal and online use
config:
  theme: base
  themeVariables:
    fontFamily: "Arial, sans-serif"
    actorBkg: "#eff4f7"
    actorBorder: "#7b909d"
    actorTextColor: "#20313b"
    noteBkgColor: "#e8f3ef"
    noteBorderColor: "#75a191"
    noteTextColor: "#203b35"
    signalColor: "#617887"
    signalTextColor: "#20313b"
  sequence:
    useMaxWidth: false
