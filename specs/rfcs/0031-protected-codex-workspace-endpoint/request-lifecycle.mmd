flowchart TD
  subgraph Prepare
    direction LR
    W1["Sandbox workspace<br/>Sandbox holds and identifies the workspace."] ~~~ G1["Agent Gateway<br/>Compute configures the new Gateway for that workspace."]
  end
  subgraph Release
    direction LR
    W2["Sandbox workspace<br/>The original workspace acknowledges release."] ~~~ G2["Agent Gateway<br/>The previous revision can keep serving."]
  end
  subgraph Activate
    direction LR
    W3["Sandbox workspace<br/>Compute separately verifies the original is serving."] ~~~ G3["Agent Gateway<br/>Traffic switches. The Gateway checks the workspace on each connection."]
  end
  Prepare --> Release --> Activate
