{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "../.build/tests/tsconfig.tsbuildinfo"
  },
  "include": [
    "**/*.test.ts",
    "../scripts/console-storybook/*.stories.ts",
    "../scripts/console/record-walkthrough.ts",
    "../packages/contracts/prepack.ts",
    "../packages/utils/prepack.ts",
    "helpers/credential-source-owner-upgrade.ts",
    "fixtures/repository-credentials/module-guard.ts",
    "fixtures/repository-credentials/planning.ts"
  ],
  "references": [
    {
      "path": "../packages/utils"
    },
    {
      "path": "../packages/contracts"
    },
    {
      "path": "../packages/occ"
    },
    {
      "path": "../packages/iam"
    },
    {
      "path": "../packages/audit"
    },
    {
      "path": "../apps/controller"
    }
  ]
}
