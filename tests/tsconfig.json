{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "../.build/tests/tsconfig.tsbuildinfo",
    "paths": {
      "@openclaw-enterprise/contracts": ["../packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "**/*.test.ts",
    "../deploy/runtime/google/install-gog.mts",
    "../scripts/console-storybook/*.stories.ts",
    "../scripts/console/record-walkthrough.ts",
    "../packages/contracts/prepack.ts",
    "../packages/utils/prepack.ts",
    "helpers/credential-source-owner-upgrade.ts",
    "helpers/deployed-repository-capability.ts",
    "helpers/compute-credential-catalog.ts",
    "helpers/provisioning-repository-status.ts",
    "helpers/provisioning-source-status.ts",
    "helpers/codex-preparation-caller.ts",
    "helpers/controlled-tls-origin.ts",
    "helpers/controlled-tls-origin-scenario.ts",
    "fixtures/runtime-google-skill-policy.mts",
    "fixtures/codex-local-plugins/probe.ts",
    "fixtures/codex-local-plugins/enrollment.ts",
    "fixtures/repository-credentials/module-guard.ts",
    "fixtures/repository-credentials/planning.ts",
    "helpers/protected-static-secret-read.ts"
  ],
  "references": [
    {
      "path": "../packages/utils"
    },
    {
      "path": "../packages/contracts"
    },
    {
      "path": "../packages/occ"
    },
    {
      "path": "../packages/iam"
    },
    {
      "path": "../packages/audit"
    },
    {
      "path": "../apps/controller"
    }
  ]
}
