// Run in the stock image against the node policy generated by its Gateway entrypoint.
import assert from "node:assert/strict";

// These modules are supplied by the runtime image.
const entrypoint = "/app/dist/extensions/file-transfer/index.js";
const { default: fileTransfer } = await import(entrypoint);

// This fresh process reads the same rendered configuration that the Gateway prepared.
process.env.OPENCLAW_CONFIG_PATH = "/home/node/.openclaw/openclaw.json";
const snapshot = "openclaw/plugin-sdk/runtime-config-snapshot";
const { captureRuntimeConfigAsyncReader } = await import(snapshot);
const config = await captureRuntimeConfigAsyncReader()();
const pluginConfig = config.plugins.entries["file-transfer"].config;
const { nodeId, remoteRoot: workspaceDir } = pluginConfig.workspaces.main;
const root = "/usr/local/lib/oce/plugins/google";
const skills = root + "/skills";
const skill = skills + "/oce-google";
const enabled = process.argv[2] === "true";
type NodePolicy = {
  commands: string[];
  handle(context: object): Promise<{ ok: true } | { ok: false; code: string; message: string }>;
};

let policy: NodePolicy | undefined;
fileTransfer.register({
  registerNodeHostCommand() {},
  registerCli() {},
  registerTool() {},
  registerNodeInvokePolicy(candidate: NodePolicy) {
    if (candidate.commands.includes("workspace.skills")) {
      policy = candidate;
    }
  },
});

async function admits(operation: string, request: object): Promise<boolean> {
  assert.ok(policy, "The runtime registered no workspace.skills policy");
  const result = await policy.handle({
    nodeId,
    pluginConfig,
    params: { workspaceDir, operation, request: JSON.stringify(request), watch: false },
    invokeNode: async () => ({ ok: true }),
  });
  if (!result.ok) {
    assert.equal(result.code, "POLICY_DENIED");
    assert.match(result.message, /existing file grant/);
  }
  return result.ok;
}

// Discovery authorizes its source root. Resource and instruction requests name the child and file.
const sourcePlan = { workspaceDir, roots: [{ dir: skills }], pluginSkillRoots: [] };
assert.equal(await admits("discovery", { sourcePlan }), enabled);
assert.equal(await admits("readResources", { skill: { baseDir: skill } }), enabled);
assert.equal(await admits("readInstructions", { filePath: skill + "/SKILL.md" }), enabled);
for (const filePath of [root + "/bin/gog", root + "/release.json", skills + "/sibling/SKILL.md"]) {
  assert.equal(await admits("readInstructions", { filePath }), false);
}
assert.equal(
  await admits("removeSkill", { plan: { workspaceDir, targetDir: skill, slug: "oce-google" } }),
  false,
);
