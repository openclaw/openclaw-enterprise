#!/bin/sh
set -eu
: "${OCC_SSH_FIXTURE_STATE:?fixture state required}"
: "${OCC_SSH_FIXTURE_UNIT_DIRECTORY:?fixture unit directory required}"
printf '%s\n' "$*" >> "$OCC_SSH_FIXTURE_STATE/systemctl.log"
operation=$1
shift
if [ "${1:-}" = '--quiet' ]; then shift; fi
if [ "$operation" = 'show' ]; then
  [ "${1:-}" = '-p' ] && shift
  [ "${1:-}" = 'ActiveState' ] && shift
  [ "${1:-}" = '--value' ] && shift
fi
unit=${1:-}
case "$operation" in
  enable|link)
    case "$unit" in
      /*)
        [ "$unit" = "$OCC_SSH_FIXTURE_UNIT_DIRECTORY/$(basename "$unit")" ]
        [ -f "$unit" ]
        unit=$(basename "$unit")
        ;;
    esac
    ;;
esac
pidfile="$OCC_SSH_FIXTURE_STATE/$unit.pid"
enabled="$OCC_SSH_FIXTURE_STATE/$unit.enabled"
active() {
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}
stop() {
  if active; then kill "$(cat "$pidfile")" 2>/dev/null || :; fi
  rm -f "$pidfile"
}
case "$operation" in
  --version) printf '%s\n' 'systemd SSH conformance fixture' ;;
  daemon-reload) : ;;
  link) : ;;
  enable) : > "$enabled" ;;
  disable) rm -f "$enabled" ;;
  is-enabled) [ -f "$enabled" ] ;;
  stop) stop ;;
  is-active) active ;;
  show) if active; then printf '%s\n' active; else printf '%s\n' inactive; fi ;;
  restart|start)
    if [ "$operation" = start ] && active; then exit 0; fi
    stop
    # The unit process only has to stay alive: the conformance test owns the gateway port
    # for the fixture's whole life and serves /readyz for the live unit configured on it,
    # so no other local process can take the port between reservation and start.
    port=$(sed -n 's/^Environment=OPENCLAW_GATEWAY_PORT=//p' "$OCC_SSH_FIXTURE_UNIT_DIRECTORY/$unit")
    [ -n "$port" ] || { printf '%s\n' 'Unit has no OPENCLAW_GATEWAY_PORT' >&2; exit 1; }
    # A second gateway on a live unit's port would fail to bind, leaving its unit inactive.
    for other in "$OCC_SSH_FIXTURE_UNIT_DIRECTORY"/*; do
      name=$(basename "$other")
      [ "$name" != "$unit" ] || continue
      grep -qsx "Environment=OPENCLAW_GATEWAY_PORT=$port" "$other" || continue
      if kill -0 "$(cat "$OCC_SSH_FIXTURE_STATE/$name.pid" 2>/dev/null)" 2>/dev/null; then exit 0; fi
    done
    node -e '
      const { spawn } = require("node:child_process");
      const { writeFileSync } = require("node:fs");
      const service = spawn(process.execPath, ["-e", "setInterval(() => {}, 1 << 30)"], {
        detached: true,
        stdio: "ignore",
      });
      writeFileSync(process.argv[1], String(service.pid), { mode: 0o600 });
      service.unref();
    ' "$pidfile"
    ;;
  *) printf '%s\n' 'Unsupported fixture systemctl invocation' >&2; exit 1 ;;
esac
