{
  "name": "openclaw-enterprise",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false",
    "typecheck": "tsc --build tsconfig.json --pretty false",
    "cli:build": "go build -trimpath -o bin/occ ./cmd/occ",
    "cli:check": "test -z \"$(gofmt -l cmd internal)\" && go vet ./...",
    "cli:test": "go test ./...",
    "format:fix": "prettier --write \"{apps,packages,scripts,tests}/**/*.{ts,mjs,cjs,json,html,css}\" \"*.{ts,mjs,cjs,json,yaml,yml,md}\" \"docs/**/*.md\" \"!docs/reference/api.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"{apps,packages,scripts,tests}/**/*.{ts,mjs,cjs,json,html,css}\" \"*.{ts,mjs,cjs,json,yaml,yml,md}\" \"docs/**/*.md\" \"!docs/reference/api.md\" \".github/**/*.yml\"",
    "contributors:update": "node scripts/update-contributors.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs --if-git-present",
    "check:workspace": "node scripts/verify-workspace-boundary.mjs",
    "openapi:generate": "node scripts/generate-occ-openapi.mjs",
    "openapi:check": "node scripts/generate-occ-openapi.mjs --check",
    "start:controller": "node apps/controller/src/server.mjs",
    "start:controller:production": "NODE_ENV=production node apps/controller/src/server.mjs",
    "start:worker": "node apps/controller/src/worker.mjs",
    "start:worker:production": "NODE_ENV=production node apps/controller/src/worker.mjs",
    "auth:maintain": "node scripts/auth-maintain.mjs",
    "db:bootstrap": "NODE_ENV=development node scripts/bootstrap-installation.mjs",
    "db:bootstrap:production": "NODE_ENV=production node scripts/bootstrap-installation.mjs",
    "db:migrate:production": "NODE_ENV=production node scripts/migrate-production.mjs",
    "profiles:render": "node scripts/render-installation-profile.mjs",
    "db:up": "docker compose -f compose.postgres.yaml up -d --wait",
    "db:down": "docker compose -f compose.postgres.yaml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_ENV=development node scripts/migrate-production.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:test": "node --test tests/integration/docker-compute-real.test.mjs",
    "podman:test": "OCC_TEST_PODMAN_COMPUTE_REAL=1 node --test tests/integration/docker-compute-real.test.mjs",
    "test": "node scripts/verify-workspace-boundary.mjs && node --test tests/conformance/*.test.mjs tests/integration/*.test.mjs",
    "test:conformance": "node scripts/verify-workspace-boundary.mjs && node --test tests/conformance/*.test.mjs",
    "test:integration": "node scripts/verify-workspace-boundary.mjs && node --test tests/integration/*.test.mjs",
    "test:console-browser": "node --test tests/browser/*.test.mjs",
    "test:postgres": "node scripts/verify-workspace-boundary.mjs && node --test --test-concurrency=1 tests/integration/postgres-*.test.mjs",
    "docs:build": "node scripts/docs-site/build.mjs && scripts/docs-site/node_modules/.bin/pagefind --site dist/docs",
    "docs:dev": "npm run docs:build && node scripts/docs-site/serve.mjs",
    "docs:check-length": "node scripts/docs-site/word-count.mjs",
    "docs:check": "node scripts/docs-site/word-count.mjs && node scripts/docs-site/build.mjs --check && node scripts/check-specs.mjs",
    "docs:install": "pnpm --dir scripts/docs-site install --frozen-lockfile --ignore-scripts",
    "test:files": "node scripts/test-files.mjs",
    "credentials:build": "tsc --build tsconfig.json --pretty false && node scripts/build-repository-credentials.mjs",
    "credentials:check-config": "node .build/repository-credentials/service/dist/composition/repository-credentials/check-config.js --check-config",
    "credentials:start": "node .build/repository-credentials/service/dist/repository-credentials.js",
    "credentials:operator": "node .build/repository-credentials/client/dist/drivers/repo/github/credentials/client/operator.js",
    "credentials:client": "node .build/repository-credentials/client/dist/drivers/repo/github/credentials/client/launch.js",
    "credentials:image": "docker build -f deploy/runtime/repository-credentials/Dockerfile -t repository-credentials:local .build/repository-credentials/service",
    "credentials:client-image": "docker build -f deploy/runtime/repository-credentials/Dockerfile.client -t repository-credentials-client:local .build/repository-credentials/client",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "format": "pnpm format:fix",
    "storybook:install": "pnpm --dir scripts/console-storybook install --frozen-lockfile",
    "storybook": "pnpm --dir scripts/console-storybook dev",
    "storybook:build": "pnpm --dir scripts/console-storybook build",
    "analyze:modules": "node scripts/verify-module-boundaries.mjs",
    "check:modules": "node scripts/verify-module-boundaries.mjs --policy scripts/module-boundaries/policy.json --exceptions scripts/module-boundaries/exceptions.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "pg": "8.23.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-compiler-api": "npm:typescript@6.0.3",
    "typescript-eslint": "8.70.1",
    "yaml": "2.9.1"
  }
}
