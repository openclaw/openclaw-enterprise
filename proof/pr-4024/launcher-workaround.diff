+// Docker can refuse a platform-filtered save for a locally pulled multi-platform
+// index; the import must fall back to the complete archive instead of failing.
+func TestOpenShellImageImportFallsBackWhenDockerRefusesPlatformSave(t *testing.T) {
+	state := kubernetesOnlyOpenShellState(t)
+	root := t.TempDir()
+	source := "ghcr.io/nvidia/openshell/supervisor@" + profileTestDigest
+	staging := "openclaw-development/openshell-supervisor:" + state.Cluster
+	commands := fakeProfileCommands(t, map[string]string{
+		"docker": `"image inspect ` + source + `") ;;
+"image inspect ` + staging + `") exit 1 ;;
+"tag ` + source + ` ` + staging + `") ;;
+"image inspect --format {{json .RepoTags}} ` + staging + `") echo '["` + staging + `"]' ;;
+"image inspect --format {{.Os}}/{{.Architecture}} ` + source + `") echo linux/amd64 ;;
+"image save --platform linux/amd64 --output "*" ` + staging + `") exit 1 ;;
+"manifest inspect --verbose ` + source + `") echo '[{"Descriptor":{"digest":"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef","platform":{"os":"linux","architecture":"amd64"}}}]' ;;
+"image save --platform linux/amd64 --output "*" ghcr.io/nvidia/openshell/supervisor@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") printf archive > "$6" ;;
+"exec k3d-occ-dev-owned-server-0 ctr -n k8s.io images list") echo "docker.io/` + staging + ` application/vnd.oci.image.manifest.v1+json ` + profileTestDigest + `" ;;
+"exec k3d-occ-dev-owned-server-0 ctr -n k8s.io images tag docker.io/` + staging + ` docker.io/openclaw-development/openshell-supervisor@` + profileTestDigest + `") ;;
+"image rm ` + staging + `") ;;`,
+		"k3d": `"image import --mode direct "*" -c occ-dev-owned") ;;`,
+	})
+	var stdout bytes.Buffer
+	r := newRunner(Options{Repository: state.Repository, Out: &stdout})
+	r.engine = "docker"
+	reference, err := r.importOpenShellImage(context.Background(), state, root, "supervisor", source, true)
+	if err != nil {
+		t.Fatalf("%v\n%s", err, strings.Join(commands(), "\n"))
+	}
+	if reference != "docker.io/openclaw-development/openshell-supervisor@"+profileTestDigest {
+		t.Fatalf("unexpected runtime reference: %q", reference)
+	}
+}
