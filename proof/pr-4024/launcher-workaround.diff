+// platformChildReference resolves a multi-platform reference to the child image
+// digest of one platform — the reference Docker can save directly when it refuses
+// the platform-filtered save of the whole index.
+func (r *runner) platformChildReference(ctx context.Context, source, platform string) (string, error) {
+	output, err := r.output(ctx, r.engine, "manifest", "inspect", "--verbose", source)
+	if err != nil {
+		return "", err
+	}
+	var descriptors []struct {
+		Descriptor struct {
+			Digest   string `json:"digest"`
+			Platform struct {
+				OS           string `json:"os"`
+				Architecture string `json:"architecture"`
+			} `json:"platform"`
+		} `json:"Descriptor"`
+	}
+	if err := json.Unmarshal(output, &descriptors); err != nil {
+		return "", err
+	}
+	for _, descriptor := range descriptors {
+		if descriptor.Descriptor.Platform.OS+"/"+descriptor.Descriptor.Platform.Architecture == platform {
+			name, _, _ := strings.Cut(source, "@")
+			return name + "@" + descriptor.Descriptor.Digest, nil
+		}
+	}
+	return "", fmt.Errorf("no %s child image in %s", platform, source)
+}
