{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "./.build/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "scripts",
    "tests/browser",
    "tests/conformance",
    "tests/docs",
    "tests/helpers",
    "tests/integration"
  ],
  "exclude": ["tests/**/*.test.ts", "scripts/console-storybook/*.stories.ts"]
}
