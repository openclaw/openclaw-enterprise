#!/usr/bin/env python3
"""Install or verify pinned Envoy channel prerequisites without adopting external resources."""
import argparse
import hashlib
import http.client
import ipaddress
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
import uuid

VERSION = "v1.6.7"
MANIFEST_URL = f"https://github.com/envoyproxy/gateway/releases/download/{VERSION}/install.yaml"
MANIFEST_SHA = "9a250c698d78b92c670d9d2bd6bd54615f1dee41ddd520ece9704edf63088df8"
CRDS = ["gatewayclasses.gateway.networking.k8s.io", "gateways.gateway.networking.k8s.io",
        "httproutes.gateway.networking.k8s.io", "referencegrants.gateway.networking.k8s.io",
        "envoyproxies.gateway.envoyproxy.io", "envoypatchpolicies.gateway.envoyproxy.io",
        "httproutefilters.gateway.envoyproxy.io"]


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def run(args, data=None):
    result = subprocess.run(args, input=data, capture_output=True, text=True, timeout=180)
    require(result.returncode == 0, f"{Path(args[0]).name} failed; inspect selected Envoy resources with the operator tools")
    return result.stdout


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["install", "check"])
    for key in ("kubeconfig", "context", "namespace", "values"):
        parser.add_argument("--" + key, required=True)
    parser.add_argument("--timeout-seconds", type=int, default=180)
    parser.add_argument("--probe-name", help="previously reserved namespace and Gateway name for controller ingress")
    args = parser.parse_args()
    if args.probe_name is not None and not re.fullmatch(r"oce-channel-probe-[0-9a-f]{12}", args.probe_name):
        parser.error("--probe-name must be oce-channel-probe- followed by 12 lowercase hexadecimal digits")
    values = json.loads(run(["yq", "-o=json", ".", args.values]))
    egress = values.get("channelEgress", {})
    if egress.get("enabled") is False:
        print("Channels disabled; no Envoy dependency or probe changes.")
        return
    require(egress.get("enabled") is True, "use explicit rendered channel settings")
    namespace = egress.get("envoyNamespace", "envoy-gateway-system")
    gateway_class = egress.get("gatewayClassName", "eg")
    kube = ["kubectl", "--kubeconfig", args.kubeconfig, "--context", args.context, "--request-timeout=30s"]
    def get(kind, name=None, ns=None):
        return json.loads(run([*kube, *(["-n", ns] if ns else []), "get", kind, *([name] if name else []), "-o", "json"]))
    def wait(kind, name, condition, ns=None):
        run([*kube, *(["-n", ns] if ns else []), "wait", kind, name, f"--for=condition={condition}", f"--timeout={args.timeout_seconds}s"])
    exclusions = egress.get("excludedCidrs", [])
    require(isinstance(exclusions, list) and exclusions,
            "supply explicit complete Pod, Service and node exclusions in the rendered channel values")
    networks = [ipaddress.ip_network(value, strict=True) for value in exclusions]
    observed = []
    complete = True
    for kind in ("nodes", "servicecidrs"):
        observation = subprocess.run([*kube, "get", kind, "-o", "json"], capture_output=True, text=True, timeout=60)
        if observation.returncode != 0:
            complete = False
            continue
        items = json.loads(observation.stdout).get("items", [])
        complete = complete and bool(items)
        for item in items:
            if kind == "nodes":
                pod_cidrs = item.get("spec", {}).get("podCIDRs", [])
                complete = complete and bool(pod_cidrs)
                observed.extend(ipaddress.ip_network(cidr, strict=True) for cidr in pod_cidrs)
                for address in item.get("status", {}).get("addresses", []):
                    if address.get("type") in ("InternalIP", "ExternalIP"):
                        ip = ipaddress.ip_address(address["address"])
                        observed.append(ipaddress.ip_network(f"{ip}/{ip.max_prefixlen}"))
            else:
                cidrs = item.get("spec", {}).get("cidrs", [])
                complete = complete and bool(cidrs)
                observed.extend(ipaddress.ip_network(cidr, strict=True) for cidr in cidrs)
    require(all(any(network.version == candidate.version and network.subnet_of(candidate)
                    for candidate in networks) for network in observed),
            "channel exclusions omit a discovered Pod, Service or node range; no dependency changes made")
    if not complete:
        print("Cluster range discovery is incomplete; the explicit exclusions must be independently verified by the operator.", file=sys.stderr)
    existing = run([*kube, "get", "namespace", namespace, "--ignore-not-found", "-o", "json"])
    if args.action == "install" and not existing:
        require(namespace == "envoy-gateway-system", "the pinned installer uses envoy-gateway-system; provision other namespaces externally")
        # Existing Gateway API CRDs retain their cluster owner. An existing Envoy
        # installation must be repaired by its owner, never by partial adoption.
        for crd in CRDS:
            if crd.endswith(".gateway.envoyproxy.io"):
                require(not run([*kube, "get", "crd", crd, "--ignore-not-found", "-o", "name"]),
                        "Envoy CRDs already exist; ask their owner to prepare the pinned controller")
        with urllib.request.urlopen(MANIFEST_URL, timeout=60) as response:
            content = response.read()
        require(hashlib.sha256(content).hexdigest() == MANIFEST_SHA, "pinned Envoy manifest checksum mismatch")
        with tempfile.TemporaryDirectory(prefix="oce-envoy-install-") as directory:
            manifest = Path(directory) / "install.yaml"
            manifest.write_bytes(content)
            documents = json.loads(run(["yq", "-o=json", "eval-all", "[.]", str(manifest)]))
            selected = []
            for item in documents:
                if not item:
                    continue
                if item["kind"] == "CustomResourceDefinition" and item["metadata"]["name"].endswith(".gateway.networking.k8s.io"):
                    if run([*kube, "get", "crd", item["metadata"]["name"], "--ignore-not-found", "-o", "name"]):
                        continue
                if item["kind"] == "ConfigMap" and item["metadata"]["name"] == "envoy-gateway-config":
                    config = json.loads(run(["yq", "-o=json", ".", "-"], item["data"]["envoy-gateway.yaml"]))
                    config.setdefault("extensionApis", {})["enableEnvoyPatchPolicy"] = True
                    item["data"]["envoy-gateway.yaml"] = json.dumps(config)
                selected.append(item)
            # Create, never apply/force/adopt. A conflict stops installation and
            # leaves the actual partial state for operator inspection.
            crds = [item for item in selected if item["kind"] == "CustomResourceDefinition"]
            others = [item for item in selected if item["kind"] != "CustomResourceDefinition"]
            run([*kube, "create", "-f", "-"], json.dumps({"apiVersion": "v1", "kind": "List", "items": crds}))
            for item in crds:
                wait("crd", item["metadata"]["name"], "Established")
            run([*kube, "create", "-f", "-"], json.dumps({"apiVersion": "v1", "kind": "List", "items": others}))
    for crd in CRDS:
        wait("crd", crd, "Established")
    deployment = get("deployment", "envoy-gateway", namespace)
    images = [item["image"] for item in deployment["spec"]["template"]["spec"]["containers"]]
    require(any(image.removeprefix("docker.io/") == f"envoyproxy/gateway:{VERSION}" for image in images), "Envoy controller must use the qualified v1.6.7 image")
    config_map = get("configmap", "envoy-gateway-config", namespace)
    config = json.loads(run(["yq", "-o=json", ".", "-"], config_map["data"]["envoy-gateway.yaml"]))
    require(config.get("extensionApis", {}).get("enableEnvoyPatchPolicy") is True,
            "EnvoyPatchPolicy is disabled; the existing controller owner must enable it")
    run([*kube, "-n", namespace, "rollout", "status", "deployment/envoy-gateway", f"--timeout={args.timeout_seconds}s"])
    existing_class = run([*kube, "get", "gatewayclass", gateway_class, "--ignore-not-found", "-o", "json"])
    if not existing_class:
        require(args.action == "install", "create the selected GatewayClass before checking")
        run([*kube, "create", "-f", "-"], json.dumps({"apiVersion": "gateway.networking.k8s.io/v1", "kind": "GatewayClass", "metadata": {"name": gateway_class}, "spec": {"controllerName": "gateway.envoyproxy.io/gatewayclass-controller"}}))
    else:
        require(json.loads(existing_class)["spec"]["controllerName"] == "gateway.envoyproxy.io/gatewayclass-controller", "GatewayClass belongs to another controller")
    wait("gatewayclass", gateway_class, "Accepted")
    name = args.probe_name or "oce-channel-probe-" + uuid.uuid4().hex[:12]
    probe(kube, namespace, gateway_class, args.timeout_seconds, name)
    print("Envoy CRDs, pinned controller, GatewayClass and actual patch delivery verified.")


def recover_probe_uid(kube, kind, metadata):
    name = metadata["name"]
    namespace = metadata.get("namespace")
    scope = [*kube, *(["-n", namespace] if namespace else [])]
    attempt = metadata["annotations"]["openclaw.dev/channel-probe-attempt"]
    try:
        result = run([*scope, "get", kind.lower(), name, "--ignore-not-found", "-o", "json"])
        observed = json.loads(result or "{}").get("metadata", {})
        annotations = observed.get("annotations") or {}
        uid = observed.get("uid")
        if (
            observed.get("name") == name
            and observed.get("namespace") == namespace
            and annotations.get("openclaw.dev/channel-probe-attempt") == attempt
            and isinstance(uid, str)
            and uid
        ):
            return uid
    except (RuntimeError, ValueError, AttributeError, OSError, subprocess.SubprocessError):
        pass
    location = f"{namespace}/{name}" if namespace else name
    print(f"Unsettled {kind} create for {location} (attempt {attempt}). Reconcile before reusing this probe name.", file=sys.stderr)
    return None


def create_probe_resource(kube, resource, owned_uids):
    metadata = resource["metadata"]
    # The marker travels in the create itself. A pre-existing object with the
    # same reserved name cannot establish custody for this attempt.
    attempt = uuid.uuid4().hex
    metadata["annotations"] = {"openclaw.dev/channel-probe-attempt": attempt}
    kind = resource["kind"]
    name = metadata["name"]
    namespace = metadata.get("namespace")
    location = f"{namespace}/{name}" if namespace else name
    print(f"Probe create {kind} {location}, attempt {attempt}.", file=sys.stderr)
    try:
        created = json.loads(run([*kube, "create", "-f", "-", "-o", "json"], json.dumps(resource)))
        uid = created["metadata"]["uid"]
        require(isinstance(uid, str) and uid, "probe create returned no UID")
    except (RuntimeError, ValueError, KeyError, TypeError, OSError, subprocess.SubprocessError):
        uid = recover_probe_uid(kube, kind, metadata)
        if uid is not None:
            owned_uids[kind] = uid
        raise
    owned_uids[kind] = uid


def probe(kube, envoy_namespace, gateway_class, timeout, name):
    marker = uuid.uuid4().hex
    print(f"Creating temporary channel probe namespace {name}; retain this name if creation has an uncertain outcome.", file=sys.stderr)
    forwarding = None
    owned_uids = {}
    try:
        create_probe_resource(kube, {"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": name}}, owned_uids)
        print(f"Temporary channel probe: namespace {name}, UID {owned_uids['Namespace']}", file=sys.stderr)
        hcm = {"name": "envoy.filters.network.http_connection_manager", "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
            "stat_prefix": "channel_probe", "route_config": {"name": "probe", "virtual_hosts": [{"name": "probe", "domains": ["*"], "routes": [{"match": {"prefix": "/"}, "direct_response": {"status": 200, "body": {"inline_string": marker}}}]}]},
            "http_filters": [{"name": "envoy.filters.http.router", "typed_config": {"@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"}}]}}
        policy = {"apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy", "metadata": {"name": name, "namespace": envoy_namespace}, "spec": {
            "podSelector": {"matchLabels": {"gateway.envoyproxy.io/owning-gateway-name": name, "gateway.envoyproxy.io/owning-gateway-namespace": name}},
            "policyTypes": ["Ingress", "Egress"], "ingress": [], "egress": [
                {"to": [{"podSelector": {"matchLabels": {"control-plane": "envoy-gateway"}}}], "ports": [{"protocol": "TCP", "port": 18000}]},
                {"to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}}, "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}}}], "ports": [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}]}]}}
        create_probe_resource(kube, policy, owned_uids)
        resources = [
            {"apiVersion": "gateway.envoyproxy.io/v1alpha1", "kind": "EnvoyProxy", "metadata": {"name": name, "namespace": name}, "spec": {"provider": {"type": "Kubernetes", "kubernetes": {"envoyService": {"type": "ClusterIP"}}}}},
            {"apiVersion": "gateway.networking.k8s.io/v1", "kind": "Gateway", "metadata": {"name": name, "namespace": name}, "spec": {"gatewayClassName": gateway_class, "infrastructure": {"parametersRef": {"group": "gateway.envoyproxy.io", "kind": "EnvoyProxy", "name": name}}, "listeners": [{"name": "probe", "protocol": "HTTP", "port": 18080}]}},
            {"apiVersion": "gateway.envoyproxy.io/v1alpha1", "kind": "EnvoyPatchPolicy", "metadata": {"name": name, "namespace": name}, "spec": {"type": "JSONPatch", "targetRef": {"group": "gateway.networking.k8s.io", "kind": "Gateway", "name": name}, "jsonPatches": [{"type": "type.googleapis.com/envoy.config.listener.v3.Listener", "name": f"{name}/{name}/probe", "operation": {"op": "replace", "path": "/default_filter_chain", "value": {"filters": [hcm]}}}]}}
        ]
        run([*kube, "create", "-f", "-"], json.dumps({"apiVersion": "v1", "kind": "List", "items": resources}))
        run([*kube, "-n", name, "wait", "gateway", name, "--for=condition=Programmed", f"--timeout={timeout}s"])
        selector = f"gateway.envoyproxy.io/owning-gateway-name={name},gateway.envoyproxy.io/owning-gateway-namespace={name}"
        run([*kube, "-n", envoy_namespace, "wait", "pod", "-l", selector, "--for=condition=Ready", f"--timeout={timeout}s"])
        pods = json.loads(run([*kube, "-n", envoy_namespace, "get", "pods", "-l", selector, "-o", "json"]))["items"]
        require(len(pods) == 1, "probe expected exactly one owned Envoy Pod")
        with socket.socket() as listener:
            listener.bind(("127.0.0.1", 0))
            port = listener.getsockname()[1]
        forwarding = subprocess.Popen([*kube, "-n", envoy_namespace, "port-forward", "pod/" + pods[0]["metadata"]["name"], f"{port}:18080", "--address=127.0.0.1"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            require(forwarding.poll() is None, "probe port-forward stopped")
            connection = http.client.HTTPConnection("127.0.0.1", port, timeout=2)
            try:
                connection.request("GET", "/")
                response = connection.getresponse()
                if response.status == 200 and response.read(1024).decode() == marker:
                    return
            except (OSError, http.client.HTTPException):
                pass
            finally:
                connection.close()
            time.sleep(1)
        raise RuntimeError("actual Envoy patch delivery probe timed out")
    finally:
        if forwarding is not None:
            forwarding.terminate()
            forwarding.wait(timeout=10)
        uid = owned_uids.get("Namespace")
        if uid is not None:
            # UID preconditions protect replacements. Let Namespace deletion
            # remove the Gateway before waiting for its external Pods.
            with tempfile.TemporaryDirectory(prefix="oce-probe-cleanup-") as directory:
                body = Path(directory) / "delete.json"
                body.write_text(json.dumps({"apiVersion": "v1", "kind": "DeleteOptions", "preconditions": {"uid": uid}}))
                run([*kube, "delete", "--raw", "/api/v1/namespaces/" + name, "-f", str(body)])
                run([*kube, "wait", "namespace", name, "--for=delete", f"--timeout={timeout}s"])
                run([*kube, "-n", envoy_namespace, "wait", "pods", "-l", f"gateway.envoyproxy.io/owning-gateway-name={name},gateway.envoyproxy.io/owning-gateway-namespace={name}", "--for=delete", f"--timeout={timeout}s"])
                policy_uid = owned_uids.get("NetworkPolicy")
                if policy_uid is not None:
                    body.write_text(json.dumps({"apiVersion": "v1", "kind": "DeleteOptions", "preconditions": {"uid": policy_uid}}))
                    run([*kube, "delete", "--raw", f"/apis/networking.k8s.io/v1/namespaces/{envoy_namespace}/networkpolicies/{name}", "-f", str(body)])
                    run([*kube, "-n", envoy_namespace, "wait", "networkpolicy", name, "--for=delete", f"--timeout={timeout}s"])


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, ValueError, KeyError, OSError, subprocess.SubprocessError) as error:
        print("setup-channel-egress: " + (str(error) if isinstance(error, RuntimeError) else "prerequisite operation failed; inspect the selected dependency and any reported probe namespace"), file=sys.stderr)
        sys.exit(1)
