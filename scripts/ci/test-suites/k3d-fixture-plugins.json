{
  "requiredEnv": [
    "OCC_TEST_KUBERNETES_KUBECONFIG",
    "OCC_TEST_KUBERNETES_CONTEXT",
    "OCC_TEST_KUBERNETES_IMAGE",
    "OCC_TEST_KUBERNETES_PLUGIN_STATUS_PROXY_CIDRS"
  ],
  "env": {
    "OCC_TEST_KUBERNETES_CONFIGURATION": "1"
  },
  "prepare": {
    "postgres": true,
    "k3d": true,
    "requiresPreparedStateForFile": true
  },
  "fileConcurrency": 2,
  "parallelFiles": [
    "tests/integration/kubelet-volume-refresh-k3d.test.mjs",
    "tests/integration/kubernetes-compute-driver-real.test.mjs"
  ],
  "files": [
    {
      "path": "tests/integration/kubelet-volume-refresh-k3d.test.mjs",
      "expectedTests": [
        "optional Secret and ConfigMap volumes populate in running Pods within the measured kubelet refresh bounds"
      ]
    },
    {
      "path": "tests/integration/kubernetes-compute-driver-real.test.mjs",
      "expectedTests": [
        "real Kubernetes Compute Driver owns isolated Agent gateways, identities, revisions, and deletion"
      ]
    }
  ]
}
