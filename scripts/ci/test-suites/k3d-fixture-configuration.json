{
  "requiredEnv": [
    "OCC_TEST_KUBERNETES_KUBECONFIG",
    "OCC_TEST_KUBERNETES_CONTEXT",
    "OCC_TEST_KUBERNETES_IMAGE",
    "OCC_TEST_KUBERNETES_PLUGIN_STATUS_PROXY_CIDRS"
  ],
  "env": {
    "OCC_TEST_KUBERNETES_CONFIGURATION": "1"
  },
  "prepare": {
    "postgres": true,
    "k3d": true,
    "requiresPreparedStateForFile": true
  },
  "fileConcurrency": 2,
  "parallelFiles": [
    "tests/integration/kubernetes-compute-real.test.mjs",
    "tests/integration/kubernetes-plugin-status-real.test.mjs"
  ],
  "files": [
    {
      "path": "tests/integration/kubernetes-plugin-status-real.test.mjs",
      "expectedTests": [
        "real Kubernetes Compute reads plugin runtime status from the exact gateway Pod",
        "real Kubernetes Compute reports plugin install warnings and disables failed plugin config"
      ]
    },
    {
      "path": "tests/integration/kubernetes-compute-real.test.mjs",
      "expectedTests": [
        "authenticated PostgreSQL OCC API and worker deploy real Agent-owned gateways, Secret bindings, and revisions"
      ]
    }
  ]
}
