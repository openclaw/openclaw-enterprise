{
  "env": {
    "OCC_TEST_REPOSITORY_CREDENTIALS_PLATFORM": "1"
  },
  "requiredEnv": [
    "OCC_TEST_DATABASE_URL",
    "OCC_TEST_KUBERNETES_KUBECONFIG",
    "OCC_TEST_KUBERNETES_CONTEXT",
    "OCC_TEST_REPOSITORY_CREDENTIALS_PLATFORM_IMAGE",
    "OCC_TEST_REPOSITORY_CREDENTIALS_HOST_ADDRESS"
  ],
  "prepare": {
    "postgres": true,
    "k3d": true,
    "requiresPreparedStateForFile": true
  },
  "fileConcurrency": 2,
  "parallelFiles": [
    "tests/integration/repository-credentials-platform.test.mjs",
    "tests/integration/repository-credentials-platform-recovery.test.mjs",
    "tests/integration/repository-credentials-platform-expiry.test.mjs"
  ],
  "files": [
    {
      "path": "tests/integration/repository-credentials-platform.test.mjs",
      "expectedTests": [
        "ordinary Agent repository bindings traverse HTTP, PostgreSQL, Unix control and Kubernetes material"
      ]
    },
    {
      "path": "tests/integration/repository-credentials-platform-recovery.test.mjs",
      "expectedTests": [
        "Agent stop recovers a confirmed disposal after the broker dies before its reply"
      ]
    },
    {
      "path": "tests/integration/repository-credentials-platform-expiry.test.mjs",
      "expectedTests": [
        "ordinary Agent worker withholds readiness when material expires during a Kubernetes observation"
      ]
    }
  ]
}
