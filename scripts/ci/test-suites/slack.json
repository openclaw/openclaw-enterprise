{
  "requiredEnv": [
    "OCC_TEST_KUBERNETES_KUBECONFIG",
    "OCC_TEST_KUBERNETES_CONTEXT",
    "OCC_TEST_PRODUCTION_CONTROLLER_IMAGE",
    "OCC_TEST_KUBERNETES_GATEWAY_IMAGE",
    "OCC_TEST_KUBERNETES_AGENT_IMAGE",
    "OPENAI_API_KEY",
    "OCC_TEST_OPENAI_MODEL",
    "OCC_TEST_SLACK_CHANNEL_ID",
    "OCC_TEST_SLACK_SENDER_BOT_TOKEN",
    "SLACK_APP_TOKEN",
    "SLACK_BOT_TOKEN",
    "OCC_TEST_GATEWAY_CA_CERT_PATH",
    "OCC_TEST_GATEWAY_CA_KEY_PATH"
  ],
  "env": {
    "OCC_TEST_SLACK_LIVE": "1"
  },
  "prepare": {
    "postgres": true,
    "k3d": true,
    "codexSeccomp": true,
    "requiresPreparedStateForFile": true,
    "requireEnv": [
      "OPENAI_API_KEY",
      "OCC_TEST_OPENAI_MODEL",
      "NODE_BASE_IMAGE",
      "OCC_TEST_SLACK_CHANNEL_ID",
      "OCC_TEST_SLACK_SENDER_BOT_TOKEN",
      "SLACK_APP_TOKEN",
      "SLACK_BOT_TOKEN"
    ],
    "immutableOptionalEnvImages": [
      "OCC_TEST_KUBERNETES_GATEWAY_IMAGE",
      "OCC_TEST_KUBERNETES_AGENT_IMAGE"
    ]
  },
  "files": [
    {
      "path": "tests/integration/harness-topology-k3d-slack-real.test.mjs",
      "expectedTests": [
        "production k3d gateway replies once to a real Slack message through its assigned Envoy listener and Codex Agent"
      ]
    },
    {
      "path": "tests/integration/channel-egress-kubernetes-real.test.ts",
      "expectedTests": [
        "channel egress isolates current Driver generations and retires real Agent bindings"
      ]
    },
    {
      "path": "tests/integration/channel-egress-helm-real.test.ts",
      "expectedTests": [
        "Helm-installed OCC and PostgreSQL deploy isolated Slack routing through real model cutover"
      ]
    }
  ],
  "fileConcurrency": 1,
  "optionalEnv": [
    "OCC_TEST_CHANNEL_EGRESS_UPGRADE",
    "OCC_TEST_CHANNEL_EGRESS_SOURCE_CONTROLLER_IMAGE",
    "OCC_TEST_CHANNEL_EGRESS_SOURCE_CHART",
    "OCC_TEST_CHANNEL_EGRESS_NEXT_CONTROLLER_IMAGE"
  ]
}
