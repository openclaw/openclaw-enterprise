    "postgres": {
      "prepare": {
        "postgres": true,
        "requiresPreparedStateForFile": true
      },
      "files": [
        {
          "path": "tests/integration/postgres-auth-accounts.test.mjs",
          "expectedTests": [
            "fresh PostgreSQL development bootstrap writes a usable administrator service key",
            "PostgreSQL auth account provisioning is visible to another controller without rebuilding IAM Driver",
            "PostgreSQL auth account audit failure rolls back IAM and Better Auth account state"
          ]
        },
        {
          "path": "tests/integration/postgres-bootstrap-failures.test.mjs",
          "expectedTests": [
            "concurrent development bootstrap subprocesses reject the loser and reload the committed winner",
            "production bootstrap preserves committed credentials when COMMIT acknowledgement is lost",
            "known bootstrap failures preserve created artifacts and report safe diagnostics",
            "development bootstrap preserves credentials when COMMIT acknowledgement is lost"
          ]
        },
        {
          "path": "tests/integration/postgres-platform-state.test.mjs",
          "expectedTests": [
            "PostgreSQL rejects platform writes until the singleton Installation is bootstrapped",
            "real OCC Namespace lifecycle persists provisioning, readiness, deletion, and its tombstone",
            "PostgreSQL platform state satisfies memory adapter ownership, immutability, and atomicity",
            "the PostgreSQL worker reloads exact Namespace restrictions and never dispatches revoked provisioning"
          ]
        },
        {
          "path": "tests/integration/postgres-production-wireup.test.mjs",
          "expectedTests": [
            "production bootstrap creates a generated-password administrator that can authenticate"
          ]
        },
        {
          "path": "tests/integration/postgres-provider-ownership.test.mjs",
          "expectedTests": [
            "development API starts with stale Provider references and permits repair through Agent update",
            "PostgreSQL Provider ownership persists exact Agent associations and admits only matching managed bindings"
          ]
        },
        {
          "path": "tests/integration/postgres-restart-recovery.test.mjs",
          "expectedTests": [
            "Namespace creation and deletion retain distinct durable work targets",
            "durable work deduplicates exact ownership and rejects actor or owner collisions",
            "Namespace convergence and admitted revision work share one durable queue with exact resource ownership",
            "stale and exhausted recovery includes admitted revisions and Namespace lifecycle work",
            "transaction-scoped queue fencing rolls back Namespace mutation, completion, and audit together",
            "concurrent claims exclude one Namespace lifecycle and one Agent while distinct Agents progress",
            "a restarted queue recovers expired claims, fences old tokens, and persists exhausted failures",
            "batch stale recovery reports each expired claim once and writes one audit event per item"
          ]
        },
        {
          "path": "tests/integration/postgres-secret-state.test.mjs",
          "expectedTests": [
            "in-memory state persists Secret metadata and binding references without values",
            "PostgreSQL state persists Secret metadata and enforces binding dependencies"
          ]
        },
        {
          "path": "tests/integration/postgres-service-api-keys.test.mjs",
          "expectedTests": [
            "PostgreSQL Better Auth keys remain hashed, scoped, and revocable across instances"
          ]
        },
        {
          "path": "tests/integration/postgres-worker-agent-revision.test.mjs",
          "expectedTests": [
            "maintenance retains its real lease across consecutive short predecessor retirements",
            "the revision worker activates admitted candidates, retires predecessors, and rejects revoked, malformed, and wrong-owner effects",
            "the revision worker rejects associated-account access revoked after admission before invoking Compute",
            "the revision worker rejects managed ServiceAccount provider mismatches before Compute",
            "the revision worker retries transient Provider binding read failures without activating",
            "an older revision retry is superseded without preparing or retiring a newer active revision",
            "real PostgreSQL preserves the failure budget while an Agent runtime converges",
            "an overdue Agent runtime fails closed without activating its incomplete revision",
            "one worker reconciles embedded OpenClaw and dedicated Codex but rejects unapproved pinned Harnesses",
            "a lost retirement claim preserves the activated replacement and cannot complete stolen work"
          ]
        },
        {
          "path": "tests/integration/postgres-worker-stale-claim.test.mjs",
          "expectedTests": [
            "a worker that loses its claim during Compute cannot publish Namespace status, lifecycle audit, or completion"
          ]
        },
        {
          "path": "tests/integration/compute-singleton-worker-postgres.test.mjs",
          "expectedTests": [
            "a worker binds persisted Namespace, Agent, and service principal before provider effects",
            "a production singleton driver activates under its claim heartbeat before CAS and retires only after CAS",
            "failed singleton activation retries without publishing or retiring the previous revision",
            "production Drivers without an activation preference retain after-commit Kubernetes ordering",
            "an opted-in active runtime continuously repairs under its original authorized actor",
            "active maintenance recovers after its convergence deadline and stops when its actor is denied"
          ]
        }
      ]
    },
