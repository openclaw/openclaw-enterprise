#!/usr/bin/env python3
"""Translate a private operator profile into the coordinated upgrade command."""

import argparse
import hashlib
import json
import os
import re
import shlex
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


NEW_RUNS = ("apply", "preflight", "migration-check")
OPERATIONS = ("plan", *NEW_RUNS, "status", "resume", "cleanup-preflight")
REQUIRED = (
    "kubeconfig",
    "context",
    "namespace",
    "release",
    "installationDirectory",
    "sourceRevision",
)
OPTIONAL = ("occ", "images")
IMAGE_FLAGS = {
    "controller": "--controller-image",
    "broker": "--broker-image",
    "runtime": "--runtime-image",
}
PROTECTED = {
    "--profile",
    "--kubeconfig",
    "--context",
    "--namespace",
    "--release",
    "--values",
    "--installation",
    "--source-revision",
    "--evidence-dir",
    "--occ",
    *IMAGE_FLAGS.values(),
    "--auto-approve",
    "--preflight-only",
    "--migration-check-only",
    "--resume",
    "--cleanup-preflight",
    "--help",
    "-h",
}


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate field")
        result[key] = value
    return result


def profile_input(parser, filename):
    try:
        fd = os.open(
            filename, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
        )
        with os.fdopen(fd, "rb") as stream:
            info = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_uid != os.geteuid()
                or info.st_mode & 0o077
            ):
                parser.error(
                    "profile must be an owner-only regular file, not a symbolic link"
                )
            if info.st_size > 65536:
                parser.error("profile must be at most 64 KiB")
            value = json.loads(stream.read(65537), object_pairs_hook=unique_object)
    except (OSError, UnicodeError, ValueError):
        parser.error("cannot read private profile JSON; use an owner-only regular file")

    if not isinstance(value, dict) or set(value) - set(REQUIRED) - set(OPTIONAL):
        parser.error(
            "unsupported profile fields; store credential file references outside the profile"
        )
    for key in REQUIRED + ("occ",):
        if key == "occ" and key not in value:
            continue
        item = value.get(key)
        if (
            not isinstance(item, str)
            or not item.strip()
            or not item.isprintable()
        ):
            parser.error(
                "profile requires nonempty target, installation directory, and source fields"
            )
    images = value.get("images", {})
    if not isinstance(images, dict) or set(images) - set(IMAGE_FLAGS):
        parser.error("unsupported profile image fields")
    if any(
        not isinstance(image, str)
        or not image.strip()
        or not image.isprintable()
        for image in images.values()
    ):
        parser.error("profile images must be nonempty strings")
    return value


def report_status(parser, directory, *, allow_missing=False):
    try:
        try:
            fd = os.open(Path(directory), os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_DIRECTORY)
        except FileNotFoundError:
            if not allow_missing:
                parser.error("resume requires the original native evidence directory; inspect RUN and reconcile the outcome")
            print("Status: no native evidence exists at this path. The run outcome is unknown.")
            print("Verify the original path and reconcile any prior request before another write.")
            return
        try:
            info = os.fstat(fd)
            if info.st_uid != os.geteuid() or info.st_mode & 0o077:
                parser.error("evidence must be an owner-only directory, not a symbolic link")
            observed = {}
            for name, is_directory in (
                ("prepared", False),
                ("database-migration-handoff.json", False),
                ("migration-check-passed", False),
                ("helm-started", False),
                ("completed", False),
                (".upgrade-lock", True),
                ("native-command-failures.tsv", False),
            ):
                try:
                    item = os.stat(name, dir_fd=fd, follow_symlinks=False)
                except FileNotFoundError:
                    observed[name] = False
                    continue
                expected = stat.S_ISDIR(item.st_mode) if is_directory else stat.S_ISREG(item.st_mode)
                if not expected or item.st_uid != os.geteuid() or item.st_mode & 0o077:
                    parser.error("evidence contains an invalid or nonprivate status marker")
                observed[name] = True
        finally:
            os.close(fd)
    except OSError:
        parser.error("cannot inspect private local evidence directory")

    if observed["completed"]:
        print("Status: completion was recorded; verify the current release and workloads separately.")
    elif observed["helm-started"]:
        print("Status: Helm intent was recorded; its outcome remains uncertain without completion evidence.")
    elif observed["database-migration-handoff.json"]:
        print("Status: a migration pause was recorded; confirm migration history before an authorized resume.")
    elif observed["migration-check-passed"]:
        print("Status: the migration compatibility check and Job cleanup were recorded. This evidence cannot resume an upgrade.")
    else:
        print("Status: no completion was recorded; inspect the original attempt before any further write.")
    print("Recorded markers: " + (", ".join(name for name, present in observed.items() if present) or "none"))
    print("These are local observations, not current cluster health or resume authority.")
    if observed[".upgrade-lock"]:
        print("A lock marker exists; it does not prove whether the previous process is still running.")


def check_revision(parser, checkout, revision):
    if not re.fullmatch(r"[0-9a-f]{40}", revision):
        parser.error("source revision must be a full lowercase Git commit SHA")
    environment = os.environ.copy()
    environment.pop("GIT_DIR", None)
    environment.pop("GIT_COMMON_DIR", None)
    environment.update(GIT_NO_LAZY_FETCH="1", GIT_ALLOW_PROTOCOL="")
    git = ["git", "--no-optional-locks", "--no-replace-objects", "--git-dir=.git"]
    try:
        root = subprocess.check_output(
            [*git, "rev-parse", "--show-toplevel"], cwd=checkout, env=environment,
            stderr=subprocess.DEVNULL, text=True,
        ).strip()
        head = subprocess.check_output(
            [*git, "rev-parse", "--verify", "HEAD^{commit}"], cwd=checkout, env=environment,
            stderr=subprocess.DEVNULL, text=True,
        ).strip()
        matches = Path(root).samefile(checkout) and head == revision
    except (OSError, subprocess.CalledProcessError):
        parser.error("cannot read the reviewed release checkout revision")
    if not matches:
        parser.error("checkout commit does not match the profile source revision")


# These are the native image upgrade options the preview can explain.
EXPERT_VALUES = {
    "--candidate-values",
    "--candidate-installation",
    "--controller-compatibility-results",
    "--timeout-seconds",
    "--doctor-heap-mib",
    "--verify-agent",
    "--verify-agent-namespace",
}
EXPERT_SWITCHES = {"--collector-config-reviewed", "--verbose"}
RECOVERY_SWITCHES = {"--recover-helm", "--recovery-reviewed", "--migration-history-checked"}


def expert_options(parser, operation, arguments):
    options = {}
    items = iter(arguments)
    for flag in items:
        if flag in EXPERT_VALUES:
            value = next(items, None)
            if not value or not value.isprintable():
                parser.error(f"{flag} requires a nonempty printable value")
            options[flag] = value
        elif flag in EXPERT_SWITCHES or (operation == "resume" and flag in RECOVERY_SWITCHES):
            options[flag] = True
        else:
            parser.error("unrecognized expert upgrade option; see scripts/upgrade-production-images --help")
    return options


def preview_file(parser, name, filename, *, private=True):
    try:
        fd = os.open(filename, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or (private and info.st_mode & 0o077):
                parser.error(f"{name} must be a private readable regular file" if private else
                             f"{name} must be a readable regular file")
            return stream.read()
    except OSError:
        parser.error(f"cannot read {name}; use a regular file without a symbolic link")


def preview_mapping(parser, name, content):
    try:
        try:
            value = json.loads(content, object_pairs_hook=unique_object)
        except ValueError:
            converted = subprocess.check_output(
                ["yq", "-p=yaml", "-o=json", ".", "-"],
                input=content, stderr=subprocess.DEVNULL,
            )
            value = json.loads(converted, object_pairs_hook=unique_object)
        if isinstance(value, dict):
            return value
    except (OSError, subprocess.CalledProcessError, ValueError):
        pass
    parser.error(f"{name} must contain one readable YAML mapping; check that yq is installed")


def setting(mapping, *path):
    for key in path:
        if not isinstance(mapping, dict):
            return None
        mapping = mapping.get(key)
    return mapping


MISSING = object()


def changed_categories(before, after, categories, prefix=()):
    if prefix not in categories:
        if before is MISSING and isinstance(after, dict) and after:
            before = {}
        if after is MISSING and isinstance(before, dict) and before:
            after = {}
        if isinstance(before, dict) and isinstance(after, dict):
            changed = set()
            for key in before.keys() | after.keys():
                changed.update(changed_categories(
                    before.get(key, MISSING), after.get(key, MISSING), categories, (*prefix, key)
                ))
            return changed
    if before is not MISSING and after is not MISSING and (
        json.dumps(before, sort_keys=True) == json.dumps(after, sort_keys=True)
    ):
        return set()
    return {categories.get(prefix, "other settings")}


def preview_inputs(parser, kubeconfig, directory, options):
    paths = {
        "kubeconfig": kubeconfig,
        "baseline Helm values": str(directory / "values.yaml"),
        "baseline Installation": str(directory / "installation.yaml"),
    }
    for flag, role in (
        ("--candidate-values", "candidate Helm values"),
        ("--candidate-installation", "candidate Installation"),
        ("--controller-compatibility-results", "controller compatibility receipt"),
    ):
        if flag in options:
            paths[role] = options[flag]
    digests = {}
    mappings = {}
    for role, filename in paths.items():
        receipt = role == "controller compatibility receipt"
        content = preview_file(parser, role, filename, private=not receipt)
        digests[role] = hashlib.sha256(content).hexdigest()
        if role not in ("kubeconfig", "controller compatibility receipt"):
            mappings[role] = preview_mapping(parser, role, content)
    before_values = mappings["baseline Helm values"]
    values = mappings.get("candidate Helm values", before_values)
    before_installation = mappings["baseline Installation"]
    installation = mappings.get("candidate Installation", before_installation)

    migration = setting(values, "database", "upgradeMigration")
    if migration is None:
        migration = "hook"
    if migration not in ("hook", "separate"):
        parser.error("candidate Helm values must select hook or separate database.upgradeMigration")
    effects = [f"Database migration mode: {migration}"]
    if migration == "separate":
        effects.append("The upgrade can stop OCC writers and pause for separate database migration (exit 3).")
    values_changes = changed_categories(before_values, values, {
        ("database", "upgradeMigration"): "migration mode",
        ("api", "channelDirectoryProxyUrl"): "Slack directory proxy",
        ("installation", "secretName"): "Installation Secret reference",
        ("agentNativeAdmin", "sharedCookieDomain"): "retired native admin cookie domain",
    })
    effects.extend(f"Helm values change: {name}" for name in sorted(values_changes))
    if "Installation Secret reference" in values_changes:
        secret = setting(values, "installation", "secretName")
        if secret is None:
            secret = "occ-installation-startup"
        if isinstance(secret, str) and re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?", secret):
            effects.append(f"Candidate Installation Secret: {secret}")
    installation_changes = changed_categories(before_installation, installation, {
        ("drivers", "plugin"): "Plugin Driver registration",
    })
    effects.extend(f"Installation change: {name}" for name in sorted(installation_changes))
    if values_changes or installation_changes:
        effects.append("Apply checks candidate changes against the live release and protected settings.")
    if "--collector-config-reviewed" in options:
        effects.append("Collector configuration review attestation supplied.")
    if "--recover-helm" in options:
        effects.append("Reviewed Helm recovery can roll back the interrupted attempt before continuing.")
    if "--migration-history-checked" in options:
        effects.append("Database migration history verification attested.")
    if "--verify-agent" in options or "--verify-agent-namespace" in options:
        effects.append("Agent continuity verification requested.")
    if "--verbose" in options:
        effects.append("Native command output enabled.")
    for flag, role in (("--timeout-seconds", "Wait timeout (seconds)"), ("--doctor-heap-mib", "Doctor heap (MiB)")):
        if flag in options:
            value = options[flag]
            effects.append(f"{role}: " + (value if re.fullmatch(r"[0-9]{1,10}", value) else "review supplied value"))
    return paths, digests, effects


def check_preview_inputs(parser, paths, digests):
    for role, path in paths.items():
        content = preview_file(parser, role, path, private=role != "controller compatibility receipt")
        if hashlib.sha256(content).hexdigest() != digests[role]:
            parser.error(f"{role} changed after the preview; review a fresh plan")


def show_plan(parser, profile, profile_relative_path, digests, effects, resume_run):
    images = profile.get("images", {})
    if not images:
        parser.error("select a controller, broker, or runtime image before planning")
    for name, image in images.items():
        if not re.fullmatch(r"[^@\s]+@sha256:[a-f0-9]{64}", image):
            parser.error(f"{name} must be an immutable SHA-256 image reference")
        # Use the same Kubernetes reference parser as the upgrade, without inherited Node hooks.
        try:
            problem = subprocess.check_output(
                ["node", "scripts/lib/image-reference-problem.ts", image],
                env={"PATH": os.environ.get("PATH", os.defpath)},
                stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except (OSError, subprocess.CalledProcessError):
            parser.error("cannot run the image reference check; check your Node.js installation")
        if problem:
            parser.error(f"{name} must be a valid immutable SHA-256 image reference")

    print("Resume preview (offline)" if resume_run else "Image upgrade plan (offline)")
    print(f"  Kubeconfig: {profile_relative_path(profile['kubeconfig'])}")
    print(f"  Context: {profile['context']}")
    print(f"  Namespace: {profile['namespace']}")
    print(f"  Helm release: {profile['release']}")
    print(f"  Checkout: {profile['sourceRevision']}")
    print(f"  Rendered baseline: {profile_relative_path(profile['installationDirectory'])}")
    for name in IMAGE_FLAGS:
        if name in images:
            print(f"  {name}: {images[name]}")
    if "runtime" in images:
        print("  Agents: redeploy those running at the start of the upgrade")
    else:
        print("  Agents: keep current revisions")
    for name, digest in digests.items():
        if name != "kubeconfig":
            print(f"  {name}: sha256:{digest}")
    for effect in effects:
        print(f"  {effect}")
    print("No cluster contact or writes occurred during this preview. Current images and migration requirements are unknown.")
    if resume_run:
        print(f"Resume run: {Path(resume_run).absolute()}")
        report_status(parser, resume_run)
        print("Resume can continue deployment. Reconcile previous effects before approving.")
    else:
        print("Apply runs preflight and can stop OCC writers. Use the maintenance window.")


def confirm(parser, operation):
    sys.stdout.flush()
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.exit(2, f"Approval required. Run {operation} in a terminal or pass --auto-approve.\n")
    print(f"{operation.capitalize()} this image upgrade? Type yes to continue: ", end="", flush=True)
    try:
        answer = sys.stdin.readline(5)
    except (KeyboardInterrupt, OSError, UnicodeError):
        answer = ""
    if answer != "yes\n":
        if not answer:
            print()
        parser.exit(1, f"{operation.capitalize()} cancelled; no command dispatched.\n")


def evidence_parent(parser, checkout, base):
    try:
        directory = base.absolute()
        info = directory.stat()
        required = stat.S_IWUSR | stat.S_IXUSR
        if (
            directory != directory.resolve(strict=True)
            or directory.is_relative_to(checkout)
            or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != os.geteuid()
            or info.st_mode & 0o022
            or info.st_mode & required != required
            or not str(directory).isprintable()
        ):
            parser.error(
                "evidence needs a writable directory outside the checkout, owned by you, "
                "with no symlinks or other writers; choose a safe --evidence-dir"
            )
        # Ancestors must prevent another writer from replacing the private run path.
        owners = {os.geteuid(), Path("/").stat().st_uid}
        for ancestor in directory.parents:
            info = ancestor.stat()
            if info.st_uid not in owners or (info.st_mode & 0o022 and not info.st_mode & stat.S_ISVTX):
                parser.error("evidence directory has an unsafe ancestor; choose a safe --evidence-dir")
        return directory
    except OSError:
        parser.error("evidence parent must exist and be writable; choose a safe --evidence-dir")


def fresh_evidence(parser, checkout, value):
    locator = Path(value).absolute()
    if locator.name in ("", ".", ".."):
        parser.error("choose a new name for --evidence-dir")
    evidence_parent(parser, checkout, locator.parent)
    if os.path.lexists(locator) or os.path.lexists(str(locator) + ".dispatch-state"):
        parser.error("evidence or its dispatch journal already exists; choose a fresh --evidence-dir")
    return str(locator)


def new_evidence(parser, checkout, base, operation):
    directory = evidence_parent(parser, checkout, base)
    try:
        # The native owner requires an absent leaf and may create a sibling journal.
        parent = tempfile.mkdtemp(prefix=f"occ-{operation}-", dir=directory)
    except OSError:
        parser.error("cannot reserve evidence beside the profile; choose a safe --evidence-dir")
    return str(Path(parent) / "evidence")


def main():
    parser = argparse.ArgumentParser(
        allow_abbrev=False,
        description="Run a coordinated production image upgrade from a private operator profile.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Pass additional canonical upgrade options after --. To translate a canonical mode,\n"
            "change the operation and remove only that mode flag; retain all other original\n"
            "expert options and applicable attestations after --:\n"
            "  --resume: scripts/upgrade-production resume --profile PROFILE --evidence-dir ORIGINAL -- ORIGINAL_EXPERT_OPTIONS\n"
            "  --preflight-only: scripts/upgrade-production preflight --profile PROFILE --evidence-dir FRESH -- ORIGINAL_EXPERT_OPTIONS\n"
            "For full control, run scripts/upgrade-production-images --help."
        ),
    )
    parser.add_argument("operation", choices=OPERATIONS)
    parser.add_argument("--profile", help="Owner-only operator JSON file")
    parser.add_argument("--auto-approve", action="store_true", help="Apply or resume without an interactive confirmation")
    parser.add_argument(
        "--evidence-dir",
        help="New evidence path (default: private run beside the profile), or the original path for recovery",
    )
    argv = sys.argv[1:]
    split = argv.index("--") if "--" in argv else len(argv)
    args = parser.parse_args(argv[:split])
    extra = argv[split + 1 :] if split < len(argv) else []
    if args.auto_approve and args.operation not in ("apply", "resume"):
        parser.error("--auto-approve is only valid with apply or resume")
    if args.evidence_dir is not None and (
        not args.evidence_dir.strip() or not str(Path(args.evidence_dir).absolute()).isprintable()
    ):
        parser.error("evidence path must be nonempty and printable")
    if args.operation == "status" and extra:
        parser.error("status does not accept expert upgrade options")
    if args.operation == "status":
        if args.profile is not None or not args.evidence_dir:
            parser.error("status requires --evidence-dir and does not use --profile")
    elif args.operation == "plan":
        if not args.profile or args.evidence_dir is not None:
            parser.error("plan requires --profile and does not use --evidence-dir")
    elif not args.profile:
        parser.error("this operation requires --profile")
    elif args.operation not in NEW_RUNS and not args.evidence_dir:
        parser.error("recovery requires the original --evidence-dir")
    extra_flags = {item.split("=", 1)[0] for item in extra}
    if "--resume" in extra_flags:
        parser.error(
            "use the resume operation and remove only --resume; retain every other original "
            "expert option and applicable recovery attestation after --, including "
            "--migration-history-checked when required: occ installation upgrade resume RUN "
            "--profile PROFILE -- ORIGINAL_EXPERT_OPTIONS"
        )
    if "--preflight-only" in extra_flags:
        parser.error(
            "use the preflight operation and remove only --preflight-only; retain every other "
            "original expert option after --: occ installation upgrade preflight "
            "--profile PROFILE -- ORIGINAL_EXPERT_OPTIONS"
        )
    if args.operation in ("plan", *NEW_RUNS) and extra_flags & RECOVERY_SWITCHES:
        parser.error(
            "recovery attestations require the original run. After reconciling its outcome, "
            "use occ installation upgrade resume RUN --profile PROFILE -- ORIGINAL_OPTIONS_AND_ATTESTATIONS"
        )
    if extra_flags & PROTECTED:
        parser.error("cannot override profile or operation arguments after --")

    checkout = Path(__file__).resolve().parent.parent
    if checkout != Path.cwd().resolve():
        parser.error("run this command from its reviewed release checkout root")
    if args.operation == "status":
        report_status(parser, args.evidence_dir, allow_missing=True)
        return

    profile = profile_input(parser, args.profile)
    profile_path = Path(args.profile).absolute()
    base = profile_path.parent

    def path(value):
        candidate = Path(value)
        return str(candidate if candidate.is_absolute() else base / candidate)

    if not str(profile_path).isprintable():
        parser.error("profile path must be printable")
    if args.operation in NEW_RUNS and args.evidence_dir is not None:
        args.evidence_dir = fresh_evidence(parser, checkout, args.evidence_dir)
    digests = None
    if args.operation in ("plan", "apply", "resume"):
        check_revision(parser, checkout, profile["sourceRevision"])
        options = expert_options(parser, args.operation, extra)
        resume_run = args.evidence_dir if args.operation == "resume" else None
        directory = Path(path(profile["installationDirectory"]))
        paths, digests, effects = preview_inputs(
            parser, path(profile["kubeconfig"]), directory, options
        )
        show_plan(parser, profile, path, digests, effects, resume_run)
        if args.operation == "plan":
            return
        if not args.auto_approve:
            confirm(parser, args.operation)
        check_preview_inputs(parser, paths, digests)
    elif args.operation == "cleanup-preflight":
        print("Cleanup removes only the original run's recorded temporary resources. It cannot resume deployment.")
    else:
        if args.evidence_dir is None:
            check_revision(parser, checkout, profile["sourceRevision"])
        print("This check creates temporary cluster resources and confirms cleanup before reporting success.")

    if args.operation in NEW_RUNS:
        if args.evidence_dir is None:
            args.evidence_dir = new_evidence(parser, checkout, base, args.operation)
        else:
            args.evidence_dir = fresh_evidence(parser, checkout, args.evidence_dir)
        locator = args.evidence_dir
        print(f"Evidence: {locator}")
        print(f"Inspect: occ installation upgrade status {shlex.quote(locator)}")
        if args.operation == "apply":
            print("Use the original evidence and arguments if the upgrade reports a recovery step.")
    sys.stdout.flush()

    target = [
        "--kubeconfig",
        path(profile["kubeconfig"]),
        "--context",
        profile["context"],
        "--namespace",
        profile["namespace"],
        "--release",
        profile["release"],
    ]
    if args.operation == "cleanup-preflight":
        command = ["--cleanup-preflight", *target, "--evidence-dir", args.evidence_dir]
    else:
        directory = Path(path(profile["installationDirectory"]))
        installation = (
            []
            if args.operation == "migration-check"
            else ["--installation", str(directory / "installation.yaml")]
        )
        command = [
            *target,
            "--values",
            str(directory / "values.yaml"),
            *installation,
            "--source-revision",
            profile["sourceRevision"],
            "--evidence-dir",
            args.evidence_dir,
        ]
        if "occ" in profile and args.operation != "migration-check":
            command.extend(("--occ", path(profile["occ"])))
        for name, image in profile.get("images", {}).items():
            if args.operation != "migration-check" or name == "controller":
                command.extend((IMAGE_FLAGS[name], image))
        if args.operation == "preflight":
            command.append("--preflight-only")
        elif args.operation == "migration-check":
            command.append("--migration-check-only")
        elif args.operation == "resume":
            command.append("--resume")

    canonical = checkout / "scripts" / "upgrade-production-images"
    try:
        environment = os.environ.copy()
        environment.pop("OCC_UPGRADE_APPROVED_INPUTS", None)
        if args.operation == "apply":
            environment["OCC_UPGRADE_APPROVED_INPUTS"] = json.dumps(digests)
        os.execve(canonical, [str(canonical), *command, *extra], environment)
    except OSError:
        parser.error(
            "cannot start scripts/upgrade-production-images from this release checkout"
        )


if __name__ == "__main__":
    main()
