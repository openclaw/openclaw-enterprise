#!/usr/bin/env bash
set -euo pipefail
umask 077

DEFAULT_RUNTIME_IMAGE="openclaw-enterprise-runtime:quickstart"
BOOTSTRAP_SERVICE_KEY_SOURCE="bootstrap:/var/lib/openclaw/bootstrap/initial-admin-service-key.json"
BOOTSTRAP_SERVICE_KEY_PATH="/var/lib/openclaw/bootstrap/initial-admin-service-key.json"
STARTUP_TIMEOUT_SECONDS=300

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
occ_cli="$repo_root/bin/occ"
cd "$repo_root"

development_compute_driver="${OCC_DEVELOPMENT_COMPUTE_DRIVER:-docker}"
case "$development_compute_driver" in
  docker) ;;
  kubernetes)
    if [ ! -x "$occ_cli" ]; then
      echo "dev-up: prerequisite failed: OCC CLI is required at $occ_cli; run pnpm cli:build" >&2
      exit 1
    fi
    exec "$occ_cli" dev up "$@"
    ;;
  *)
    echo "dev-up: configuration failed: OCC_DEVELOPMENT_COMPUTE_DRIVER must be docker or kubernetes" >&2
    exit 2
    ;;
esac

usage() {
  echo "usage: scripts/dev-up [--key-output PATH] [-- COMPOSE_GLOBAL_OPTIONS...]" >&2
}

quote_command() {
  local first=1
  local arg
  for arg in "$@"; do
    if [ "$first" -eq 0 ]; then
      printf ' '
    fi
    printf '%q' "$arg"
    first=0
  done
}

fail() {
  local stage="$1"
  local message="$2"
  shift 2
  echo "dev-up: ${stage} failed: ${message}" >&2
  if [ "$#" -gt 0 ]; then
    printf 'diagnostic: ' >&2
    quote_command "$@" >&2
    printf '\n' >&2
  fi
  exit 1
}

usage_error() {
  local stage="$1"
  local message="$2"
  echo "dev-up: ${stage} failed: ${message}" >&2
  usage
  exit 2
}

key_output=""
compose_args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --key-output)
      if [ "$#" -lt 2 ] || [ -z "$2" ]; then
        usage_error "arguments" "--key-output requires a path"
      fi
      key_output="$2"
      shift 2
      ;;
    --)
      shift
      compose_args=("$@")
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage_error "arguments" "unknown option: $1"
      ;;
  esac
done

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "prerequisite" "$1 is required on PATH"
  fi
}

require_command python3
if [ ! -x "$occ_cli" ]; then
  fail "prerequisite" "OCC CLI is required at $occ_cli; run pnpm cli:build"
fi

temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/openclaw-dev-up.XXXXXXXXXX")"
chmod 700 "$temporary_directory"
cleanup() {
  rm -rf -- "$temporary_directory"
}
trap cleanup EXIT

validate_key_output() {
  python3 - "$1" <<'PY'
import os
import pathlib
import stat
import sys

path = pathlib.Path(sys.argv[1])
if not path.is_absolute():
    raise SystemExit("key output must be an absolute path")
if path.exists() or path.is_symlink():
    raise SystemExit("destination already exists")
parent = path.parent
try:
    parent_stat = parent.stat()
except FileNotFoundError:
    raise SystemExit("parent directory does not exist")
if not stat.S_ISDIR(parent_stat.st_mode):
    raise SystemExit("parent path is not a directory")
if parent_stat.st_uid != os.geteuid():
    raise SystemExit("parent directory must be owned by the current user")
if stat.S_IMODE(parent_stat.st_mode) & 0o077:
    raise SystemExit("parent directory must be private to the current user")
PY
}

if [ -z "$key_output" ]; then
  key_directory="$(mktemp -d "${TMPDIR:-/tmp}/openclaw-dev-up-key.XXXXXXXXXX")"
  chmod 700 "$key_directory"
  key_output="$key_directory/initial-admin-service-key.json"
else
  if ! key_output_error="$(validate_key_output "$key_output" 2>&1)"; then
    usage_error "key output" "$key_output_error"
  fi
fi

container_engine=""
container_engine_label=""
engine_command=()
compose_command=()
compose_capability_probe="$temporary_directory/compose-capability.yaml"
printf 'services:\n  probe:\n    image: scratch\n' >"$compose_capability_probe"

requested_container_engine="${OCC_DEVELOPMENT_CONTAINER_ENGINE:-auto}"
case "$requested_container_engine" in
  auto | docker | podman) ;;
  *) fail "configuration" "OCC_DEVELOPMENT_CONTAINER_ENGINE must be auto, docker, or podman" ;;
esac

if [ "$requested_container_engine" != podman ] && command -v docker >/dev/null 2>&1; then
  # Some Docker servers omit the platform name. Only a positive Podman identity
  # selects its separate socket, Compose and logging configuration.
  docker_platform="$(docker version --format '{{.Server.Platform.Name}}' 2>/dev/null || true)"
  if [ "$docker_platform" != "Podman Engine" ] &&
    docker_root_directory="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)" &&
    [ -n "$docker_root_directory" ] &&
    docker compose version >/dev/null 2>&1 &&
    docker compose -f "$compose_capability_probe" config --format json \
      >"$temporary_directory/docker-compose-capability.json" 2>/dev/null; then
    container_engine="docker"
    container_engine_label="Docker"
    engine_command=(docker)
    compose_command=(docker compose)
  fi
fi

if [ -z "$container_engine" ] && [ "$requested_container_engine" != docker ] && command -v podman >/dev/null 2>&1; then
  if podman compose version >/dev/null 2>&1; then
    require_command podman-compose
    podman_compose_provider="$(command -v podman-compose)"
    podman_socket="$(podman info --format '{{.Host.RemoteSocket.Path}}' 2>/dev/null || true)"
    podman_socket="${podman_socket#unix://}"
    if [ "${podman_socket#/}" = "$podman_socket" ] || [ -z "$podman_socket" ]; then
      fail "prerequisite" "Podman did not report an absolute API socket path" podman info
    fi
    require_command yq
    yq_version="$(yq --version 2>/dev/null || true)"
    case "$yq_version" in
      *"version v4."*) ;;
      *) fail "prerequisite" "Podman development requires yq v4" yq --version ;;
    esac
    container_engine="podman"
    container_engine_label="Podman"
    engine_command=(podman)
    compose_command=(podman compose)
    export PODMAN_COMPOSE_PROVIDER="$podman_compose_provider"
    export OCC_CONTAINER_ENGINE_SOCKET="$podman_socket"

    compose_file_selected=0
    if [ "${#compose_args[@]}" -gt 0 ]; then
      for arg in "${compose_args[@]}"; do
        case "$arg" in
          -f | --file | --file=*) compose_file_selected=1 ;;
        esac
      done
    fi
    if [ "$compose_file_selected" -eq 0 ]; then
      compose_file_args=()
      if [ -n "${COMPOSE_FILE:-}" ]; then
        compose_environment_files=()
        IFS="${COMPOSE_PATH_SEPARATOR:-:}" read -r -a compose_environment_files <<<"$COMPOSE_FILE"
        for compose_file in "${compose_environment_files[@]}"; do
          if [ -z "$compose_file" ]; then
            fail "configuration" "COMPOSE_FILE contains an empty file path"
          fi
          compose_file_args+=(-f "$compose_file")
        done
        unset COMPOSE_FILE
      else
        compose_file_args=(-f compose.yaml)
      fi
      if [ "${#compose_args[@]}" -eq 0 ]; then
        compose_args=("${compose_file_args[@]}")
      else
        compose_args=("${compose_file_args[@]}" "${compose_args[@]}")
      fi
    fi

    podman_override_selected=0
    for arg in "${compose_args[@]}"; do
      case "$arg" in
        *compose.logging.yaml)
          fail "configuration" "Docker Fluentd logging is not supported with Podman"
          ;;
        *compose.podman.yaml) podman_override_selected=1 ;;
      esac
    done
    if [ "$podman_override_selected" -eq 0 ]; then
      compose_args+=(-f "$repo_root/compose.podman.yaml")
    fi
  fi
fi

if [ -z "$container_engine" ]; then
  fail "prerequisite" "a running Docker Engine with Docker Compose or Podman with podman-compose is required"
fi

if [ "$container_engine" = "docker" ]; then
  compose_ps_status_args=(ps --all --format json)
  compose_ps_diagnostic_args=(ps --all)
else
  compose_ps_status_args=(ps --format json)
  compose_ps_diagnostic_args=(ps)
fi

engine() {
  "${engine_command[@]}" "$@"
}

compose() {
  "${compose_command[@]}" "${compose_args[@]}" "$@"
}

compose_config="$temporary_directory/compose-config.json"
if [ "$container_engine" = "docker" ]; then
  if ! compose config --format json >"$compose_config" 2>"$temporary_directory/compose-config.err"; then
    fail "configuration" "Docker Compose config failed" "${compose_command[@]}" "${compose_args[@]}" config --quiet
  fi
else
  compose_yaml="$temporary_directory/compose-config.yaml"
  if ! compose config >"$compose_yaml" 2>"$temporary_directory/compose-config.err"; then
    fail "configuration" "Podman Compose config failed" "${compose_command[@]}" "${compose_args[@]}" config --quiet
  fi
  if ! yq -o=json '.' <"$compose_yaml" >"$compose_config" 2>"$temporary_directory/compose-convert.err"; then
    fail "configuration" "could not convert the resolved Podman Compose configuration to JSON" yq --version
  fi
fi

compose_analysis="$temporary_directory/compose-analysis"
compose_analysis_error="$temporary_directory/compose-analysis.err"
if ! "$occ_cli" dev analyze-compose --profile docker <"$compose_config" >"$compose_analysis" 2>"$compose_analysis_error"; then
  analysis_error="$(cat "$compose_analysis_error" 2>/dev/null || true)"
  if [ -z "$analysis_error" ]; then
    analysis_error="could not inspect Compose services"
  fi
  fail "configuration" "$analysis_error" "${compose_command[@]}" "${compose_args[@]}" config --quiet
fi

api_url="$(sed -n '1p' "$compose_analysis")"
runtime_mode="$(sed -n '2p' "$compose_analysis")"
runtime_images="$(sed -n '3,$p' "$compose_analysis")"

if [ "$runtime_mode" = "default" ]; then
  export OCC_DOCKER_RUNTIME_IMAGE="$DEFAULT_RUNTIME_IMAGE"
  if ! engine image inspect "$DEFAULT_RUNTIME_IMAGE" >/dev/null 2>&1; then
    if ! engine build -f deploy/runtime/Dockerfile --tag "$DEFAULT_RUNTIME_IMAGE" deploy/runtime; then
      fail "runtime image" "could not build $DEFAULT_RUNTIME_IMAGE" "${engine_command[@]}" build -f deploy/runtime/Dockerfile --tag "$DEFAULT_RUNTIME_IMAGE" deploy/runtime
    fi
  fi
elif [ "$runtime_mode" = "custom" ]; then
  while IFS= read -r image; do
    if [ -z "$image" ]; then
      continue
    fi
    if ! engine image inspect "$image" >/dev/null 2>&1; then
      fail "runtime image" "selected image is not available locally: $image" "${engine_command[@]}" image inspect "$image"
    fi
  done <<EOF
$runtime_images
EOF
else
  fail "configuration" "unknown runtime image selection"
fi

if ! compose config --quiet >"$temporary_directory/compose-validated" 2>"$temporary_directory/compose-validate.err"; then
  fail "configuration" "$container_engine_label Compose config validation failed" "${compose_command[@]}" "${compose_args[@]}" config --quiet
fi

if [ "$container_engine" = "podman" ]; then
  # podman-compose builds once per service even when multiple services select
  # the same image, so build the shared application image once before startup.
  if ! compose build migrate; then
    fail "startup" "Podman Compose application image build failed" "${compose_command[@]}" "${compose_args[@]}" build migrate
  fi
  if ! compose up --no-build -d; then
    fail "startup" "Podman Compose up failed" "${compose_command[@]}" "${compose_args[@]}" "${compose_ps_diagnostic_args[@]}"
  fi
elif ! compose up --build -d; then
  fail "startup" "Docker Compose up failed" "${compose_command[@]}" "${compose_args[@]}" "${compose_ps_diagnostic_args[@]}"
fi

poll_services() {
  local output="$temporary_directory/ps-all.json"
  if ! compose "${compose_ps_status_args[@]}" >"$output" 2>"$temporary_directory/ps-all.err"; then
    return 1
  fi
  python3 - "$output" <<'PY'
import json
import sys

raw = open(sys.argv[1], encoding="utf-8").read().strip()
if not raw:
    raise SystemExit("missing compose service status")
try:
    decoded = json.loads(raw)
except json.JSONDecodeError:
    decoded = [json.loads(line) for line in raw.splitlines()]
payload = decoded if isinstance(decoded, list) else [decoded]
services = {}
for entry in payload:
    if not isinstance(entry, dict):
        raise SystemExit("Compose service status records must be JSON objects.")
    labels = entry.get("Labels")
    if isinstance(labels, str):
        labels = dict(
            item.split("=", 1)
            for item in labels.split(",")
            if "=" in item
        )
    elif not isinstance(labels, dict):
        labels = {}
    service = entry.get("Service")
    if service is None:
        service = labels.get("com.docker.compose.service") or labels.get("io.podman.compose.service")
    for field in ("State", "ExitCode"):
        if field not in entry:
            raise SystemExit(f"Compose service status is missing {field}.")
    if service is None:
        raise SystemExit("Compose service status is missing Service identity.")
    health = entry.get("Health")
    if health is None and "(healthy)" in str(entry.get("Status") or "").lower():
        health = "healthy"
    services[str(service)] = {**entry, "Service": str(service), "Health": health or ""}


def entry(name):
    value = services.get(name)
    if value is None:
        print(f"fail\tstartup\tcould not inspect {name}\tps\t{name}")
        raise SystemExit(0)
    return value


def state(value):
    return str(value.get("State") or "").lower()


def exit_code(value):
    code = value.get("ExitCode")
    return "" if code is None else str(code)


for name in ("migrate", "bootstrap"):
    current = entry(name)
    current_state = state(current)
    current_exit = exit_code(current)
    if current_state == "exited" and current_exit == "0":
        continue
    if current_state in ("exited", "dead"):
        print(f"fail\tstartup\t{name} exited with {current_exit or 'unknown'}\tps\t{name}")
        raise SystemExit(0)
    print(f"wait\tstartup\t{name} has not completed\tps\t{name}")
    raise SystemExit(0)

controller = entry("controller")
controller_state = state(controller)
if controller_state == "running" and str(controller.get("Health") or "").lower() == "healthy":
    pass
elif controller_state in ("exited", "dead"):
    print(f"fail\tstartup\tcontroller exited with {exit_code(controller) or 'unknown'}\tlogs\tcontroller")
    raise SystemExit(0)
else:
    print("wait\tstartup\tcontroller is not healthy\tlogs\tcontroller")
    raise SystemExit(0)

worker = entry("worker")
worker_state = state(worker)
if worker_state == "running":
    print("probe\treadiness\tworker is running\tlogs\tworker")
elif worker_state in ("exited", "dead"):
    print(f"fail\tstartup\tworker exited with {exit_code(worker) or 'unknown'}\tlogs\tworker")
else:
    print("wait\tstartup\tworker is not running\tlogs\tworker")
PY
}

deadline=$((SECONDS + STARTUP_TIMEOUT_SECONDS))
startup_ready=0
while [ "$SECONDS" -le "$deadline" ]; do
  if ! service_report="$(poll_services)"; then
    fail "startup" "could not inspect Compose services" "${compose_command[@]}" "${compose_args[@]}" "${compose_ps_diagnostic_args[@]}"
  fi
  IFS=$'\t' read -r service_status service_stage service_message diagnostic_kind diagnostic_service <<<"$service_report"
  if [ "$service_status" = "fail" ]; then
    if [ "$diagnostic_kind" = "logs" ]; then
      fail "$service_stage" "$service_message" "${compose_command[@]}" "${compose_args[@]}" logs "$diagnostic_service"
    fi
    if [ "$container_engine" = "docker" ]; then
      fail "$service_stage" "$service_message" "${compose_command[@]}" "${compose_args[@]}" "${compose_ps_diagnostic_args[@]}" "$diagnostic_service"
    fi
    fail "$service_stage" "$service_message" "${compose_command[@]}" "${compose_args[@]}" "${compose_ps_diagnostic_args[@]}"
  fi
  if [ "$service_status" = "probe" ]; then
    if compose exec -T worker node scripts/production-healthcheck.mjs worker ready >/dev/null 2>"$temporary_directory/worker-readiness.err"; then
      startup_ready=1
      break
    fi
    if ! service_report="$(poll_services)"; then
      fail "readiness" "worker readiness probe did not pass" "${compose_command[@]}" "${compose_args[@]}" logs worker
    fi
    IFS=$'\t' read -r service_status service_stage service_message diagnostic_kind diagnostic_service <<<"$service_report"
    if [ "$service_status" = "fail" ]; then
      fail "readiness" "worker readiness probe did not pass" "${compose_command[@]}" "${compose_args[@]}" logs worker
    fi
  fi
  sleep 2
done

if [ "$startup_ready" -ne 1 ]; then
  fail "readiness" "worker readiness probe did not pass within ${STARTUP_TIMEOUT_SECONDS}s" "${compose_command[@]}" "${compose_args[@]}" logs worker
fi

if [ -e "$key_output" ] || [ -L "$key_output" ]; then
  usage_error "key output" "destination already exists"
fi
key_copy_temp="$(mktemp "$(dirname "$key_output")/.dev-up-service-key.XXXXXXXXXX")"
chmod 600 "$key_copy_temp"
if [ "$container_engine" = "docker" ]; then
  if ! compose cp "$BOOTSTRAP_SERVICE_KEY_SOURCE" "$key_copy_temp"; then
    fail "key copy" "could not copy bootstrap service key from stopped bootstrap container" "${compose_command[@]}" "${compose_args[@]}" ps --all bootstrap
  fi
else
  podman_status="$temporary_directory/podman-services.json"
  if ! compose "${compose_ps_status_args[@]}" >"$podman_status" 2>"$temporary_directory/podman-services.err"; then
    fail "key copy" "could not inspect the Podman bootstrap container" "${compose_command[@]}" "${compose_args[@]}" "${compose_ps_diagnostic_args[@]}"
  fi
  if ! bootstrap_container_id="$(python3 - "$podman_status" <<'PY'
import json
import pathlib
import sys

raw = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").strip()
try:
    decoded = json.loads(raw)
except json.JSONDecodeError:
    decoded = [json.loads(line) for line in raw.splitlines()]
payload = decoded if isinstance(decoded, list) else [decoded]
matches = []
for entry in payload:
    if not isinstance(entry, dict):
        continue
    labels = entry.get("Labels")
    if isinstance(labels, str):
        labels = dict(
            item.split("=", 1)
            for item in labels.split(",")
            if "=" in item
        )
    elif not isinstance(labels, dict):
        labels = {}
    service = entry.get("Service")
    if service is None:
        service = labels.get("com.docker.compose.service") or labels.get("io.podman.compose.service")
    container_id = entry.get("ID") or entry.get("Id")
    if service == "bootstrap" and isinstance(container_id, str) and container_id:
        matches.append(container_id)
if len(matches) != 1:
    raise SystemExit(f"expected one Podman bootstrap container, found {len(matches)}")
print(matches[0])
PY
)"; then
    fail "key copy" "could not identify exactly one Podman bootstrap container" "${compose_command[@]}" "${compose_args[@]}" "${compose_ps_diagnostic_args[@]}"
  fi
  if ! engine cp "$bootstrap_container_id:$BOOTSTRAP_SERVICE_KEY_PATH" "$key_copy_temp"; then
    fail "key copy" "could not copy bootstrap service key from stopped bootstrap container" "${engine_command[@]}" cp "$bootstrap_container_id:$BOOTSTRAP_SERVICE_KEY_PATH" "$key_copy_temp"
  fi
fi
chmod 600 "$key_copy_temp"
if ! python3 - "$key_copy_temp" "$key_output" <<'PY'
import os
import pathlib
import shutil
import sys

source = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
with source.open("rb") as reader:
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as writer:
        shutil.copyfileobj(reader, writer)
PY
then
  fail "key output" "destination already exists; copied key remains at $key_copy_temp"
fi
rm -f -- "$key_copy_temp"

if ! key_installation_id="$(
  python3 - "$key_output" 2>"$temporary_directory/key-validation.err" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
installation_id = payload.get("meta", {}).get("installationId")
key = payload.get("data", {}).get("key")
if not isinstance(installation_id, str) or not installation_id:
    raise SystemExit("bootstrap service key file does not include meta.installationId")
if not isinstance(key, str) or not key.strip():
    raise SystemExit("bootstrap service key file does not include data.key")
print(installation_id)
PY
)"; then
  key_error="$(cat "$temporary_directory/key-validation.err" 2>/dev/null || true)"
  fail "key copy" "${key_error:-copied bootstrap service key is invalid}" "${compose_command[@]}" "${compose_args[@]}" "${compose_ps_diagnostic_args[@]}"
fi

installation_response="$temporary_directory/installation-response.json"
if ! OCC_URL="$api_url" OCC_SERVICE_KEY_FILE="$key_output" "$occ_cli" installation get --output json >"$installation_response"; then
  fail "authorization" "occ could not read the Installation" "$occ_cli" installation get --output json
fi

if ! installation_id="$(
  python3 - "$installation_response" "$key_installation_id" 2>"$temporary_directory/installation-match.err" <<'PY'
import json
import pathlib
import sys

payload = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
expected = sys.argv[2]
observed = payload.get("id")
if observed != expected:
    raise SystemExit(f"Installation ID mismatch: key belongs to {expected}, API returned {observed}")
print(observed)
PY
)"; then
  match_error="$(cat "$temporary_directory/installation-match.err" 2>/dev/null || true)"
  fail "authorization" "${match_error:-Installation ID mismatch}" "$occ_cli" installation get --output json
fi

cleanup_command="$(quote_command env "OCC_DEVELOPMENT_COMPUTE_DRIVER=docker" "OCC_DEVELOPMENT_CONTAINER_ENGINE=$container_engine" "$occ_cli" dev down -- "${compose_args[@]}")"
next_check_command="$(quote_command "OCC_URL=$api_url" "OCC_SERVICE_KEY_FILE=$key_output" "$occ_cli" installation get)"

cat <<EOF
OpenClaw Enterprise development stack is ready.
Container engine: $container_engine_label
API URL: $api_url
Installation ID: $installation_id
Service key file: $key_output

Check API access again:
  $next_check_command

Cleanup:
  $cleanup_command
EOF
