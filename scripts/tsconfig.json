{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "ES2024.Promise", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "noCheck": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "../.build/scripts/tsconfig.tsbuildinfo",
    "paths": {
      "@kubernetes/client-node": [
        "../apps/controller/node_modules/@kubernetes/client-node/dist/index.d.ts"
      ],
      "@openclaw/gateway-client": [
        "../apps/controller/node_modules/@openclaw/gateway-client/dist/index.d.mts"
      ],
      "/app/apps/controller/src/drivers/repo/access/*": [
        "../apps/controller/src/drivers/repo/access/*"
      ],
      "/app/apps/controller/src/drivers/repo/github/access/*": [
        "../apps/controller/src/drivers/repo/github/access/*"
      ],
      "@openclaw-enterprise/contracts": ["../packages/contracts/src/index.ts"],
      "/app/packages/occ/src/index.ts": ["../packages/occ/src/index.ts"],
      "/app/packages/utils/src/index.ts": ["../packages/utils/src/index.ts"],
      "/app/apps/controller/src/backends/openshell.ts": [
        "../apps/controller/src/backends/openshell.ts"
      ],
      "/app/apps/controller/src/drivers/sandbox/openshell-gateway-errors.ts": [
        "../apps/controller/src/drivers/sandbox/openshell-gateway-errors.ts"
      ],
      "/console/agents/plugin-fields.mjs": [
        "../apps/controller/src/console/agents/plugin-fields.mts"
      ],
      "/console/console.mjs": ["../apps/controller/src/console/console.mts"],
      "/console/agents/plugin-fields.production.mjs": [
        "../apps/controller/src/console/agents/plugin-fields.mts"
      ],
      "/storybook-fixtures/scenarios.mjs": ["./console-storybook/public/scenarios.mts"],
      "/console/default-codex-preset.mjs": ["./console-storybook/default-codex-preset.d.mts"],
      "/console/standard-codex-preset.mjs": ["./console-storybook/standard-codex-preset.d.mts"],
      "/console/standard-openclaw-preset.mjs": [
        "./console-storybook/standard-openclaw-preset.d.mts"
      ],
      "/console/swe-preset.mjs": ["./console-storybook/swe-preset.d.mts"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "../eslint.config.ts",
    "*.ts",
    "ci/**/*.ts",
    "lib/**/*.ts",
    "../deploy/helm/src/*.ts",
    "../deploy/runtime/native-tools/fetch.ts",
    "../deploy/runtime/node/verify.mts",
    "../deploy/runtime/with-pinned-matrix-sdk-crypto.mts",
    "../docs/snippets/openshell-quickstart/**/*.mts",
    "docs-site/compute-matrix.ts",
    "docs-site/serve.ts",
    "docs-site/preview-build.ts",
    "module-boundaries/*.ts",
    "console-storybook/prepare-assets.ts",
    "console-storybook/plugin-fields.storybook-wrapper.mts",
    "console-storybook/public/**/*.mts"
  ],
  "references": [
    {
      "path": "../packages/utils"
    },
    {
      "path": "../packages/contracts"
    },
    {
      "path": "../packages/occ"
    },
    {
      "path": "../packages/iam"
    },
    {
      "path": "../packages/audit"
    },
    {
      "path": "../apps/controller"
    }
  ]
}
