{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "noCheck": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "../.build/scripts/tsconfig.tsbuildinfo",
    "paths": {
      "@openclaw-enterprise/contracts": ["../packages/contracts/src/index.ts"],
      "/console/agents/plugin-fields.mjs": [
        "../apps/controller/src/console/agents/plugin-fields.mts"
      ],
      "/console/console.mjs": ["../apps/controller/src/console/console.mts"],
      "/console/agents/plugin-fields.production.mjs": [
        "../apps/controller/src/console/agents/plugin-fields.mts"
      ],
      "/storybook-fixtures/scenarios.mjs": ["./console-storybook/public/scenarios.mjs"],
      "/console/default-codex-preset.mjs": ["./console-storybook/default-codex-preset.d.mts"],
      "/console/standard-codex-preset.mjs": ["./console-storybook/standard-codex-preset.d.mts"],
      "/console/standard-openclaw-preset.mjs": [
        "./console-storybook/standard-openclaw-preset.d.mts"
      ],
      "/console/swe-preset.mjs": ["./console-storybook/swe-preset.d.mts"]
    },
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "ci/**/*.ts",
    "lib/**/*.ts",
    "docs-site/compute-matrix.ts",
    "module-boundaries/*.ts",
    "console-storybook/prepare-assets.ts",
    "console-storybook/plugin-fields.storybook-wrapper.mts",
    "console-storybook/public/**/*.mts"
  ],
  "references": [
    {
      "path": "../packages/utils"
    },
    {
      "path": "../packages/contracts"
    },
    {
      "path": "../packages/occ"
    },
    {
      "path": "../packages/iam"
    },
    {
      "path": "../packages/audit"
    },
    {
      "path": "../apps/controller"
    }
  ]
}
