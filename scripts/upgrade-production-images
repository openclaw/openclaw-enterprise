#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: scripts/upgrade-production-images \
  --kubeconfig FILE --context NAME --namespace NAME --release NAME \
  --values FILE --installation FILE \
  [--candidate-values FILE] [--candidate-installation FILE] \
  [--controller-image IMAGE@sha256:DIGEST] \
  [--controller-compatibility-results FILE] \
  [--broker-image IMAGE@sha256:DIGEST] \
  [--runtime-image IMAGE@sha256:DIGEST] \
  --source-revision FULL_GIT_SHA --evidence-dir DIRECTORY \
  [--occ PATH] [--timeout-seconds SECONDS] [--doctor-heap-mib MIB] [--resume] \
  [--verify-agent AGENT_ID --verify-agent-namespace NAMESPACE_ID] \
  [--migration-history-checked] [--recover-helm --recovery-reviewed] \
  [--collector-config-reviewed] [--preflight-only]

Select at least one image. Candidate files contain reviewed settings changes;
image fields are selected only by the image flags. A controller-only upgrade
does not deploy Agent revisions. A runtime upgrade restarts OCC on its current image,
then redeploys every Agent that was running when the command began. Resume with
the same arguments and evidence directory after inspecting any unknown outcomes.
Completed upgrades cannot be resumed; retain their completed evidence marker.
Keep the runtime upgrade's sibling <evidence-directory>.dispatch-state journal
with the operator. Preserve it separately from backups of the evidence directory.
Use --preflight-only to check the candidate before the maintenance window. It
creates temporary Jobs and requires confirmed cleanup before quiescence;
its evidence cannot be resumed. To deploy, omit the flag and use a fresh evidence directory.
After interruption, inspect final preflight-*-identity.json files alongside this run's parameters.json.
OCC_URL, OCC_SERVICE_KEY_FILE, and OCC_CA_BUNDLE configure the OCC CLI connection.
With the bundled Collector enabled, its config Secret must carry this checkout's
deploy/logging collector.yaml and kubernetes.yaml; pass --collector-config-reviewed
only to keep a reviewed custom configuration.
For a controller/broker upgrade, --verify-agent with --verify-agent-namespace
requires the same active revision and Ready workload Pods before completion.
It needs exact Agent read/operate and active AgentRevision read permissions.
--timeout-seconds bounds each wait (default 900, at most 86400).
--doctor-heap-mib sets OpenClaw Doctor's heap cap (default 384); raise it only
after Doctor ran out of heap. It can change on --resume.
EOF
}

warn() {
  printf 'upgrade-production-images: %s\n' "$1" >&2
}

die() {
  warn "$1"
  exit "${2:-1}"
}

# Record only fixed operation/component labels and the native exit status.
# This is a client failure observation, not evidence of whether a write committed.
# Append so a later resume cannot erase an earlier unknown outcome.
native_command_failed() {
  local status=$1 operation=$2 component=$3
  # The operation has returned; failed pipe or file writes must not replace its status.
  trap '' PIPE XFSZ
  printf '%s\t%s\t%s\n' "$operation" "$component" "$status" \
    >>"$evidence_dir/native-command-failures.tsv" ||
    warn "could not append native-command-failures.tsv in the evidence directory." || true
  warn "$operation for $component exited $status; inspect native-command-failures.tsv and reconcile live state before resuming." || true
  exit "$status"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command $1 is unavailable."
}

private_file_mode() {
  local mode
  if mode=$(stat -f '%Lp' "$1" 2>/dev/null); then
    printf '%s\n' "$mode"
  else
    stat -c '%a' "$1"
  fi
}

require_regular_file() {
  local path=$1
  [[ -f "$path" && ! -L "$path" && -r "$path" ]] ||
    die "$path must be a readable regular file, not a symbolic link."
}

require_private_file() {
  local path=$1
  local mode
  require_regular_file "$path"
  mode=$(private_file_mode "$path")
  (((8#$mode & 077) == 0)) || die "$path must not grant group or other permissions."
}

# Input checks set LC_ALL=C locally: under a locale such as en_US.UTF-8, bash
# regex ranges like [a-f0-9] also match accented letters and non-ASCII digits.
# Kubernetes refuses to pull a reference its parser refuses (InvalidImageName), such as one
# with an uppercase repository path; only the registry host and the tag may use uppercase.
# Profile preflight, the chart and Compute apply the same rule
# (packages/occ/src/image-reference.ts), which a small Node helper runs here.
require_immutable_image() {
  local flag=$1
  local image=$2
  local problem
  local LC_ALL=C
  [[ "$image" =~ @sha256:[a-f0-9]{64}$ ]] ||
    die "$flag must be an approved immutable SHA-256 image reference."
  local helper=scripts/lib/image-reference-problem.mjs
  [[ -f "$helper" ]] || die "could not find $helper; run this command from the repository root."
  problem=$(node "$helper" "$image") ||
    die "could not run the image reference check for $flag (it needs Node.js 24 or later)."
  case "$problem" in
    "") ;;
    uppercase-repository)
      die "$flag repository path must be lowercase; Kubernetes refuses to pull an uppercase one."
      ;;
    *) die "$flag must be an approved immutable SHA-256 image reference." ;;
  esac
}

positive_integer() {
  local LC_ALL=C
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

full_commit_sha() {
  local LC_ALL=C
  [[ "$1" =~ ^[a-f0-9]{40}$ ]]
}

json_file_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'
}

# json_fields JSON NAME=FIELD... sets each variable NAME to what
# NAME=$(jq -r .FIELD <<<"$JSON") would, with one jq start for all of them. jq
# prints each value as one compact JSON line: a string without escapes is that
# text between its quotes. Any other value, or output that is not one line per
# field (JSON holding several values), is read again with jq -r.
json_fields() {
  local json=$1 values filter='' assignment value index=0
  local plain='^"[^"\\]*"$'
  local -a lines=()
  shift
  for assignment in "$@"; do
    filter+="${filter:+, }.${assignment#*=}"
  done
  values=$(jq -c "$filter" <<<"$json") || return
  IFS=$'\n' read -r -d '' -a lines <<<"$values" || true
  ((${#lines[@]} == $#)) || lines=()
  for assignment in "$@"; do
    value=${lines[index]-}
    if [[ "$value" =~ $plain ]]; then
      value=${value:1:${#value}-2}
    else
      value=$(jq -r ".${assignment#*=}" <<<"$json") || return
    fi
    printf -v "${assignment%%=*}" '%s' "$value"
    ((++index))
  done
}

# Prints OCC's refusal from a failed `occ agent deploy`'s stderr FILE and
# succeeds only when OCC answered with a 4xx error code (occ prints
# "OCC operation failed (HTTP 4xx): CODE: message") or refused the service key.
# OCC admits a deploy in one transaction, so such a refusal saved no revision.
# Anything else, such as a lost connection, a timeout, HTTP 408 or a 5xx, leaves
# the outcome unknown. occ prints its error once, as its last output, on a line
# that starts with "Error: ". Only that line is read: when stderr has any other
# such line, for example inside a notice or OCC's message, the outcome is unknown.
deploy_refusal() {
  python3 - "$1" <<'PYTHON'
import re, sys
try:
    lines = open(sys.argv[1], encoding="utf-8", errors="replace").read().splitlines()
except OSError:
    sys.exit(1)
errors = [index for index, line in enumerate(lines) if line.startswith("Error: ")]
if len(errors) != 1:
    sys.exit(1)
index = errors[0]
pattern = re.compile(r"Error: (OCC operation failed \(HTTP 4(?!08)[0-9]{2}\): [A-Z][A-Z0-9_]*: |OCC rejected the service key )")
if not pattern.match(lines[index]):
    sys.exit(1)
# occ indents the rejected fields' JSON details under its message.
details = [detail.strip() for detail in lines[index + 1 : index + 4] if detail.startswith("  ")]
refusal = " ".join([lines[index].removeprefix("Error: ")] + details)
print(re.sub(r"[\x00-\x1f\x7f-\x9f\u2028\u2029]", "?", refusal)[:600])
PYTHON
}

# YAML files this run already converted, keyed by their exact bytes: yq gives the
# same bytes the same JSON, so a file read again unchanged starts no new yq, and
# no new jq for the comparison form. Only successful results are kept, and only
# when the file still holds the same bytes after yq read it.
yaml_sources=()
yaml_values=()
yaml_objects=()

# yaml_json FILE sets yaml_text to `yq -p=yaml -o=json '.' FILE`'s output and
# returns yq's status. yaml_index names FILE's entry above, or is -1 when the
# result is not reused (a failure, a NUL byte or a file that changed meanwhile).
yaml_json() {
  local file=$1 source='' again='' status=0 index
  yaml_index=-1
  # read -d '' succeeds only at a NUL byte, which a Bash string cannot hold. An
  # empty read (an empty file, or one that went away) is never reused either.
  if [[ -f "$file" && -r "$file" ]] && ! IFS= read -r -d '' source 2>/dev/null <"$file" &&
    [[ -n "$source" ]]; then
    for ((index = 0; index < ${#yaml_sources[@]}; index++)); do
      if [[ "${yaml_sources[index]}" == "$source" ]]; then
        yaml_index=$index
        yaml_text=${yaml_values[index]}
        return 0
      fi
    done
  else
    source=
    again=unreadable
  fi
  yaml_text=$(yq -p=yaml -o=json '.' "$file") || status=$?
  if ((status == 0)) && [[ -z "$again" ]] && ! IFS= read -r -d '' again 2>/dev/null <"$file" &&
    [[ "$again" == "$source" ]]; then
    yaml_index=${#yaml_sources[@]}
    yaml_sources+=("$source")
    yaml_values+=("$yaml_text")
    yaml_objects+=("")
  fi
  return "$status"
}

project_yaml() {
  local path=$1
  local filter=$2
  local output=$3
  local status=0
  yaml_json "$path" || status=$?
  # As in a yq | jq pipeline under pipefail: jq reads whatever yq printed, and
  # the status is jq's failure, else yq's.
  jq -S "$filter" <<<"$yaml_text" >"$output" || return
  return "$status"
}

# yaml_object FILE OUTPUT writes FILE's YAML object documents to OUTPUT as sorted
# JSON and sets yaml_object_text to that JSON; it fails without one or if
# any document is not an object.
yaml_object() {
  local file=$1 output=$2 status=0
  yaml_json "$file" || status=$?
  if ((status == 0 && yaml_index >= 0)) && [[ -n "${yaml_objects[yaml_index]}" ]]; then
    yaml_object_text=${yaml_objects[yaml_index]}
  else
    yaml_object_text=$(jq -eS -n 'inputs | if type == "object" then . else error("expected a YAML object") end' <<<"$yaml_text") || return 1
    ((status == 0)) || return 1
  fi
  # Compare the checked conversion, not a best-effort read of its evidence copy.
  printf '%s\n' "$yaml_object_text" >"$output" || return 1
  if ((yaml_index >= 0)) && [[ -n "$yaml_object_text" ]]; then
    yaml_objects[yaml_index]=$yaml_object_text
  fi
}

matches_yaml() {
  local actual=$1
  local expected=$2
  local actual_text
  # Callers include negated conditions and recovery alternatives: unusable input
  # must terminate here, never enter a branch reserved for valid inequality.
  local unusable='Cannot compare upgrade YAML: both inputs must be readable and contain only YAML mappings (no empty documents). Check that the evidence directory is writable.'
  yaml_object "$actual" "$evidence_dir/compare-actual.json" 2>/dev/null || die "$unusable"
  actual_text=$yaml_object_text
  yaml_object "$expected" "$evidence_dir/compare-expected.json" 2>/dev/null || die "$unusable"
  [[ -s "$evidence_dir/compare-actual.json" && -s "$evidence_dir/compare-expected.json" ]] || die "$unusable"
  [[ "$actual_text" == "$yaml_object_text" ]]
}

require_mutable_installation_secret() {
  jq -e '.immutable != true' "$1" >/dev/null ||
    die "Installation Secret $installation_secret is immutable and the candidate requires different data. Choose a candidate that preserves the live Installation configuration or defer this upgrade."
}

check_installation_update_access() {
  local request decision
  request=$(jq -n --arg namespace "$namespace" --arg name "$installation_secret" '{
    apiVersion: "authorization.k8s.io/v1", kind: "SelfSubjectAccessReview",
    spec: {resourceAttributes: {namespace: $namespace, verb: "update", group: "", resource: "secrets", name: $name}}
  }')
  # A failed or incomplete self-review says nothing about the real update.
  if decision=$(printf '%s\n' "$request" |
    "${kube[@]}" --request-timeout=15s create --raw /apis/authorization.k8s.io/v1/selfsubjectaccessreviews --filename - 2>/dev/null |
    jq -ers --argjson request "$request" '
      select(length == 1) | .[0] |
      select(.apiVersion == $request.apiVersion and .kind == $request.kind) |
      select((.spec | .resourceAttributes |= ({group: ""} + .)) == $request.spec) |
      .status | select(type == "object" and (.allowed | type == "boolean") and
        ((has("denied") | not) or (.denied | type == "boolean")) and
        ((has("reason") | not) or (.reason | type == "string")) and
        ((has("evaluationError") | not) or .evaluationError == "") and
        ((.allowed and .denied) | not)) | .allowed | tostring' 2>/dev/null); then
    [[ "$decision" == true ]] ||
      die "Kubernetes denied update on Installation Secret $namespace/$installation_secret. Obtain update access before upgrading."
  else
    warn "Could not verify update access to the Installation Secret. The upgrade requires update permission on that Secret."
  fi
}

# Versioned Secrets are operator-staged. Neither reference may be replaced or
# edited while the helper owns the upgrade, including after Helm acknowledges it.
verify_pinned_installation_secret() {
  jq -e --slurpfile expected "$2" '
    .metadata.uid == $expected[0].metadata.uid and
    .metadata.name == $expected[0].metadata.name and
    .metadata.namespace == $expected[0].metadata.namespace and
    .metadata.deletionTimestamp == null and .immutable == true and
    .metadata.annotations["openclaw.dev/installation-id"] ==
      $expected[0].metadata.annotations["openclaw.dev/installation-id"] and
    .type == $expected[0].type and .data == $expected[0].data
  ' "$1" >/dev/null || die "a versioned Installation Secret identity or data changed."
}

verify_installation_switch() {
  local previous_name
  previous_name=$(jq -er '.metadata.name' "$evidence_dir/before-live-installation-secret.json")
  "${kube[@]}" --namespace "$namespace" get secret "$previous_name" --output json \
    >"$evidence_dir/current-original-installation-secret.json"
  verify_pinned_installation_secret "$evidence_dir/current-original-installation-secret.json" \
    "$evidence_dir/before-live-installation-secret.json"
  "${kube[@]}" --namespace "$namespace" get secret "$installation_secret" --output json \
    >"$evidence_dir/current-live-installation-secret.json"
  verify_pinned_installation_secret "$evidence_dir/current-live-installation-secret.json" \
    "$evidence_dir/before-candidate-installation-secret.json"
}

# Prints the quoted name of the resource that the OCC read ARGS returns, or
# nothing when the read fails. tojson escapes C0 controls and DEL; C1 controls
# are replaced too, so a name cannot forge lines or terminal sequences.
occ_name() {
  "${occ_json[@]}" "$@" </dev/null 2>/dev/null |
    jq -r 'if (.name | type) == "string" then .name | tojson | gsub("[\u0080-\u009f]"; "?") else empty end' 2>/dev/null
}

# Lists the first ten inventory Agents that FILTER selects, with their names,
# so an inventory refusal tells the operator which Agents to act on. FILTER
# binds $namespace. Names are read-only lookups with the same OCC credentials;
# a failed lookup keeps the ID and says the name is unavailable.
list_inventory_agents() {
  local inventory=$1
  local filter=$2
  local limit=10
  local total namespace_id agent_id agent_name
  local listed_namespace='' namespace_name=''
  total=$(jq "[$filter] | length" "$inventory")
  while IFS=$'\t' read -r namespace_id agent_id; do
    if [[ "$namespace_id" != "$listed_namespace" ]]; then
      listed_namespace=$namespace_id
      namespace_name=$(occ_name namespace get "$namespace_id") || namespace_name=
    fi
    agent_name=$(occ_name --namespace "$namespace_id" agent get "$agent_id") || agent_name=
    printf '  - Agent %s %s in Namespace %s %s\n' \
      "$agent_id" "${agent_name:-(name unavailable)}" \
      "$namespace_id" "${namespace_name:-(name unavailable)}"
  done < <(jq -r --argjson limit "$limit" "limit(\$limit; $filter | [\$namespace.id, .id]) | @tsv" "$inventory")
  if ((total > limit)); then
    printf '  - and %d more; see %s\n' "$((total - limit))" "$inventory"
  fi
}

install_atomically() {
  local source=$1
  local destination=$2
  local temporary
  temporary=$(mktemp "${destination}.upgrade.XXXXXXXX")
  install -m 600 "$source" "$temporary"
  mv -f "$temporary" "$destination"
}

kubeconfig=
context=
namespace=
release=
values=
installation=
requested_values=
requested_installation=
controller_image=
controller_compatibility_results=
broker_image=
runtime_image=
source_revision=
evidence_dir=
occ=occ
verify_agent=
verify_agent_namespace=
timeout_seconds=900
doctor_heap_mib=384
resume=0
preflight_only=0
migration_history_checked=0
recover_helm=0
recovery_reviewed=0
collector_config_reviewed=0

while (($#)); do
  case "$1" in
    --kubeconfig | --context | --namespace | --release | --values | --installation | --candidate-values | --candidate-installation | --controller-image | --controller-compatibility-results | --broker-image | --runtime-image | --source-revision | --evidence-dir | --occ | --timeout-seconds | --doctor-heap-mib | --verify-agent | --verify-agent-namespace)
      (($# >= 2)) || die "$1 requires a value."
      if [[ "$1" == --verify-agent || "$1" == --verify-agent-namespace ]]; then
        [[ -n "$2" ]] || die "$1 requires a nonempty value."
      fi
      case "$1" in
        --kubeconfig) kubeconfig=$2 ;;
        --context) context=$2 ;;
        --namespace) namespace=$2 ;;
        --release) release=$2 ;;
        --values) values=$2 ;;
        --installation) installation=$2 ;;
        --candidate-values) requested_values=$2 ;;
        --candidate-installation) requested_installation=$2 ;;
        --controller-image) controller_image=$2 ;;
        --controller-compatibility-results)
          [[ -n "$2" ]] || die "$1 requires a nonempty value."
          controller_compatibility_results=$2
          ;;
        --broker-image) broker_image=$2 ;;
        --runtime-image) runtime_image=$2 ;;
        --source-revision) source_revision=$2 ;;
        --evidence-dir) evidence_dir=$2 ;;
        --occ) occ=$2 ;;
        --verify-agent) verify_agent=$2 ;;
        --verify-agent-namespace) verify_agent_namespace=$2 ;;
        --timeout-seconds) timeout_seconds=$2 ;;
        --doctor-heap-mib) doctor_heap_mib=$2 ;;
      esac
      shift 2
      ;;
    --preflight-only)
      preflight_only=1
      shift
      ;;
    --resume)
      resume=1
      shift
      ;;
    --migration-history-checked)
      migration_history_checked=1
      shift
      ;;
    --recover-helm)
      recover_helm=1
      shift
      ;;
    --recovery-reviewed)
      recovery_reviewed=1
      shift
      ;;
    --collector-config-reviewed)
      collector_config_reviewed=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      die "unsupported argument $1."
      ;;
  esac
done

# Helm reads these independently of --kubeconfig/--kube-context. Keep its
# endpoint and TLS settings bound to the same selected file as kubectl.
for variable in HELM_KUBEAPISERVER HELM_KUBECAFILE HELM_KUBETLS_SERVER_NAME HELM_KUBEINSECURE_SKIP_TLS_VERIFY; do
  [[ -z "${!variable:-}" ]] ||
    die "unset $variable; configure the endpoint and TLS settings in the selected kubeconfig before starting or resuming an upgrade."
done

[[ -z "$verify_agent" && -z "$verify_agent_namespace" || -n "$verify_agent" && -n "$verify_agent_namespace" ]] ||
  die "--verify-agent and --verify-agent-namespace must be supplied together."
[[ -z "$verify_agent" || -z "$runtime_image" ]] ||
  die "--verify-agent cannot be combined with --runtime-image, which selects new Agent revisions."

((resume == 0 || preflight_only == 0)) || die "--resume cannot be combined with --preflight-only."
((recover_helm == 0 || (resume && migration_history_checked && recovery_reviewed))) ||
  die "--recover-helm requires --resume --migration-history-checked --recovery-reviewed."
((recovery_reviewed == 0 || recover_helm)) || die "--recovery-reviewed requires --recover-helm."

for input in kubeconfig context namespace release values installation source_revision evidence_dir; do
  [[ -n "${!input}" ]] || die "--${input//_/-} is required."
done
[[ -n "$controller_image" || -n "$broker_image" || -n "$runtime_image" ]] ||
  die "select a controller, broker, or runtime image."
[[ -z "$controller_compatibility_results" || -n "$controller_image" ]] ||
  die "--controller-compatibility-results requires --controller-image."
positive_integer "$timeout_seconds" || die "--timeout-seconds must be positive."
# Each phase's wait gets the whole timeout; a day is far beyond any of them, so a
# larger value is likely a unit mistake. Compare lengths before arithmetic, which
# would wrap a huge value and expire every wait at once.
if ((${#timeout_seconds} > 5 || timeout_seconds > 86400)); then
  die "--timeout-seconds must be at most 86400 (24 hours)."
fi
full_commit_sha "$source_revision" ||
  die "--source-revision must be a full lowercase Git commit SHA."
checkout_git=(git --no-optional-locks --no-replace-objects --git-dir=.git)
read_checkout() (
  unset GIT_DIR GIT_COMMON_DIR
  export GIT_NO_LAZY_FETCH=1 GIT_ALLOW_PROTOCOL=
  "$@" 2>/dev/null
)
checkout_revision=$(
  # Matching HEAD is insufficient when Git assigns this metadata another worktree.
  # Compare directory identity so symlinked paths still name the physical root.
  checkout_root=$(read_checkout "${checkout_git[@]}" rev-parse --show-toplevel) || exit 1
  [[ "$checkout_root" -ef . ]] || exit 1
  read_checkout "${checkout_git[@]}" rev-parse --verify 'HEAD^{commit}'
) ||
  die "could not verify the checkout commit; run this command from the release repository root with Git available."
[[ "$checkout_revision" == "$source_revision" ]] ||
  die "checkout commit does not match --source-revision; use the reviewed release checkout."
require_command python3
chart=deploy/helm/openclaw-enterprise
# Helm reads this physical directory. Check it before reading protected inputs.
# The operator must keep this checkout unchanged while the helper uses it.
chart_sha256=$(read_checkout python3 - "$chart" "$checkout_revision" "$evidence_dir" "$values" "$installation" "${checkout_git[@]}" <<'PYTHON'
import hashlib, os, stat, subprocess, sys
from pathlib import Path

chart_path, revision, evidence, values, installation, *git = sys.argv[1:]
chart = os.fsencode(chart_path)

def git_output(*args):
    return subprocess.check_output([*git, *args])

# NUL-delimited paths preserve literal names, including hidden files and case.
expected = {}
tree = git_output("ls-tree", "-rtz", f"{revision}:{chart_path}")
for record in tree.split(b"\0")[:-1]:
    metadata, path = record.split(b"\t", 1)
    mode, kind, oid = metadata.split()
    if mode == b"040000" and kind == b"tree":
        expected[path] = None
    elif mode in (b"100644", b"100755") and kind == b"blob":
        expected[path] = oid
    else:
        sys.exit(1)
if expected.get(b"Chart.yaml") is None:
    sys.exit(1)

directory = b"."
for component in chart.split(b"/"):
    directory = os.path.join(directory, component)
    directory_info = os.lstat(directory)
    if not stat.S_ISDIR(directory_info.st_mode):
        sys.exit(1)
chart_directories = {(directory_info.st_dev, directory_info.st_ino)}

digest = hashlib.sha256()

def verify_directory(directory, prefix):
    directories = []
    with os.scandir(directory) as entries:
        for entry in sorted(entries, key=lambda entry: entry.name):
            relative = os.path.join(prefix, entry.name)
            oid = expected.pop(relative)
            info = entry.stat(follow_symlinks=False)
            if oid is None and stat.S_ISDIR(info.st_mode):
                chart_directories.add((info.st_dev, info.st_ino))
                directories.append((entry.path, relative))
            elif oid is not None and stat.S_ISREG(info.st_mode):
                contents = git_output("cat-file", "blob", oid)
                with open(entry.path, "rb") as source:
                    if source.read(len(contents) + 1) != contents:
                        sys.exit(1)
                digest.update(entry.path + b"\0" + contents + b"\0")
            else:
                sys.exit(1)
    # Keep the evidence digest's order: sorted files first, then sorted directories.
    for path, relative in directories:
        verify_directory(path, relative)

verify_directory(chart, b"")
if expected:
    sys.exit(1)

def existing_output(path):
    # A new evidence directory has no identity yet. Resolve its nearest
    # existing ancestor, and do not treat other lookup errors as missing.
    while True:
        try:
            os.stat(path)
        except FileNotFoundError:
            parent = os.path.dirname(path) or "."
            if parent == path:
                raise
            path = parent
        else:
            return Path(path).resolve(strict=True)

# A mount can expose a verified directory under a different physical path.
chart_root = os.path.abspath(chart_path)
for path in (evidence, values, installation):
    try:
        if os.path.commonpath((chart_root, os.path.realpath(path))) == chart_root:
            sys.exit(2)
        physical = existing_output(path)
        for ancestor in (physical, *physical.parents):
            info = ancestor.stat()
            if (info.st_dev, info.st_ino) in chart_directories:
                sys.exit(2)
    except OSError:
        sys.exit(3)
print(digest.hexdigest())
PYTHON
) || {
  case $? in
    2) die "keep the evidence directory and baseline files outside the stock Helm chart." ;;
    3) die "could not verify the evidence directory and baseline file paths." ;;
  esac
  die "the stock Helm chart must match the selected commit. Use a complete release checkout with the original chart files."
}
positive_integer "$doctor_heap_mib" || die "--doctor-heap-mib must be positive."
# Leave room for both margins in signed 64-bit shell arithmetic; compare decimal
# strings before evaluating the untrusted value as an arithmetic expression.
if ((${#doctor_heap_mib} > 19)) || \
  { ((${#doctor_heap_mib} == 19)) && [[ "$doctor_heap_mib" > 9223372036854775167 ]]; }; then
  die "--doctor-heap-mib must be at most 9223372036854775167 (signed 64-bit threshold limit)."
fi
[[ -z "$controller_image" ]] || require_immutable_image --controller-image "$controller_image"
[[ -z "$broker_image" ]] || require_immutable_image --broker-image "$broker_image"
[[ -z "$runtime_image" ]] || require_immutable_image --runtime-image "$runtime_image"
if ((resume)); then
  [[ -d "$evidence_dir" && ! -L "$evidence_dir" ]] || die "--resume requires the original evidence directory."
  mode=$(private_file_mode "$evidence_dir")
  (((8#$mode & 077) == 0)) || die "the evidence directory must not grant group or other permissions."
else
  [[ ! -e "$evidence_dir" ]] || die "--evidence-dir must not already exist."
  ((migration_history_checked == 0)) || die "--migration-history-checked is only valid with --resume."
fi

# An invalid existing intent is never equivalent to an unsubmitted attempt.
if [[ -e "$evidence_dir/helm-started" || -L "$evidence_dir/helm-started" ]]; then
  require_private_file "$evidence_dir/helm-started"
fi

require_private_file "$kubeconfig"
require_private_file "$values"
require_private_file "$installation"
[[ -z "$requested_values" ]] || require_private_file "$requested_values"
[[ -z "$requested_installation" ]] || require_private_file "$requested_installation"
# The protected baselines are replaced during execution; candidate inputs must
# remain independent, including when different paths are hard links.
python3 - "$values" "$installation" "$requested_values" "$requested_installation" <<'PYTHON'
import os, sys
paths = [path for path in sys.argv[1:] if path]
for index, path in enumerate(paths):
    for other in paths[:index]:
        if os.path.samefile(path, other):
            sys.exit("Baseline and candidate inputs must be distinct files.")
PYTHON
: "${OCC_URL:?Set OCC_URL to the trusted HTTPS OCC origin.}"
[[ "$OCC_URL" == https://* ]] || die "OCC_URL must use HTTPS."
: "${OCC_SERVICE_KEY_FILE:?Set OCC_SERVICE_KEY_FILE to a protected service-key response.}"
require_private_file "$OCC_SERVICE_KEY_FILE"
if [[ -n "${OCC_CA_BUNDLE:-}" ]]; then
  require_regular_file "$OCC_CA_BUNDLE"
fi
for command in cmp helm jq kubectl mktemp node yq; do
  require_command "$command"
done
[[ -x "$occ" ]] || command -v "$occ" >/dev/null 2>&1 || die "the OCC CLI is unavailable."

umask 077
if ((resume == 0)); then
  mkdir -m 700 "$evidence_dir"
fi
mkdir "$evidence_dir/.upgrade-lock" 2>/dev/null || die "the evidence directory is locked; check for a running upgrade before removing its stale .upgrade-lock directory."
trap 'rmdir "$evidence_dir/.upgrade-lock" 2>/dev/null || true' EXIT

# An interrupted caller does not establish that its child or remote operation stopped.
# Keep the lock and preflight resources until the operator reconciles that work.
interrupted_upgrade() {
  trap - EXIT
  warn "upgrade interrupted; evidence lock retained. Check running helper and child commands and reconcile unfinished operations before removing .upgrade-lock." || true
  exit "$1"
}
trap 'interrupted_upgrade 129' HUP
trap 'interrupted_upgrade 130' INT
trap 'interrupted_upgrade 143' TERM

# Bind resume to the original physical directory, inputs and chart. The
# separate dispatch journal protects against restoring stale evidence in place.
# Kubeconfig bytes bind the context to the same cluster if the file is replaced.
parameters=$(python3 - "$kubeconfig" "$context" "$namespace" "$release" "$values" "$installation" "$controller_image" "$runtime_image" "$source_revision" "$OCC_URL" "$occ" "${OCC_CA_BUNDLE:-}" "$requested_values" "$requested_installation" "$broker_image" "$evidence_dir" "$chart_sha256" "$verify_agent_namespace" "$verify_agent" "$controller_compatibility_results" <<'PYTHON'
import hashlib, json, os, sys
def digest(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()
evidence = os.stat(sys.argv[16])
print(json.dumps({"evidenceDirectory": {"path": os.path.realpath(sys.argv[16]), "st_dev": evidence.st_dev, "st_ino": evidence.st_ino}, "arguments": sys.argv[1:16], "agentContinuity": sys.argv[18:20], "controllerCompatibilityResults": sys.argv[20], "kubeconfigSha256": digest(sys.argv[1]), "caSha256": digest(sys.argv[12]) if sys.argv[12] else None, "chartSha256": sys.argv[17], "scriptSha256": digest("scripts/upgrade-production-images"), "pairProbeSha256": digest("scripts/upgrade-repository-image-probe.mjs"), "imageIdentitySha256": digest("scripts/upgrade-image-identity.py"), "nodePlatformSha256": digest("scripts/upgrade-node-platform.py"), "deploymentIdentitySha256": digest("scripts/upgrade-deployment-identity.py"), "startupPreflightSha256": digest("scripts/upgrade-startup-preflight.mjs"), "imageReferenceSha256": digest("packages/occ/src/image-reference.ts"), "imageReferenceHelperSha256": digest("scripts/lib/image-reference-problem.mjs"), "preparedEvidenceSha256": digest("scripts/upgrade-evidence.py"), "helmStateSha256": digest("scripts/upgrade-helm-state.py"), "resourceQuantitiesSha256": digest("apps/controller/src/drivers/compute/kubernetes/resource-quantities.ts"), "dispatchStateSha256": digest("scripts/upgrade-dispatch-state.py"), "upgradeFlowSha256": digest("docs/flows/coordinated-production-upgrade.md")}, sort_keys=True))
PYTHON
)
if ((resume)); then
  require_private_file "$evidence_dir/parameters.json"
  original_parameters=$(python3 - "$evidence_dir/parameters.json" <<'PYTHON'
import json, sys
with open(sys.argv[1], encoding="utf-8") as source:
    values = json.load(source)
values.pop("pairEvidence", None)
values.pop("preparedEvidence", None)
values.pop("dispatchJournal", None)
print(json.dumps(values, sort_keys=True))
PYTHON
  )
  [[ "$parameters" == "$original_parameters" ]] || die "resume evidence directory, inputs, kubeconfig, CA, scripts, image rule, chart, or flow changed; use the original evidence directory and investigate before continuing."
  [[ ! -e "$evidence_dir/completed" && ! -L "$evidence_dir/completed" ]] ||
    die "a completion marker exists; this upgrade cannot be resumed. Preserve its evidence and investigate if completion was unexpected."
  [[ -f "$evidence_dir/prepared" ]] || die "evidence is not a prepared deployment. Inspect it and any remaining temporary preflight resources, then start with a new evidence directory."
fi

dispatch_journal=
dispatch_state() {
  local action=$1
  shift
  python3 scripts/upgrade-dispatch-state.py "$action" "$dispatch_journal" \
    9 "$dispatch_binding" "$dispatch_operation" "$@" ||
    die "cannot use the original dispatch journal at $dispatch_journal. Preserve it and reconcile Agent revision history and audit records before proceeding."
}
if [[ -n "$runtime_image" ]] && ((preflight_only == 0)); then
  dispatch_journal=$(jq -er '.evidenceDirectory.path + ".dispatch-state"' <<<"$parameters")
  dispatch_operation=$(printf '%s' "$parameters" |
    python3 -c 'import hashlib, sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')
  if ((resume)); then
    dispatch_binding=$(jq -ce '.dispatchJournal' "$evidence_dir/parameters.json") ||
      die "missing dispatch journal binding. Preserve the evidence and reconcile Agent revision history and audit records."
  else
    dispatch_binding=$(python3 scripts/upgrade-dispatch-state.py create "$dispatch_journal" "$dispatch_operation") ||
      die "cannot create the dispatch journal at $dispatch_journal. Preserve any existing journal and reconcile before starting a new run."
    parameters=$(jq --argjson binding "$dispatch_binding" '.dispatchJournal = $binding' <<<"$parameters")
  fi
  python3 scripts/upgrade-dispatch-state.py check-path "$dispatch_journal" ||
    die "the original dispatch journal at $dispatch_journal is missing or invalid. Reconcile Agent revision history and audit records before proceeding."
  exec 9<"$dispatch_journal"
  dispatch_state lock
fi
if ((resume == 0)); then
  printf '%s\n' "$parameters" >"$evidence_dir/parameters.json"
fi

kube=(kubectl --kubeconfig "$kubeconfig" --context "$context")
helm_args=(--kubeconfig "$kubeconfig" --kube-context "$context" --namespace "$namespace")
occ_json=("$occ" --output json)

# Only a successful create acknowledgement establishes Job or dependency cleanup ownership.
# kubectl's error output stays off the terminal but is kept in the private
# evidence directory, so the operator can tell a refusal (quota, admission,
# RBAC, a failed Secret build) from a create whose acknowledgement was lost.
preflight_resources=()
preflight_children=()
preflight_consumer_unknown=0
unconfirmed_preflight() {
  local resource=$1 errors=$2 status=$3 reason
  # A lost Job acknowledgement may leave a running Secret consumer.
  [[ "$resource" != job.batch/* ]] || preflight_consumer_unknown=1
  if ((status == 2)); then
    reason="The create returned no usable UID; kubectl's error output, if any, is in $errors in the evidence directory."
  else
    reason="kubectl reported an error for the create; see $errors in the evidence directory."
  fi
  die "ownership unconfirmed for ${resource:0:300}; no cleanup was attempted for this name. $reason Check whether this object remains in the selected namespace. Correct the failure and use a fresh evidence directory. This run stopped no OCC writer."
}
# create_preflight FILE ERRORS [scrub] prints guarded DeleteOptions for the
# created object. It returns 1 when kubectl failed and 2 when kubectl succeeded
# without a usable UID.
create_preflight() {
  local errors="$evidence_dir/$2"
  local statuses
  # Validate the opaque UID before Bash can strip newlines or NULs, and build
  # the complete guarded request before cleanup can start a DELETE.
  "${kube[@]}" --request-timeout=30s --namespace "$namespace" create \
    --filename "$1" -o 'jsonpath={.metadata.uid}' 2>"$errors" |
    python3 -c '
import json, sys
uid = sys.stdin.buffer.read().decode("utf-8")
if not uid or not uid.isprintable() or any(c.isspace() for c in uid):
    sys.exit(1)
print(json.dumps({"apiVersion": "v1", "kind": "DeleteOptions", "propagationPolicy": "Background", "preconditions": {"uid": uid}}, separators=(",", ":")))
' 2>/dev/null && statuses=(0 0) || statuses=("${PIPESTATUS[@]}")
  # kubectl echoes a manifest it cannot decode. The Secret's only data is the
  # candidate Installation, already saved here, base64-encoded; drop long
  # base64 runs so this file never holds a second copy.
  if [[ "${3:-}" == scrub && -s "$errors" ]]; then
    python3 - "$errors" <<'PYTHON' || : >"$errors"
import re, sys
with open(sys.argv[1], encoding="utf-8", errors="replace") as source:
    text = source.read()
with open(sys.argv[1], "w", encoding="utf-8") as target:
    target.write(re.sub(r"[A-Za-z0-9+/]{32,}={0,2}", "[redacted]", text))
PYTHON
  fi
  ((statuses[0] == 0)) || return 1
  ((statuses[1] == 0)) || return 2
}
# Register cleanup before local publication: a disk failure is not a failed create.
# Child identities are observed through their acknowledged Job owner.
# These records are identity evidence only; they are never read for replay.
acknowledge_preflight() {
  local slot=$1 resource=$2 delete_options=$3
  preflight_resources+=("$resource $delete_options")
  python3 - "$evidence_dir" "$slot" "$resource" 3<<<"$delete_options" 2>/dev/null <<'PYTHON' ||
import json, os, sys
root, slot, resource = sys.argv[1:]
with os.fdopen(3, encoding="utf-8") as options:
    uid = json.load(options)["preconditions"]["uid"]
assert slot in ("networkpolicy", "secret", "api", "worker", "api-pod", "worker-pod")
kind, name = resource.split("/", 1)
record = {"kind": kind, "name": name, "uid": uid}
# Fixed local names, exclusive staging, and link publication refuse existing
# files, directories and symlinks. Bind all operations to the same private
# directory; publish only a complete, synced record.
directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
filename = "preflight-" + slot + "-identity.json"
staging = "." + filename + ".tmp"
try:
    fd = os.open(staging, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                 0o600, dir_fd=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(record, output, ensure_ascii=True, separators=(",", ":"))
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.link(staging, filename, src_dir_fd=directory, dst_dir_fd=directory,
                follow_symlinks=False)
        os.fsync(directory)
    finally:
        os.unlink(staging, dir_fd=directory)
        os.fsync(directory)
finally:
    os.close(directory)
PYTHON
    die "preflight create acknowledged, but local identity evidence could not be confirmed; no OCC writer was stopped."
}
preflight_cleanup_error() {
  local resource=$1 errors=$2
  printf '%s\n%s\n' "${resource:0:300}:" "$errors" >>"$evidence_dir/preflight-cleanup.err"
  if [[ "$errors" == *"Precondition failed: UID in precondition"* ]]; then
    warn "could not confirm cleanup of ${resource:0:300}: an object with a different UID now holds this name, so it was left in place; see preflight-cleanup.err in the evidence directory."
  else
    warn "could not confirm cleanup of ${resource:0:300}: the delete request failed; see preflight-cleanup.err in the evidence directory."
  fi
}
cleanup_preflight() {
  local entry resource name uri delete_options errors uid deadline remaining child child_name child_uid
  local consumers_stopped=1 cleanup_failed=0
  ((preflight_consumer_unknown == 0)) || consumers_stopped=0
  # Stop controllers first. Foreground deletion keeps each Job until its dependent Pods end.
  for entry in ${preflight_resources[@]+"${preflight_resources[@]}"}; do
    resource=${entry%% *}
    [[ "$resource" == job.batch/* ]] || continue
    name=${resource#*/}
    delete_options=${entry#* }
    if ! uid=$(jq -er '.preconditions.uid' <<<"$delete_options") ||
      ! delete_options=$(jq -ce '.propagationPolicy = "Foreground"' <<<"$delete_options"); then
      printf 'Cannot build UID-guarded deletion for %s.\n' "$resource" >>"$evidence_dir/preflight-cleanup.err"
      consumers_stopped=0
      continue
    fi
    uri="/apis/batch/v1/namespaces/$namespace/jobs/$name"
    if ! errors=$("${kube[@]}" --request-timeout=15s delete --raw="$uri" -f - \
      <<<"$delete_options" 2>&1 >/dev/null); then
      preflight_cleanup_error "$resource" "$errors"
      consumers_stopped=0
      continue
    fi
    child_name= child_uid=
    for child in ${preflight_children[@]+"${preflight_children[@]}"}; do
      [[ "${child%% *}" == "$uid" ]] || continue
      child=${child#* }
      child_name=${child%% *}
      child_uid=${child#* }
    done
    deadline=$((SECONDS + 30))
    while true; do
      : >"$evidence_dir/preflight-cleanup-child.json"
      if ! "${kube[@]}" --request-timeout=10s --namespace "$namespace" get "$resource" \
        --ignore-not-found -o json >"$evidence_dir/preflight-cleanup-job.json" 2>>"$evidence_dir/preflight-cleanup.err" ||
        ! "${kube[@]}" --request-timeout=10s --namespace "$namespace" get pods \
          --selector "batch.kubernetes.io/controller-uid=$uid" -o json \
          >"$evidence_dir/preflight-cleanup-pods.json" 2>>"$evidence_dir/preflight-cleanup.err"; then
        consumers_stopped=0
        break
      fi
      if [[ -n "$child_name" ]] && ! "${kube[@]}" --request-timeout=10s --namespace "$namespace" \
        get "pod/$child_name" --ignore-not-found -o json \
        >"$evidence_dir/preflight-cleanup-child.json" 2>>"$evidence_dir/preflight-cleanup.err"; then
        consumers_stopped=0
        break
      fi
      if ! remaining=$(node scripts/upgrade-startup-preflight.mjs remaining \
        "$evidence_dir/preflight-cleanup-job.json" "$uid" "$evidence_dir/preflight-cleanup-pods.json" \
        "$evidence_dir/preflight-cleanup-child.json" "$child_uid" 2>>"$evidence_dir/preflight-cleanup.err"); then
        consumers_stopped=0
        break
      fi
      [[ "$remaining" != false ]] || break
      if ((SECONDS >= deadline)); then
        printf 'Timed out stopping %s and its child Pods.\n' "$resource" >>"$evidence_dir/preflight-cleanup.err"
        consumers_stopped=0
        break
      fi
      sleep 1
    done
  done
  if ((consumers_stopped == 0)); then
    warn "preflight Job or child Pod cleanup is unconfirmed; retained the candidate Secret and NetworkPolicy. Reconcile identities and preflight-cleanup.err before proceeding."
    preflight_resources=()
    return 1
  fi
  for entry in ${preflight_resources[@]+"${preflight_resources[@]}"}; do
    resource=${entry%% *}
    delete_options=${entry#* }
    name=${resource#*/}
    case "$resource" in
      job.batch/* | pod/*) continue ;;
      secret/*) uri="/api/v1/namespaces/$namespace/secrets/$name" ;;
      networkpolicy.networking.k8s.io/*)
        uri="/apis/networking.k8s.io/v1/namespaces/$namespace/networkpolicies/$name" ;;
    esac
    # Compare the original UID atomically; leave same-name replacements untouched.
    if ! errors=$("${kube[@]}" --request-timeout=15s delete --raw="$uri" -f - \
      <<<"$delete_options" 2>&1 >/dev/null); then
      preflight_cleanup_error "$resource" "$errors"
      cleanup_failed=1
    fi
  done
  preflight_resources=()
  return "$cleanup_failed"
}
trap 'cleanup_preflight || true; rmdir "$evidence_dir/.upgrade-lock" 2>/dev/null || true' EXIT

# Read the current Job and validate the child against its original controller and UID.
read_preflight_child() {
  local component=$1 job=$2 job_uid=$3 previous_uid=$4 request_timeout=$5
  "${kube[@]}" --request-timeout="$request_timeout" --namespace "$namespace" get "job.batch/$job" \
    --output json >"$evidence_dir/preflight-$component-job-status.json" || return 1
  "${kube[@]}" --request-timeout="$request_timeout" --namespace "$namespace" get pods \
    --selector "batch.kubernetes.io/controller-uid=$job_uid" --output json \
    >"$evidence_dir/preflight-$component-pods.json" || return 1
  node scripts/upgrade-startup-preflight.mjs child \
    "$evidence_dir/preflight-$component-job-status.json" "$job_uid" \
    "$evidence_dir/preflight-$component-pods.json" "$previous_uid"
}

# Before any writer stops, start the selected controller image on the candidate
# Installation the way the API and worker start: the rendered chart's env, mounts
# and service account, with the candidate Installation in a temporary Secret.
# Configuration the image rejects, such as a presets.files entry naming a file
# the image no longer ships, or Kubernetes state its Compute preflight refuses,
# such as split-layout Gateway storage, would otherwise crash-loop both after the
# migration.
preflight_startup() {
  local suffix secret component job_prefix job job_uid pod pod_uid child phase waiting deadline remaining_seconds message failures refusal name_refusal delete_options identity_valid logs logs_status
  local job_uids=()
  local drafts='' drafts_flag=none drafts_status=0 draft_refusals
  suffix=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
  if [[ -s "${agent_drafts:-}" ]]; then
    drafts="$evidence_dir/inventory/agent-drafts.json.gz"
    node scripts/upgrade-startup-preflight.mjs drafts "$agent_drafts" "$candidate_installation" \
      "$drafts" >/dev/null || drafts_status=$?
    if ((drafts_status == 3)); then
      warn "the recorded Agents' drafts do not fit in the startup preflight Secret beside the candidate Installation, so it does not check them; OCC checks each draft when the upgrade deploys it."
      drafts=
    elif ((drafts_status != 0)); then
      die "cannot gather the recorded Agents' drafts for the startup preflight; no OCC writer was stopped."
    else
      drafts_flag=drafts
    fi
  fi
  secret="$release-upgrade-preflight-$suffix"
  yq -p=yaml -o=json -I=0 '.' "$rendered" >"$evidence_dir/preflight-rendered.jsonl" ||
    die "cannot read the rendered chart for the startup preflight; no OCC writer was stopped."
  # Helm's server-side dry-run renders the release but does not submit each
  # Certificate for admission. Check these before creating the startup Jobs.
  local certificates="$evidence_dir/preflight-certificates.json"
  jq -s '{apiVersion: "v1", kind: "List",
    items: map(select(.apiVersion == "cert-manager.io/v1" and .kind == "Certificate"))}' \
    "$evidence_dir/preflight-rendered.jsonl" >"$certificates" ||
    die "cannot select rendered Certificates for preflight; no OCC writer was stopped."
  local certificate_count
  certificate_count=$(jq -er '.items | length' "$certificates") ||
    die "cannot count rendered Certificates for preflight; no OCC writer was stopped."
  if ((certificate_count > 0)); then
    # Server-side apply sends even unchanged objects for admission. Ignore field
    # ownership conflicts in the dry-run only; Helm does not use server-side apply.
    "${kube[@]}" --request-timeout=20s --namespace "$namespace" apply --dry-run=server \
      --server-side --force-conflicts --field-manager=occ-upgrade-preflight \
      --filename "$certificates" >/dev/null 2>"$evidence_dir/preflight-certificates.err" ||
      die "certificate admission preflight failed; no OCC writer was stopped. Check cert-manager and see preflight-certificates.err in the evidence directory."
  fi
  node scripts/upgrade-startup-preflight.mjs networkpolicy "$evidence_dir/preflight-rendered.jsonl" \
    "$secret" "$namespace" "$release" >"$evidence_dir/preflight-networkpolicy.json" ||
    die "cannot build the startup preflight NetworkPolicy from the rendered chart; no OCC writer was stopped."
  if [[ "$(cat "$evidence_dir/preflight-networkpolicy.json")" != null ]]; then
    delete_options=$(create_preflight "$evidence_dir/preflight-networkpolicy.json" \
      preflight-networkpolicy-create.err) ||
      unconfirmed_preflight "networkpolicy.networking.k8s.io/$secret" preflight-networkpolicy-create.err $?
    acknowledge_preflight networkpolicy "networkpolicy.networking.k8s.io/$secret" "$delete_options"
  fi
  delete_options=$(node scripts/upgrade-startup-preflight.mjs secret "$candidate_installation" \
    "$installation_key" "$secret" "$namespace" "$release" "$drafts" |
    create_preflight - preflight-secret-create.err scrub) ||
    unconfirmed_preflight "secret/$secret" preflight-secret-create.err $?
  acknowledge_preflight secret "secret/$secret" "$delete_options"
  # Leave room for the suffix; a trailing dot would create an invalid DNS label.
  job_prefix=${release:0:29}
  job_prefix=${job_prefix%.}
  for component in api worker; do
    job="$job_prefix-upgrade-preflight-$component-$suffix"
    node scripts/upgrade-startup-preflight.mjs job "$evidence_dir/preflight-rendered.jsonl" \
      "$component" "$job" "$namespace" "$release" "$installation_secret" "$secret" \
      "$selected_controller" "$timeout_seconds" "$evidence_dir/installation.json" "$drafts_flag" \
      >"$evidence_dir/preflight-$component-job.json" ||
      die "cannot build the $component startup preflight Job from the rendered chart; no OCC writer was stopped."
    delete_options=$(create_preflight "$evidence_dir/preflight-$component-job.json" \
      "preflight-$component-job-create.err") ||
      unconfirmed_preflight "job.batch/$job" "preflight-$component-job-create.err" $?
    acknowledge_preflight "$component" "job.batch/$job" "$delete_options"
    job_uids+=("$(jq -er '.preconditions.uid' <<<"$delete_options")")
  done
  # Wait for every Pod and save each one's status and log before reporting, so a
  # refusal shows every component that failed, not only the first.
  deadline=$((SECONDS + timeout_seconds))
  failures=()
  for component in api worker; do
    job="$job_prefix-upgrade-preflight-$component-$suffix"
    job_uid=${job_uids[0]}
    [[ "$component" != worker ]] || job_uid=${job_uids[1]}
    pod= pod_uid=
    phase=
    waiting=
    message=
    identity_valid=0
    while true; do
      # Read each Pod at least once, even after an earlier one used up the deadline.
      remaining_seconds=$((deadline - SECONDS))
      ((remaining_seconds >= 15)) || remaining_seconds=15
      identity_valid=0
      if ! child=$(read_preflight_child "$component" "$job" "$job_uid" "$pod_uid" "${remaining_seconds}s"); then
        message="cannot establish the $component startup preflight child Pod identity; no OCC writer was stopped."
        break
      fi
      identity_valid=1
      phase=Running
      if [[ -n "$child" ]]; then
        printf '%s\n' "$child" >"$evidence_dir/preflight-$component-status.json"
        if [[ -z "$pod" ]]; then
          pod=$(jq -er '.metadata.name' <<<"$child")
          pod_uid=$(jq -er '.metadata.uid' <<<"$child")
          preflight_children+=("$job_uid $pod $pod_uid")
          delete_options=$(jq -cn --arg uid "$pod_uid" \
            '{apiVersion:"v1",kind:"DeleteOptions",propagationPolicy:"Background",preconditions:{uid:$uid}}')
          acknowledge_preflight "$component-pod" "pod/$pod" "$delete_options"
        fi
        phase=$(node scripts/upgrade-startup-preflight.mjs phase "$evidence_dir/preflight-$component-status.json" \
          "$evidence_dir/preflight-$component-job-status.json")
      fi
      case "$phase" in
        Running | Pending:*)
          [[ "$phase" != Pending:* ]] || waiting=${phase#Pending:}
          if ((SECONDS >= deadline)); then
            message="the $component startup preflight did not finish before the timeout${waiting:+ ($waiting)}; see preflight-$component-job-status.json and preflight-$component-pods.json. No OCC writer was stopped."
            break
          fi
          ;;
        *) break ;;
      esac
      sleep 2
    done
    # The logs API addresses a name, so retain output only while that name still
    # identifies the validated child before and after the request.
    if [[ -n "$pod" ]] && ((identity_valid)); then
      if ! child=$(read_preflight_child "$component" "$job" "$job_uid" "$pod_uid" 30s) || [[ -z "$child" ]]; then
        message="cannot bind the $component startup preflight logs to the original child Pod; no OCC writer was stopped."
      else
        logs_status=0
        # Bash drops NUL bytes; reject them before they can change a result marker.
        logs=$("${kube[@]}" --request-timeout=30s --namespace "$namespace" logs "pod/$pod" --container "$component" 2>&1 |
          python3 -c 'import sys
data = sys.stdin.buffer.read()
if b"\0" in data:
    sys.exit(1)
sys.stdout.buffer.write(data)') || logs_status=$?
        if ! child=$(read_preflight_child "$component" "$job" "$job_uid" "$pod_uid" 30s) || [[ -z "$child" ]]; then
          logs=
          message="cannot bind the $component startup preflight logs to the original child Pod; discarded unconfirmed output. No OCC writer was stopped."
        else
          printf '%s\n' "$child" >"$evidence_dir/preflight-$component-status.json"
          printf '%s\n' "$logs" >"$evidence_dir/preflight-$component.log"
          logs=
          phase=$(node scripts/upgrade-startup-preflight.mjs phase "$evidence_dir/preflight-$component-status.json" \
            "$evidence_dir/preflight-$component-job-status.json")
          if ((logs_status != 0)) && [[ -z "$message" && "$phase" == Succeeded ]]; then
            message="cannot read the $component startup preflight logs; no OCC writer was stopped."
          fi
        fi
      fi
    fi
    if [[ -z "$message" ]]; then
      case "$phase" in
        JobFailed)
          message="the $component startup preflight Job failed; see preflight-$component-job-status.json. No OCC writer was stopped."
          ;;
        Succeeded)
          grep -qx installation-startup-ready "$evidence_dir/preflight-$component.log" ||
            message="the $component startup preflight succeeded without its result line; no OCC writer was stopped."
          if [[ -z "$message" && "$component" == api && -n "$drafts" ]] &&
            grep -qx agent-draft-check-unavailable "$evidence_dir/preflight-api.log"; then
            warn "the selected controller image cannot check Agent drafts before the upgrade; OCC checks each draft when the upgrade deploys it."
          elif [[ -z "$message" && "$component" == api && -n "$drafts" ]] &&
            ! grep -qx agent-drafts-accepted "$evidence_dir/preflight-api.log"; then
            message="the api startup preflight succeeded without checking the Agent drafts; no OCC writer was stopped."
          fi
          ;;
        Stuck:*)
          message="the $component startup preflight Pod cannot start (${phase#Stuck:}); no OCC writer was stopped."
          ;;
        *)
          name_refusal=$(grep -m 1 '^The stored Installation name breaks the Name rule: ' \
            "$evidence_dir/preflight-$component.log" | cut -c 1-600 || true)
          refusal=$(grep -m 1 -E '^Kubernetes Compute startup preflight (refused the candidate release|could not complete):' \
            "$evidence_dir/preflight-$component.log" | cut -c 1-600 || true)
          draft_refusals=
          if [[ "$component" == api && -n "$drafts" ]]; then
            draft_refusals=$(node scripts/upgrade-startup-preflight.mjs refusals \
              "$evidence_dir/preflight-api.log") || draft_refusals=
          fi
          if [[ -n "$draft_refusals" ]]; then
            message="the selected controller image refuses to deploy $(grep -c '^Agent draft refused: ' "$evidence_dir/preflight-api.log") recorded Agent draft(s):
$draft_refusals
No OCC writer was stopped; the old release keeps serving. Correct each draft as its refusal says, for example remove a setting the new release retired, or stop the Agent, then start again with a new evidence directory."
          elif [[ "$component" == api && -n "$drafts" ]] &&
            grep -Fxq 'Agent draft check could not load the configured Harness resolver.' "$evidence_dir/preflight-api.log"; then
            message="the selected controller image could not check saved Agent drafts because its configured Harness resolver is unavailable. No OCC writer was stopped; the old release keeps serving. Select a corrected controller image and start again with a new evidence directory."
          elif [[ -n "$name_refusal" ]]; then
            message="the $component startup preflight stopped: $name_refusal (INSTALLATION_NAME_INVALID) No OCC writer was stopped; the old release keeps serving. Rename the Installation as in docs/guides/deploy/production-upgrade-recovery.md#correct-an-invalid-installation-name, then start again with a new evidence directory."
          elif [[ -n "$refusal" ]]; then
            message="the $component startup preflight stopped: $refusal No OCC writer was stopped; the old release keeps serving."
            if [[ "$refusal" == *split-layout* ]]; then
              message+=" See docs/reference/drivers/kubernetes-compute.md#existing-split-layout-installations."
            elif [[ "$refusal" == *"openclaw-execution chart"* ]]; then
              message+=" Upgrade the execution release as in docs/testing/kubernetes.md#upgrade-the-execution-chart, then start again with a new evidence directory."
            elif [[ "$refusal" == *"execution cluster tenant grant review failed"* ]]; then
              message+=" The Pod used its execution cluster kubeconfig, which must list Namespaces and create SelfSubjectAccessReviews there; fix that access and start again with a new evidence directory."
            else
              message+=" The Pod uses the installed release's service account and RBAC and only the chart's dependency egress (preflight-networkpolicy.json); fix its Kubernetes API access and start again with a new evidence directory."
            fi
          else
            message=$(tail -n 3 "$evidence_dir/preflight-$component.log" | tr '\n' ' ' | cut -c 1-600)
            [[ -n "${message// /}" ]] || message="no output (see preflight-$component-status.json). "
            message="the selected controller image cannot start the $component with the candidate Installation: ${message}No OCC writer was stopped; correct the Installation and start again with a new evidence directory."
          fi
          ;;
      esac
    fi
    [[ -z "$message" ]] || failures+=("$message")
  done
  if [[ -n "${failures[*]+set}" ]]; then
    for message in "${failures[@]:0:${#failures[@]}-1}"; do
      warn "$message"
    done
    die "${failures[${#failures[@]}-1]}"
  fi
  cleanup_preflight || die "startup preflight cleanup is incomplete; no OCC writer was stopped."
  touch "$evidence_dir/startup-preflight-passed"
}

validate_controller_compatibility() {
  [[ -n "$controller_compatibility_results" ]] || return 0
  require_private_file "$evidence_dir/controller-compatibility-results.json"
  require_immutable_image "released controller image" "$current_controller"
  python3 scripts/upgrade-evidence.py compatibility \
    "$evidence_dir/controller-compatibility-results.json" "$current_controller" "$selected_controller" ||
    die "controller compatibility receipt must pass for the exact released and candidate images; no new writer changes were made."
}

# Sample the exact original revision through the supported read-only runtime API.
# The Driver's sources describe immutable revision topology; Agent.executionMode
# describes the editable draft and cannot tell us which Pods must be present.
verify_agent_continuity() {
  local phase=$1 deadline=$((SECONDS + timeout_seconds)) remaining revision roles
  local prefix="$evidence_dir/agent-continuity-$phase" observation ready
  local failure="selected Agent $verify_agent continuity check failed before writer shutdown."
  if [[ "$phase" == after ]]; then
    failure="control-plane upgrade reached verification, but selected Agent $verify_agent continuity failed; completion was not recorded. Preserve the evidence and restore the original revision before --resume; no Agent deployment was requested."
  fi
  while true; do
    remaining=$((deadline - SECONDS))
    ((remaining > 0)) || die "$failure Timed out waiting for Ready workload Pods."
    "${occ_json[@]}" --timeout-seconds "$remaining" --namespace "$verify_agent_namespace" \
      agent get "$verify_agent" </dev/null >"$prefix.agent.json" || die "$failure Cannot read the selected Agent."
    revision=$(jq -er --arg agent "$verify_agent" --arg namespace "$verify_agent_namespace" '
      select(.id == $agent and .namespaceId == $namespace and
        .status == "active" and .desiredRuntimeState == "running") |
      .activeRevisionId | select(type == "string" and length > 0)
    ' "$prefix.agent.json") || die "$failure The selected Agent must be active and running with an active revision."
    if [[ "$phase" == after ]]; then
      [[ "$revision" == "$(jq -er .revisionId "$evidence_dir/agent-continuity.json")" ]] ||
        die "$failure The active revision changed."
    fi
    remaining=$((deadline - SECONDS))
    ((remaining > 0)) || die "$failure Timed out reading the selected Agent."
    "${occ_json[@]}" --timeout-seconds "$remaining" --namespace "$verify_agent_namespace" \
      agent runtime "$verify_agent" --revision "$revision" </dev/null >"$prefix.runtime.json" ||
      die "$failure Cannot read the exact revision runtime; check Agent read/operate, AgentRevision read, and runtime inspection configuration."
    roles=$(jq -ce --arg revision "$revision" '
      select(.revisionId == $revision) |
      [.sources[] | select(.kind == "container") | .id] | sort |
      select(. == ["gateway"] or . == ["agent", "gateway"])
    ' "$prefix.runtime.json") || die "$failure Runtime inspection did not identify the exact revision and its workload roles."
    if [[ "$phase" == after ]]; then
      [[ "$roles" == "$(jq -c .roles "$evidence_dir/agent-continuity.json")" ]] ||
        die "$failure The revision workload roles changed."
    fi
    remaining=$((deadline - SECONDS))
    ((remaining > 0)) || die "$failure Timed out reading the revision runtime."
    "${occ_json[@]}" --timeout-seconds "$remaining" --namespace "$verify_agent_namespace" \
      agent get "$verify_agent" </dev/null >"$prefix.confirm.json" || die "$failure Cannot confirm the selected Agent."
    jq -e --arg agent "$verify_agent" --arg namespace "$verify_agent_namespace" --arg revision "$revision" '
      .id == $agent and .namespaceId == $namespace and .status == "active" and
      .desiredRuntimeState == "running" and .activeRevisionId == $revision
    ' "$prefix.confirm.json" >/dev/null || die "$failure The selected Agent changed during runtime inspection."
    ((SECONDS < deadline)) || die "$failure Timed out confirming the selected Agent."
    observation=$(mktemp "$prefix.XXXXXXXX")
    jq -n --arg namespace "$verify_agent_namespace" --arg agent "$verify_agent" \
      --arg revision "$revision" --argjson roles "$roles" --slurpfile runtime "$prefix.runtime.json" '
      {namespaceId: $namespace, agentId: $agent, revisionId: $revision, roles: $roles,
       providerHarnessObserved: ($runtime[0] | has("harness")), runtime: $runtime[0]}
    ' >"$observation"
    mv "$observation" "$prefix.json"
    ready=0
    # Runtime inspection caps each role at eight Pods; a full page cannot prove
    # uniqueness after filtering ended Pods. Pod Ready includes completed init
    # containers, whose terminated status must not be treated as a failure.
    if jq -e '
      .roles as $roles | .runtime |
      .pods as $observed |
      [.pods[] | select(.phase != "Succeeded" and .phase != "Failed")] as $pods |
      all($roles[]; . as $role | ([$observed[] | select(.role == $role)] | length) < 8) and
      (($pods | map(.role) | sort) == $roles) and
      all($pods[]; (.uid | type == "string" and length > 0) and
        (.name | type == "string" and length > 0) and .phase == "Running" and .ready == true) and
      ((has("harness") | not) or .harness.state == "running")
    ' "$prefix.json" >/dev/null; then
      ready=1
    fi
    if [[ "$phase" == after ]] && jq -e .providerHarnessObserved "$evidence_dir/agent-continuity.json" >/dev/null; then
      jq -e '.runtime.harness.state == "running"' "$prefix.json" >/dev/null || ready=0
    fi
    if ((ready)); then
      if [[ "$phase" == before ]]; then
        cp "$prefix.json" "$evidence_dir/agent-continuity.json"
      fi
      return
    fi
    [[ "$phase" != before ]] || die "$failure The original revision workload must be Ready."
    sleep 2
  done
}

prepare_upgrade() {
mkdir -m 700 "$evidence_dir/inventory"
if [[ -n "$runtime_image" ]]; then
  mkdir -m 700 "$evidence_dir/dispatch" "$evidence_dir/status"
fi
printf '%s\n' "$source_revision" >"$evidence_dir/source-revision"
[[ -z "$controller_image" ]] || printf '%s\n' "$controller_image" >"$evidence_dir/controller-image"
[[ -z "$broker_image" ]] || printf '%s\n' "$broker_image" >"$evidence_dir/broker-image"
[[ -z "$runtime_image" ]] || printf '%s\n' "$runtime_image" >"$evidence_dir/runtime-image"
cp "$values" "$evidence_dir/before-values.yaml"
cp "$installation" "$evidence_dir/before-installation.yaml"
[[ -z "$requested_values" ]] || cp "$requested_values" "$evidence_dir/requested-values.yaml"
[[ -z "$requested_installation" ]] || cp "$requested_installation" "$evidence_dir/requested-installation.yaml"

"${kube[@]}" --request-timeout=15s get --raw=/readyz >"$evidence_dir/kubernetes-readyz"
helm status "$release" "${helm_args[@]}" >"$evidence_dir/before-helm-status.txt"
helm status "$release" "${helm_args[@]}" --output json >"$evidence_dir/before-helm-status.json"
jq -e '.info.status == "deployed" and (.version | type == "number")' \
  "$evidence_dir/before-helm-status.json" >/dev/null || die "the Helm release must be deployed before starting an upgrade."
helm get values "$release" "${helm_args[@]}" --output yaml >"$evidence_dir/before-live-values.yaml"
installation_secret=$(
  yq -er '.installation.secretName // "occ-installation-startup"' \
    "$evidence_dir/before-live-values.yaml"
)
installation_key=$(
  yq -er '.installation.key // "installation.yaml"' \
    "$evidence_dir/before-live-values.yaml"
)
live_installation_secret="$evidence_dir/before-live-installation-secret.json"
"${kube[@]}" --namespace "$namespace" get secret "$installation_secret" --output json \
  >"$live_installation_secret"
jq -e '(.metadata.uid | type == "string" and length > 0) and
  (.metadata.resourceVersion | type == "string" and length > 0)' \
  "$live_installation_secret" >/dev/null || die "the live Installation Secret lacks a UID or resource version."
if ! cluster_installation_id=$(
  jq -er '.metadata.annotations["openclaw.dev/installation-id"]' "$live_installation_secret"
); then
  die "the live Installation Secret must carry the openclaw.dev/installation-id annotation."
fi
jq -er --arg key "$installation_key" '.data[$key]' "$live_installation_secret" |
  python3 -c 'import base64,sys; sys.stdout.buffer.write(base64.b64decode(sys.stdin.buffer.read()))' \
    >"$evidence_dir/before-live-installation.yaml"

matches_yaml "$evidence_dir/before-values.yaml" "$evidence_dir/before-live-values.yaml" ||
  die "the protected Helm values differ from the live release; refresh --values before upgrading."
matches_yaml "$evidence_dir/before-installation.yaml" "$evidence_dir/before-live-installation.yaml" ||
  die "the protected Installation YAML differs from the live Secret; refresh --installation before upgrading."

# The bundled Collector reads an operator-created Secret that Helm never
# updates. Stop before mutation when it still holds another revision's shared
# policy, so a release cannot silently keep an old log filter.
if [[ $(yq -r '.logging.collector.enabled // false' "$evidence_dir/before-values.yaml") == true ]]; then
  collector_secret=$(
    yq -er '.logging.collector.configSecretName // "occ-otel-collector-config"' \
      "$evidence_dir/before-values.yaml"
  )
  "${kube[@]}" --namespace "$namespace" get secret "$collector_secret" --output json \
    >"$evidence_dir/before-live-collector-config.json" ||
    die "cannot read the Collector config Secret $collector_secret."
  : >"$evidence_dir/collector-config-drift"
  for key in collector.yaml kubernetes.yaml; do
    if ! jq -er --arg key "$key" '.data[$key]' "$evidence_dir/before-live-collector-config.json" |
      python3 -c 'import base64,sys; sys.stdout.buffer.write(base64.b64decode(sys.stdin.buffer.read()))' |
      cmp -s - "deploy/logging/$key"; then
      printf '%s\n' "$key" >>"$evidence_dir/collector-config-drift"
    fi
  done
  if [[ -s "$evidence_dir/collector-config-drift" ]] && ((collector_config_reviewed == 0)); then
    die "the Collector config Secret $collector_secret differs from this checkout's deploy/logging ($(paste -sd, "$evidence_dir/collector-config-drift")); refresh it and restart the Collector, or pass --collector-config-reviewed to keep a reviewed custom configuration."
  fi
fi

"${kube[@]}" get deployments,statefulsets,pods,persistentvolumeclaims --all-namespaces \
  --output json >"$evidence_dir/before-workloads.json"
"${occ_json[@]}" installation get >"$evidence_dir/installation.json"
installation_id=$(jq -er '.id' "$evidence_dir/installation.json")
[[ "$installation_id" == "$cluster_installation_id" ]] ||
  die "OCC Installation $installation_id does not match Kubernetes Installation $cluster_installation_id."

[[ -z "$verify_agent" ]] || verify_agent_continuity before

targets="$evidence_dir/targets.jsonl"
: >"$targets"
target_count=0
inventory="$evidence_dir/inventory/deployment-inventory.json"
"${occ_json[@]}" installation deployment-inventory >"$inventory"
# Validate the fields used below before filtering: absent state is not settled state.
jq -es --arg installationId "$installation_id" '
  def identifier: type == "string" and length > 0;
  length == 1 and (.[0] |
    .installationId == $installationId and
    (.namespaces | type == "array" and all(.[];
      (.id | identifier) and (.status | IN("provisioning", "ready", "failed", "deleting")) and
      (.agents | type == "array" and all(.[];
        (.id | identifier) and (.status | IN("active", "deleting")) and
        (.desiredRuntimeState | IN("running", "stopped")) and
        (.executionMode | IN("embedded", "dedicated")) and
        (.deploymentInProgress | type == "boolean") and
        ((has("activeRevisionId") | not) or (.activeRevisionId | identifier))
      ))
    )))
' "$inventory" >/dev/null ||
  die "the deployment inventory must be one complete JSON document belonging to this Installation."

if jq -e '.namespaces[].agents[] | select(.deploymentInProgress)' "$inventory" >/dev/null; then
  die "the deployment inventory contains nonterminal Agent work; wait for it to finish before upgrading."
fi

if [[ -z "$runtime_image" ]]; then
  # This path does not replace Agent revisions. Read the exact active snapshot,
  # not the current draft, before stopping the worker that will maintain it.
  jq -c '.namespaces[] as $namespace | $namespace.agents[] |
    select(.status == "active" and .desiredRuntimeState == "running" and .activeRevisionId != null) |
    {namespaceId: $namespace.id, agentId: .id, revisionId: .activeRevisionId}' \
    "$inventory" >"$evidence_dir/inventory/active-revisions.jsonl"
  while IFS= read -r active; do
    json_fields "$active" namespace_id=namespaceId agent_id=agentId revision_id=revisionId
    snapshot="$evidence_dir/inventory/$(json_file_name "$namespace_id--$agent_id--$revision_id").json"
    # Validate in memory; retain no native Configuration or credential references.
    if "${occ_json[@]}" --namespace "$namespace_id" agent revision "$agent_id" "$revision_id" </dev/null |
      jq -es --arg namespaceId "$namespace_id" --arg agentId "$agent_id" --arg revisionId "$revision_id" '
        if length == 1 and (.[0] |
          .namespaceId == $namespaceId and .agentId == $agentId and .id == $revisionId and
          (.harness.overrides | type) == "object" and (.harness.configuration | type) == "object")
        then {namespaceId: $namespaceId, agentId: $agentId, revisionId: $revisionId,
          savedHarnessSettings: "readable"}
        else empty end
      ' >"$snapshot"; then
      :
    else
      read_status=("${PIPESTATUS[@]}")
      rm -f -- "$snapshot"
      ((read_status[0] == 0)) ||
        die "cannot read active revision $revision_id of Agent $agent_id; no OCC writer was stopped."
      die "active revision $revision_id of Agent $agent_id has missing or unreadable saved Harness settings; this upgrade does not replace Agent revisions. Plan an authorized replacement or stop and settle the Agent before upgrading. No OCC writer was stopped."
    fi
  done <"$evidence_dir/inventory/active-revisions.jsonl"
fi

if [[ -n "$runtime_image" ]]; then
  # shellcheck disable=SC2016 # $namespace is a jq variable.
  unrevisioned_agents='.namespaces[] as $namespace | $namespace.agents[] |
    select(.status == "active" and .desiredRuntimeState == "running" and (.activeRevisionId == null))'
  if jq -e "$unrevisioned_agents" "$inventory" >/dev/null; then
    die "the deployment inventory contains a running Agent without an active revision; resolve its initial deployment first. No cluster changes were made.
$(list_inventory_agents "$inventory" "$unrevisioned_agents")
Stop or delete each running Agent without an active revision (occ --namespace NAMESPACE_ID agent stop AGENT_ID), or deploy it until it succeeds (occ --namespace NAMESPACE_ID agent deploy AGENT_ID), then start again with a new evidence directory. See docs/guides/deploy/production-upgrade.md#upgrade-agent-runtimes."
  fi
  if jq -e \
    '.namespaces[] | select(.status != "ready") | .agents[] | select(.status == "active" and .desiredRuntimeState == "running")' \
    "$inventory" >/dev/null; then
    die "the deployment inventory contains a running Agent in a Namespace that is not ready."
  fi

  jq -c '
    .namespaces[] as $namespace |
    $namespace.agents[] |
    select(
      $namespace.status == "ready" and
      .status == "active" and
      .desiredRuntimeState == "running" and
      (.activeRevisionId != null)
    ) |
    {
      namespaceId: $namespace.id,
      agentId: .id,
      executionMode: .executionMode,
      baselineRevisionId: .activeRevisionId
    }
  ' "$inventory" >"$targets"
  target_count=$(wc -l <"$targets" | tr -d ' ')

  # The draft each recorded Agent deploys: its saved Configuration. The startup preflight
  # checks them with the selected controller image's deploy rules before any writer stops,
  # so a setting that release refuses stops the upgrade here, not after the controller
  # moved (finding 2809). Deploy needs the same Agent and Configuration reads.
  agent_drafts="$evidence_dir/inventory/agent-drafts.jsonl"
  : >"$agent_drafts"
  while IFS= read -r target; do
    json_fields "$target" namespace_id=namespaceId agent_id=agentId
    prefix="$evidence_dir/inventory/$(json_file_name "$namespace_id--$agent_id")"
    "${occ_json[@]}" --namespace "$namespace_id" agent get "$agent_id" </dev/null \
      >"$prefix.agent.json" ||
      die "cannot read Agent $agent_id in Namespace $namespace_id to check its draft; no cluster changes were made."
    configuration_id=$(jq -er '.configurationId | select(type == "string" and length > 0)' \
      "$prefix.agent.json") ||
      die "OCC returned no Configuration for Agent $agent_id in Namespace $namespace_id; no cluster changes were made."
    "${occ_json[@]}" --namespace "$namespace_id" configuration get "$configuration_id" </dev/null \
      >"$prefix.configuration.json" ||
      die "cannot read Configuration $configuration_id of Agent $agent_id in Namespace $namespace_id to check its draft; no cluster changes were made."
    jq -ec --arg namespaceId "$namespace_id" --arg agentId "$agent_id" \
      --arg configurationId "$configuration_id" --slurpfile agent "$prefix.agent.json" '
      select(.id == $configurationId and (.values | type) == "object") |
      {namespaceId: $namespaceId, agentId: $agentId, name: $agent[0].name,
        configurationId: $configurationId, values: .values}
    ' "$prefix.configuration.json" >>"$agent_drafts" ||
      die "OCC returned no values for Configuration $configuration_id of Agent $agent_id; no cluster changes were made."
  done <"$targets"

  current_gateway=$(yq -er '.drivers.compute.configuration.images.gateway' "$evidence_dir/before-installation.yaml")
  current_agent=$(yq -er '.drivers.compute.configuration.images.agent' "$evidence_dir/before-installation.yaml")
  [[ "$runtime_image" != "$current_gateway" || "$runtime_image" != "$current_agent" ]] ||
    die "both runtime image slots already select the candidate digest."
fi

current_controller=$(yq -er '.images.controller' "$evidence_dir/before-values.yaml")
repository_enabled=$(yq -r '.repositoryCredentials.enabled // false' "$evidence_dir/before-values.yaml")
if [[ -n "$controller_image" && -z "$runtime_image" && "$controller_image" == "$current_controller" ]]; then
  if [[ -z "$broker_image" ]]; then
    die "the controller image already selects the candidate digest."
  elif [[ "$repository_enabled" == true ]] &&
    [[ "$broker_image" == "$(yq -r '.repositoryCredentials.image // ""' "$evidence_dir/before-values.yaml")" ]]; then
    die "the controller and broker already select the candidate digests."
  fi
fi
selected_controller=${controller_image:-$current_controller}
if [[ -n "$controller_compatibility_results" ]]; then
  require_regular_file "$controller_compatibility_results"
  cp "$controller_compatibility_results" "$evidence_dir/controller-compatibility-results.json"
  validate_controller_compatibility
fi

candidate_values="$evidence_dir/candidate-values.yaml"
candidate_installation="$evidence_dir/candidate-installation.yaml"
if [[ -n "$requested_values" ]]; then
  cp "$evidence_dir/requested-values.yaml" "${candidate_values}.requested"
else
  cp "$evidence_dir/before-values.yaml" "${candidate_values}.requested"
fi
if [[ -n "$requested_installation" ]]; then
  cp "$evidence_dir/requested-installation.yaml" "${candidate_installation}.requested"
else
  cp "$evidence_dir/before-installation.yaml" "${candidate_installation}.requested"
fi
matches_yaml "${candidate_values}.requested" "${candidate_values}.requested" || die "candidate values must be a YAML object."
matches_yaml "${candidate_installation}.requested" "${candidate_installation}.requested" || die "candidate Installation must be a YAML object."
# Keep all settings protected except the supported database phase, proxy and curated catalog
# selections. New configuration fields remain protected until explicitly reviewed.
values_guard='del(.api.channelDirectoryProxyUrl, .installation.secretName, .database.upgradeMigration) | if .database == {} then del(.database) else . end | if .api == {} then del(.api) else . end | if .installation == {} then del(.installation) else . end'
project_yaml "$evidence_dir/before-values.yaml" "$values_guard" "$evidence_dir/values-guard.json"
project_yaml "${candidate_values}.requested" "$values_guard" "$evidence_dir/candidate-values-guard.json"
# Compare resolved values so YAML aliases have the same meaning as ordinary scalars.
if jq -e --slurpfile candidate "$evidence_dir/candidate-values-guard.json" '
  .agentNativeAdmin.sharedCookieDomain == "" and
  ($candidate[0].agentNativeAdmin | has("sharedCookieDomain") | not)
' "$evidence_dir/values-guard.json" >/dev/null; then
  project_yaml "$evidence_dir/before-values.yaml" "$values_guard | del(.agentNativeAdmin.sharedCookieDomain)" "$evidence_dir/values-guard.json"
fi
cmp -s "$evidence_dir/values-guard.json" "$evidence_dir/candidate-values-guard.json" ||
  die "candidate values change a protected setting; only database.upgradeMigration, api.channelDirectoryProxyUrl or a validated immutable Installation Secret reference may change; an empty agentNativeAdmin.sharedCookieDomain may be removed."
project_yaml "$evidence_dir/before-installation.yaml" '.' "$evidence_dir/installation-guard.json"
project_yaml "${candidate_installation}.requested" '.' "$evidence_dir/candidate-installation-guard.json"
if ! cmp -s "$evidence_dir/installation-guard.json" "$evidence_dir/candidate-installation-guard.json"; then
  # Compare the explicit candidate with the existing registration in canonical
  # form. Do not rewrite the baseline or silently convert an installed object.
  jq -e --slurpfile candidate "$evidence_dir/candidate-installation-guard.json" '
    (.drivers.plugin | type == "object") as $single |
    if $single then
      .drivers.plugin |= (
        if keys == ["configuration", "id"] and
          (.id == "occ-plugin" or .id == "codex-plugin") and
          (.configuration | type == "object")
        then [.] else error("invalid installed Plugin Driver registration") end
      )
    else .drivers.plugin //= [] end |
    if $single and . == $candidate[0] then true
    else
      if any(.drivers.plugin[]; .id == "codex-plugin") then
        (.drivers.plugin[] | select(.id == "codex-plugin") | .configuration.catalogSource) = "openai-curated"
      else
        .drivers.plugin += [{id: "codex-plugin", configuration: {catalogSource: "openai-curated"}}]
      end |
      (.drivers.plugin |= sort_by(.id)) == ($candidate[0] | .drivers.plugin |= sort_by(.id))
    end
  ' "$evidence_dir/installation-guard.json" >/dev/null ||
    die "candidate Installation changes a protected setting; only an unchanged Plugin Driver registration wrapped in an array or the curated Plugin Driver selection may change."
fi
mv "${candidate_values}.requested" "$candidate_values"
mv "${candidate_installation}.requested" "$candidate_installation"

if [[ "$repository_enabled" == true ]]; then
  [[ -n "$controller_image" && -n "$broker_image" ]] ||
    die "repository-enabled upgrades require explicit controller and broker image selections."
  [[ $(yq -r '.drivers.repo == null' "$candidate_installation") == true ]] ||
    die "drain accepted repository work on its original owner before switching from drivers.repo."
  [[ $(yq -r '.repository.nativeSender.controlSocket // ""' "$candidate_installation") == "/run/openclaw/repository-control/private/control.sock" ]] ||
    die "repository.nativeSender must use the worker's private broker socket."
  for command in docker node openssl; do
    require_command "$command"
  done
  "${kube[@]}" --request-timeout=15s get nodes --output json >"$evidence_dir/before-nodes.json"
  yq -o=json '.' "$candidate_values" >"$evidence_dir/node-selector-values.json"
  python3 scripts/upgrade-node-platform.py "$evidence_dir/before-nodes.json" \
    "$evidence_dir/node-selector-values.json" >"$evidence_dir/eligible-nodes.json" ||
    die "cannot identify a single eligible control-plane platform."
  qualified_platform=$(jq -er '.platform' "$evidence_dir/eligible-nodes.json")
  node scripts/upgrade-repository-image-probe.mjs "$controller_image" "$broker_image" \
    "$qualified_platform" >"$evidence_dir/pair-proof.json" ||
    die "the selected repository image pair failed compatibility qualification."
  python3 - "$evidence_dir/parameters.json" "$evidence_dir/pair-proof.json" "$evidence_dir/eligible-nodes.json" "$evidence_dir/node-selector-values.json" \
    >"$evidence_dir/parameters.prepared.json" <<'PYTHON'
import hashlib, json, sys
with open(sys.argv[1], encoding="utf-8") as source:
    parameters = json.load(source)
parameters["pairEvidence"] = {path.rsplit("/", 1)[-1]: hashlib.sha256(open(path, "rb").read()).hexdigest() for path in sys.argv[2:]}
print(json.dumps(parameters, sort_keys=True))
PYTHON
  mv "$evidence_dir/parameters.prepared.json" "$evidence_dir/parameters.json"
elif [[ -n "$broker_image" ]]; then
  die "--broker-image requires repository credentials to be enabled."
fi

# Keep the endpoint already pinned by certificates and repository sessions.
# Read it only after protected/live values and Installation identity agree.
# repository_enabled is before-values.yaml's setting, read above after both checks.
if [[ "$repository_enabled" == true ]]; then
  broker_deployment="$evidence_dir/before-broker-deployment.json"
  "${kube[@]}" --namespace "$namespace" get deployment openclaw-enterprise-worker \
    --output json >"$broker_deployment"
  yq -o=json '.' "$evidence_dir/before-values.yaml" >"$evidence_dir/before-broker-values.json"
  broker_hostname=$(python3 - "$broker_deployment" "$evidence_dir/before-broker-values.json" "$namespace" "$release" <<'PYTHON'
import json, re, sys
try:
    deployment = json.load(open(sys.argv[1]))
    values = json.load(open(sys.argv[2]))["repositoryCredentials"]
    assert deployment["metadata"]["labels"]["app.kubernetes.io/instance"] == sys.argv[4]
    containers = [c for c in deployment["spec"]["template"]["spec"]["containers"] if c["name"] == "repository-credentials"]
    assert len(containers) == 1
    args = containers[0]["args"]
    assert args.count("--public-origin") == 1
    origin = args[args.index("--public-origin") + 1]
    domain = values.get("clusterDomain", "cluster.local")
    match = re.fullmatch(r"https://([a-z][a-z0-9-]*)\." + re.escape(sys.argv[3]) + r"\.svc(?:\." + re.escape(domain) + r")?", origin)
    assert match is not None
    hostname = origin.removeprefix("https://")
    assert not values.get("serviceName") or values["serviceName"] == match[1]
    assert not values.get("hostname") or values["hostname"] == hostname
    print(hostname)
except (AssertionError, KeyError, ValueError, TypeError, IndexError):
    sys.exit("Cannot preserve repository broker hostname: live origin and Helm Service settings disagree.")
PYTHON
  )
  BROKER_HOSTNAME="$broker_hostname" BROKER_SERVICE_NAME="${broker_hostname%%.*}" yq -i \
    '.repositoryCredentials.hostname = strenv(BROKER_HOSTNAME) |
     .repositoryCredentials.serviceName = strenv(BROKER_SERVICE_NAME)' "$candidate_values"
fi
if [[ -n "$controller_image" ]]; then
  CONTROLLER_IMAGE="$controller_image" yq -i \
    '.images.controller = strenv(CONTROLLER_IMAGE)' "$candidate_values"
fi
if [[ -n "$broker_image" ]]; then
  BROKER_IMAGE="$broker_image" yq -i \
    '.repositoryCredentials.image = strenv(BROKER_IMAGE)' "$candidate_values"
fi
if [[ -n "$runtime_image" ]]; then
  RUNTIME_IMAGE="$runtime_image" yq -i \
    '.drivers.compute.configuration.images.gateway = strenv(RUNTIME_IMAGE) |
     .drivers.compute.configuration.images.agent = strenv(RUNTIME_IMAGE)' \
    "$candidate_installation"
fi
candidate_secret=$(yq -er '.installation.secretName // "occ-installation-startup"' "$candidate_values")
if [[ "$candidate_secret" != "$installation_secret" ]]; then
  # The key and namespace stay fixed; all unrelated Secret data must survive.
  jq -e --arg namespace "$namespace" '.immutable == true and
    .metadata.namespace == $namespace and .metadata.deletionTimestamp == null' \
    "$live_installation_secret" >/dev/null || die "switching the Installation reference requires an immutable predecessor."
  candidate_secret_snapshot="$evidence_dir/before-candidate-installation-secret.json"
  "${kube[@]}" --namespace "$namespace" get secret "$candidate_secret" --output json >"$candidate_secret_snapshot"
  jq -e --arg name "$candidate_secret" --arg key "$installation_key" \
    --slurpfile before "$live_installation_secret" '
    .metadata.name == $name and .metadata.namespace == $before[0].metadata.namespace and
    (.metadata.uid | type == "string" and length > 0) and
    .metadata.uid != $before[0].metadata.uid and
    (.metadata.resourceVersion | type == "string" and length > 0) and
    .metadata.deletionTimestamp == null and .immutable == true and
    .metadata.annotations["openclaw.dev/installation-id"] ==
      $before[0].metadata.annotations["openclaw.dev/installation-id"] and
    .type == $before[0].type and
    (.data | del(.[$key])) == ($before[0].data | del(.[$key]))
  ' "$candidate_secret_snapshot" >/dev/null || die "the staged immutable Installation Secret does not match the predecessor authority or unrelated data."
  jq -er --arg key "$installation_key" '.data[$key]' "$candidate_secret_snapshot" |
    python3 -c 'import base64,sys; sys.stdout.buffer.write(base64.b64decode(sys.stdin.buffer.read().strip(), validate=True))' \
      >"$evidence_dir/staged-installation.yaml"
  # YAML-to-JSON comparison must not equate keys that startup interprets
  # differently (for example, an unquoted hexadecimal key and a string key).
  installation_inputs=("$evidence_dir/before-installation.yaml" "$evidence_dir/before-live-installation.yaml"
    "$candidate_installation" "$evidence_dir/staged-installation.yaml")
  if [[ -n "$requested_installation" ]]; then
    installation_inputs+=("$evidence_dir/requested-installation.yaml")
  fi
  for installation_input in "${installation_inputs[@]}"; do
    yq -e '[.. | select(tag == "!!map") | keys | .[] | select(tag != "!!str")] | length == 0' \
      "$installation_input" >/dev/null 2>&1 ||
      die "immutable Installation reference switches require string mapping keys in all Installation inputs."
  done
  matches_yaml "$evidence_dir/staged-installation.yaml" "$candidate_installation" ||
    die "the staged immutable Installation Secret must contain the candidate Installation configuration."
  # Bind the checksum to the mounted bytes after validating their configuration.
  cp "$evidence_dir/staged-installation.yaml" "$candidate_installation"
  installation_secret=$candidate_secret
fi
if [[ -f "$evidence_dir/before-candidate-installation-secret.json" ]] ||
  ! matches_yaml "$candidate_installation" "$evidence_dir/before-live-installation.yaml"; then
  if [[ ! -f "$evidence_dir/before-candidate-installation-secret.json" ]]; then
    require_mutable_installation_secret "$live_installation_secret"
    check_installation_update_access
  fi
  touch "$evidence_dir/installation-changed"
  installation_checksum=$(
    python3 -c \
      'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' \
      "$candidate_installation"
  )
  INSTALLATION_CHECKSUM="$installation_checksum" yq -i \
    '.controlPlane.installationChecksum = strenv(INSTALLATION_CHECKSUM)' "$candidate_values"
  printf '%s\n' "$installation_checksum" >"$evidence_dir/installation-checksum"
fi

helm_attempt=$(python3 scripts/upgrade-helm-state.py new "$evidence_dir" "$release" "${helm_args[@]}")
candidate_values="$evidence_dir/helm-attempts/$helm_attempt/values.yaml"
rendered="$evidence_dir/helm-attempts/$helm_attempt/rendered.yaml"
preflight_startup
if [[ -f "$evidence_dir/before-candidate-installation-secret.json" ]]; then
  verify_installation_switch
fi
if ((preflight_only)); then
  printf 'Preflight passed; no OCC writer was stopped. To deploy, omit --preflight-only and use the same reviewed inputs with a fresh evidence directory.\n'
  exit 0
fi
printf '%s\n' "$installation_id" >"$evidence_dir/installation-id"
printf '%s\n' "$installation_secret" >"$evidence_dir/installation-secret-name"
printf '%s\n' "$installation_key" >"$evidence_dir/installation-secret-key"
printf '%s\n' "$selected_controller" >"$evidence_dir/selected-controller"
python3 scripts/upgrade-evidence.py capture "$evidence_dir" ||
  die "cannot bind prepared upgrade evidence."
if [[ -n "$dispatch_journal" ]]; then
  dispatch_state prepare "$targets"
fi
touch "$evidence_dir/prepared"
}

if ((resume == 0)); then
  prepare_upgrade
fi

candidate_values="$evidence_dir/candidate-values.yaml"
candidate_installation="$evidence_dir/candidate-installation.yaml"
python3 scripts/upgrade-evidence.py verify "$evidence_dir" ||
  die "prepared upgrade evidence changed; investigate before continuing."
helm_attempt=$(python3 scripts/upgrade-helm-state.py select "$evidence_dir")
candidate_values="$evidence_dir/helm-attempts/$helm_attempt/values.yaml"
targets="$evidence_dir/targets.jsonl"
dispatch_prefix() {
  printf '%s/dispatch/%s' "$evidence_dir" "$(json_file_name "$1--$2")"
}
read_dispatch_response() {
  jq -cser 'select(length == 1) | .[0] | select(.id | type == "string" and length > 0) | '"$2" "$1"
}
if [[ -n "$dispatch_journal" ]]; then
  dispatch_snapshot=$(dispatch_state snapshot "$targets")
  while IFS= read -r target; do
    [[ -n "$target" ]] || continue
    json_fields "$target" namespace_id=namespaceId agent_id=agentId dispatch_status=state
    prefix=$(dispatch_prefix "$namespace_id" "$agent_id")
    if [[ "$dispatch_status" == pending && ! -f "$prefix.json" ]]; then
      die "Agent $agent_id in Namespace $namespace_id has an unknown deployment outcome. Inspect its revision history and audit records before recording a confirmed response."
    fi
  done <<<"$dispatch_snapshot"
fi
current_controller=$(yq -er '.images.controller' "$evidence_dir/before-values.yaml")
repository_enabled=$(yq -r '.repositoryCredentials.enabled // false' "$candidate_values")
verify_pair_nodes() {
  "${kube[@]}" --request-timeout=15s get nodes --output json >"$evidence_dir/current-nodes.json"
  python3 scripts/upgrade-node-platform.py "$evidence_dir/current-nodes.json" \
    "$evidence_dir/node-selector-values.json" >"$evidence_dir/current-eligible-nodes.json" ||
    die "cannot verify the eligible control-plane nodes."
  cmp -s "$evidence_dir/eligible-nodes.json" "$evidence_dir/current-eligible-nodes.json" ||
    die "the eligible control-plane nodes changed after image qualification."
}
if [[ "$repository_enabled" == true ]]; then
  python3 - "$evidence_dir/pair-proof.json" "$evidence_dir/eligible-nodes.json" "$evidence_dir/node-selector-values.json" \
    "$evidence_dir/parameters.json" <<'PYTHON' || die "the image-pair proof changed; investigate before continuing."
import hashlib, json, sys
with open(sys.argv[4], encoding="utf-8") as f:
    expected = json.load(f)["pairEvidence"]
actual = {path.rsplit("/", 1)[-1]: hashlib.sha256(open(path, "rb").read()).hexdigest() for path in sys.argv[1:4]}
if actual != expected:
    sys.exit(1)
PYTHON
  verify_pair_nodes
  if ((resume)); then
    resume_pair_proof=$(mktemp "$evidence_dir/pair-resume.XXXXXXXX.json")
    qualified_platform=$(jq -er '.platform' "$evidence_dir/eligible-nodes.json")
    node scripts/upgrade-repository-image-probe.mjs "$controller_image" "$broker_image" \
      "$qualified_platform" >"$resume_pair_proof" || die "the selected image pair could not be requalified."
    jq -e --slurpfile original "$evidence_dir/pair-proof.json" \
      '.controller == $original[0].controller and .broker == $original[0].broker' \
      "$resume_pair_proof" >/dev/null || die "the selected image identities changed since preparation."
    verify_pair_nodes
  fi
fi
target_count=$(wc -l <"$targets" | tr -d ' ')
installation_id=$(cat "$evidence_dir/installation-id")
installation_secret=$(cat "$evidence_dir/installation-secret-name")
installation_key=$(cat "$evidence_dir/installation-secret-key")
selected_controller=$(cat "$evidence_dir/selected-controller")
validate_controller_compatibility
if [[ -n "$requested_values" ]]; then
  matches_yaml "$requested_values" "$evidence_dir/requested-values.yaml" || die "reviewed candidate values changed after preparation."
fi
if [[ -n "$requested_installation" ]]; then
  matches_yaml "$requested_installation" "$evidence_dir/requested-installation.yaml" || die "reviewed candidate Installation changed after preparation."
fi

# Read the live state on every attempt before deciding whether a mutation is
# needed. An accepted write whose response was lost must not be repeated.
helm status "$release" "${helm_args[@]}" --output json >"$evidence_dir/current-helm-status.json"
helm_state=$(jq -er '.info.status' "$evidence_dir/current-helm-status.json")
case "$helm_state" in
  deployed | failed) ;;
  pending-upgrade) ((recover_helm)) || die "Helm reports pending-upgrade; reconcile the interrupted client before recovery." ;;
  *) die "Helm reports $helm_state; resolve the in-progress or unknown release before resuming." ;;
esac
if [[ ! -f "$evidence_dir/helm-started" && "$helm_state" != deployed ]]; then
  die "the Helm release changed before this upgrade started; investigate before continuing."
fi
helm get values "$release" "${helm_args[@]}" --output yaml >"$evidence_dir/current-live-values.yaml"
matches_yaml "$values" "$evidence_dir/before-values.yaml" ||
  matches_yaml "$values" "$candidate_values" || die "protected Helm values changed outside this upgrade."
matches_yaml "$installation" "$evidence_dir/before-installation.yaml" ||
  matches_yaml "$installation" "$candidate_installation" || die "protected Installation changed outside this upgrade."
matches_yaml "$evidence_dir/current-live-values.yaml" "$evidence_dir/before-live-values.yaml" ||
  matches_yaml "$evidence_dir/current-live-values.yaml" "$candidate_values" ||
  { [[ -f "$evidence_dir/helm-started" ]] && python3 scripts/upgrade-helm-state.py predecessor "$evidence_dir"; } ||
  die "live Helm values changed outside this upgrade."

live_secret="$evidence_dir/current-live-installation-secret.json"
if [[ -f "$evidence_dir/before-candidate-installation-secret.json" ]]; then
  verify_installation_switch
else
  "${kube[@]}" --namespace "$namespace" get secret "$installation_secret" --output json >"$live_secret"
  jq -e --arg id "$installation_id" --slurpfile before "$evidence_dir/before-live-installation-secret.json" '
    .metadata.uid == $before[0].metadata.uid and
    .metadata.annotations["openclaw.dev/installation-id"] == $id and
    (.data | del(.[$key])) == ($before[0].data | del(.[$key]))
  ' --arg key "$installation_key" "$live_secret" >/dev/null || die "the Installation Secret identity or unrelated data changed."
fi
jq -er --arg key "$installation_key" '.data[$key]' "$live_secret" |
  python3 -c 'import base64,sys; sys.stdout.buffer.write(base64.b64decode(sys.stdin.buffer.read().strip(), validate=True))' \
    >"$evidence_dir/current-live-installation.yaml"
matches_yaml "$evidence_dir/current-live-installation.yaml" "$evidence_dir/before-live-installation.yaml" ||
  matches_yaml "$evidence_dir/current-live-installation.yaml" "$candidate_installation" ||
  die "the live Installation Secret changed outside this upgrade."

if [[ ! -f "$evidence_dir/helm-started" ]]; then
  jq -e --slurpfile before "$evidence_dir/before-helm-status.json" \
    '.version == $before[0].version' "$evidence_dir/current-helm-status.json" >/dev/null ||
    die "the Helm release revision changed before this upgrade started."
fi

helm_complete=0
recovered_revision=
if [[ -e "$evidence_dir/helm-recovery" || -L "$evidence_dir/helm-recovery" ]]; then
  recovered_revision=$(python3 scripts/upgrade-helm-state.py verify-recovery "$evidence_dir" "$release" "$kubeconfig" "$context" "$namespace") ||
    die "Helm recovery is unresolved; preserve its evidence and reconcile manually. Do not replay recovery."
  helm_complete=1
elif ((recover_helm)); then
  matches_yaml "$evidence_dir/current-live-installation.yaml" "$candidate_installation" ||
    die "Helm recovery requires the exact candidate Installation."
  python3 scripts/upgrade-helm-state.py recover "$evidence_dir" "$release" "$kubeconfig" "$context" "$namespace" ||
    die "Helm recovery did not complete; preserve its evidence and reconcile before further action."
  recovered_revision=$(python3 scripts/upgrade-helm-state.py verify-recovery "$evidence_dir" "$release" "$kubeconfig" "$context" "$namespace")
  helm_complete=1
fi
if [[ -f "$evidence_dir/helm-started" ]] && ((helm_complete == 0)); then
  jq -es '
    length == 1 and (.[0] |
    (.previousRevision | type == "number" and . > 0 and floor == .) and
    (.expectedRevision | type == "number" and . > 0 and floor == .) and
    .expectedRevision == .previousRevision + 1 and
    .expectedRevision > .previousRevision)
  ' "$evidence_dir/helm-started" >/dev/null ||
    die "the Helm submission intent is missing or invalid; reconcile the release before continuing."
  jq -e --slurpfile submission "$evidence_dir/helm-started" '
    .version == $submission[0].previousRevision or .version == $submission[0].expectedRevision
  ' "$evidence_dir/current-helm-status.json" >/dev/null ||
    die "the Helm release revision is outside this submission; investigate before continuing."
  if [[ "$helm_state" == deployed ]] &&
    jq -e --slurpfile submission "$evidence_dir/helm-started" \
      '.version == $submission[0].expectedRevision' "$evidence_dir/current-helm-status.json" >/dev/null; then
    matches_yaml "$evidence_dir/current-live-values.yaml" "$candidate_values" ||
      die "the expected deployed Helm revision does not match the candidate values; investigate before continuing."
    helm_complete=1
  fi
fi
if ((helm_complete)) && ! matches_yaml "$evidence_dir/current-live-installation.yaml" "$candidate_installation"; then
  die "Helm selected the candidate but the live Installation Secret does not; investigate before continuing."
fi
if [[ -f "$evidence_dir/helm-started" ]] && ((helm_complete == 0)); then
  ((migration_history_checked)) || die "Helm's outcome is unresolved. Inspect the release and initialization Job, run the candidate migration --check against the retained database, then resume with --migration-history-checked."
  # A Job with no running Pods can still create a new Pod. Require both the
  # Job and its Pods to be terminal before another migration may start.
  "${kube[@]}" --request-timeout=15s --namespace "$namespace" get jobs \
    --selector "app.kubernetes.io/instance=$release,app.kubernetes.io/component=initialization" \
    --output json >"$evidence_dir/current-initialization-jobs.json"
  jq -e 'all(.items[]; any(.status.conditions[]?; (.type == "Complete" or .type == "Failed") and .status == "True"))' \
    "$evidence_dir/current-initialization-jobs.json" >/dev/null || die "an initialization Job is still active; wait for it to finish before retrying Helm."
  "${kube[@]}" --request-timeout=15s --namespace "$namespace" get pods \
    --selector "app.kubernetes.io/instance=$release,app.kubernetes.io/component=initialization" \
    --output json >"$evidence_dir/current-initialization-pods.json"
  jq -e 'all(.items[]; .status.phase == "Succeeded" or .status.phase == "Failed")' \
    "$evidence_dir/current-initialization-pods.json" >/dev/null || die "an initialization Pod is still active; wait for it to terminate before retrying Helm."
fi

if ((helm_complete == 0)); then
  replace_installation_secret=0
  if [[ -f "$evidence_dir/installation-changed" ]] &&
    ! matches_yaml "$evidence_dir/current-live-installation.yaml" "$candidate_installation"; then
    require_mutable_installation_secret "$live_secret"
    replace_installation_secret=1
  fi
  if [[ -f "$evidence_dir/helm-started" ]]; then
    # Every submitted retry has a fresh hook identity; retain earlier attempts.
    helm_attempt=$(python3 scripts/upgrade-helm-state.py new "$evidence_dir" "$release" "${helm_args[@]}")
    candidate_values="$evidence_dir/helm-attempts/$helm_attempt/values.yaml"
  fi
  if [[ "$repository_enabled" == true ]]; then
    verify_pair_nodes
  fi
  # Stop the old database writers before the migration hook. Other writers and
  # autoscalers must already be stopped by the operator's maintenance window.
  deadline=$((SECONDS + timeout_seconds))
  quiescence_remaining() {
    remaining_seconds=$((deadline - SECONDS))
    ((remaining_seconds > 0)) || die "OCC quiescence timed out; migration was not started."
  }
  upgrade_migration=$(yq -er '.database.upgradeMigration // "hook"' "$candidate_values")
  handoff="$evidence_dir/database-migration-handoff.json"
  separate_handoff=0
  if [[ "$upgrade_migration" == separate && ! -f "$evidence_dir/helm-started" ]]; then
    separate_handoff=1
    if [[ -e "$handoff" || -L "$handoff" ]]; then
      require_private_file "$handoff"
    fi
  fi
  # Validate both writers before stopping either one.
  for component in api worker; do
    deployment="openclaw-enterprise-$component"
    quiescence_remaining
    "${kube[@]}" --request-timeout="${remaining_seconds}s" --namespace "$namespace" get "deployment/$deployment" --output json \
      >"$evidence_dir/current-$component-deployment.json"
    jq -e --arg release "$release" --arg component "$component" '
      .metadata.labels["app.kubernetes.io/instance"] == $release and
      .metadata.labels["app.kubernetes.io/component"] == $component and
      (.metadata.uid | type == "string" and length > 0) and
      (.metadata.resourceVersion | type == "string" and length > 0) and
      .metadata.deletionTimestamp == null and
      (.spec.replicas == 0 or .spec.replicas == 1)
    ' "$evidence_dir/current-$component-deployment.json" >/dev/null || die "$deployment has unexpected ownership or replicas."
    if ((separate_handoff)) && [[ -f "$handoff" ]]; then
      jq -e --arg component "$component" --slurpfile handoff "$handoff" '
        .spec.replicas == 0 and (.metadata | {uid, generation}) == $handoff[0][$component]
      ' "$evidence_dir/current-$component-deployment.json" >/dev/null ||
        die "The $component Deployment changed during the separate database deployment. Preserve the database and reconcile the writer before resuming."
    fi
    # Test and scale atomically: a replacement or concurrent edit must not be stopped.
    jq '[
      {op: "test", path: "/metadata/uid", value: .metadata.uid},
      {op: "test", path: "/metadata/resourceVersion", value: .metadata.resourceVersion},
      {op: "test", path: "/spec/replicas", value: .spec.replicas},
      {op: "replace", path: "/spec/replicas", value: 0}
    ]' "$evidence_dir/current-$component-deployment.json" >"$evidence_dir/quiescence-$component-patch.json"
  done
  # These writes are sequential; a later conflict can leave the API stopped.
  for component in api worker; do
    deployment="openclaw-enterprise-$component"
    quiescence_remaining
    "${kube[@]}" --request-timeout="${remaining_seconds}s" --namespace "$namespace" patch "deployment/$deployment" \
      --type json --patch-file "$evidence_dir/quiescence-$component-patch.json" ||
      native_command_failed "$?" quiescence-scale "$component"
  done
  while true; do
    quiescence_remaining
    "${kube[@]}" --request-timeout="${remaining_seconds}s" --namespace "$namespace" get pods \
      --selector "app.kubernetes.io/name=openclaw-enterprise,app.kubernetes.io/instance=$release" \
      --output json >"$evidence_dir/quiescence-pods.json"
    if jq -e '[.items[] | select(.metadata.labels["app.kubernetes.io/component"] == "api" or .metadata.labels["app.kubernetes.io/component"] == "worker")] | length == 0' \
      "$evidence_dir/quiescence-pods.json" >/dev/null; then
      break
    fi
    ((SECONDS < deadline)) || die "OCC Pods did not terminate before the timeout; migration was not started."
    sleep 2
  done
  for component in api worker; do
    quiescence_remaining
    "${kube[@]}" --request-timeout="${remaining_seconds}s" --namespace "$namespace" get "deployment/openclaw-enterprise-$component" --output json \
      >"$evidence_dir/quiescence-$component-deployment.json"
    jq -e --slurpfile observed "$evidence_dir/current-$component-deployment.json" '
      .metadata.uid == $observed[0].metadata.uid and
      .metadata.deletionTimestamp == null and .spec.replicas == 0
    ' "$evidence_dir/quiescence-$component-deployment.json" >/dev/null ||
      die "OCC identity or replicas changed during quiescence; migration was not started."
  done

  if ((separate_handoff)) && { [[ ! -f "$handoff" ]] || ((migration_history_checked == 0)); }; then
    if [[ ! -f "$handoff" ]]; then
      staged_handoff=$(mktemp "$evidence_dir/database-migration-handoff.XXXXXXXX")
      jq -nes --slurpfile api "$evidence_dir/quiescence-api-deployment.json" \
        --slurpfile worker "$evidence_dir/quiescence-worker-deployment.json" '
        {api: $api[0].metadata, worker: $worker[0].metadata} |
        with_entries(.value |= {uid, generation}) | select(all(.[]; (.generation | type) == "number"))
      ' >"$staged_handoff" || die "Cannot record the stopped Deployment generations."
      mv "$staged_handoff" "$handoff"
    fi
    die "API and worker stopped for the separate database deployment. Keep other writers and autoscalers fenced. Run node scripts/migrate-production.mjs in the selected controller image against this Installation with the dedicated migrator credential. Confirm --require-current succeeds, then use --resume --migration-history-checked with this evidence directory. The Helm hook independently requires the complete candidate schema." 3
  fi

  install_atomically "$candidate_values" "$values"
  if [[ -f "$evidence_dir/installation-changed" ]]; then
    install_atomically "$candidate_installation" "$installation"
    if ((replace_installation_secret)); then
      python3 - "$live_secret" "$candidate_installation" "$installation_key" <<'PYTHON' |
import base64, json, sys
with open(sys.argv[1]) as f:
    secret = json.load(f)
with open(sys.argv[2], "rb") as f:
    secret["data"][sys.argv[3]] = base64.b64encode(f.read()).decode()
secret["metadata"].pop("managedFields", None)
json.dump(secret, sys.stdout)
PYTHON
        "${kube[@]}" --namespace "$namespace" replace --filename - \
          >"$evidence_dir/installation-secret-apply.txt"
    fi
  fi
  # The marker precedes the request, so a crash cannot turn an unknown Helm
  # outcome into an automatic retry or an unsafe return to the old image.
  if [[ "$repository_enabled" == true ]]; then
    verify_pair_nodes
  fi
  helm status "$release" "${helm_args[@]}" --output json >"$evidence_dir/before-helm-submission.json"
  jq -e --slurpfile observed "$evidence_dir/current-helm-status.json" '
    . == $observed[0]
  ' "$evidence_dir/before-helm-submission.json" >/dev/null ||
    die "the Helm release changed before submission; investigate before continuing."
  if [[ -f "$evidence_dir/before-candidate-installation-secret.json" ]]; then
    verify_installation_switch
  fi
  python3 scripts/upgrade-helm-state.py record "$evidence_dir" "$helm_attempt"
  # Open stdout before entering the native failure handler.
  {
    helm upgrade --install "$release" "$chart" "${helm_args[@]}" \
      --values "$values" --wait --timeout 5m ||
      native_command_failed "$?" helm-upgrade release
  } >"$evidence_dir/helm-attempts/$helm_attempt/helm-upgrade.txt"
fi

for component in api worker; do
  deployment="openclaw-enterprise-$component"
  "${kube[@]}" --namespace "$namespace" rollout status "deployment/$deployment" --timeout=180s ||
    native_command_failed "$?" rollout-status "$component"
  "${kube[@]}" --namespace "$namespace" get "deployment/$deployment" --output json \
    >"$evidence_dir/after-$component-deployment.json"
  # The broker-enabled worker may be an ordinary container on the existing
  # chart or a restartable init container on charts with broker drain recovery.
  jq -e --arg component "$component" --arg image "$selected_controller" \
    --arg repositoryEnabled "$repository_enabled" '
      .spec.template.spec as $pod |
      [$pod.containers[]? | select(.name == $component)] as $containers |
      [$pod.initContainers[]? | select(.name == $component)] as $initContainers |
      (($containers | length) + ($initContainers | length)) == 1 and
      (if ($containers | length) == 1 then
        $containers[0].image == $image
      else
        $component == "worker" and $repositoryEnabled == "true" and
        $initContainers[0].restartPolicy == "Always" and $initContainers[0].image == $image
      end)
    ' "$evidence_dir/after-$component-deployment.json" >/dev/null ||
    die "$deployment must contain exactly one $component with the selected controller image in a valid container placement."
  jq -e '.spec.replicas == 1' "$evidence_dir/after-$component-deployment.json" >/dev/null ||
    die "$deployment does not have its expected replica."
  if [[ -f "$evidence_dir/before-candidate-installation-secret.json" ]]; then
    "${kube[@]}" --namespace "$namespace" get pods \
      --selector "app.kubernetes.io/name=openclaw-enterprise,app.kubernetes.io/instance=$release,app.kubernetes.io/component=$component" \
      --output json >"$evidence_dir/after-$component-installation-pods.json"
  fi
  if [[ -f "$evidence_dir/installation-changed" ]]; then
    installation_checksum=$(cat "$evidence_dir/installation-checksum")
    jq -e --arg checksum "$installation_checksum" \
      '.spec.template.metadata.annotations["openclaw.dev/installation-checksum"] == $checksum' \
      "$evidence_dir/after-$component-deployment.json" >/dev/null ||
      die "$deployment does not select the candidate Installation checksum."
  fi
done

if [[ -f "$evidence_dir/before-candidate-installation-secret.json" ]]; then
  python3 scripts/upgrade-helm-state.py verify-installation "$evidence_dir" "$release" "$kubeconfig" "$context" "$namespace" ||
    die "the deployed Installation consumers do not match the staged reference."
  verify_installation_switch
fi

if [[ "$repository_enabled" == true ]]; then
  # Check the exact ready Pods, their controlling ReplicaSets, and the selected
  # image identities before asking the deployed Driver to query its broker.
  verify_deployed_pair() {
    local phase=$1
    for component in api worker; do
      "${kube[@]}" --request-timeout=15s --namespace "$namespace" get "deployment/openclaw-enterprise-$component" --output json \
        >"$evidence_dir/$phase-$component-deployment.json"
      "${kube[@]}" --request-timeout=15s --namespace "$namespace" get replicasets \
        --selector "app.kubernetes.io/name=openclaw-enterprise,app.kubernetes.io/instance=$release,app.kubernetes.io/component=$component" \
        --output json >"$evidence_dir/$phase-$component-replicasets.json"
      "${kube[@]}" --request-timeout=15s --namespace "$namespace" get pods \
        --selector "app.kubernetes.io/name=openclaw-enterprise,app.kubernetes.io/instance=$release,app.kubernetes.io/component=$component" \
        --output json >"$evidence_dir/$phase-$component-pods.json"
      python3 scripts/upgrade-deployment-identity.py "$component" \
        "$evidence_dir/$phase-$component-deployment.json" "$evidence_dir/$phase-$component-replicasets.json" \
        "$evidence_dir/$phase-$component-pods.json" "$evidence_dir/eligible-nodes.json" \
        "$evidence_dir/pair-proof.json" "$release" >"$evidence_dir/$phase-$component-identity.json" ||
        die "the deployed $component identity does not match the qualified image pair."
    done
  }
  verify_pair_nodes
  verify_deployed_pair capability-before
  capability_pod=$(jq -er '.podName' "$evidence_dir/capability-before-worker-identity.json")
  capability_code=$(cat <<'JAVASCRIPT'
import { GitHubNativeRepositorySender } from "/app/apps/controller/src/drivers/repo/github/driver.ts";
import { UnixRepositoryCredentialControlClient } from "/app/apps/controller/src/backends/repository-credentials/control-client.ts";
const id = "compatibility-probe";
const client = new UnixRepositoryCredentialControlClient({ controlSocket: "/run/openclaw/repository-control/private/control.sock" });
const driver = new GitHubNativeRepositorySender({ id, drivers: { repo: id }, client }, {});
if (typeof driver.checkAdmissionReady !== "function") throw new Error("capability check unavailable");
await driver.checkAdmissionReady(AbortSignal.timeout(5000));
process.stdout.write("repository-admission-ready\n");
JAVASCRIPT
)
  "${kube[@]}" --request-timeout=15s --namespace "$namespace" exec "$capability_pod" -c worker -- \
    node --input-type=module -e "$capability_code" >"$evidence_dir/deployed-capability.txt" ||
    die "the deployed controller cannot verify repository admission capability."
  [[ "$(cat "$evidence_dir/deployed-capability.txt")" == repository-admission-ready ]] ||
    die "the deployed controller returned an unexpected capability result."
  verify_pair_nodes
  verify_deployed_pair capability-after
  for component in api worker; do
    cmp -s "$evidence_dir/capability-before-$component-identity.json" \
      "$evidence_dir/capability-after-$component-identity.json" ||
      die "the deployed $component changed while checking repository capability."
  done
fi

deadline=$((SECONDS + timeout_seconds))
until "${occ_json[@]}" installation get >"$evidence_dir/installation-after.json" 2>"$evidence_dir/occ-recovery-error.txt"; do
  ((SECONDS < deadline)) || die "OCC authentication did not recover before the timeout."
  sleep 2
done
jq -e --arg id "$installation_id" '.id == $id' "$evidence_dir/installation-after.json" >/dev/null ||
  die "the recovered OCC endpoint identifies a different Installation."
rm -f "$evidence_dir/occ-recovery-error.txt"

if [[ "$repository_enabled" == true ]]; then
  verify_pair_nodes
  verify_deployed_pair before-dispatch
  for component in api worker; do
    cmp -s "$evidence_dir/capability-after-$component-identity.json" \
      "$evidence_dir/before-dispatch-$component-identity.json" ||
      die "the deployed $component changed after the repository capability check."
  done
fi

if [[ -n "$runtime_image" ]] && ((target_count > 0)); then
  confirmed_deployment_status() {
    local namespace_id=$1 agent_id=$2 revision=$3
    "${occ_json[@]}" --namespace "$namespace_id" agent deployment-status "$agent_id" "$revision" </dev/null |
      jq -ser --arg namespace "$namespace_id" --arg agent "$agent_id" --arg revision "$revision" '
        select(length == 1) | .[0] |
        select(.namespaceId == $namespace and .agentId == $agent and .deploymentId == $revision) |
        .status | select(. == "queued" or . == "running" or . == "succeeded" or . == "failed")'
  }

  # Reconcile every existing attempt before starting any additional sends.
  ready=()
  while IFS= read -r target; do
    json_fields "$target" namespace_id=namespaceId agent_id=agentId dispatch_status=state recorded_revision=deploymentId baseline_revision=baselineRevisionId
    prefix=$(dispatch_prefix "$namespace_id" "$agent_id")
    if [[ -e "$prefix.json" || -L "$prefix.json" ]]; then
      require_private_file "$prefix.json"
      receipt=$(read_dispatch_response "$prefix.json" '.') ||
        die "invalid recorded deployment response for Agent $agent_id; inspect it before resuming."
      revision=$(jq -er '.id' <<<"$receipt")
      if [[ "$dispatch_status" == pending ]]; then
        [[ "$revision" != "$baseline_revision" ]] &&
          jq -e 'has("replacesDeploymentId") | not' <<<"$receipt" >/dev/null &&
          confirmed_deployment_status "$namespace_id" "$agent_id" "$revision" >/dev/null ||
          die "Agent $agent_id has an unknown deployment outcome. Confirm the exact recorded deployment before resuming."
        dispatch_state accept "$targets" "$namespace_id" "$agent_id" "$revision"
      elif [[ "$dispatch_status" == accepted && "$recorded_revision" != "$revision" ]]; then
        if jq -e --arg revision "$revision" '.acceptedDeploymentIds | index($revision) != null' <<<"$target" >/dev/null; then
          # Restored evidence can contain a superseded receipt. Keep its bytes
          # for diagnosis and continue with the current journaled deployment.
          warn "recorded response for Agent $agent_id is superseded; using journaled deployment $recorded_revision."
          continue
        fi
        jq -e --arg current "$recorded_revision" '.replacesDeploymentId == $current' <<<"$receipt" >/dev/null ||
          die "replacement for Agent $agent_id must name the current journaled revision $recorded_revision. Preserve the response and inspect revision history and audit records before recording a replacement."
        [[ "$revision" != "$baseline_revision" ]] ||
          die "the baseline revision cannot replace journaled deployment $recorded_revision for Agent $agent_id."
        recorded_status=$(confirmed_deployment_status "$namespace_id" "$agent_id" "$recorded_revision") &&
          [[ "$recorded_status" == failed ]] &&
          confirmed_deployment_status "$namespace_id" "$agent_id" "$revision" >/dev/null ||
          die "cannot confirm the failed deployment and its recorded replacement for Agent $agent_id. Preserve the response and inspect both deployment statuses before resuming."
        dispatch_state replace "$targets" "$namespace_id" "$agent_id" "$recorded_revision" "$revision"
      elif [[ "$dispatch_status" != accepted ]]; then
        die "recorded deployment response for Agent $agent_id conflicts with the dispatch journal."
      fi
    elif [[ "$dispatch_status" == accepted ]]; then
      # The durable acknowledgement can outlive a backup of the evidence.
      response=$(mktemp "$prefix.XXXXXXXX.tmp")
      jq -n --arg id "$recorded_revision" '{id: $id}' >"$response"
      mv "$response" "$prefix.json"
    elif [[ "$dispatch_status" == pending ]]; then
      die "Agent $agent_id has an unknown deployment outcome. Inspect its revision history and audit records."
    else
      ready+=("$target")
    fi
  done <<<"$dispatch_snapshot"

  pids=()
  attempts=()
  for target in "${ready[@]}"; do
    json_fields "$target" namespace_id=namespaceId agent_id=agentId baseline_revision=baselineRevisionId
    prefix=$(dispatch_prefix "$namespace_id" "$agent_id")
    attempt=$(mktemp -d "$evidence_dir/dispatch/.attempt.XXXXXXXX")
    attempts+=("$attempt")
    touch "$prefix.intent"
    # Once this record is durable, interruption at any point is an unknown
    # outcome until we have an acknowledgement or a definite refusal.
    dispatch_state send "$targets" "$namespace_id" "$agent_id"
    "${occ_json[@]}" --namespace "$namespace_id" agent deploy "$agent_id" --retain-harness-overrides "$baseline_revision" </dev/null \
      >"$attempt/response" 2>"$attempt/error" &
    pids+=("$!")
  done

  refused=()
  key_refused=()
  unknown=()
  for index in "${!pids[@]}"; do
    json_fields "${ready[index]}" namespace_id=namespaceId agent_id=agentId
    prefix=$(dispatch_prefix "$namespace_id" "$agent_id")
    attempt=${attempts[index]}
    status=0
    wait "${pids[index]}" || status=$?
    if ((status == 0)) && revision=$(read_dispatch_response "$attempt/response" '.id'); then
      dispatch_state accept "$targets" "$namespace_id" "$agent_id" "$revision"
      mv "$attempt/error" "$prefix.error"
      mv "$attempt/response" "$prefix.json"
      rmdir "$attempt"
      continue
    fi

    refusal=
    if ((status != 0)) && refusal=$(deploy_refusal "$attempt/error"); then
      # Classify only the stderr from this native call. A stale refusal in the
      # evidence directory cannot change a pending journal entry.
      dispatch_state refuse "$targets" "$namespace_id" "$agent_id"
      printf '%s\n' "$refusal" >>"$prefix.rejected"
      rm -f "$prefix.intent" "$prefix.json.tmp" "$attempt/response"
    else
      mv "$attempt/response" "$prefix.json.tmp"
    fi
    mv "$attempt/error" "$prefix.error"
    rmdir "$attempt"
    agent_name=$(occ_name --namespace "$namespace_id" agent get "$agent_id") || agent_name=
    agent="Agent $agent_id ${agent_name:-(name unavailable)} in Namespace $namespace_id"
    if [[ -z "$refusal" ]]; then
      unknown+=("  - $agent")
    elif [[ "$refusal" == "OCC rejected the service key "* ]]; then
      key_refused+=("  - $agent")
    else
      refused+=("  - $agent: $refusal")
    fi
  done
  if ((${#key_refused[@]})); then
    warn "OCC rejected the service key in $OCC_SERVICE_KEY_FILE, so it did not deploy ${#key_refused[@]} recorded Agent(s) and saved no revision for them:
$(printf '%s\n' "${key_refused[@]}")
The key is invalid, expired or revoked; the Agents are not at fault. Ask an Installation administrator for a new key, point OCC_SERVICE_KEY_FILE at it, then repeat this command with --resume and the same evidence directory. The resume deploys these Agents once."
  fi
  if ((${#refused[@]})); then
    warn "OCC refused to deploy ${#refused[@]} recorded Agent(s) with the new release and saved no revision for them:
$(printf '%s\n' "${refused[@]}")
Correct what each refusal names, such as a Configuration setting the new release refuses, then repeat this command with --resume and the same evidence directory. The resume deploys each refused Agent once; do not deploy it yourself. The refusals are in dispatch/*.rejected."
  fi
  ((${#unknown[@]} == 0)) || die "at least one Agent deployment outcome is unknown; inspect $evidence_dir/dispatch and reconcile it before resuming:
$(printf '%s\n' "${unknown[@]}")"
  if ((${#key_refused[@]} || ${#refused[@]})); then
    exit 1
  fi
fi

deployments="$evidence_dir/deployments.jsonl"
if [[ -n "$dispatch_journal" ]]; then
  dispatch_state deployments "$targets" >"$deployments"
else
  : >"$deployments"
fi

pending=$target_count
while ((pending > 0)); do
  ((SECONDS < deadline)) || die "$pending Agent deployments remained incomplete at the upgrade timeout."
  pending=0
  failed=0
  while IFS= read -r deployment; do
    json_fields "$deployment" namespace_id=namespaceId agent_id=agentId deployment_id=deploymentId
    status_file="$evidence_dir/status/$(json_file_name "$namespace_id--$agent_id--$deployment_id").json"
    "${occ_json[@]}" --namespace "$namespace_id" agent deployment-status "$agent_id" "$deployment_id" \
      >"$status_file"
    status=$(jq -er '.status' "$status_file")
    case "$status" in
      queued | running) ((pending += 1)) ;;
      succeeded) ;;
      failed) failed=1 ;;
      *) die "deployment $deployment_id returned unknown status $status." ;;
    esac
  done <"$deployments"
  ((failed == 0)) || die "at least one Agent deployment failed; inspect $evidence_dir/status."
  ((pending == 0)) || sleep 2
done

doctor_targets="$evidence_dir/doctor-targets.jsonl"
: >"$doctor_targets"
while IFS= read -r deployment; do
  json_fields "$deployment" namespace_id=namespaceId agent_id=agentId \
    execution_mode=executionMode deployment_id=deploymentId
  case "$execution_mode" in
    embedded) expected_runtime_count=1 ;;
    dedicated) expected_runtime_count=2 ;;
    *) die "Agent $agent_id returned unsupported execution mode $execution_mode." ;;
  esac
  selected=$("${occ_json[@]}" --namespace "$namespace_id" agent get "$agent_id" | jq -er '.activeRevisionId')
  [[ "$selected" == "$deployment_id" ]] ||
    die "Agent $agent_id selected $selected instead of deployment $deployment_id."
  pods="$evidence_dir/status/$(json_file_name "$namespace_id--$agent_id--$deployment_id").pods.json"
  live_pods="${pods%.json}.live.json"
  while true; do
    remaining_seconds=$((deadline - SECONDS))
    ((remaining_seconds > 0)) ||
      die "Agent $agent_id revision Pods did not become ready before the upgrade timeout."
    "${kube[@]}" --request-timeout="${remaining_seconds}s" get pods --all-namespaces \
      --selector "openclaw.dev/revision=$deployment_id" \
      --output json >"$pods"
    # A Pod that ended (phase Succeeded or Failed, such as an evicted gateway) no
    # longer serves, and its controller starts a replacement. Kubernetes keeps ended
    # Pods until garbage collection, so this wait, also on --resume, ignores them.
    jq '.items |= map(select(.status.phase != "Succeeded" and .status.phase != "Failed"))' \
      "$pods" >"$live_pods"
    runtime_count=$(jq '[.items[].spec.containers[] | select(.name == "gateway" or .name == "agent")] | length' "$live_pods")
    if ((runtime_count == expected_runtime_count)); then
      jq -e --arg image "$runtime_image" '
        all(.items[].spec.containers[] | select(.name == "gateway" or .name == "agent"); .image == $image)
      ' "$live_pods" >/dev/null ||
        die "Agent $agent_id exposes revision Pods on an unexpected runtime image."
      if jq -e '
        (.items | length) > 0 and
        all(.items[];
          .status.phase == "Running" and
          any(.status.conditions[]?; .type == "Ready" and .status == "True")
        )
      ' "$live_pods" >/dev/null; then
        break
      fi
    fi
    ((SECONDS < deadline)) ||
      die "Agent $agent_id revision Pods did not become ready before the upgrade timeout."
    sleep 2
  done

  if ! gateway=$(
    jq -er '
      [
        .items[] |
        select(any(.spec.containers[]; .name == "gateway")) |
        {namespace: .metadata.namespace, name: .metadata.name,
          uid: .metadata.uid,
          restarts: ([.status.containerStatuses[]? | select(.name == "gateway")] |
            if length == 1 then .[0].restartCount else null end)}
      ] |
      if length == 1 then .[0] else error("expected exactly one gateway Pod") end
    ' "$live_pods"
  ); then
    die "Agent $agent_id revision does not expose exactly one gateway Pod."
  fi
  gateway_namespace=$(jq -er '.namespace' <<<"$gateway")
  gateway_name=$(jq -er '.name' <<<"$gateway")
  # The ready gateway container's restart count: a Doctor failure reports only
  # restarts after this point.
  gateway_restarts=$(jq -c '.restarts' <<<"$gateway")
  # Every live revision Pod the wait above required Ready, such as a dedicated Agent's
  # gateway and Codex agent Pods, with the restart count of its gateway and agent
  # containers (of all its containers when it has neither). The check after the last
  # Doctor reads each of them again (finding 2755).
  revision_pods=$(
    jq -c '
      [
        .items[] |
        ([.spec.containers[].name] as $names |
          if any($names[]; . == "gateway") then "gateway"
          elif any($names[]; . == "agent") then "agent"
          else "revision" end) as $role |
        {role: $role, namespace: .metadata.namespace, name: .metadata.name, uid: .metadata.uid,
          restarts: ([.status.containerStatuses[]? | select($role == "revision" or .name == "gateway" or .name == "agent") |
            .restartCount] |
            if length > 0 and all(.[]; type == "number") then add else null end)}
      ]
    ' "$live_pods"
  )
  jq -cn --arg namespaceId "$namespace_id" --arg agentId "$agent_id" \
    --arg deploymentId "$deployment_id" --arg gatewayNamespace "$gateway_namespace" \
    --arg gatewayName "$gateway_name" --argjson gatewayRestarts "$gateway_restarts" \
    --argjson gatewayUid "$(jq '.uid' <<<"$gateway")" --argjson revisionPods "$revision_pods" \
    '{namespaceId: $namespaceId, agentId: $agentId, deploymentId: $deploymentId,
      gatewayNamespace: $gatewayNamespace, gatewayName: $gatewayName,
      gatewayRestarts: $gatewayRestarts, gatewayUid: $gatewayUid, revisionPods: $revisionPods}' \
    >>"$doctor_targets"
done <"$deployments"

# Doctor runs in the serving gateway container and shares its memory limit. An
# out-of-memory kill there can stop the gateway too. The headroom check reduces
# that risk but does not reserve memory (finding 2697).
# With a dedicated Agent's configuration, Doctor used
# under 256 MiB of heap and needed 320 to 384 MiB in all. Cap its heap
# (--doctor-heap-mib, default 384). Node also uses about 100 MiB outside the
# heap (code, buffers, thread stacks), so a Doctor at its cap needs about
# heap + 100 MiB: start it once two reads in a row leave heap + 256 MiB free
# below the container's limit (128 MiB off-heap allowance and 128 MiB for the
# gateway's own growth), or one read leaves heap + 640 MiB (1 GiB by default).
doctor_memory_mib=$((doctor_heap_mib + 256))
doctor_ample_mib=$((doctor_heap_mib + 640))

# kubectl reports a dropped API server or kubelet connection on stderr; a read that
# ran and failed ends with "command terminated with exit code N" and is not retried.
transient_kubectl_failure='^error: EOF$|"https?://[^" ]+": EOF$|Unable to connect to the server|error dialing backend|websocket: close|unexpected EOF|connection reset by peer|connection refused|http2: client connection lost|TLS handshake timeout|i/o timeout|context deadline exceeded|the server is currently unable to handle the request|etcdserver: request timed out'

# Prints the gateway container's free memory below its cgroup v2 limit in MiB,
# or "unlimited". Inactive file cache counts as free, as in the kubelet's
# working set. Fails when the container's cgroup files cannot be read, and
# returns 2 without a read once the deadline has passed.
gateway_free_memory() {
  local gateway_namespace=$1 gateway_name=$2 output=$3 free attempt remaining
  local LC_ALL=C
  : >"$output.retry"
  # A network or API timeout is retried twice (reads change nothing); any other
  # failure, such as missing cgroup v2 files, falls back at once.
  for attempt in 1 2 3; do
    remaining=$((deadline - SECONDS))
    ((remaining > 0)) || return 2
    ((remaining <= 15)) || remaining=15
    "${kube[@]}" --request-timeout="${remaining}s" --namespace "$gateway_namespace" exec "$gateway_name" \
      --container gateway -- cat /sys/fs/cgroup/memory.max /sys/fs/cgroup/memory.current \
      /sys/fs/cgroup/memory.stat </dev/null >"$output" 2>"$output.error" && break
    if ((attempt == 3 || SECONDS >= deadline)) ||
      grep -q 'command terminated with exit code' "$output.error" ||
      ! grep -Eq "$transient_kubectl_failure" "$output.error"; then
      return 1
    fi
    printf 'retry\n' >"$output.retry"
    sleep 2
  done
  free=$(python3 - "$output" <<'PYTHON'
import sys
lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
limit = lines[0].strip()
current = int(lines[1])
stat = dict(line.split(" ", 1) for line in lines[2:] if " " in line)
working = current - int(stat.get("inactive_file", "0"))
print("unlimited" if limit == "max" else max(0, (int(limit) - working) // 1048576))
PYTHON
  ) || return 1
  # The value reaches shell arithmetic; accept only what the parser prints.
  [[ "$free" =~ ^(0|[1-9][0-9]*|unlimited)$ ]] || return 1
  printf '%s\n' "$free"
}

# Reports one failed Doctor command from its exit status and, separately, the
# gateway container's restarts since it became Ready. A kill (status 137) alone
# does not show an out-of-memory kill; only the container status names one.
report_doctor_failure() {
  local status=$1 agent_id=$2 gateway_namespace=$3 gateway_name=$4 ready_gateway=$5 doctor_prefix=$6
  local gateway_state restarts reason
  if ((status == 137)); then
    warn "OpenClaw Doctor was killed (exit 137) in Agent $agent_id's gateway."
  elif ((status == 134)) && grep -q 'heap out of memory' "$doctor_prefix.error"; then
    # V8 aborts (SIGABRT, status 134) when Doctor reaches its heap cap.
    warn "OpenClaw Doctor ran out of its $doctor_heap_mib MiB heap in Agent $agent_id's gateway. Repeat the command with --resume and a larger --doctor-heap-mib; see docs/guides/deploy/production-upgrade-recovery.md#correct-a-doctor-failure."
  else
    warn "OpenClaw Doctor failed (exit $status) in Agent $agent_id's gateway."
  fi
  if ! gateway_state=$("${kube[@]}" --request-timeout=15s --namespace "$gateway_namespace" get \
    "pod/$gateway_name" --output json 2>/dev/null | jq -er \
      --argjson baseline "$ready_gateway" '
      def count:
        if type == "number" then . >= 0 and . <= 9007199254740991 and floor == .
        else false end;
      select(.metadata.namespace == $baseline.gatewayNamespace and
        .metadata.name == $baseline.gatewayName and
        ($baseline.gatewayUid | type == "string" and length > 0) and
        .metadata.uid == $baseline.gatewayUid) |
      [.status.containerStatuses[]? | select(.name == "gateway")] |
      select(length == 1) | .[0] |
      select((.restartCount | count) and ($baseline.gatewayRestarts | count)) |
      select(.restartCount >= $baseline.gatewayRestarts) |
      "\(.restartCount - $baseline.gatewayRestarts)\t\(.lastState.terminated.reason // "none")"'); then
    warn "Agent $agent_id's gateway restart history since Ready is unknown (missing or incomparable observations)."
    return
  fi
  restarts=${gateway_state%%$'\t'*}
  reason=${gateway_state#*$'\t'}
  if ((restarts == 0)); then
    warn "Agent $agent_id's gateway container did not restart after it became Ready."
  elif [[ "$reason" == OOMKilled ]]; then
    warn "Agent $agent_id's gateway container was OOM-killed and restarted $restarts time(s) after it became Ready: Doctor shares its memory limit. Repeat the command with --resume once the gateway is Ready; Doctor waits for $doctor_memory_mib MiB of free gateway memory."
  else
    warn "Agent $agent_id's gateway container restarted $restarts time(s) after it became Ready (last termination: ${reason:0:100})."
  fi
}

# Prints how a revision Pod changed since its Ready baseline (a doctor-targets.jsonl
# revisionPods entry, with its namespace and name as json_fields reads them), or
# nothing when it is the same Pod, still Running and Ready, with the same restart
# count. A read failure is a change too: the upgrade cannot show the Pod kept serving.
revision_pod_change_since_ready() {
  local ready_pod=$1 pod_namespace=$2 pod_name=$3 output=$4 status=0
  "${kube[@]}" --request-timeout=15s --namespace "$pod_namespace" \
    get "pod/$pod_name" --output json \
    </dev/null >"$output" 2>"$output.error" || status=$?
  if ((status != 0)); then
    if grep -q '(NotFound)' "$output.error"; then
      printf 'no longer exists (evicted or deleted)\n'
    else
      printf 'could not be read again (kubectl exit %s)\n' "$status"
    fi
    return
  fi
  jq -r --argjson baseline "$ready_pod" '
    def count:
      if type == "number" then . >= 0 and . <= 9007199254740991 and floor == .
      else false end;
    [.status.containerStatuses[]? |
      select($baseline.role == "revision" or .name == "gateway" or .name == "agent")] as $rows |
    if .metadata.uid != $baseline.uid then
      "was replaced by a new Pod with the same name"
    elif .status.reason == "Evicted" then
      "was evicted (phase \(.status.phase // "unknown"))"
    elif .metadata.deletionTimestamp != null then
      "is being deleted"
    elif .status.phase != "Running" then
      "stopped (phase \(.status.phase // "unknown"), reason \(.status.reason // "none"))"
    elif ($rows | length) == 0 or (all($rows[]; .restartCount | count) | not) or
      ($baseline.restarts | count | not) then
      "has no comparable \($baseline.role) restart count"
    elif ([$rows[].restartCount] | add) != $baseline.restarts then
      "restarted \(([$rows[].restartCount] | add) - $baseline.restarts) time(s) (last termination: \([$rows[].lastState.terminated.reason // empty][0] // "none"))"
    elif any(.status.conditions[]?; .type == "Ready" and .status == "True") | not then
      "is not Ready"
    else
      empty
    end' "$output" | cut -c 1-200
}

# Doctor runs in one gateway at a time: Doctors in several gateways on one node
# could together exhaust the node's memory and get Pods evicted (finding 2736).
# Each Doctor's memory wait and run has its own --timeout-seconds bound, so the
# serial phase scales with the number of Agents instead of sharing one deadline.
doctor_failed=0
doctor_timeout=
if ((target_count > 0)); then
  while IFS= read -r target; do
    json_fields "$target" namespace_id=namespaceId agent_id=agentId deployment_id=deploymentId \
      gateway_namespace=gatewayNamespace gateway_name=gatewayName
    doctor_prefix="$evidence_dir/status/$(json_file_name "$namespace_id--$agent_id--$deployment_id").doctor"
    deadline=$((SECONDS + timeout_seconds))
    settled=0
    measured_low=0
    admitted=0
    free=unknown
    # The last successful read, for the timeout message when later reads fail.
    measured=unknown
    # gateway_free_memory checks the deadline before each read.
    while :; do
      read_status=0
      read_free=$(gateway_free_memory "$gateway_namespace" "$gateway_name" "$doctor_prefix.memory") ||
        read_status=$?
      # The deadline passed before the read: keep the last read for the timeout message.
      ((read_status != 2)) || break
      if ((read_status == 0)); then
        free=$read_free
        measured=$free
      else
        if ((measured_low == 0)); then
          warn "cannot read the cgroup v2 memory use of Agent $agent_id's gateway; running OpenClaw Doctor without checking its free memory."
          admitted=1
          break
        fi
        settled=0
        free=unknown
      fi
      [[ ! -s "$doctor_prefix.memory.retry" ]] || settled=0
      if [[ "$free" == unlimited ]] || { [[ "$free" != unknown ]] && ((free >= doctor_ample_mib)); }; then
        admitted=1
        break
      fi
      if [[ "$free" != unknown ]] && ((free >= doctor_memory_mib)); then
        if ((++settled >= 2)); then
          admitted=1
          break
        fi
      else
        settled=0
      fi
      measured_low=1
      ((SECONDS < deadline)) || break
      sleep 2
    done
    # A read that admitted Doctor can still end at the deadline; that is a plain
    # timeout below, not a memory shortage.
    if ((admitted == 0 && measured_low == 1)); then
      last_read="last read: $free MiB free"
      # A read that failed after a low one, such as one cut off at the deadline, measured
      # nothing; name the last read that did.
      [[ "$free" != unknown ]] || last_read="last measured: $measured MiB free; later reads failed"
      doctor_timeout="Agent $agent_id's gateway did not keep $doctor_memory_mib MiB free below its memory limit before the upgrade timeout ($last_read), so OpenClaw Doctor did not run: Doctor shares the gateway container's limit and could OOM-kill the serving gateway. Wait for the gateway's memory use to settle, then repeat the command with --resume; see docs/guides/deploy/production-upgrade-recovery.md#correct-a-doctor-failure."
    fi
    # On a timeout, start no further Doctor. No Doctor is running then: each one
    # ends before the next starts, so the evidence lock outlasts all of them.
    [[ -z "$doctor_timeout" ]] || break
    remaining_seconds=$((deadline - SECONDS))
    if ((remaining_seconds <= 0)); then
      doctor_timeout="OpenClaw Doctor did not run before the upgrade timeout."
      break
    fi
    doctor_status=0
    "${kube[@]}" --request-timeout="${remaining_seconds}s" \
      --namespace "$gateway_namespace" exec "$gateway_name" --container gateway -- \
      env "NODE_OPTIONS=--max-old-space-size=$doctor_heap_mib" \
      node /app/openclaw.mjs doctor --lint --json --severity-min error \
      </dev/null >"$doctor_prefix.json" 2>"$doctor_prefix.error" || doctor_status=$?
    ((doctor_status != 0)) || continue
    doctor_failed=1
    report_doctor_failure "$doctor_status" "$agent_id" "$gateway_namespace" "$gateway_name" \
      "$target" "$doctor_prefix"
  done <"$doctor_targets"
fi
[[ -z "$doctor_timeout" ]] || die "$doctor_timeout"

# Doctor passing proves little if a gateway it checked was then evicted, replaced or
# restarted, for example under node memory pressure (finding 2736), and neither does a
# dedicated Agent whose Codex agent Pod went the same way (finding 2755). After the last
# Doctor, every revision Pod the readiness wait required must still be the same Pod,
# Running and Ready, with the restart count it had when it became Ready. This also runs
# after a failed Doctor: an eviction kills Doctor (exit 137) without a container
# restart, and only this check names it.
pod_changed=0
while IFS= read -r target; do
  json_fields "$target" agent_id=agentId namespace_id=namespaceId deployment_id=deploymentId
  target_prefix="$namespace_id--$agent_id--$deployment_id"
  ready_pods=$(jq -ce '.revisionPods | arrays | select(length > 0) | .[]' <<<"$target") ||
    die "Agent $agent_id's Doctor target records no revision Pods to check."
  while IFS= read -r ready_pod; do
    json_fields "$ready_pod" pod_namespace=namespace pod_name=name pod_role=role
    pod_change=$(revision_pod_change_since_ready "$ready_pod" "$pod_namespace" "$pod_name" \
      "$evidence_dir/status/$(json_file_name "$target_prefix--$pod_name").after-doctor.json") ||
      pod_change="could not be compared with its Ready state"
    [[ -n "$pod_change" ]] || continue
    pod_changed=1
    # shellcheck disable=SC2154 # json_fields assigns pod_role.
    warn "Agent $agent_id's $pod_role Pod $pod_namespace/$pod_name $pod_change after it became Ready for OpenClaw Doctor."
  done <<<"$ready_pods"
done <"$doctor_targets"
((doctor_failed == 0)) ||
  die "OpenClaw Doctor failed for at least one replacement gateway; inspect $evidence_dir/status/*.doctor.error."
((pod_changed == 0)) ||
  die "at least one Agent's gateway or agent Pod did not stay on the same Ready Pod without restarts through OpenClaw Doctor, so the upgrade is not complete. Wait until each named Agent's revision Pods are Ready, then repeat the command with --resume and the same evidence directory; the resume runs Doctor again in the current gateway without new deployments."

[[ -z "$verify_agent" ]] || verify_agent_continuity after

if [[ "$repository_enabled" == true ]]; then
  verify_pair_nodes
  verify_deployed_pair completion-before
  for component in api worker; do
    cmp -s "$evidence_dir/capability-after-$component-identity.json" \
      "$evidence_dir/completion-before-$component-identity.json" ||
      die "the deployed $component changed before completion."
  done
  "${kube[@]}" --request-timeout=15s --namespace "$namespace" exec "$capability_pod" -c worker -- \
    node --input-type=module -e "$capability_code" >"$evidence_dir/completion-capability.txt" ||
    die "the deployed controller cannot verify repository admission capability at completion."
  [[ "$(cat "$evidence_dir/completion-capability.txt")" == repository-admission-ready ]] ||
    die "the deployed controller returned an unexpected capability result at completion."
  verify_pair_nodes
  verify_deployed_pair completion-after
  for component in api worker; do
    cmp -s "$evidence_dir/completion-before-$component-identity.json" \
      "$evidence_dir/completion-after-$component-identity.json" ||
      die "the deployed $component changed while checking completion."
  done
fi

helm status "$release" "${helm_args[@]}" >"$evidence_dir/after-helm-status.txt"
helm status "$release" "${helm_args[@]}" --output json >"$evidence_dir/after-helm-status.json"
jq -e --arg recovered "$recovered_revision" --slurpfile submission "$evidence_dir/helm-started" '
  .info.status == "deployed" and .version == (if $recovered == "" then $submission[0].expectedRevision else ($recovered | tonumber) end)
' "$evidence_dir/after-helm-status.json" >/dev/null ||
  die "the final Helm release is not this submission's deployed revision; completion was not recorded."
"${kube[@]}" get deployments,statefulsets,pods,persistentvolumeclaims --all-namespaces \
  --output json >"$evidence_dir/after-workloads.json"
# Record the terminal state only after every required check and evidence read.
# A lost final console message must not permit another run after the window closes.
(
  set -o noclobber
  : >"$evidence_dir/completed"
) ||
  die "could not record upgrade completion; preserve the evidence and investigate before recovery."
if [[ -n "$runtime_image" && -n "$controller_image" && "$controller_image" != "$current_controller" ]]; then
  printf 'Upgraded controller and runtime images; %s running Agents selected new revisions.\n' "$target_count"
elif [[ -n "$runtime_image" ]]; then
  printf 'Upgraded runtime image; controller image remained unchanged and %s running Agents selected new revisions.\n' "$target_count"
elif [[ -n "$broker_image" && "$controller_image" == "$current_controller" ]]; then
  printf 'Upgraded repository broker image; no Agent deployments were requested.\n'
else
  printf 'Upgraded controller image; no Agent deployments were requested.\n'
fi
