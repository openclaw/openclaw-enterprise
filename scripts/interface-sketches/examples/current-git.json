    {
      "kind": "text",
      "x": 24,
      "y": 510,
      "text": "Before allowing the request, the worker rechecks the recipient and loaded generation via Gateway status without fetching a token. For credential setup, see 01b.",
      "size": 14,
      "role": "note"
    },
    {
      "kind": "text",
      "x": 24,
      "y": 540,
      "text": "An allow does not confirm delivery to GitHub. One observed denial does not establish that every request uses the hook.",
      "size": 14,
      "role": "note"
    },
    {
      "kind": "text",
      "x": 24,
      "y": 570,
      "text": "OCE adds no per-ref filter. The bundled Driver refuses repository-scoped Git and has no native sender fallback.",
