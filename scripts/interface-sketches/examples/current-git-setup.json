    {
      "kind": "text",
      "x": 24,
      "y": 1803,
      "text": "The adapter reads the prepared token during setup or refresh. Git requests do not pull tokens. The native Git sender and broker use a separate path.",
      "size": 14,
      "role": "note"
    },
    {
      "kind": "text",
      "x": 24,
      "y": 1833,
      "text": "The sandbox references the sentinel provider by name. The adapter updates its token conditionally and checks the loaded policy and generation",
      "size": 14,
      "role": "note"
    },
    { "kind": "text", "x": 24, "y": 1853, "text": "independently.", "size": 14, "role": "note" },
    {
      "kind": "text",
      "x": 24,
      "y": 1883,
      "text": "The preview observes the hook. Mandatory mediation remains unverified. The bundled Driver refuses repository-scoped Git.",
      "size": 14,
      "role": "note"
    }
