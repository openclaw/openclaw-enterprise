{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "replicas",
    "port",
    "tlsSecretName",
    "issuerSecretName",
    "issuer",
    "keyId",
    "clients"
  ],
  "properties": {
    "image": { "type": "string", "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$" },
    "replicas": { "type": "integer", "minimum": 1 },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "tlsSecretName": { "$ref": "#/definitions/secretName" },
    "issuerSecretName": { "$ref": "#/definitions/secretName" },
    "issuer": { "type": "string", "minLength": 1 },
    "keyId": { "type": "string", "minLength": 1 },
    "clients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["namespaceSelector", "podSelector"],
        "additionalProperties": false,
        "properties": {
          "namespaceSelector": { "$ref": "#/definitions/selector" },
          "podSelector": { "$ref": "#/definitions/selector" }
        }
      }
    }
  },
  "definitions": {
    "secretName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchLabels"],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
