  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "All events",
      "description": "All retained operational events. Expand a row for request, work and workload identity; use Explore to filter related records.",
      "datasource": {
        "type": "loki",
        "uid": "occ-loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~`${service:regex}`} | event_name=~`${event:regex}` | line_format `{{.service_name}} | {{.event_name}}{{if .http_request_method}} {{.http_request_method}}{{end}}{{if .http_response_status_code}} status={{.http_response_status_code}}{{end}}{{if .duration_ms}} duration={{.duration_ms}}ms{{end}}{{if .work_outcome}} outcome={{.work_outcome}}{{end}}{{if .occ_startup_phase}} phase={{.occ_startup_phase}}{{end}}{{if .occ_code}} code={{.occ_code}}{{end}}{{if .work_operation}} op={{.work_operation}}{{end}}{{if .work_attempt}} attempt={{.work_attempt}}{{end}}`",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Needs attention",
      "description": "Warnings and errors, HTTP 4xx/5xx, and retry/permanent/failure work outcomes. HTTP and worker failures can have INFO severity.",
      "datasource": {
        "type": "loki",
        "uid": "occ-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~`${service:regex}`} | event_name=~`${event:regex}` | severity_text=~\"WARN|ERROR|FATAL\" or http_response_status_code=~\"[45][0-9]{2}\" or work_outcome=~\"retry|permanent|failure\" | line_format `{{.service_name}} | {{.event_name}}{{if .http_request_method}} {{.http_request_method}}{{end}}{{if .http_response_status_code}} status={{.http_response_status_code}}{{end}}{{if .duration_ms}} duration={{.duration_ms}}ms{{end}}{{if .work_outcome}} outcome={{.work_outcome}}{{end}}{{if .occ_startup_phase}} phase={{.occ_startup_phase}}{{end}}{{if .occ_code}} code={{.occ_code}}{{end}}{{if .work_operation}} op={{.work_operation}}{{end}}{{if .work_attempt}} attempt={{.work_attempt}}{{end}}`",
          "queryType": "range"
        }
      ]
    }
  ]
