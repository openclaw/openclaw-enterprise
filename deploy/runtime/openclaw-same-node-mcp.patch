+++ b/src/worker/worker-local-mcp.test.ts
@@ -0,0 +1,88 @@
+import { expect, it, vi } from "vitest";
+import type { WorkerToolSurface } from "../../packages/gateway-protocol/src/schema/worker-gateway-tool.js";
+import { consumeMcpCodeModeGuestResult } from "../agents/mcp-content.js";
+import { createWorkerLocalMcpClient, createWorkerLocalMcpTool } from "./worker-local-mcp.js";
+import {
+  parseWorkerProcessMessage,
+  parseWorkerProcessRequest,
+  type WorkerProcessMessage,
+} from "./worker-process-protocol.js";
+
+const entry: WorkerToolSurface["tools"][number] = {
+  id: "generation-1:0",
+  execution: "placement",
+  definition: {
+    name: "documents_search",
+    label: "Search",
+    description: "Search documents",
+    parameters: { type: "object", properties: { query: { type: "string" } }, required: ["query"] },
+  },
+  plugin: {
+    pluginId: "node-mcp",
+    optional: false,
+    mcp: {
+      node: { id: "node-1" },
+      serverName: "documents",
+      safeServerName: "documents",
+      toolName: "search",
+      operation: "tool",
+    },
+  },
+};
+const grant = { id: entry.id, server: "documents", tool: "search" };
+const grants = [grant];
+
+it("invokes the admitted handle over the supervisor pipe and projects the result for Code Mode in the worker", async () => {
+  const result = { content: [{ type: "text", text: "found" }], structuredContent: { document: 7 } };
+  const write = vi.fn(async (message: WorkerProcessMessage) => {
+    const frame = parseWorkerProcessMessage(structuredClone(message));
+    if (frame?.type !== "mcp-call") {
+      throw new Error("Unexpected worker frame");
+    }
+    const reply = parseWorkerProcessRequest({
+      type: "mcp-result",
+      turnId: frame.turnId,
+      requestId: frame.requestId,
+      result,
+    });
+    if (reply.type !== "mcp-result") {
+      throw new Error("Unexpected supervisor frame");
+    }
+    client.receive(reply);
+  });
+  const client = createWorkerLocalMcpClient("turn-1", write);
+  const tool = createWorkerLocalMcpTool(entry, grants, client.call)!;
+  const response = await tool.execute("call-1", { query: "hello" });
+  expect(write).toHaveBeenCalledExactlyOnceWith({
+    type: "mcp-call",
+    turnId: "turn-1",
+    requestId: expect.any(String),
+    toolId: entry.id,
+    arguments: { query: "hello" },
+  });
+  expect(consumeMcpCodeModeGuestResult(response)).toEqual(result);
+
+  await expect(tool.execute("call-2", { query: 42 })).rejects.toThrow("arguments");
+  expect(write).toHaveBeenCalledTimes(1);
+  expect(
+    createWorkerLocalMcpTool(entry, [{ ...grant, tool: "delete" }], client.call),
+  ).toBeUndefined();
+});
+
+it("cancels the same local request when a tool call aborts", async () => {
+  const write = vi.fn(async (_message: WorkerProcessMessage) => {});
+  const client = createWorkerLocalMcpClient("turn-2", write);
+  const controller = new AbortController();
+  const call = client.call(entry.id, {}, controller.signal);
+  const first = write.mock.calls[0]?.[0];
+  if (first?.type !== "mcp-call") {
+    throw new Error("Expected an MCP call");
+  }
+  controller.abort(new Error("turn cancelled"));
+  await expect(call).rejects.toThrow("turn cancelled");
+  expect(write).toHaveBeenLastCalledWith({
+    type: "mcp-cancel",
+    turnId: "turn-2",
+    requestId: first.requestId,
+  });
+});
diff --git a/src/worker/worker-local-mcp.ts b/src/worker/worker-local-mcp.ts
new file mode 100644
index 0000000..cf27d0e
--- /dev/null
+++ b/src/worker/worker-local-mcp.ts
@@ -0,0 +1,102 @@
+import { randomUUID } from "node:crypto";
+import { isRecord } from "@openclaw/normalization-core/record-coerce";
+import { Value } from "typebox/value";
+import type { WorkerToolSurface } from "../../packages/gateway-protocol/src/schema/worker-gateway-tool.js";
+import {
+  WORKER_PROTOCOL_MAX_CONCURRENT_TOOLS,
+  WORKER_PROTOCOL_MAX_PAYLOAD_BYTES,
+} from "../../packages/gateway-protocol/src/schema/worker-protocol-primitives.js";
+import { projectMcpCallToolResult } from "../agents/mcp-content.js";
+import type { AnyAgentTool } from "../agents/tools/common.js";
+import { createDeferredCore, type Deferred } from "../shared/deferred.js";
+import type { WorkerLaunchPlan } from "./launch-descriptor.js";
+import type { WorkerMcpResult, WorkerProcessMessage } from "./worker-process-protocol.js";
+
+type McpResult = Extract<WorkerMcpResult, { result: unknown }>["result"];
+export type WorkerLocalMcpCall = (
+  toolId: string,
+  args: Record<string, unknown>,
+  signal?: AbortSignal,
+) => Promise<McpResult>;
+
+/** Only an admitted tool handle crosses the private, turn-scoped supervisor pipe. */
+export function createWorkerLocalMcpClient(
+  turnId: string,
+  write: (message: WorkerProcessMessage) => Promise<void>,
+) {
+  const pending = new Map<string, Deferred<McpResult>>();
+  const call: WorkerLocalMcpCall = async (toolId, args, signal) => {
+    signal?.throwIfAborted();
+    if (pending.size >= WORKER_PROTOCOL_MAX_CONCURRENT_TOOLS) {
+      throw new Error("Worker MCP tool concurrency limit exceeded");
+    }
+    const requestId = randomUUID();
+    const frame = { type: "mcp-call", turnId, requestId, toolId, arguments: args } as const;
+    if (Buffer.byteLength(JSON.stringify(frame)) > WORKER_PROTOCOL_MAX_PAYLOAD_BYTES) {
+      throw new Error("Worker MCP arguments exceed the tool payload limit");
+    }
+    const result = createDeferredCore<McpResult>();
+    pending.set(requestId, result);
+    const cancel = () => {
+      result.reject(signal?.reason);
+      void write({ type: "mcp-cancel", turnId, requestId }).catch(() => {});
+    };
+    signal?.addEventListener("abort", cancel, { once: true });
+    try {
+      void write(frame).catch(result.reject);
+      return await result.promise;
+    } finally {
+      pending.delete(requestId);
+      signal?.removeEventListener("abort", cancel);
+    }
+  };
+  return {
+    call,
+    receive(frame: WorkerMcpResult) {
+      const request = pending.get(frame.requestId);
+      if (frame.turnId === turnId && request) {
+        if ("error" in frame) {
+          request.reject(new Error(frame.error));
+        } else {
+          request.resolve(frame.result);
+        }
+      }
+    },
+    close(this: void) {
+      for (const request of pending.values()) {
+        request.reject(new Error("Worker MCP turn ended"));
+      }
+      pending.clear();
+    },
+  };
+}
+
+export function createWorkerLocalMcpTool(
+  entry: WorkerToolSurface["tools"][number],
+  grants: WorkerLaunchPlan["assignment"]["toolAuthority"]["mcpTools"],
+  call: WorkerLocalMcpCall | undefined,
+): AnyAgentTool | undefined {
+  const mcp = entry.plugin?.mcp;
+  if (
+    !call ||
+    !mcp?.node ||
+    mcp.operation !== "tool" ||
+    entry.execution !== "placement" ||
+    !grants?.some(
+      (grant) =>
+        grant.id === entry.id && grant.server === mcp.serverName && grant.tool === mcp.toolName,
+    )
+  ) {
+    return undefined;
+  }
+  return {
+    ...entry.definition,
+    execute: async (_toolCallId, args, signal) => {
+      if (!isRecord(args) || !Value.Check(entry.definition.parameters, args)) {
+        throw new Error("Worker MCP tool arguments are invalid");
+      }
+      const result = await call(entry.id, args, signal);
+      return projectMcpCallToolResult(result, { mcpServer: mcp.serverName, mcpTool: mcp.toolName });
+    },
+  };
+}
