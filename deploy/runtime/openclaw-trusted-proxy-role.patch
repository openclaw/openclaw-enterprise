+      const connect = async (identity: string, role: keyof typeof definitions, backend = false) => {
+        const headers: Record<string, string> = {
+          ...TRUSTED_PROXY_HEADERS,
+          "x-forwarded-user": identity,
+          "x-openclaw-scopes": definitions[role].scopes.join(","),
+          "x-occ-role": encodeURIComponent(role),
+          "x-occ-role-policy": roleHash(role),
+        };
+        if (backend) {
+          delete headers.origin;
+        }
+        const ws = await openWs(port, headers);
+        sockets.push(ws);
+        const connected = await (backend ? connectReq : connectIdentity)(ws, {
+          skipDefaultAuth: true,
+          prePairDevice: false,
+          scopes: backend ? [] : ["operator.admin", "operator.read", "operator.write"],
+          ...(backend ? { client: BACKEND_GATEWAY_CLIENT, device: null } : {}),
+          deviceIdentityPath: deviceIdentityPath(`proxy-${sockets.length}`),
+        });
+        expect(connected.ok).toBe(true);
+        return { ws, connected };
+      };
+      try {
+        // Fresh human devices use the proxy's real scope cap and autoapproval,
+        // without pre-pairing. The default role grants nothing before assignment.
+        const joe = await connect("oce:prn_joe", "researcher");
+        const jo = await connect("oce:prn_jo", "réviseur");
+        // Match the workspace-files caller: backend client, no device or requested scopes.
+        const service = await connect("occ-workspace-files", "administrator", true);
+        expect(responseAuth(joe.connected)?.scopes).toEqual(["operator.read", "operator.write"]);
+        expect(responseAuth(jo.connected)?.scopes).toEqual(["operator.read"]);
+        expect((await rpcReq(joe.ws, "status", {})).ok).toBe(true);
+        expect(
+          (
+            await rpcReq(joe.ws, "sessions.patch", {
+              key: "agent:main:permitted",
+              label: "allowed",
+            })
+          ).ok,
+        ).toBe(true);
+        const joeProfile = await rpcReq<UsersSelfResult>(joe.ws, "users.self", {});
+        const joProfile = await rpcReq<UsersSelfResult>(jo.ws, "users.self", {});
+        expect(joeProfile.ok).toBe(true);
+        expect(joProfile.ok).toBe(true);
+        expect(joeProfile.payload?.profile.id).not.toBe(joProfile.payload?.profile.id);
+        expect(
+          (
+            await rpcReq(joe.ws, "users.setRole", {
+              profileId: joeProfile.payload!.profile.id,
+              role: "administrator",
+            })
+          ).ok,
+        ).toBe(false);
+        expect((await rpcReq(service.ws, "config.get", {})).ok).toBe(true);
+        expect(
+          (await rpcReq(joe.ws, "sessions.patch", { key: "agent:other:denied", label: "denied" }))
+            .ok,
+        ).toBe(false);
+        expect(
+          (await rpcReq(jo.ws, "sessions.patch", { key: "agent:main:denied", label: "denied" })).ok,
+        ).toBe(false);
+        // Reconnecting with a changed assignment updates the persisted native profile and closes its old authority.
+        const closed = waitForWsClose(joe.ws, 5_000);
+        const changed = await connect("oce:prn_joe", "reviewer");
+        expect(await closed).toBe(true);
+        expect(responseAuth(changed.connected)?.scopes).toEqual(["operator.read"]);
+        const changedProfile = await rpcReq<UsersSelfResult>(changed.ws, "users.self", {});
+        expect(changedProfile.payload?.profile.id).toBe(joeProfile.payload?.profile.id);
+
+        const owner = await openWs(port, { origin: BROWSER_ORIGIN });
+        sockets.push(owner);
+        const ownerConnected = await connectIdentity(owner, {
+          skipDefaultAuth: true,
+          password: "proxy-owner-password",
+          scopes: ["operator.admin"],
+          deviceIdentityPath: deviceIdentityPath("proxy-owner"),
+        });
+        expect(ownerConnected.ok).toBe(true);
+        expect(responseAuth(ownerConnected)?.scopes).toEqual(["operator.admin"]);
+        expect((await rpcReq<UsersSelfResult>(owner, "users.self", {})).payload?.profile.id).toBe(
+          GATEWAY_OWNER_PROFILE_ID,
+        );
+        expect((await rpcReq(owner, "config.get", {})).ok).toBe(true);
+      } finally {
+        for (const ws of sockets) {
+          ws.close();
+        }
+      }
+    });
+  });
+
+  test("rejects a competing role publication and ambiguous managed identities before admission", async () => {
+    await setup();
+    await withGatewayServer(async ({ port }) => {
+      const profile = ensureProfileForEmail("oce:prn_raced");
+      setUserProfileRole(profile.id, "administrator");
+      let raced = false;
+      const stop = onUserProfilesChanged(() => {
+        if (!raced && getUserProfileRole(profile.id) === "researcher") {
+          raced = true;
+          // A native administrator's committed mutation wins before the connecting
+          // researcher acquires authority. Admission must not adopt that wider role.
+          setUserProfileRole(profile.id, "administrator");
+        }
+      });
+      const connect = async (identity: string) => {
+        const ws = await openWs(port, {
+          ...TRUSTED_PROXY_HEADERS,
+          "x-forwarded-user": identity,
+          "x-occ-role": "researcher",
+          "x-occ-role-policy": roleHash("researcher"),
+        });
+        try {
+          await expect(
+            connectIdentity(ws, {
+              skipDefaultAuth: true,
+              scopes: ["operator.read", "operator.write"],
+              deviceIdentityPath: deviceIdentityPath(`binding-${identity}`),
+            }),
+          ).rejects.toThrow("closed");
+        } finally {
+          ws.close();
+        }
+      };
+      try {
+        await connect("oce:prn_raced");
+        expect(raced).toBe(true);
+      } finally {
+        stop();
+      }
+      const ambiguous = ensureProfileForEmail("oce:prn_ambiguous");
+      setUserProfileRole(ambiguous.id, "administrator");
+      linkEmail("oce:prn_other", ambiguous.id);
+      await connect("oce:prn_ambiguous");
+      expect(getUserProfileRole(ambiguous.id)).toBe("administrator");
+      const service = ensureProfileForEmail("occ-workspace-files");
+      setUserProfileRole(service.id, "administrator");
+      linkEmail("oce:prn_service_alias", service.id);
+      await connect("oce:prn_service_alias");
+      expect(getUserProfileRole(service.id)).toBe("administrator");
+    });
+  });
+
+  const rejectedAssignments: Array<{ label: string; headers: Record<string, string> }> = [
+    { label: "missing assignment", headers: {} },
+    {
+      label: "unknown role",
+      headers: { "x-occ-role": "unknown", "x-occ-role-policy": roleHash("reviewer") },
+    },
+    {
+      label: "changed native policy",
+      headers: { "x-occ-role": "reviewer", "x-occ-role-policy": "0".repeat(64) },
+    },
+  ];
+  test.each(rejectedAssignments)("rejects $label before admission", async ({ headers }) => {
+    await setup();
+    await withGatewayServer(async ({ port }) => {
+      const ws = await openWs(port, { ...TRUSTED_PROXY_HEADERS, ...headers });
+      try {
+        await expect(
+          connectIdentity(ws, {
+            skipDefaultAuth: true,
+            scopes: ["operator.read"],
+            deviceIdentityPath: deviceIdentityPath("proxy-rejected"),
+          }),
+        ).rejects.toThrow("closed");
+      } finally {
+        ws.close();
+      }
+    });
+  });
+});
