+              "x-forwarded-user": "oce:prn_http_person",
+              "x-forwarded-for": "198.51.100.20",
+              "x-occ-role": role,
+              "x-occ-role-policy": createHash("sha256")
+                .update(JSON.stringify(canonical(definitions[role])))
+                .digest("hex"),
+              "x-openclaw-scopes": "operator.admin,operator.read,operator.write",
+            },
+          };
+          const beforePublication = calls;
+          const publication = await sendRequest(server, request);
+          // Publishing the profile role retires the authority captured before acquisition.
+          // The handler must not run until a separate request captures the new authority.
+          expect(publication.res.statusCode).toBe(401);
+          expect(calls).toBe(beforePublication);
+          const response = await sendRequest(server, request);
+          expect(response.res.statusCode).toBe(200);
+          const current = JSON.parse(response.getBody());
+          expect(current.adminAllowed).toBe(role === "administrator");
+          expect(current.writeAllowed).toBe(role === "administrator");
+          if (profileId) {
+            expect(current.profileId).toBe(profileId);
+          } else {
+            profileId = current.profileId;
+          }
+          const before = calls;
+          expect(
+            (
+              await sendRequest(server, {
+                ...request,
+                headers: { ...request.headers, "x-occ-role-policy": "0".repeat(64) },
+              })
+            ).res.statusCode,
+          ).toBe(401);
+          expect(calls).toBe(before);
+        }
+        const owner = await sendRequest(server, {
+          path: routePath,
+          remoteAddress: "127.0.0.1",
+          authorization: "Bearer proxy-http-owner-password",
+        });
+        expect(owner.res.statusCode).toBe(200);
+        expect(JSON.parse(owner.getBody())).toMatchObject({
+          profileId: GATEWAY_OWNER_PROFILE_ID,
+          adminAllowed: true,
+        });
+
+        // Native linking is an administrator-owned API, but it must never let
+        // one proxy principal overwrite another principal's single native role.
+        linkEmail("oce:prn_http_other", profileId!);
+        const beforeAmbiguous = calls;
+        const ambiguous = await sendRequest(server, {
+          path: routePath,
+          remoteAddress: proxyAddress,
+          headers: {
+            "x-forwarded-user": "oce:prn_http_person",
+            "x-forwarded-for": "198.51.100.20",
+            "x-occ-role": "administrator",
+            "x-occ-role-policy": createHash("sha256")
+              .update(JSON.stringify(canonical(definitions.administrator)))
+              .digest("hex"),
+          },
+        });
+        expect(ambiguous.res.statusCode).toBe(401);
+        expect(calls).toBe(beforeAmbiguous);
+        expect(getUserProfileRole(profileId!)).toBe("reviewer");
+      },
+    });
+  });
+});
