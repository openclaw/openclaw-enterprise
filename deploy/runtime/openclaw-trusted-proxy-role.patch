+describe("verified proxy profile roles", () => {
+  const definitions = {
+    administrator: { sessions: { others: "write" }, agents: "*", scopes: ["operator.admin"] },
+    researcher: {
+      sessions: { others: "none" },
+      agents: ["main"],
+      scopes: ["operator.read", "operator.write"],
+    },
+    reviewer: { sessions: { others: "view" }, agents: ["main"], scopes: ["operator.read"] },
+    réviseur: { sessions: { others: "view" }, agents: ["main"], scopes: ["operator.read"] },
+    denied: { sessions: { others: "none" }, agents: [], scopes: [] },
+  } satisfies GatewayOperatorRolesConfig["definitions"];
+  const roleHash = (role: keyof typeof definitions) => {
+    const canonical = (value: unknown): unknown =>
+      Array.isArray(value)
+        ? value.map(canonical)
+        : value !== null && typeof value === "object"
+          ? Object.fromEntries(
+              Object.entries(value)
+                .toSorted(([a], [b]) => a.localeCompare(b, "en"))
+                .map(([key, item]) => [key, canonical(item)]),
+            )
+          : value;
+    return createHash("sha256")
+      .update(JSON.stringify(canonical(definitions[role])))
+      .digest("hex");
+  };
