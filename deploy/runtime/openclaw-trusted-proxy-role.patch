diff --git a/src/gateway/trusted-proxy-role.ts b/src/gateway/trusted-proxy-role.ts
new file mode 100644
index 0000000..9e23ac2
--- /dev/null
+++ b/src/gateway/trusted-proxy-role.ts
@@ -0,0 +1,120 @@
+import { createHash } from "node:crypto";
+import type { IncomingHttpHeaders } from "node:http";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { prepareUserProfileRoleAuthority } from "../state/user-channel-identity-operations.js";
+import { normalizeProfileEmail } from "../state/user-profile-email.kernel.js";
+import { prepareUserProfileIdentity } from "../state/user-profile-list.js";
+import { setCanonicalUserProfileRole } from "../state/user-profile-writes.js";
+import { invalidateOperatorRolePolicy } from "./operator-role-policy.js";
+
+export function resolveVerifiedProxyRole(
+  cfg: OpenClawConfig,
+  headers: IncomingHttpHeaders,
+  authenticated: boolean,
+  user: string | undefined,
+) {
+  const proxy = cfg.gateway?.auth?.trustedProxy;
+  if (!proxy?.roleHeader) {
+    return undefined;
+  }
+  const encoded = headers[proxy.roleHeader];
+  const role = typeof encoded === "string" ? decodeURIComponent(encoded) : undefined;
+  const policyHash = proxy.rolePolicyHashHeader && headers[proxy.rolePolicyHashHeader];
+  const definitions = cfg.gateway?.roles?.definitions;
+  if (
+    !authenticated ||
+    !user ||
+    typeof role !== "string" ||
+    !definitions ||
+    !Object.hasOwn(definitions, role) ||
+    typeof policyHash !== "string"
+  ) {
+    throw new Error("Verified proxy role assignment is missing");
+  }
+  const canonical = (value: unknown): unknown =>
+    Array.isArray(value)
+      ? value.map(canonical)
+      : value !== null && typeof value === "object"
+        ? Object.fromEntries(
+            Object.entries(value)
+              .toSorted(([a], [b]) => a.localeCompare(b, "en"))
+              .map(([key, item]) => [key, canonical(item)]),
+          )
+        : value;
+  const digest = createHash("sha256")
+    .update(JSON.stringify(canonical(definitions[role])))
+    .digest("hex");
+  if (policyHash !== digest) {
+    throw new Error("Verified proxy role differs from runtime policy");
+  }
+  const managedIdentityPrefixes = proxy.managedIdentityPrefixes ?? [];
+  const managedIdentities = proxy.managedIdentities ?? [];
+  const identity = normalizeProfileEmail(user);
+  if (
+    !managedIdentityPrefixes.some((prefix) => identity.startsWith(prefix)) &&
+    !managedIdentities.includes(identity)
+  ) {
+    throw new Error("Verified proxy identity is outside the managed identity scope");
+  }
+  return { role, managedIdentityPrefixes, managedIdentities };
+}
+
+/** Bind proxy admission to one canonical principal and its exact verified assignment. */
+export async function prepareVerifiedProxyRoleProfile(params: {
+  profileId: string;
+  user: string;
+  role: string;
+  managedIdentityPrefixes: readonly string[];
+  managedIdentities: readonly string[];
+  assertCurrent?: () => void;
+  onRoleCommitted?: (profileId: string) => void;
+}) {
+  params.assertCurrent?.();
+  const identity = await prepareUserProfileIdentity(params.profileId);
+  try {
+    const email = normalizeProfileEmail(params.user);
+    const bindingIds = identity.emailBindingIds;
+    const readCurrent = () => {
+      params.assertCurrent?.();
+      // These facts belong to the retained async catalog owner; guards do not read SQLite.
+      const { profile } = identity.readCurrentFacts(bindingIds);
+      const managed = profile.emails.filter(
+        (candidate) =>
+          params.managedIdentityPrefixes.some((prefix) => candidate.startsWith(prefix)) ||
+          params.managedIdentities.includes(candidate),
+      );
+      if (managed.length !== 1 || managed[0] !== email) {
+        throw new Error("Verified proxy identity has an ambiguous native profile");
+      }
+      return profile;
+    };
+    const assertCurrent = () => {
+      readCurrent();
+    };
+    let updatedAt: number | undefined;
+    if (readCurrent().assignedRole !== params.role) {
+      const committed = await setCanonicalUserProfileRole(params.profileId, params.role, {
+        assertCurrent,
+        onCommitted: (profileId) => {
+          invalidateOperatorRolePolicy(profileId);
+          params.onRoleCommitted?.(profileId);
+        },
+      });
+      updatedAt = committed.updatedAt;
+    }
+    assertCurrent();
+    const authority = await prepareUserProfileRoleAuthority(params.profileId);
+    const current = readCurrent();
+    if (
+      !authority?.isCurrent() ||
+      authority.profileId !== current.profileId ||
+      authority.role !== params.role ||
+      current.assignedRole !== params.role
+    ) {
+      throw new Error("Verified proxy assignment changed during profile acquisition");
+    }
+    return { authority, updatedAt };
+  } finally {
+    identity.release();
+  }
+}
