+    let calls = 0;
+    const registry = createGatewayTestRegistry({
+      httpRoutes: [
+        {
+          pluginId: "proxy-role",
+          source: "proxy-role",
+          path: routePath,
+          auth: "gateway",
+          match: "exact",
+          gatewayRuntimeScopeSurface: "trusted-operator",
+          handler: async (_req: IncomingMessage, res: ServerResponse) => {
+            calls++;
