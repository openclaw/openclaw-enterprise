+          rolePolicyHashHeader: "x-occ-role-policy",
+          deviceAutoApprove: {
+            enabled: true,
+            scopes: ["operator.admin", "operator.read", "operator.write"],
+          },
+        },
+      },
+      { roles: { default: "denied", definitions } },
+    );
+
