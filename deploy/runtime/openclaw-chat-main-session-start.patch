+  }
+  const canonicalKey = (sessionKey: string) =>
+    resolveSessionStoreIdentity({ cfg, sessionKey, agentId }).canonicalKey;
+  return (
+    canonicalKey(params.sessionKey) === canonicalKey(resolveAgentMainSessionKey({ cfg, agentId }))
+  );
+}
 
