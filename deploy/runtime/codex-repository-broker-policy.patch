+    let spec = NetworkProxySpec::from_config_and_constraints(
+        NetworkProxyConfig {
+            enabled: true,
+            ..NetworkProxyConfig::default()
+        },
+        Some(requirements),
+        &PermissionProfile::workspace_write(),
+    )
+    .expect("managed private endpoint should load");
+
+    let expected = NetworkPrivateEndpoint {
+        host: "git-broker.internal".to_string(),
+        port: 443,
+        allow_methods: vec!["POST".to_string()],
+    };
