+pub fn validate_private_endpoints(cfg: &NetworkProxyConfig) -> Result<()> {
+    for (index, endpoint) in cfg.private_endpoints.iter().enumerate() {
+        validate_private_endpoint(endpoint)
+            .with_context(|| format!("invalid network.private_endpoints[{index}]"))?;
+    }
+    Ok(())
+}
+
+fn validate_private_endpoint(endpoint: &NetworkPrivateEndpoint) -> Result<()> {
+    if endpoint.port == 0 {
+        bail!("port must be between 1 and 65535");
+    }
+    let normalized_host = normalize_host(&endpoint.host);
+    if endpoint.host != normalized_host {
+        bail!("host must be normalized exactly as {normalized_host:?}");
+    }
+    if normalized_host.is_empty() {
+        bail!("host must not be empty");
+    }
+    if normalized_host.contains("://")
+        || normalized_host.contains('/')
+        || normalized_host.contains('*')
+        || normalized_host.contains('?')
+    {
+        bail!("host must be an exact hostname without a URL, path, or wildcard");
+    }
+    if normalized_host.parse::<IpAddr>().is_ok() {
+        bail!("host must be a DNS hostname, not an IP literal");
+    }
+    if endpoint.allow_methods.is_empty() {
+        bail!("allow_methods must not be empty");
+    }
+    for method in &endpoint.allow_methods {
+        if method.is_empty()
+            || method != &method.to_ascii_uppercase()
+            || !method.bytes().all(|b| {
+                b.is_ascii_alphanumeric()
+                    || matches!(
+                        b,
+                        b'!' | b'#'
+                            | b'$'
+                            | b'%'
+                            | b'&'
+                            | b'\''
+                            | b'*'
+                            | b'+'
+                            | b'-'
+                            | b'.'
+                            | b'^'
+                            | b'_'
+                            | b'`'
+                            | b'|'
+                            | b'~'
+                    )
+            })
+        {
+            bail!("allow_methods entries must be uppercase HTTP method tokens");
+        }
+    }
+    Ok(())
+}
