+
+it("links each HTTP completion to its original input across model retries and repeated sends", async () => {
+  const sessionKey = "agent:http-input:main";
+  const input = { role: "user", content: "What is the answer?" };
+  const post = async (messages: Array<typeof input>) => {
+    const response = await fetch(`http://127.0.0.1:${gateway.port}/v1/chat/completions`, {
+      method: "POST",
+      headers: {
+        authorization: "Bearer recovery-test",
+        "content-type": "application/json",
+        "x-openclaw-session-key": sessionKey,
+      },
+      body: JSON.stringify({ model: "openclaw/http-input", messages }),
+    });
+    const body: unknown = await response.json();
+    expect(response.status, JSON.stringify(body)).toBe(200);
+    if (!isRecord(body) || typeof body.id !== "string" || !body.id.startsWith("chatcmpl_")) {
+      throw new Error("Expected a server-issued chat completion ID");
+    }
+    return body.id;
+  };
+  const first = await post([input]);
+  expect(requests.get("http-input")).toHaveLength(2);
+  const second = await post([input]);
+  expect(requests.get("http-input")).toHaveLength(3);
+  expect(first).not.toBe(second);
+  const combined = await post([input, { role: "user", content: "Please explain." }]);
+  const history = await gateway.client.request<{ messages: unknown[] }>("chat.history", {
+    sessionKey,
+  });
+  const inputs = history.messages.filter(isRecord).filter((message) => message.role === "user");
+  expect(inputs).toHaveLength(3);
+  for (const [index, runId] of [first, second].entries()) {
+    expect(inputs[index]).toMatchObject({
+      content: input.content,
+      idempotencyKey: `${runId}:user`,
+      __openclaw: { transport: { channel: "openai-http" } },
+    });
+  }
+  expect(inputs[2]?.content).toEqual(expect.stringContaining(input.content));
+  expect(inputs[2]?.content).toEqual(expect.stringContaining("Please explain."));
+  expect(inputs[2]?.idempotencyKey).not.toBe(`${combined}:user`);
+  expect(inputs[2]).not.toMatchObject({ __openclaw: { transport: { channel: "openai-http" } } });
+}, 90_000);

