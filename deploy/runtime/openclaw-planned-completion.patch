+import { afterEach, expect, it, vi } from "vitest";
+import type {
+  GatewaySuspendPrepareResult,
+  SystemInfoResult,
+} from "../../../packages/gateway-protocol/src/index.js";
+import {
+  markGatewayRestartDraining,
+  tryBeginGatewayRootWorkAdmission,
+} from "../../process/gateway-work-admission.js";
+import { withOpenClawTestState } from "../../test-utils/openclaw-test-state.js";
+import { resetGatewayTestState } from "../gateway.test-support.js";
+import {
+  connectGatewayClient,
+  disconnectGatewayClient,
+  startGatewayWithClient,
+} from "../test-helpers.e2e.js";
+import { createAuthorityGatewayTestEnv } from "../test-helpers.env.js";
+
+// Enable the production owner which ordinary in-process Gateway tests skip.
+vi.mock("../../infra/gateway-lock.js", async (original) => {
+  const actual = await original<typeof import("../../infra/gateway-lock.js")>();
+  return {
+    ...actual,
+    acquireGatewayLock: (options: Parameters<typeof actual.acquireGatewayLock>[0]) =>
+      actual.acquireGatewayLock({ ...options, allowInTests: true }),
+  };
+});
+
+afterEach(resetGatewayTestState);
+
+it.each(["resume", "external stop"] as const)(
+  "keeps a completion wait routable while rejecting independent work: %s",
+  { timeout: 60_000 },
+  async (finish) => {
+    await withOpenClawTestState(
+      { label: "completion-wait-transport", env: createAuthorityGatewayTestEnv() },
+      async (state) => {
+        const token = "synthetic-completion-wait-token";
+        const { client, server, port } = await startGatewayWithClient({
+          configPath: state.configPath,
+          token,
+          scopes: ["operator.admin"],
+          hostLifecycle: {
+            externalRestart: {
+              isCurrent: () => true,
+              commitStopFence: () => markGatewayRestartDraining(),
+            },
+            request: async () => ({
+              ok: false,
+              error: "The external supervisor owns this test stop",
+            }),
+          },
+          cfg: {
+            gateway: {
+              mode: "local",
+              auth: { mode: "token", token },
+              http: { endpoints: { chatCompletions: { enabled: true } } },
+            },
+            agents: {
+              entries: { main: {} },
+              defaults: { workspace: state.workspaceDir, skipBootstrap: true },
+            },
+            plugins: { enabled: false, slots: { memory: "none" } },
+            cron: { enabled: false },
+            update: { checkOnStart: false },
+          },
+        });
+        const clients = [client];
+        const admitted = tryBeginGatewayRootWorkAdmission("completion-transport-proof");
+        try {
+          expect(admitted).not.toBeNull();
+          await server.startupSettled;
+          await expect
+            .poll(async () => (await fetch(`http://127.0.0.1:${port}/readyz`)).status, {
+              timeout: 15_000,
+            })
+            .toBe(200);
+          for (const invalid of [
+            { drain: true, completionDeadlineMs: Date.now() + 60_000 },
+            { terminalPolicy: "terminate", completionDeadlineMs: Date.now() + 60_000 },
+          ]) {
+            await expect(
+              client.request("gateway.suspend.prepare", { requestId: "invalid", ...invalid }),
+            ).rejects.toThrow(/invalid gateway.suspend.prepare params/i);
+          }
+          for (const offset of [-1, 31 * 60_000]) {
+            await expect(
+              client.request("gateway.suspend.prepare", {
+                requestId: "outside-window",
+                completionDeadlineMs: Date.now() + offset,
+              }),
+            ).rejects.toThrow(/outside Gateway clock window/i);
+          }
+          const approval = await client.request<{ id: string }>("exec.approval.request", {
+            command: "printf approval",
+            twoPhase: true,
+            requireDeliveryRoute: false,
+            suppressDelivery: true,
+            timeoutMs: 60_000,
+          });
+          const request = {
+            requestId: "planned-update",
+            completionDeadlineMs: Date.now() + 30 * 60_000 + 3_000,
+          };
+          const held = await client.request<GatewaySuspendPrepareResult>(
+            "gateway.suspend.prepare",
+            request,
+          );
+          expect(held.status).toBe("draining");
+          if (held.status !== "draining") {
+            throw new Error("Expected an admitted-work completion wait");
+          }
+          expect((await fetch(`http://127.0.0.1:${port}/readyz`)).status).toBe(200);
+          await expect(
+            client.request("chat.send", {
+              sessionKey: "agent:main:completion-transport-proof",
+              message: "must not execute",
+              idempotencyKey: "rejected-during-completion",
+            }),
+          ).rejects.toThrow(/paused|suspend|unavailable/i);
+          const reconnected = await connectGatewayClient({
+            url: `ws://127.0.0.1:${port}`,
+            token,
+            scopes: ["operator.admin"],
+          });
+          clients.push(reconnected);
+          const approvals = await reconnected.request<Array<{ id: string }>>(
+            "exec.approval.list",
+            {},
+          );
+          expect(approvals.map((entry) => entry.id)).toContain(approval.id);
+          await reconnected.request("exec.approval.resolve", { id: approval.id, decision: "deny" });
+          expect(await reconnected.request("exec.approval.list", {})).not.toContainEqual(
+            expect.objectContaining({ id: approval.id }),
+          );
+          const rejected = await fetch(`http://127.0.0.1:${port}/v1/chat/completions`, {
+            method: "POST",
+            headers: { authorization: `Bearer ${token}`, "content-type": "application/json" },
+            body: JSON.stringify({
+              model: "openclaw",
+              messages: [{ role: "user", content: "busy" }],
+            }),
+          });
+          expect(rejected.status).toBe(503);
+          expect(await reconnected.request("gateway.suspend.prepare", request)).toMatchObject({
+            status: "draining",
+            suspensionId: held.suspensionId,
+          });
+          admitted?.release();
+          // Socket and startup owners may still be settling after the response.
+          await expect
+            .poll(
+              () =>
+                reconnected.request("gateway.suspend.status", { suspensionId: held.suspensionId }),
+              { timeout: 5_000 },
+            )
+            .toMatchObject({ status: "ready" });
+          expect((await fetch(`http://127.0.0.1:${port}/readyz`)).status).toBe(200);
+          if (finish === "resume") {
+            await reconnected.request("gateway.suspend.resume", {
+              suspensionId: held.suspensionId,
+            });
+            expect(
+              await reconnected.request("gateway.suspend.status", {
+                suspensionId: held.suspensionId,
+              }),
+            ).toMatchObject({ status: "running" });
+          } else {
+            const target = await reconnected.request<SystemInfoResult>("system.info", {});
+            expect(target.deferredStopHandoff).toBe(true);
+            const handoff = {
+              suspensionId: held.suspensionId,
+              deferExit: true,
+              target: { pid: target.pid, processInstanceId: target.processInstanceId },
+            };
+            expect(await reconnected.request("gateway.suspend.handoff", handoff)).toMatchObject({
+              status: "armed",
+            });
+            expect(
+              await reconnected.request("gateway.suspend.handoff", { ...handoff, commit: true }),
+            ).toMatchObject({ status: "committed" });
+            expect(tryBeginGatewayRootWorkAdmission("must remain closed")).toBeNull();
+            // The host is still alive for its external supervisor to retire it.
+            expect((await fetch(`http://127.0.0.1:${port}/readyz`)).status).toBe(503);
+          }
+        } finally {
+          admitted?.release();
+          await Promise.all(clients.map(disconnectGatewayClient));
+          await server.close({ reason: "completion transport proof finished" });
+        }
+      },
+    );
+  },
+);
