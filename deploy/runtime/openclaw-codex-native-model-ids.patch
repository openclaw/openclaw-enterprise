+import { describe, expect, it } from "vitest";
+import {
+  resolveCodexAppServerThreadModelSelection,
+  resolveCodexAppServerRequestModelSelection,
+} from "./thread-model-selection.js";
+
+const model = "z-ai/glm-5.3-flash";
+const config = {
+  models: {
+    providers: {
+      codex: {
+        baseUrl: "http://127.0.0.1:9",
+        api: "openai-responses" as const,
+        models: [
+          {
+            id: model,
+            name: "GLM 5.3 Flash",
+            reasoning: false,
+            input: ["text" as const],
+            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+            contextWindow: 32000,
+            maxTokens: 4096,
+          },
+        ],
+      },
+    },
+  },
+};
+
+describe("explicit native Codex model IDs", () => {
+  it("preserves a registered vendor namespace and native provider selection", () => {
+    expect(
+      resolveCodexAppServerThreadModelSelection({
+        provider: "codex",
+        model,
+        config,
+      }),
+    ).toEqual({ model });
+  });
+
+  it("preserves the registered ID when request builders resolve the model again", () => {
+    expect(
+      resolveCodexAppServerRequestModelSelection({
+        provider: "codex",
+        model,
+        config,
+      }),
+    ).toEqual({ model });
+  });
+
+  it("accepts a provider-prefixed catalog entry admitted by OCE", () => {
+    const prefixed = structuredClone(config);
+    prefixed.models.providers.codex.models[0]!.id = `codex/${model}`;
+    expect(
+      resolveCodexAppServerThreadModelSelection({
+        provider: "codex",
+        model,
+        config: prefixed,
+      }),
+    ).toEqual({ model });
+  });
+
+  it("retains the provider binding when resuming that exact native model", () => {
+    expect(
+      resolveCodexAppServerThreadModelSelection({
+        provider: "codex",
+        model,
+        config,
+        binding: {
+          threadId: "thread-1",
+          model,
+          modelProvider: "openai-compatible",
+        },
+      }),
+    ).toEqual({ model, modelProvider: "openai-compatible" });
+  });
+
+  it("still resolves an unregistered provider-qualified override", () => {
+    expect(
+      resolveCodexAppServerThreadModelSelection({
+        provider: "codex",
+        model,
+        requestModel: "lmstudio/other/model",
+        config,
+      }),
+    ).toEqual({ model: "other/model", modelProvider: "lmstudio" });
+  });
+});
