+it("delivers a deployment-pinned Gateway skill from a compact session and rewrites its full tree", async () => {
+  const directory = await writeSkill("guide");
+  const instruction = path.join(directory, "SKILL.md");
+  const script = "scripts/check.sh";
+  await fs.mkdir(path.dirname(path.join(directory, script)));
+  await fs.writeFile(path.join(directory, script), "echo pin", { mode: 0o755 });
+  const entries = loadWorkspaceSkills(workspace, { workspaceOnly: true });
+  for (const entry of entries) {
+    recordSkillFileHost(entry.skill, "gateway");
+  }
+  const snapshot = await buildSkillSnapshot(workspace, { entries });
+  const compact = stripRuntimeOnlySessionSkillsFields({
+    sessionId: "pinned",
+    updatedAt: 1,
+    skillsSnapshot: snapshot,
+  }).skillsSnapshot!;
+  vi.stubEnv(
+    "OPENCLAW_PINNED_SKILL_FILES",
+    JSON.stringify({ guide: instruction, other: "/unselected/SKILL.md" }),
+  );
+  try {
+    const delivery = await prepare(compact);
+    expect(delivery?.skills.map((skill) => skill.name)).toEqual(["guide"]);
+    const worker = await materialize(delivery!);
+    const workerInstruction = worker.snapshot.resolvedSkills[0]!.filePath;
+    expect(worker.rewriteReferences(compact.prompt)).toContain(workerInstruction);
+    expect(worker.rewriteReferences(compact.prompt)).not.toContain(instruction);
+    const workerDir = path.dirname(workerInstruction);
+    await expectFile(workerDir, "SKILL.md", markdown, 0o400);
+    await expectFile(workerDir, script, "echo pin", 0o500);
+
+    // Hydration retains the earlier prompt but can exclude a skill under current eligibility.
+    expect(await prepare({ ...compact, resolvedSkills: [], discoverySkills: [] })).toBeUndefined();
+
+    await fs.unlink(instruction);
+    await expect(prepare(compact)).rejects.toThrow(/guide/u);
+  } finally {
+    vi.unstubAllEnvs();
+  }
+});
