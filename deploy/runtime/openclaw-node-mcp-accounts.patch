diff --git a/src/node-host/node-worker-mcp-accounts.integration.test.ts b/src/node-host/node-worker-mcp-accounts.integration.test.ts
new file mode 100644
index 0000000..5a31573
--- /dev/null
+++ b/src/node-host/node-worker-mcp-accounts.integration.test.ts
@@ -0,0 +1,146 @@
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { expect, it } from "vitest";
+import {
+  readMcpFixtureMessage,
+  replyMcpFixtureResult,
+  startMcpHttpFixture,
+} from "../agents/agent-bundle-mcp-lifecycle.test-support.js";
+import { NodeHostMcpServerSchema } from "../config/zod-schema.mcp-server.js";
+import { NODE_WORKER_SUPERVISOR_LAUNCH_COMMAND } from "../infra/node-commands.js";
+import { startNodeHostMcpManager } from "./mcp.js";
+import { createNodeWorkerMcpTurn, NodeWorkerMcpPolicy } from "./node-worker-mcp.js";
+import {
+  TEST_WORKER_ENDPOINT,
+  testWorkerLaunchInput,
+} from "./node-worker-supervisor.test-support.js";
+
+it("routes one admitted worker tool to its chosen account on the same HTTP endpoint", async ({
+  onTestFinished,
+}) => {
+  const credentials = { cs_west: randomUUID(), cs_east: randomUUID() };
+  const identities = new Map(
+    Object.entries(credentials).map(([name, token]) => ["Bearer " + token, name]),
+  );
+  const calls: Array<{ identity: string; name?: string; arguments: unknown }> = [];
+  const server = await startMcpHttpFixture(async (request, response) => {
+    const identity = identities.get(request.headers.authorization ?? "");
+    if (!identity || request.method !== "POST") {
+      response.writeHead(405).end();
+      return;
+    }
+    const message = await readMcpFixtureMessage<{
+      protocolVersion?: string;
+      name?: string;
+      arguments?: unknown;
+    }>(request);
+    if (message.method === "initialize") {
+      replyMcpFixtureResult(response, message, {
+        protocolVersion: message.params?.protocolVersion,
+        capabilities: { tools: {} },
+        serverInfo: { name: "account-probe", version: "1" },
+      });
+    } else if (message.method === "tools/list") {
+      // Both accounts expose probe. Its native field named account means something
+      // different on each account and must reach the remote server unchanged.
+      const probe = {
+        name: "probe",
+        inputSchema: {
+          type: "object",
+          $defs: {
+            target: { type: identity === "cs_west" ? "string" : "integer" },
+          },
+          properties: { account: { $ref: "#/$defs/target" } },
+          required: ["account"],
+        },
+      };
+      const tools = identity === "cs_east" ? [probe, { ...probe, name: "east_only" }] : [probe];
+      replyMcpFixtureResult(response, message, { tools });
+    } else if (message.method === "tools/call") {
+      calls.push({ identity, name: message.params?.name, arguments: message.params?.arguments });
+      replyMcpFixtureResult(response, message, { content: [{ type: "text", text: identity }] });
+    } else {
+      response.writeHead(202).end();
+    }
+  });
+  onTestFinished(() => server.close());
+
+  async function start(accounts: Record<string, string>) {
+    const fixture = NodeHostMcpServerSchema.parse({
+      transport: "streamable-http",
+      url: server.url,
+      toolFilter: { include: ["probe", "east_only"] },
+      accounts: Object.fromEntries(
+        Object.entries(accounts).map(([id, value]) => [
+          id,
+          { headers: { Authorization: "Bearer " + value } },
+        ]),
+      ),
+    });
+    const manager = await startNodeHostMcpManager({ fixture });
+    onTestFinished(() => manager.close());
+    const descriptor = testWorkerLaunchInput("/synthetic/workspace", "accounts-turn").descriptor;
+    descriptor.assignment.toolAuthority.mcpTools = manager.descriptors.map(({ mcp }) => ({
+      id: mcp!.tool,
+      ...mcp!,
+    }));
+    const policy = new NodeWorkerMcpPolicy();
+    policy.setAllowed(true);
+    const turn = createNodeWorkerMcpTurn(
+      { ...descriptor, connectionEndpoint: TEST_WORKER_ENDPOINT },
+      policy.sessionForCommand(NODE_WORKER_SUPERVISOR_LAUNCH_COMMAND, manager),
+    );
+    assert(turn);
+    onTestFinished(() => turn.close());
+    return {
+      manager,
+      async invoke(args: Record<string, unknown>, toolId = "probe") {
+        const reply = Promise.withResolvers<unknown>();
+        await turn.invoke(
+          {
+            type: "mcp-call",
+            requestId: randomUUID(),
+            turnId: descriptor.assignment.turnId,
+            toolId,
+            arguments: args,
+          },
+          async (frame) => reply.resolve(frame),
+        );
+        return reply.promise;
+      },
+    };
+  }
+
+  const both = await start(credentials);
+  expect(both.manager.descriptors.map(({ name }) => name)).toEqual([
+    "fixture_east_only",
+    "fixture_probe",
+  ]);
+  const result = (identity: string) => ({
+    result: { content: [{ type: "text", text: identity }] },
+  });
+  const west = { account: "cs_west", arguments: { account: "native-account" } };
+  const east = { account: "cs_east", arguments: { account: 17 } };
+  const replies = await Promise.all([both.invoke(west), both.invoke(east)]);
+  expect(replies).toMatchObject([result("cs_west"), result("cs_east")]);
+  // The union advertised to the model accepts both native shapes. The dispatcher
+  // still checks this particular account's own catalog and schema before I/O.
+  expect(await both.invoke({ ...east, arguments: west.arguments })).toHaveProperty("error");
+  expect(await both.invoke(east, "east_only")).toMatchObject(result("cs_east"));
+  expect(await both.invoke({ ...east, account: "cs_west" }, "east_only")).toHaveProperty("error");
+  expect(await both.invoke({ arguments: west.arguments })).toHaveProperty("error");
+  expect(await both.invoke({ ...west, account: "cs_unknown" })).toHaveProperty("error");
+  await both.manager.close();
+
+  const remaining = await start({ cs_east: credentials.cs_east });
+  expect(await remaining.invoke(west)).toHaveProperty("error");
+  expect(await remaining.invoke(east)).toMatchObject(result("cs_east"));
+  expect(calls.filter(({ identity }) => identity === "cs_west")).toEqual([
+    { identity: "cs_west", name: "probe", arguments: west.arguments },
+  ]);
+  expect(calls.filter(({ identity }) => identity === "cs_east")).toEqual([
+    { identity: "cs_east", name: "probe", arguments: east.arguments },
+    { identity: "cs_east", name: "east_only", arguments: east.arguments },
+    { identity: "cs_east", name: "probe", arguments: east.arguments },
+  ]);
+});
