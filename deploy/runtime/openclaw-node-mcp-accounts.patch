+
+function listNodeMcpTools(states: Iterable<NodeHostMcpServerState>): ListedNodeMcpTool[] {
+  const listedTools: ListedNodeMcpTool[] = [];
+  const grouped = new Map<
+    string,
+    { serverName: string; tool: Tool; schemas: Tool["inputSchema"][] }
+  >();
+  for (const state of states) {
+    for (const tool of state.listedTools) {
+      if (state.account === undefined) {
+        listedTools.push({ serverName: state.serverName, tool });
+        continue;
+      }
+      const key = JSON.stringify([state.serverName, tool.name]);
+      const group = grouped.get(key);
+      if (!group) {
+        grouped.set(key, { serverName: state.serverName, tool, schemas: [tool.inputSchema] });
+      } else if (!group.schemas.some((schema) => isDeepStrictEqual(schema, tool.inputSchema))) {
+        group.schemas.push(tool.inputSchema);
+      }
+    }
+  }
+  for (const { serverName, tool, schemas } of grouped.values()) {
+    // Each embedded upstream schema stays its own resource: #/$defs and recursive
+    // references keep resolving relative to the native argument object.
+    const variants = schemas.map((schema, index) => ({
+      ...schema,
+      $id:
+        schema.$id ??
+        `urn:openclaw:node-mcp:${encodeURIComponent(serverName)}:${encodeURIComponent(tool.name)}:${index}`,
+    }));
+    listedTools.push({
+      serverName,
+      tool: {
+        ...tool,
+        inputSchema: {
+          type: "object",
+          additionalProperties: false,
+          required: ["account", "arguments"],
+          properties: {
+            account: {
+              type: "string",
+              description: "Account handle from the oce-plugin-accounts skill.",
+            },
+            arguments: variants.length === 1 ? variants[0] : { anyOf: variants },
+          },
+        },
+      },
+    });
+  }
+  return listedTools;
+}
