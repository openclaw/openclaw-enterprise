+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import {
+  readMcpFixtureMessage,
+  replyMcpFixtureResult,
+  startMcpHttpFixture,
+} from "../agents/agent-bundle-mcp-lifecycle.test-support.js";
+import {
+  applyGatewayToolPolicy,
+  createGatewayToolPolicyAssertion,
+  isGatewayToolAllowedWithoutAction,
+} from "../agents/gateway-tool-policy.js";
+import { resolveOpenClawPluginToolsForOptionsAsync } from "../agents/openclaw-plugin-tools.js";
+import { filterToolsByPolicy } from "../agents/tool-policy-match.js";
+import { createToolSurfacePresentationForTest } from "../agents/tool-surface-plan.test-support.js";
+import { NodeHostMcpServerSchema } from "../config/zod-schema.mcp-server.js";
+import {
+  publishNodeSessionPluginTools,
+  removeConnectedNodePluginTools,
+} from "../gateway/node-plugin-tool-snapshot.js";
+import { makeNodeSession } from "../gateway/node-registry.test-helpers.js";
+import { createWorkerConnectionIdentity } from "../gateway/worker-environments/connection-identity.test-support.js";
+import { createWorkerGatewayToolRuntime } from "../gateway/worker-environments/worker-gateway-tool-runtime.js";
+import { NODE_WORKER_SUPERVISOR_LAUNCH_COMMAND } from "../infra/node-commands.js";
+import { createWorkerGatewayToolProxies } from "../worker/worker-gateway-tools.js";
+import { startNodeHostMcpManager } from "./mcp.js";
+import { createNodeWorkerMcpTurn, NodeWorkerMcpPolicy } from "./node-worker-mcp.js";
+import {
+  TEST_WORKER_ENDPOINT,
+  testWorkerLaunchInput,
+} from "./node-worker-supervisor.test-support.js";
+
+// A cold arm64 image also compiles the worker before its first MCP call.
+it(
+  "publishes each distinct account tool definition and dispatches only to eligible accounts",
+  { timeout: 300_000 },
+  async ({ onTestFinished, annotate }) => {
+    const credentials = { cs_a_west: randomUUID(), cs_b_east: randomUUID() };
+    const identities = new Map(
+      Object.entries(credentials).map(([name, token]) => ["Bearer " + token, name]),
+    );
+    const calls: Array<{ identity: string; name?: string; arguments: unknown }> = [];
+    const server = await startMcpHttpFixture(async (request, response) => {
+      const identity = identities.get(request.headers.authorization ?? "");
+      if (!identity || request.method !== "POST") {
+        response.writeHead(405).end();
+        return;
+      }
+      const message = await readMcpFixtureMessage<{
+        protocolVersion?: string;
+        name?: string;
+        arguments?: unknown;
+      }>(request);
+      if (message.method === "initialize") {
+        replyMcpFixtureResult(response, message, {
+          protocolVersion: message.params?.protocolVersion,
+          capabilities: { tools: {} },
+          serverInfo: { name: "account-probe", version: "1" },
+        });
+      } else if (message.method === "tools/list") {
+        const inputSchema = {
+          type: "object",
+          $id: "https://schemas.example/probe",
+          $defs: { target: { type: "string" } },
+          properties: { account: { $ref: "#/$defs/target" } },
+          required: ["account"],
+        };
+        const probe = {
+          name: "probe",
+          inputSchema,
+          description: identity === "cs_b_east" ? "Look up east invoices." : "Look up west orders.",
+        };
+        const shared = { name: "shared", inputSchema, description: "Look up the current user." };
+        const scalar = { type: identity === "cs_b_east" ? "integer" : "string" };
+        const schema = { type: "object", properties: { value: scalar } };
+        const tools = [
+          probe,
+          shared,
+          { ...shared, name: "disabled" },
+          { ...shared, name: "by_input", inputSchema: schema },
+          { ...shared, name: "by_output", outputSchema: schema },
+          { ...shared, name: "by_hint", annotations: { readOnlyHint: identity === "cs_b_east" } },
+        ];
+        if (identity === "cs_b_east") {
+          tools.push({ ...shared, name: "east_only" });
+        }
+        replyMcpFixtureResult(response, message, { tools });
+      } else if (message.method === "tools/call") {
+        calls.push({ identity, name: message.params?.name, arguments: message.params?.arguments });
+        replyMcpFixtureResult(response, message, { content: [{ type: "text", text: identity }] });
+      } else {
+        response.writeHead(202).end();
+      }
+    });
+    onTestFinished(() => server.close());
+
+    async function start(accounts: Record<string, string>) {
+      const fixture = NodeHostMcpServerSchema.parse({
+        transport: "streamable-http",
+        url: server.url,
+        toolFilter: {
+          include: ["probe", "shared", "east_only", "by_input", "by_output", "by_hint"],
+        },
+        accounts: Object.fromEntries(
+          Object.entries(accounts).map(([id, value]) => [
+            id,
+            { headers: { Authorization: "Bearer " + value } },
+          ]),
+        ),
+      });
+      const manager = await startNodeHostMcpManager({ fixture });
+      onTestFinished(() => manager.close());
+      const descriptor = testWorkerLaunchInput("/synthetic/workspace", "accounts-turn").descriptor;
+      descriptor.assignment.toolAuthority.mcpTools = manager.descriptors.map(({ mcp, name }) => ({
+        id: name,
+        ...mcp!,
+      }));
+      const policy = new NodeWorkerMcpPolicy();
+      policy.setAllowed(true);
+      const turn = createNodeWorkerMcpTurn(
+        { ...descriptor, connectionEndpoint: TEST_WORKER_ENDPOINT },
+        policy.sessionForCommand(NODE_WORKER_SUPERVISOR_LAUNCH_COMMAND, manager),
+      );
+      assert(turn);
+      onTestFinished(() => turn.close());
+      return {
+        manager,
+        async invoke(toolId: string, args: Record<string, unknown>) {
+          const reply = Promise.withResolvers<unknown>();
+          await turn.invoke(
+            {
+              type: "mcp-call",
+              requestId: randomUUID(),
+              turnId: descriptor.assignment.turnId,
+              toolId,
+              arguments: args,
+            },
+            async (frame) => reply.resolve(frame),
+          );
+          return reply.promise;
+        },
+      };
+    }
+
+    const both = await start(credentials);
+    // Use the Gateway's model-tool materialization, not a second interpretation of tools/list.
+    const node = makeNodeSession("account-fixture", {
+      commands: ["mcp.tools.call.v1"],
+      declaredNodePluginTools: both.manager.descriptors,
+    });
+    publishNodeSessionPluginTools(node, true, []);
+    onTestFinished(() => removeConnectedNodePluginTools(node.nodeId));
+    const workspaceDir = await mkdtemp(join(tmpdir(), "worker-account-tools-"));
+    onTestFinished(() => rm(workspaceDir, { recursive: true, force: true }));
+    const enabledTools = ["probe", "shared", "east_only", "by_input", "by_output", "by_hint"].map(
+      (tool) => "fixture_" + tool,
+    );
+    const config = {
+      plugins: { enabled: false },
+      tools: { gatewayPolicy: { allow: enabledTools } },
+    };
+    const tools = await resolveOpenClawPluginToolsForOptionsAsync({
+      resolvedConfig: config,
+      options: { workspaceDir, senderIsOwner: true, config, pluginToolAllowlist: enabledTools },
+    });
+    const westTool = tools.find((tool) => tool.description.startsWith("Look up west orders."));
+    const eastTool = tools.find((tool) => tool.description.startsWith("Look up east invoices."));
+    assert(westTool && eastTool);
+    await annotate(westTool.name + " — " + westTool.description);
+    await annotate(eastTool.name + " — " + eastTool.description);
+    expect([westTool.name, eastTool.name]).toEqual([
+      "acct_fixture_probe_86c485eb7dbd",
+      "acct_fixture_probe_cdbc053af6d2",
+    ]);
+    for (const difference of ["by_input", "by_output", "by_hint"]) {
+      expect(
+        tools.filter(({ name }) => name.startsWith("acct_fixture_" + difference + "_")),
+      ).toHaveLength(2);
+    }
+    // The ordinary native and Gateway policies both apply one upstream grant to
+    // every variant, including on same-node worker admission and execution.
+    const variants = [westTool, eastTool];
+    const workerCatalog = createWorkerGatewayToolRuntime({
+      assertCurrent() {},
+      signal: new AbortController().signal,
+      prepare: async () => ({
+        tools: variants,
+        presentation: createToolSurfacePresentationForTest(),
+        policy: {
+          workspaceOnly: true,
+          readOnly: false,
+          applyPatchEnabled: true,
+          applyPatchWorkspaceOnly: true,
+          imageSanitization: {},
+        },
+      }),
+    });
+    onTestFinished(() => workerCatalog.close());
+    const identity = createWorkerConnectionIdentity();
+    const surface = await workerCatalog.getSurface(identity);
+    const projection = await workerCatalog.getPromptProjection(identity);
+    expect(projection.tools).toEqual(
+      variants.map(({ name, description, parameters }) => ({ name, description, parameters })),
+    );
+    // The serialized worker tools must retain the same upstream policy grant.
+    const unused = async () => {
+      throw new Error("This check only reads proxy definitions");
+    };
+    const workerTools = createWorkerGatewayToolProxies(surface, {
+      invokeGatewayTool: unused,
+      cancelGatewayTool: unused,
+    });
+    expect(workerTools.map(({ name }) => name)).toEqual(variants.map(({ name }) => name));
+    expect(applyGatewayToolPolicy(workerTools, config)).toEqual(workerTools);
+    expect(filterToolsByPolicy(variants, { allow: ["fixture_probe"] })).toEqual(variants);
+    expect(filterToolsByPolicy(variants, { deny: ["fixture_probe"] })).toEqual([]);
+    expect(applyGatewayToolPolicy(variants, config)).toEqual(variants);
+    const denied = { tools: { gatewayPolicy: { allow: ["fixture_shared"] } } };
+    expect(applyGatewayToolPolicy(variants, denied)).toEqual([]);
+    expect(isGatewayToolAllowedWithoutAction(westTool, config)).toBe(true);
+    expect(() => createGatewayToolPolicyAssertion(eastTool, denied)({})).toThrow("denies tool");
+    function expectHandles(tool: { parameters: unknown }, handles: string[]) {
+      expect(tool.parameters).toMatchObject({ properties: { account: { enum: handles } } });
+    }
+    expectHandles(westTool, ["cs_a_west"]);
+    expectHandles(eastTool, ["cs_b_east"]);
+    const shared = tools.filter((tool) => tool.name === "fixture_shared");
+    expect(shared).toHaveLength(1);
+    expectHandles(shared[0]!, ["cs_a_west", "cs_b_east"]);
+    expect(tools.some((tool) => tool.name === "fixture_disabled")).toBe(false);
+
+    const result = (identity: string) => ({
+      result: { content: [{ type: "text", text: identity }] },
+    });
+    const west = { account: "cs_a_west", arguments: { account: "native-account" } };
+    const east = { account: "cs_b_east", arguments: { account: "second-native-account" } };
+    expect(await both.invoke(westTool.name, west)).toMatchObject(result(west.account));
+    expect(await both.invoke(eastTool.name, east)).toMatchObject(result(east.account));
+    expect(await both.invoke("fixture_shared", west)).toMatchObject(result(west.account));
+    expect(await both.invoke("fixture_shared", east)).toMatchObject(result(east.account));
+    expect(await both.invoke("fixture_east_only", east)).toMatchObject(result(east.account));
+
+    // Check the dispatcher used by Gateway calls as well as the worker turn wrapper.
+    const westRoute = both.manager.descriptors.find(({ name }) => name === westTool.name)!.mcp!;
+    await expect(both.manager.callMcpTool({ ...westRoute, arguments: east })).rejects.toThrow(
+      "does not provide this tool",
+    );
+    expect(await both.invoke(westTool.name, east)).toHaveProperty("error");
+    expect(await both.invoke(eastTool.name, west)).toHaveProperty("error");
+    expect(
+      await both.invoke("fixture_shared", { ...west, arguments: { account: 17 } }),
+    ).toHaveProperty("error");
+    expect(await both.invoke("fixture_east_only", west)).toHaveProperty("error");
+    expect(await both.invoke("fixture_shared", { arguments: west.arguments })).toHaveProperty(
+      "error",
+    );
+    expect(await both.invoke("fixture_shared", { ...west, account: "cs_unknown" })).toHaveProperty(
+      "error",
+    );
+    await both.manager.close();
+
+    // Adding a lexically earlier account to the west definition keeps both names.
+    const extra = randomUUID();
+    identities.set("Bearer " + extra, "cs_0_west");
+    const extended = await start({ cs_0_west: extra, ...credentials });
+    const westDefinition = extended.manager.descriptors.find(({ name }) => name === westTool.name);
+    assert(westDefinition?.parameters);
+    expectHandles({ parameters: westDefinition.parameters }, ["cs_0_west", "cs_a_west"]);
+    expect(extended.manager.descriptors.some(({ name }) => name === eastTool.name)).toBe(true);
+    await extended.manager.close();
+
+    const remaining = await start({ cs_b_east: credentials.cs_b_east });
+    expect(await remaining.invoke("fixture_probe", west)).toHaveProperty("error");
+    expect(await remaining.invoke("fixture_probe", east)).toMatchObject(result(east.account));
+    expect(calls).toEqual([
+      { identity: west.account, name: "probe", arguments: west.arguments },
+      { identity: east.account, name: "probe", arguments: east.arguments },
+      { identity: west.account, name: "shared", arguments: west.arguments },
+      { identity: east.account, name: "shared", arguments: east.arguments },
+      { identity: east.account, name: "east_only", arguments: east.arguments },
+      { identity: east.account, name: "probe", arguments: east.arguments },
+    ]);
+  },
+);
