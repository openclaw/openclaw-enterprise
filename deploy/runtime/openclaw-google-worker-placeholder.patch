+import { expect, test } from "vitest";
+import {
+  captureNodeWorkerPlatformTrust,
+  snapshotNodeWorkerEnv,
+  snapshotNodeWorkerExecutionEnv,
+} from "./node-worker-environment.js";
+
+test("a native worker receives only a scoped Google placeholder, with the node's trust", () => {
+  const marker = `openshell:resolve:env:s${"a".repeat(64)}_GOG_ACCESS_TOKEN`;
+  expect(snapshotNodeWorkerEnv({ GOG_ACCESS_TOKEN: marker }).GOG_ACCESS_TOKEN).toBe(marker);
+  for (const token of ["raw-token", marker.replace("GOG_ACCESS_TOKEN", "ANOTHER_TOKEN")]) {
+    expect(snapshotNodeWorkerEnv({ GOG_ACCESS_TOKEN: token }).GOG_ACCESS_TOKEN).toBeUndefined();
+  }
+  const trust = "/run/openshell-supervisor-ca/material/ca-bundle.crt";
+  const source = { GOG_ACCESS_TOKEN: marker, SSL_CERT_FILE: trust };
+  expect(
+    snapshotNodeWorkerExecutionEnv(source, undefined, captureNodeWorkerPlatformTrust(source)),
+  ).toMatchObject({ GOG_ACCESS_TOKEN: marker, SSL_CERT_FILE: trust });
+});
