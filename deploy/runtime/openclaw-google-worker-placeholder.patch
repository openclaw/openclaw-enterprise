--- /dev/null
+++ b/src/node-host/node-worker-google-placeholder.test.ts
@@ -0,0 +1,36 @@
+import { expect, test } from "vitest";
+import { snapshotNodeWorkerEnv } from "./node-worker-environment.js";
+
+test("a native worker receives only its independently scoped CLI placeholders and OpenShell trust", () => {
+  const trust = "/run/openshell-supervisor-ca/material/ca-bundle.crt";
+  const west = "GOG_ACCESS_TOKEN_A";
+  const east = "GOG_ACCESS_TOKEN_B";
+  const marker = (alias: string) => "openshell:resolve:env:s" + "a".repeat(64) + "_" + alias;
+  const env = {
+    ["OCE_MANAGED_CLI_" + west]: marker(west),
+    ["OCE_MANAGED_CLI_" + east]: marker(east),
+    OCE_MANAGED_CLI_OTHER: marker(west),
+    OCE_MANAGED_CLI_RAW: "raw-token",
+    GOG_ACCESS_TOKEN: "raw",
+    SSL_CERT_FILE: trust,
+  };
+  const independent = marker("GOG_ACCESS_TOKEN_" + "F".repeat(24));
+  expect(snapshotNodeWorkerEnv({ GOG_ACCESS_TOKEN: independent }).GOG_ACCESS_TOKEN).toBe(
+    independent,
+  );
+  const snapshot = snapshotNodeWorkerEnv(env);
+  expect(snapshot).toMatchObject({
+    ["OCE_MANAGED_CLI_" + west]: marker(west),
+    ["OCE_MANAGED_CLI_" + east]: marker(east),
+    SSL_CERT_FILE: trust,
+  });
+  for (const key of ["GOG_ACCESS_TOKEN", "OCE_MANAGED_CLI_OTHER", "OCE_MANAGED_CLI_RAW"]) {
+    expect(snapshot[key]).toBeUndefined();
+  }
+  expect(
+    snapshotNodeWorkerEnv({ OCE_MANAGED_CLI_RAW: "raw", SSL_CERT_FILE: trust }).SSL_CERT_FILE,
+  ).toBeUndefined();
+  expect(
+    snapshotNodeWorkerEnv({ ...env, SSL_CERT_FILE: "/tmp/untrusted.pem" }).SSL_CERT_FILE,
+  ).toBeUndefined();
+});
