+import { expect, test } from "vitest";
+import { snapshotNodeWorkerEnv } from "./node-worker-environment.js";
+
+test("a native worker receives only a scoped Google placeholder and OpenShell trust", () => {
+  const marker = `openshell:resolve:env:s${"a".repeat(64)}_GOG_ACCESS_TOKEN`;
+  const trust = "/run/openshell-supervisor-ca/material/ca-bundle.crt";
+  const capture = (token: string, ca = trust) =>
+    snapshotNodeWorkerEnv({ GOG_ACCESS_TOKEN: token, SSL_CERT_FILE: ca });
+  expect(capture(marker)).toMatchObject({ GOG_ACCESS_TOKEN: marker, SSL_CERT_FILE: trust });
+  for (const token of ["raw-token", marker.replace("GOG_ACCESS_TOKEN", "ANOTHER_TOKEN")]) {
+    expect(capture(token).GOG_ACCESS_TOKEN).toBeUndefined();
+    expect(capture(token).SSL_CERT_FILE).toBeUndefined();
+  }
+  expect(capture(marker, "/tmp/untrusted-ca.pem").SSL_CERT_FILE).toBeUndefined();
+});
