+it("sends separate Codex provider attempts in the admitted turn and retries the same event", async () => {
+  const first = {
+    modelCallId: "e16d8272-e2b8-4ca8-be44-267ea13986a4",
+    model: "gpt-5.1",
+    provider: "fixture",
+  } as const;
+  const second = { ...first, modelCallId: "06819eb6-d731-41c6-96f1-70454d8e8cfc" };
+  const missingStart = { ...first, modelCallId: "de6e8676-5e42-4c96-a4a9-0bdbb83d0db4" };
+  const firstStartDeliveries: string[] = [];
+  const events: Array<Record<string, unknown>> = [];
+  const headers: Array<{ authorization?: string; source?: string | string[] }> = [];
+  const server = createServer(async (request, response) => {
+    const chunks: Buffer[] = [];
+    for await (const chunk of request) {
+      chunks.push(Buffer.from(chunk));
+    }
+    headers.push({
+      authorization: request.headers.authorization,
+      source: request.headers["x-openclaw-runtime-audit-source"],
+    });
+    const body = Buffer.concat(chunks).toString("utf8");
+    const event = JSON.parse(body) as Record<string, unknown>;
+    if (
+      event.action === "openclaw.runtime.model_call.started" &&
+      event.modelCallId === first.modelCallId
+    ) {
+      firstStartDeliveries.push(body);
+      if (firstStartDeliveries.length === 1) {
+        response.writeHead(503).end();
+        return;
+      }
+    }
+    events.push(event);
+    response.writeHead(204).end();
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  try {
+    const address = server.address();
+    if (!address || typeof address === "string") {
+      throw new Error("Fixture failed to get a loopback address");
+    }
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_URL", `http://127.0.0.1:${address.port}/runtime-audit`);
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_TOKEN", "fixture-audit-token");
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_TOKEN_PATH", undefined);
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_CA_PATH", undefined);
+    initializeOpenClawRuntimeAudit();
+    function bindAuditCapability() {
+      const capability = bindCodexRuntimeAudit({
+        sessionId: "host-session",
+        transcript: undefined,
+        assertActive: () => {},
+      });
+      if (!capability) {
+        throw new Error("Fixture failed to initialize Codex runtime audit");
+      }
+      return capability;
+    }
+
+    // An unselected App Server keeps turn audit but cannot supply model records.
+    vi.stubEnv("OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT", undefined);
+    applyConfigEnvVars({ env: { vars: { OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT: "1" } } });
+    expect(process.env.OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT).toBeUndefined();
+    const unselected = await bindAuditCapability().admitTurn();
+    await unselected.started(1);
+    await unselected.observeNativeModel({ ...first, stage: "started" }, 2);
+    await unselected.observeNativeModel({ ...first, stage: "succeeded" }, 3);
+    await unselected.completed("completed", 4);
+    expect(events.map((event) => event.action)).toEqual([
+      "openclaw.runtime.turn.admitted",
+      "openclaw.runtime.turn.started",
+      "openclaw.runtime.turn.completed",
+    ]);
+    events.length = 0;
+    headers.length = 0;
