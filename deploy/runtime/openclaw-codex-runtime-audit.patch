+    expect(hostRecords.map((event) => event.action)).toEqual([
+      "openclaw.runtime.tool_call.requested",
+      "openclaw.runtime.policy.decided",
+      "openclaw.runtime.tool_attempt.admitted",
+      "openclaw.runtime.tool_attempt.completed",
