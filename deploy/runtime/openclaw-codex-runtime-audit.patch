+import { expect, it, vi } from "vitest";
+import { prepareCodexServerNotification } from "./protocol-validators.js";
+import type { CodexThreadItem } from "./protocol.js";
+import { createCodexAttemptNotificationController } from "./run-attempt-notification-controller.js";
+
+it("observes structured native tool and model facts only for the accepted turn", () => {
+  const observeNativeTool = vi.fn(async () => {});
+  const observeNativeModel = vi.fn(async () => {});
+  type ControllerInput = Parameters<typeof createCodexAttemptNotificationController>;
+  const resources = {
+    prompt: {
+      context: { attemptTools: {}, runtime: { connection: {} } },
+      turnState: { codexTurnPromptText: "" },
+    },
+    state: { thread: { threadId: "thread" } },
+    projectorRef: {},
+  } as unknown as ControllerInput[0];
+  const turn = {
+    state: {
+      auditTurn: { nativeTurnId: "turn", receipt: { observeNativeTool, observeNativeModel } },
+    },
+    turnIdRef: {},
+  } as unknown as ControllerInput[1];
+  const controller = createCodexAttemptNotificationController(
+    resources,
+    turn,
+    {} as ControllerInput[2],
+  );
+
+  const receivedAtMs = 42;
+  function receive(
+    method: "item/started" | "item/completed",
+    item: Pick<CodexThreadItem, "id" | "status" | "type"> & { source?: string; command?: string },
+    threadId = "thread",
+  ) {
+    const scope = { threadId, turnId: "turn" };
+    controller.noteNotificationReceived(
+      prepareCodexServerNotification({ method, params: { ...scope, item } }),
+      scope,
+      receivedAtMs,
+    );
+  }
+  const command = {
+    id: "command",
+    type: "commandExecution",
+    source: "agent",
+    command: "synthetic command text",
+  };
+  receive("item/started", { ...command, status: "inProgress" });
+  receive("item/completed", { ...command, status: "declined" });
+  receive("item/completed", { ...command, status: "failed" }, "other-thread");
+  receive("item/completed", { ...command, source: "userShell", status: "completed" });
+  receive("item/completed", { id: "message", type: "agentMessage", status: "completed" });
+  expect(observeNativeTool.mock.calls).toEqual([
+    ["command", "commandExecution", "requested", receivedAtMs],
+    ["command", "commandExecution", "denied", receivedAtMs],
+  ]);
+  const call = {
+    modelCallId: "e16d8272-e2b8-4ca8-be44-267ea13986a4",
+    model: "gpt-5.1",
+    provider: "fixture",
+  };
+  function receiveModel(
+    stage: string,
+    provider = call.provider,
+    threadId = "thread",
+    turnId = "turn",
+  ) {
+    const scope = { threadId, turnId };
+    controller.noteNotificationReceived(
+      prepareCodexServerNotification({
+        method: "model/providerAttempt",
+        params: {
+          ...scope,
+          ...call,
+          provider,
+          stage,
+          unexpectedContent: "response body never enters the audit receipt",
+        },
+      }),
+      scope,
+      receivedAtMs,
+    );
+  }
+  receiveModel("started");
+  receiveModel("failed", call.provider, "thread", "other-turn");
+  receiveModel("failed", call.provider, "other-thread");
+  receiveModel("succeeded", "invalid provider label\n");
+  receiveModel("queued");
+  receiveModel("failed");
+  expect(observeNativeModel.mock.calls).toEqual([
+    [{ ...call, stage: "started" }, receivedAtMs],
+    [{ ...call, stage: "failed" }, receivedAtMs],
+  ]);
+});
