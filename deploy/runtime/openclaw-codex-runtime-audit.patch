+      turn.observeNativeModel({ ...first, stage: "started" }, 3),
+      turn.observeNativeModel({ ...first, stage: "started" }, 3),
+      turn.observeNativeModel({ ...first, model: "wrong-model", stage: "succeeded" }, 4),
+      turn.observeNativeModel({ ...first, stage: "failed" }, 4),
+      turn.observeNativeModel({ ...first, stage: "succeeded" }, 4),
+      turn.observeNativeModel({ ...second, stage: "started" }, 5),
+      turn.observeNativeModel({ ...second, stage: "succeeded" }, 6),
+    ];
