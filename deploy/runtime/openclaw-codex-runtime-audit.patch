+    await turn.observeNativeModel({ ...missingStart, stage: "started" }, 8);
+
+    expect(firstStartDeliveries).toHaveLength(2);
+    expect(firstStartDeliveries[0]).toBe(firstStartDeliveries[1]);
+    expect(headers).toHaveLength(events.length + 1);
+    for (const header of headers) {
+      expect(header).toEqual({ authorization: "Bearer fixture-audit-token", source: "codex" });
+    }
+    expect(events.at(0)?.action).toBe("openclaw.runtime.turn.admitted");
+    expect(events.at(1)?.action).toBe("openclaw.runtime.turn.started");
+    expect(events.at(-1)).toMatchObject({
+      action: "openclaw.runtime.turn.completed",
+      outcome: "succeeded",
+    });
+    for (const event of events) {
+      expect(event).toMatchObject({ sessionId: "host-session", turnId: events[0]?.turnId });
+    }
+    expect(new Set(events.map((event) => event.eventId)).size).toBe(events.length);
+    const modelEvents = events.slice(2, -1);
+    expect(modelEvents).toHaveLength(4);
+    for (const [call, outcome] of [
+      [first, "failed"],
+      [second, "succeeded"],
+    ] as const) {
+      const matching = modelEvents.filter((event) => event.modelCallId === call.modelCallId);
+      expect(matching).toMatchObject([
+        { ...call, action: "openclaw.runtime.model_call.started" },
+        { ...call, action: "openclaw.runtime.model_call.completed", outcome },
