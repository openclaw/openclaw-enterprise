+    expect(JSON.stringify(hostRecords)).not.toContain("gateway-tool-1");
+    expect(new Set(hostRecords.map(({ invocationId }) => invocationId)).size).toBe(1);
+    expect(hostRecords.at(3)).toMatchObject({
+      attemptId: hostRecords.at(2)?.attemptId,
+      outcome: "succeeded",
+    });
+  } finally {
+    vi.unstubAllEnvs();
+    await new Promise<void>((resolve, reject) => {
+      server.close((error) => (error ? reject(error) : resolve()));
+    });
+  }
+});
diff --git a/src/agents/harness/codex-runtime-audit.ts b/src/agents/harness/codex-runtime-audit.ts
new file mode 100644
index 0000000..48dc94b
--- /dev/null
+++ b/src/agents/harness/codex-runtime-audit.ts
@@ -0,0 +1,371 @@
+import { createHmac, randomBytes, randomUUID } from "node:crypto";
+import {
+  hasOpenClawRuntimeAudit,
+  recordObservedOpenClawRuntimeAudit,
+  recordOpenClawRuntimeAudit,
+  type OpenClawRuntimeAuditEvent,
+} from "../../infra/openclaw-runtime-audit.js";
+import type { UserTurnTranscriptRecorder } from "../../sessions/user-turn-transcript.types.js";
+
+const record = (event: OpenClawRuntimeAuditEvent) => recordOpenClawRuntimeAudit(event, "codex");
+const observe = (event: OpenClawRuntimeAuditEvent) =>
+  recordObservedOpenClawRuntimeAudit(event, "codex");
+
+type NativeTurnStatus = "completed" | "failed" | "interrupted";
+type NativeModelAttempt = Readonly<{
+  modelCallId: string;
+  model: string;
+  provider: string;
+  stage: "started" | "succeeded" | "failed" | "cancelled";
+}>;
+
+const AUDIT_ID = /^[^\s\p{Cc}]{1,256}$/u;
+const AUDIT_EVENT_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+const AUDIT_TOOL_NAME = /^[a-zA-Z0-9_][a-zA-Z0-9_.:-]{0,255}$/;
+
+type ToolAttemptOutcome = "succeeded" | "failed" | "cancelled" | "unknown" | "blocked";
+type ToolAuditIdentity = { sessionId: string; turnId: string; messageId?: string };
+
+type CodexHostToolAudit = Readonly<{
+  requested: (toolName: string) => Promise<void>;
+  deny: () => Promise<void>;
+  admit: () => Promise<void>;
+  noteExecutionOutcome: (outcome: ToolAttemptOutcome) => void;
+  complete: (outcome: ToolAttemptOutcome) => Promise<void>;
+}>;
+
+const NATIVE_AUDIT_BASE_FIELDS = new Set([
+  "action",
+  "eventId",
+  "invocationId",
+  "toolName",
+  "occurredAtMs",
+]);
+const NATIVE_AUDIT_ACTION_FIELDS: Readonly<Record<string, ReadonlySet<string>>> = {
+  "tool_call.requested": new Set(),
+  "tool_attempt.admitted": new Set(["attemptId", "approvalId"]),
+  "tool_attempt.completed": new Set(["attemptId", "outcome"]),
+  "policy.decided": new Set(["policy", "decision"]),
+  "approval.requested": new Set(["approvalId"]),
+  "approval.resolved": new Set(["approvalId", "decision"]),
+};
+
+function readNativeToolAudit(
+  value: unknown,
+  turn: ToolAuditIdentity,
+  auditInvocationId: (nativeId: string) => string,
+): OpenClawRuntimeAuditEvent | undefined {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    return;
+  }
+  const data = value as Record<string, unknown>;
+  const { action } = data;
+  if (typeof action !== "string" || !Object.hasOwn(NATIVE_AUDIT_ACTION_FIELDS, action)) {
+    return;
+  }
+  const actionFields = NATIVE_AUDIT_ACTION_FIELDS[action];
+  if (
+    Object.keys(data).some((key) => !NATIVE_AUDIT_BASE_FIELDS.has(key) && !actionFields?.has(key))
+  ) {
+    return;
+  }
+  const { eventId, invocationId, toolName, occurredAtMs, attemptId, approvalId, decision } = data;
+  if (
+    typeof eventId !== "string" ||
+    !AUDIT_EVENT_ID.test(eventId) ||
+    typeof invocationId !== "string" ||
+    !AUDIT_ID.test(invocationId) ||
+    typeof toolName !== "string" ||
+    !AUDIT_TOOL_NAME.test(toolName) ||
+    typeof occurredAtMs !== "number" ||
+    !Number.isSafeInteger(occurredAtMs) ||
+    occurredAtMs < 0 ||
+    occurredAtMs > Date.now() + 60_000
+  ) {
+    return;
+  }
+  const fields = {
+    ...turn,
+    eventId,
+    invocationId: auditInvocationId(invocationId),
+    toolName,
+    occurredAt: new Date(occurredAtMs).toISOString(),
+  };
+  const validAttempt = typeof attemptId === "string" && AUDIT_EVENT_ID.test(attemptId);
+  const validApproval = typeof approvalId === "string" && AUDIT_EVENT_ID.test(approvalId);
+  switch (data.action) {
+    case "tool_call.requested":
+      return { action: "openclaw.runtime.tool_call.requested", ...fields };
+    case "tool_attempt.admitted":
+      if (validAttempt && (approvalId === undefined || validApproval)) {
+        return {
+          action: "openclaw.runtime.tool_attempt.admitted",
+          ...fields,
+          attemptId,
+          ...(validApproval ? { approvalId } : {}),
+        };
+      }
+      break;
+    case "tool_attempt.completed": {
+      const { outcome } = data;
+      if (
+        validAttempt &&
+        (outcome === "succeeded" ||
+          outcome === "failed" ||
+          outcome === "cancelled" ||
+          outcome === "unknown" ||
+          outcome === "blocked")
+      ) {
+        return { action: "openclaw.runtime.tool_attempt.completed", ...fields, attemptId, outcome };
+      }
+      break;
+    }
+    case "policy.decided": {
+      const { policy } = data;
+      if (
+        (policy === "codex_policy" || policy === "codex_guardian") &&
+        (decision === "allow" || decision === "deny" || decision === "require_approval")
+      ) {
+        return { action: "openclaw.runtime.policy.decided", ...fields, policy, decision };
+      }
+      break;
+    }
+    case "approval.requested":
+      if (validApproval) {
+        return { action: "openclaw.runtime.approval.requested", ...fields, approvalId };
+      }
+      break;
+    case "approval.resolved":
+      if (
+        validApproval &&
+        (decision === "allow-once" ||
+          decision === "allow-session" ||
+          decision === "allow-always" ||
+          decision === "deny" ||
+          decision === "expired" ||
+          decision === "cancelled" ||
+          decision === "unavailable")
+      ) {
+        return { action: "openclaw.runtime.approval.resolved", ...fields, approvalId, decision };
+      }
+      break;
+  }
+  return undefined;
+}
+
+function bindHostToolAudit(
+  turn: ToolAuditIdentity,
+  nativeId: string,
+  auditInvocationId: () => string,
+): CodexHostToolAudit {
+  const attemptId = randomUUID();
+  let fields: (ToolAuditIdentity & { invocationId: string; toolName: string }) | undefined;
+  let admitted = false;
+  let executionOutcome: ToolAttemptOutcome | undefined;
+  return {
+    async requested(toolName) {
+      if (!AUDIT_ID.test(nativeId) || !AUDIT_TOOL_NAME.test(toolName)) {
+        throw new Error("Invalid Codex tool audit identity");
+      }
+      fields = { ...turn, invocationId: auditInvocationId(), toolName };
+      await record({ action: "openclaw.runtime.tool_call.requested", ...fields });
+    },
+    async deny() {
+      if (fields) {
+        await observe({
+          action: "openclaw.runtime.policy.decided",
+          ...fields,
+          policy: "tool_policy",
+          decision: "deny",
+        });
+      }
+    },
+    async admit() {
+      if (!fields) {
+        throw new Error("Codex tool audit is missing the tool request");
+      }
+      await record({
+        action: "openclaw.runtime.policy.decided",
+        ...fields,
+        policy: "tool_policy",
+        decision: "allow",
+      });
+      await record({ action: "openclaw.runtime.tool_attempt.admitted", ...fields, attemptId });
+      admitted = true;
+    },
+    noteExecutionOutcome(outcome) {
+      executionOutcome ??= outcome;
+    },
+    async complete(outcome) {
+      if (fields && admitted) {
+        admitted = false;
+        await observe({
+          action: "openclaw.runtime.tool_attempt.completed",
+          ...fields,
+          attemptId,
+          outcome: executionOutcome ?? outcome,
+        });
+      }
+    },
+  };
+}
+
+export type CodexRuntimeAuditCapability = Readonly<{
+  sessionStarted: (nativeSessionId: string) => Promise<void>;
+  admitTurn: () => Promise<CodexRuntimeAuditTurn>;
+}>;
+
+export type CodexRuntimeAuditTurn = Readonly<{
+  started: (receivedAtMs: number) => Promise<void>;
+  completed: (status: NativeTurnStatus, receivedAtMs: number) => Promise<void>;
+  nativeTool: (observation: unknown) => Promise<boolean>;
+  hostTool: (invocationId: string) => CodexHostToolAudit;
+  observeNativeModel: (attempt: NativeModelAttempt, receivedAtMs: number) => Promise<void>;
+}>;
+
+export function bindCodexRuntimeAudit(params: {
+  sessionId: string | undefined;
+  transcript: UserTurnTranscriptRecorder | undefined;
+  assertActive: () => void;
+}): CodexRuntimeAuditCapability | undefined {
+  const { sessionId, transcript, assertActive } = params;
+  if (!sessionId || !hasOpenClawRuntimeAudit()) {
+    return undefined;
+  }
+  // Compute sets this only when it launches its paired, audit-enabled App Server.
+  const auditProviderAttempts = process.env.OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT === "1";
+  const sessionStarts = new Map<string, Promise<void>>();
+  return Object.freeze({
+    sessionStarted: (nativeSessionId: string) => {
+      const previous = sessionStarts.get(nativeSessionId);
+      if (previous) {
+        return previous;
+      }
+      const started = observe({
+        action: "openclaw.runtime.session.started",
+        sessionId,
+        nativeSessionId,
+      });
+      sessionStarts.set(nativeSessionId, started);
+      return started;
+    },
+    admitTurn: async () => {
+      assertActive();
+      const admission = transcript?.getAdmissionReceipt();
+      const identity = {
+        sessionId,
+        turnId: randomUUID(),
+        ...(admission?.sessionId === sessionId ? { messageId: admission.entryId } : {}),
+      };
+      await record({ action: "openclaw.runtime.turn.admitted", ...identity });
+      // Provider item IDs may contain arbitrary text. Use them only to correlate
+      // events for this accepted turn, without copying their bytes into the ledger.
+      const invocationKey = randomBytes(32);
+      const auditInvocationId = (owner: "native" | "host", nativeId: string) =>
+        createHmac("sha256", invocationKey)
+          .update(JSON.stringify([owner, nativeId]))
+          .digest("hex");
+      let started: Promise<void> | undefined;
+      let completed: Promise<void> | undefined;
+      const modelCalls = new Map<
+        string,
+        { model: string; provider: string; recorded: Promise<void>; finished?: true }
+      >();
+      return Object.freeze({
+        started: (receivedAtMs: number) =>
+          (started ??= observe({
+            action: "openclaw.runtime.turn.started",
+            ...identity,
+            occurredAt: new Date(receivedAtMs).toISOString(),
+          })),
+        completed: (status: NativeTurnStatus, receivedAtMs: number) =>
+          (completed ??= Promise.all([
+            started,
+            ...Array.from(modelCalls.values(), ({ recorded }) => recorded),
+          ]).then(() =>
+            observe({
+              action: "openclaw.runtime.turn.completed",
+              ...identity,
+              occurredAt: new Date(receivedAtMs).toISOString(),
+              outcome:
+                status === "completed"
+                  ? "succeeded"
+                  : status === "interrupted"
+                    ? "cancelled"
+                    : "failed",
+            }),
+          )),
+        nativeTool: async (observation: unknown) => {
+          if (!auditProviderAttempts || completed) {
+            return false;
+          }
+          assertActive();
+          const event = readNativeToolAudit(observation, identity, (id) =>
+            auditInvocationId("native", id),
+          );
+          if (!event) {
+            return false;
+          }
+          await started;
+          if (
+            event.action === "openclaw.runtime.tool_attempt.completed" ||
+            (event.action === "openclaw.runtime.policy.decided" && event.decision === "deny") ||
+            (event.action === "openclaw.runtime.approval.resolved" &&
+              event.decision !== "allow-once" &&
+              event.decision !== "allow-session" &&
+              event.decision !== "allow-always")
+          ) {
+            await observe(event);
+          } else {
+            await record(event);
+          }
+          return true;
+        },
+        hostTool: (nativeId: string) =>
+          bindHostToolAudit(identity, nativeId, () => auditInvocationId("host", nativeId)),
+        observeNativeModel: async (
+          { modelCallId, model, provider, stage }: NativeModelAttempt,
+          receivedAtMs: number,
+        ) => {
+          if (!auditProviderAttempts || completed) {
+            return;
+          }
+          const call = modelCalls.get(modelCallId);
+          const details = {
+            ...identity,
+            modelCallId,
+            model,
+            provider,
+            occurredAt: new Date(receivedAtMs).toISOString(),
+          };
+          if (stage === "started") {
+            if (!call) {
+              const recorded = Promise.resolve(started).then(() =>
+                observe({ action: "openclaw.runtime.model_call.started", ...details }),
+              );
+              modelCalls.set(modelCallId, {
+                model,
+                provider,
+                recorded,
+              });
+              await recorded;
+            }
+            return;
+          }
+          if (!call || call.finished || call.model !== model || call.provider !== provider) {
+            return;
+          }
+          call.finished = true;
+          call.recorded = call.recorded.then(() =>
+            observe({
+              action: "openclaw.runtime.model_call.completed",
+              ...details,
+              outcome: stage,
+            }),
+          );
+          await call.recorded;
+        },
+      });
+    },
+  });
+}
