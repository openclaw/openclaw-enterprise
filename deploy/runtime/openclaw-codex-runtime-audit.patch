index 0000000..7eff8bd
--- /dev/null
+++ b/src/agents/harness/codex-runtime-audit.test.ts
@@ -0,0 +1,136 @@
+import { once } from "node:events";
+import { createServer } from "node:http";
+import { expect, it, vi } from "vitest";
+import { applyConfigEnvVars } from "../../config/config-env-vars.js";
+import { initializeOpenClawRuntimeAudit } from "../../infra/openclaw-runtime-audit.js";
+import { bindCodexRuntimeAudit } from "./codex-runtime-audit.js";
+
+it("sends separate Codex provider attempts in the admitted turn and retries the same event", async () => {
+  const first = {
+    modelCallId: "e16d8272-e2b8-4ca8-be44-267ea13986a4",
+    model: "gpt-5.1",
+    provider: "fixture",
+  } as const;
+  const second = { ...first, modelCallId: "06819eb6-d731-41c6-96f1-70454d8e8cfc" };
+  const missingStart = { ...first, modelCallId: "de6e8676-5e42-4c96-a4a9-0bdbb83d0db4" };
+  const firstStartDeliveries: string[] = [];
+  const events: Array<Record<string, unknown>> = [];
+  const headers: Array<{ authorization?: string; source?: string | string[] }> = [];
+  const server = createServer(async (request, response) => {
+    const chunks: Buffer[] = [];
+    for await (const chunk of request) {
+      chunks.push(Buffer.from(chunk));
+    }
+    headers.push({
+      authorization: request.headers.authorization,
+      source: request.headers["x-openclaw-runtime-audit-source"],
+    });
+    const body = Buffer.concat(chunks).toString("utf8");
+    const event = JSON.parse(body) as Record<string, unknown>;
+    if (
+      event.action === "openclaw.runtime.model_call.started" &&
+      event.modelCallId === first.modelCallId
+    ) {
+      firstStartDeliveries.push(body);
+      if (firstStartDeliveries.length === 1) {
+        response.writeHead(503).end();
+        return;
+      }
+    }
+    events.push(event);
+    response.writeHead(204).end();
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  try {
+    const address = server.address();
+    if (!address || typeof address === "string") {
+      throw new Error("Fixture failed to get a loopback address");
+    }
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_URL", `http://127.0.0.1:${address.port}/runtime-audit`);
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_TOKEN", "fixture-audit-token");
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_TOKEN_PATH", undefined);
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_CA_PATH", undefined);
+    initializeOpenClawRuntimeAudit();
+    function bindAuditCapability() {
+      const capability = bindCodexRuntimeAudit({
+        sessionId: "host-session",
+        transcript: undefined,
+        assertActive: () => {},
+      });
+      if (!capability) {
+        throw new Error("Fixture failed to initialize Codex runtime audit");
+      }
+      return capability;
+    }
+
+    // An unselected App Server keeps turn audit but cannot supply model records.
+    vi.stubEnv("OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT", undefined);
+    applyConfigEnvVars({ env: { vars: { OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT: "1" } } });
+    expect(process.env.OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT).toBeUndefined();
+    const unselected = await bindAuditCapability().admitTurn();
+    await unselected.started(1);
+    await unselected.observeNativeModel({ ...first, stage: "started" }, 2);
+    await unselected.observeNativeModel({ ...first, stage: "succeeded" }, 3);
+    await unselected.completed("completed", 4);
+    expect(events.map((event) => event.action)).toEqual([
+      "openclaw.runtime.turn.admitted",
+      "openclaw.runtime.turn.started",
+      "openclaw.runtime.turn.completed",
+    ]);
+    events.length = 0;
+    headers.length = 0;
+
+    vi.stubEnv("OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT", "1");
+    const turn = await bindAuditCapability().admitTurn();
+    await turn.started(1);
+    await turn.observeNativeModel({ ...missingStart, stage: "failed" }, 2);
+    const observations = [
+      turn.observeNativeModel({ ...first, stage: "started" }, 3),
+      turn.observeNativeModel({ ...first, stage: "started" }, 3),
+      turn.observeNativeModel({ ...first, model: "wrong-model", stage: "succeeded" }, 4),
+      turn.observeNativeModel({ ...first, stage: "failed" }, 4),
+      turn.observeNativeModel({ ...first, stage: "succeeded" }, 4),
+      turn.observeNativeModel({ ...second, stage: "started" }, 5),
+      turn.observeNativeModel({ ...second, stage: "succeeded" }, 6),
+    ];
+    // The terminal turn record waits for already observed model evidence even during a delivery retry.
+    await turn.completed("completed", 7);
+    await Promise.all(observations);
+    await turn.observeNativeModel({ ...missingStart, stage: "started" }, 8);
+
+    expect(firstStartDeliveries).toHaveLength(2);
+    expect(firstStartDeliveries[0]).toBe(firstStartDeliveries[1]);
+    expect(headers).toHaveLength(events.length + 1);
+    for (const header of headers) {
+      expect(header).toEqual({ authorization: "Bearer fixture-audit-token", source: "codex" });
+    }
+    expect(events.at(0)?.action).toBe("openclaw.runtime.turn.admitted");
+    expect(events.at(1)?.action).toBe("openclaw.runtime.turn.started");
+    expect(events.at(-1)).toMatchObject({
+      action: "openclaw.runtime.turn.completed",
+      outcome: "succeeded",
+    });
+    for (const event of events) {
+      expect(event).toMatchObject({ sessionId: "host-session", turnId: events[0]?.turnId });
+    }
+    expect(new Set(events.map((event) => event.eventId)).size).toBe(events.length);
+    const modelEvents = events.slice(2, -1);
+    expect(modelEvents).toHaveLength(4);
+    for (const [call, outcome] of [
+      [first, "failed"],
+      [second, "succeeded"],
+    ] as const) {
+      const matching = modelEvents.filter((event) => event.modelCallId === call.modelCallId);
+      expect(matching).toMatchObject([
+        { ...call, action: "openclaw.runtime.model_call.started" },
+        { ...call, action: "openclaw.runtime.model_call.completed", outcome },
+      ]);
+    }
+  } finally {
+    vi.unstubAllEnvs();
+    await new Promise<void>((resolve, reject) => {
+      server.close((error) => (error ? reject(error) : resolve()));
+    });
+  }
+});
diff --git a/src/agents/harness/codex-runtime-audit.ts b/src/agents/harness/codex-runtime-audit.ts
new file mode 100644
index 0000000..f00067a
--- /dev/null
+++ b/src/agents/harness/codex-runtime-audit.ts
@@ -0,0 +1,143 @@
+import { randomUUID } from "node:crypto";
+import {
+  hasOpenClawRuntimeAudit,
+  recordObservedOpenClawRuntimeAudit,
+  recordOpenClawRuntimeAudit,
+  type OpenClawRuntimeAuditEvent,
+} from "../../infra/openclaw-runtime-audit.js";
+import type { UserTurnTranscriptRecorder } from "../../sessions/user-turn-transcript.types.js";
+
+const record = (event: OpenClawRuntimeAuditEvent) => recordOpenClawRuntimeAudit(event, "codex");
+const observe = (event: OpenClawRuntimeAuditEvent) =>
+  recordObservedOpenClawRuntimeAudit(event, "codex");
+
+type NativeTurnStatus = "completed" | "failed" | "interrupted";
+type NativeModelAttempt = Readonly<{
+  modelCallId: string;
+  model: string;
+  provider: string;
+  stage: "started" | "succeeded" | "failed" | "cancelled";
+}>;
+
+export type CodexRuntimeAuditCapability = Readonly<{
+  sessionStarted: (nativeSessionId: string) => Promise<void>;
+  admitTurn: () => Promise<CodexRuntimeAuditTurn>;
+}>;
+
+export type CodexRuntimeAuditTurn = Readonly<{
+  started: (receivedAtMs: number) => Promise<void>;
+  completed: (status: NativeTurnStatus, receivedAtMs: number) => Promise<void>;
+  observeNativeModel: (attempt: NativeModelAttempt, receivedAtMs: number) => Promise<void>;
+}>;
+
+export function bindCodexRuntimeAudit(params: {
+  sessionId: string | undefined;
+  transcript: UserTurnTranscriptRecorder | undefined;
+  assertActive: () => void;
+}): CodexRuntimeAuditCapability | undefined {
+  const { sessionId, transcript, assertActive } = params;
+  if (!sessionId || !hasOpenClawRuntimeAudit()) {
+    return undefined;
+  }
+  // Compute sets this only when it launches its paired, audit-enabled App Server.
+  const auditProviderAttempts = process.env.OPENCLAW_CODEX_PROVIDER_ATTEMPT_AUDIT === "1";
+  const sessionStarts = new Map<string, Promise<void>>();
+  return Object.freeze({
+    sessionStarted: (nativeSessionId: string) => {
+      const previous = sessionStarts.get(nativeSessionId);
+      if (previous) {
+        return previous;
+      }
+      const started = observe({
+        action: "openclaw.runtime.session.started",
+        sessionId,
+        nativeSessionId,
+      });
+      sessionStarts.set(nativeSessionId, started);
+      return started;
+    },
+    admitTurn: async () => {
+      assertActive();
+      const admission = transcript?.getAdmissionReceipt();
+      const identity = {
+        sessionId,
+        turnId: randomUUID(),
+        ...(admission?.sessionId === sessionId ? { messageId: admission.entryId } : {}),
+      };
+      await record({ action: "openclaw.runtime.turn.admitted", ...identity });
+      let started: Promise<void> | undefined;
+      let completed: Promise<void> | undefined;
+      const modelCalls = new Map<
+        string,
+        { model: string; provider: string; recorded: Promise<void>; finished?: true }
+      >();
+      return Object.freeze({
+        started: (receivedAtMs: number) =>
+          (started ??= observe({
+            action: "openclaw.runtime.turn.started",
+            ...identity,
+            occurredAt: new Date(receivedAtMs).toISOString(),
+          })),
+        completed: (status: NativeTurnStatus, receivedAtMs: number) =>
+          (completed ??= Promise.all([
+            started,
+            ...Array.from(modelCalls.values(), ({ recorded }) => recorded),
+          ]).then(() =>
+            observe({
+              action: "openclaw.runtime.turn.completed",
+              ...identity,
+              occurredAt: new Date(receivedAtMs).toISOString(),
+              outcome:
+                status === "completed"
+                  ? "succeeded"
+                  : status === "interrupted"
+                    ? "cancelled"
+                    : "failed",
+            }),
+          )),
+        observeNativeModel: async (
+          { modelCallId, model, provider, stage }: NativeModelAttempt,
+          receivedAtMs: number,
+        ) => {
+          if (!auditProviderAttempts || completed) {
+            return;
+          }
+          const call = modelCalls.get(modelCallId);
+          const details = {
+            ...identity,
+            modelCallId,
+            model,
+            provider,
+            occurredAt: new Date(receivedAtMs).toISOString(),
+          };
+          if (stage === "started") {
+            if (!call) {
+              const recorded = Promise.resolve(started).then(() =>
