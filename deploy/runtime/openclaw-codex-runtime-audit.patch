+import { expect, it, vi } from "vitest";
+import { prepareCodexServerNotification } from "./protocol-validators.js";
+import { createCodexAttemptNotificationController } from "./run-attempt-notification-controller.js";
+
+it("observes model attempts only for the accepted turn", () => {
+  const observeNativeModel = vi.fn(async () => {});
+  type ControllerInput = Parameters<typeof createCodexAttemptNotificationController>;
+  const resources = {
+    prompt: {
+      context: { attemptTools: {}, runtime: { connection: {} } },
+      turnState: { codexTurnPromptText: "" },
+    },
+    state: { thread: { threadId: "thread" } },
+    projectorRef: {},
+  } as unknown as ControllerInput[0];
+  const turn = {
+    state: {
+      auditTurn: { nativeTurnId: "turn", receipt: { observeNativeModel } },
+    },
+    turnIdRef: {},
+  } as unknown as ControllerInput[1];
+  const controller = createCodexAttemptNotificationController(
+    resources,
+    turn,
+    {} as ControllerInput[2],
+  );
+
+  const receivedAtMs = 42;
+  const call = {
+    modelCallId: "e16d8272-e2b8-4ca8-be44-267ea13986a4",
+    model: "gpt-5.1",
+    provider: "fixture",
+  };
+  function receiveModel(
+    stage: string,
+    provider = call.provider,
+    threadId = "thread",
+    turnId = "turn",
+  ) {
+    const scope = { threadId, turnId };
+    controller.noteNotificationReceived(
+      prepareCodexServerNotification({
+        method: "model/providerAttempt",
+        params: {
+          ...scope,
+          ...call,
+          provider,
+          stage,
+          unexpectedContent: "response body never enters the audit receipt",
+        },
+      }),
+      scope,
+      receivedAtMs,
+    );
+  }
+  receiveModel("started");
+  receiveModel("failed", call.provider, "thread", "other-turn");
+  receiveModel("failed", call.provider, "other-thread");
+  receiveModel("succeeded", "invalid provider label\n");
+  receiveModel("queued");
+  receiveModel("failed");
+  expect(observeNativeModel.mock.calls).toEqual([
+    [{ ...call, stage: "started" }, receivedAtMs],
+    [{ ...call, stage: "failed" }, receivedAtMs],
+  ]);
+});
