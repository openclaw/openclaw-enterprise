+            return;
+          }
+          const name = frame.params?.client?.displayName ?? "missing display name";
+          frames.push(name);
+          sendMinimalGatewayResponse(
+            socket,
+            frame.id,
+            buildMinimalGatewayHelloOkPayload({
+              connId: name,
+              auth: { role: "node", scopes: [] },
+              snapshot: {
+                presence: [],
+                health: {},
+                stateVersion: { presence: 0, health: 0 },
+                uptimeMs: 0,
