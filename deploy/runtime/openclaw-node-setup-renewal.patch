+  formatCliProcessFailure,
+  getCliProcessTestTimeout,
+  runCliProcessChild,
+  waitForCliProcessStderrMarker,
+  type CliProcessChildResult,
+} from "../cli/cli-process-child.test-helpers.js";
+import {
+  buildMinimalGatewayHelloOkPayload,
+  closeMinimalGatewayServer,
+  sendMinimalGatewayConnectChallenge,
+  sendMinimalGatewayResponse,
+} from "../gateway/minimal-gateway.test-helpers.js";
+import { resolveRuntimeWorkerArgv, resolveRuntimeWorkerUrl } from "../infra/runtime-worker-url.js";
+import {
+  createOpenClawTestState,
+  type OpenClawTestState,
+} from "../test-utils/openclaw-test-state.js";
+import { acquireTestPortBlock } from "../test-utils/port-claims.js";
+import { loadNodeHostConfig } from "./config.js";
+
+// Resolve the real runtime graph during collection, before subprocess deadlines.
+const runnerUrl = resolveRuntimeWorkerUrl({
+  currentModuleUrl: import.meta.url,
+  sourceWorkerName: "runner",
+  distWorkerPath: "node-host/runner.js",
+});
+const cleanupUrl = resolveRuntimeWorkerUrl({
+  currentModuleUrl: import.meta.url,
+  sourceWorkerName: "../cli/runtime-cleanup-scope",
+  distWorkerPath: "cli/runtime-cleanup-scope.js",
+});
+const finalizerUrl = resolveRuntimeWorkerUrl({
+  currentModuleUrl: import.meta.url,
+  sourceWorkerName: "../cli/one-shot-exit",
+  distWorkerPath: "cli/one-shot-exit.js",
+});
+// The first owner remains alive while two more cold subprocesses start.
+const CHILD_TIMEOUT_MS = 180_000;
+
+type RunnerProcess = {
+  child: ChildProcessWithoutNullStreams;
+  result: Promise<CliProcessChildResult>;
+  accepted: Promise<void>;
+};
+
+it.skipIf(process.platform === "win32")(
+  "excludes same-profile runners until graceful release or definite owner death",
+  async ({ signal }) => {
+    const profiles: OpenClawTestState[] = [];
+    const runners: RunnerProcess[] = [];
+    const claim = await acquireTestPortBlock({ offsets: [0] });
+    const server = new WebSocketServer({ host: "127.0.0.1", port: claim.port });
+    const frames: string[] = [];
+    const connected = new Map<string, ReturnType<typeof createDeferred<void>>>();
+    try {
+      await once(server, "listening");
+      for (const label of ["runner-owner", "runner-independent"]) {
+        profiles.push(
+          await createOpenClawTestState({
+            label,
+            applyEnv: false,
+            env: {
+              OPENCLAW_DISABLE_BUNDLED_PLUGINS: "1",
+              OPENCLAW_NO_AUTO_UPDATE: "1",
+              OPENCLAW_NO_RESPAWN: "1",
+            },
+          }),
+        );
+      }
