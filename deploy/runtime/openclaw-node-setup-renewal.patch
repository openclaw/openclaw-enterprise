+/** Classify option positions without interpreting freeform values as flags. */
+function readNodeServiceOptions(argv: string[]) {
+  const start = argv.findIndex((arg, index) => arg === "node" && argv[index + 1] === "run");
+  const valued = new Set([
+    "--host",
+    "--port",
+    "--context-path",
+    "--tls-fingerprint",
+    "--node-id",
+    "--display-name",
+    "--commands",
+  ]);
