+        const ready = connected.get(name);
+        if (!ready) {
+          throw new Error(`missing connection gate for ${name}`);
+        }
+        const exited = runner.result.then((result): never => {
+          throw new Error(
+            formatCliProcessFailure({
+              reason: `${name} exited before accepting hello (code=${result.code}, signal=${result.signal})`,
+              stdout: result.stdout,
+              stderr: result.stderr,
+            }),
+          );
+        });
+        return withinTest(
+          Promise.race([Promise.all([ready.promise, runner.accepted.catch(() => exited)]), exited]),
+          signal,
+        );
+      };
+      const stop = async (runner: RunnerProcess) => {
+        runner.child.kill("SIGTERM");
+        const result = await withinTest(runner.result, signal);
+        expect(result.signal, result.stderr).toBeNull();
+        expect(result.code, result.stderr).toBe(143);
+      };
+
+      const first = launch(shared, "first-owner");
+      await waitConnected("first-owner", first);
+      const saved = await loadNodeHostConfig(shared.env);
+
+      // A losing process cannot reach the peer or change the selected node config.
+      const contender = launch(shared, "same-profile-contender");
+      const denied = await withinTest(contender.result, signal);
+      expect(denied.code, denied.stderr).toBe(1);
+      expect(denied.stderr).toContain("file_lock_timeout");
+      expect(frames).toEqual(["first-owner"]);
+      expect(await loadNodeHostConfig(shared.env)).toEqual(saved);
+
+      const other = launch(independent, "independent-owner");
+      await waitConnected("independent-owner", other);
+      expect(first.child.exitCode).toBeNull();
+      await stop(other);
+      await stop(first);
+
+      const next = launch(shared, "next-owner");
+      await waitConnected("next-owner", next);
+      // SIGKILL cannot execute release callbacks. Recovery must inspect the real
+      // dead owner; the fixture neither removes nor rewrites its lock sidecar.
+      next.child.kill("SIGKILL");
+      const killed = await withinTest(next.result, signal);
+      expect(killed.signal, killed.stderr).toBe("SIGKILL");
+      const abandoned = JSON.parse(
+        await fs.readFile(shared.statePath("node-host-runner.lock"), "utf8"),
+      );
+      expect(abandoned.pid).toBe(next.child.pid);
+      const recovered = launch(shared, "recovered-owner");
+      await waitConnected("recovered-owner", recovered);
+      await stop(recovered);
+      expect(frames).toEqual(["first-owner", "independent-owner", "next-owner", "recovered-owner"]);
+    } finally {
+      for (const runner of runners) {
+        if (runner.child.exitCode === null && runner.child.signalCode === null) {
+          runner.child.kill("SIGTERM");
+        }
+      }
