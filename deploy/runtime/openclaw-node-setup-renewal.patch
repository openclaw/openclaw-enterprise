+import { runNodeHost } from ${JSON.stringify(runnerUrl.href)};
+import { withCliProcessScope, withCliCommandCleanup } from ${JSON.stringify(cleanupUrl.href)};
+import { runCliWithExitFinalization } from ${JSON.stringify(finalizerUrl.href)};
+await withCliProcessScope(() => runCliWithExitFinalization({
+  run: () => withCliCommandCleanup(false, () => runNodeHost({
+    gatewayHost: "127.0.0.1",
+    gatewayPort: Number(process.argv[2]),
+    displayName: process.argv[3],
+    commands: ["fs.listDir"],
+    ephemeral: true,
+  })),
+  onError(error) {
+    console.error("runner rejected:", error?.code, String(error));
+    process.exitCode = 1;
+  },
