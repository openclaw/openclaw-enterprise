+    "--share-installed-apps",
+    "--no-share-installed-apps",
+    "--all-commands",
+    "--require-device-auth",
+    "--auth-from-env",
+  ]);
+  const values = new Map<string, string | true>();
+  if (start < 0) {
+    return undefined;
+  }
+  for (let index = start + 2; index < argv.length; index++) {
+    const argument = argv[index]!;
+    const inlineValue = /^(--display-name|--node-id)=(.*)$/su.exec(argument);
+    const flag = inlineValue?.[1] ?? argument;
+    if (values.has(flag) || (!valued.has(flag) && !boolean.has(flag))) {
+      throw new Error(
+        "Paired node service has ambiguous or unsupported options; reconnect with connect --service.",
+      );
