index 0000000..8d2735f
--- /dev/null
+++ b/extensions/codex/src/app-server/external-workspace-owner.test.ts
@@ -0,0 +1,394 @@
+import { execFileSync } from "node:child_process";
+import { once } from "node:events";
+import {
+  chmod,
+  mkdir,
+  mkdtemp,
+  readFile,
+  rename,
+  rm,
+  symlink,
+  writeFile,
+} from "node:fs/promises";
+import { createServer } from "node:https";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { WebSocketServer } from "ws";
+import { TEST_TLS_CERT_PEM } from "../../../../test/helpers/tls-fixture.js";
+import {
+  allowsExternalWorkspaceRequest,
+  externalWorkspaceRequestRefusal,
+  matchesExternalWorkspaceGeneration,
+  readExternalWorkspaceOwner,
+} from "./external-workspace-owner.js";
+import { createWebSocketTransport } from "./transport-websocket.js";
+
+const workspaceRoot = "/home/node/workspace";
+it("describes an external workspace refusal with fixed codes without echoing caller data", () => {
+  const owner = { workspaceRoot };
+  const privateArgument = "/synthetic/caller-controlled";
+  expect(externalWorkspaceRequestRefusal(owner, privateArgument, {})).toBe("rpc-not-allowed");
+  expect(
+    externalWorkspaceRequestRefusal(owner, "thread/inject_items", { input: privateArgument }),
+  ).toBe("rpc-thread-inject-items");
+  expect(
+    externalWorkspaceRequestRefusal(owner, "thread/start", {
+      cwd: privateArgument,
+      sandbox: "workspace-write",
+    }),
+  ).toBe("thread/start:cwd");
+  expect(
+    externalWorkspaceRequestRefusal(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "restricted" },
+    }),
+  ).toBeUndefined();
+});
+
+const generationSha256 = "a".repeat(64);
+const authToken = "fixture-native-transport-capability";
+const header = "X-OpenClaw-Workspace-Generation";
+const owner = { workspaceRoot };
+
+it("does not inherit an earlier external policy on an implicit or global-danger turn", () => {
+  expect(allowsExternalWorkspaceRequest(owner, "turn/start", {})).toBe(false);
+  expect(
+    allowsExternalWorkspaceRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      permissions: ":danger-full-access",
+    }),
+  ).toBe(false);
+  expect(
+    allowsExternalWorkspaceRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "dangerFullAccess" },
+    }),
+  ).toBe(false);
+  expect(
+    allowsExternalWorkspaceRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "enabled" },
+    }),
+  ).toBe(false);
+  expect(
+    allowsExternalWorkspaceRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "restricted" },
+    }),
+  ).toBe(true);
+  expect(
+    allowsExternalWorkspaceRequest(owner, "turn/start", {
+      cwd: workspaceRoot + "/nested",
+      sandboxPolicy: { type: "readOnly", networkAccess: false },
+    }),
+  ).toBe(true);
+  const policy = { type: "externalSandbox", networkAccess: "restricted" };
+  expect(
+    allowsExternalWorkspaceRequest(owner, "turn/start", {
+      cwd: "/tmp",
+      sandboxPolicy: policy,
+    }),
+  ).toBe(false);
+  expect(
+    allowsExternalWorkspaceRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: policy,
+      environments: [{ environmentId: "foreign" }],
+    }),
+  ).toBe(false);
+  expect(
+    allowsExternalWorkspaceRequest(owner, "command/exec", {
+      cwd: workspaceRoot,
+      sandboxPolicy: policy,
+    }),
+  ).toBe(false);
+  expect(allowsExternalWorkspaceRequest(owner, "thread/shellCommand", {})).toBe(
+    false,
+  );
+  expect(allowsExternalWorkspaceRequest(owner, "thread/read", {})).toBe(true);
+  expect(
+    allowsExternalWorkspaceRequest(owner, "thread/start", {
+      cwd: workspaceRoot,
+      sandbox: "workspace-write",
+      environments: [],
+    }),
+  ).toBe(true);
+});
+
+it("uses only the closed provider mount for the exact Compute route and capability", async () => {
+  const root = await mkdtemp(join(tmpdir(), "openclaw-external-workspace-"));
+  const parent = join(root, "etc");
+  const directory = join(parent, "owner");
+  const bindingPath = join(directory, "binding.json");
+  const caPath = join(directory, "ca.pem");
+  const scope = { root, ancestry: ["etc", "owner"], uid: process.getuid!() };
+  try {
+    const url = "wss://workspace-harness.example.svc.cluster.local:8443/";
+    const input = {
+      transport: "websocket",
+      url,
+      workspaceRoot,
+      authToken,
+      computeUrl: url,
+      computeToken: authToken,
+      headers: {},
+    };
+    await mkdir(parent, { mode: 0o755 });
+    expect(readExternalWorkspaceOwner(input, scope)).toBeUndefined();
+    const unmapped = { ...scope, uid: scope.uid + 1 };
+    expect(readExternalWorkspaceOwner(input, unmapped)).toBeUndefined();
+    await mkdir(directory, { mode: 0o755 });
+    expect(() => readExternalWorkspaceOwner(input, scope)).toThrow(
+      "external workspace binding is invalid",
+    );
+    await writeFile(
+      bindingPath,
+      JSON.stringify({ format: "external-workspace-v1", url, workspaceRoot, generationSha256 }),
+      { mode: 0o444 },
+    );
+    expect(() => readExternalWorkspaceOwner(input, scope)).toThrow(
+      "external workspace binding is invalid",
+    );
+    await writeFile(caPath, TEST_TLS_CERT_PEM, { mode: 0o444 });
+    const owner = readExternalWorkspaceOwner(input, scope);
+    expect(() => readExternalWorkspaceOwner(input, unmapped)).toThrow(
+      "external workspace binding is invalid",
+    );
+    expect(owner).toMatchObject({
+      url,
+      workspaceRoot,
+      generationSha256,
+      ca: TEST_TLS_CERT_PEM,
+    });
+    expect(() => owner!.assertCurrent()).not.toThrow();
+    for (const invalid of [
+      { url: "wss://elsewhere/" },
+      { transport: "stdio" },
+      { computeToken: "other" },
+      { workspaceRoot: "/home/node/other" },
+    ]) {
+      expect(() =>
+        readExternalWorkspaceOwner({ ...input, ...invalid }, scope),
+      ).toThrow("external workspace binding is invalid");
+    }
+    expect(
+      matchesExternalWorkspaceGeneration(owner!, {
+        rawHeaders: [header, generationSha256, header, generationSha256],
+      }),
+    ).toBe(false);
+    await chmod(parent, 0o777);
+    expect(() => owner!.assertCurrent()).toThrow("external workspace binding is invalid");
+    expect(() => readExternalWorkspaceOwner(input, scope)).toThrow(
+      "external workspace binding is invalid",
+    );
+    await chmod(parent, 0o755);
+    await rename(caPath, caPath + ".old");
+    await symlink("ca.pem.old", caPath);
+    expect(() => owner!.assertCurrent()).toThrow("external workspace binding is invalid");
+    expect(() => readExternalWorkspaceOwner(input, scope)).toThrow(
+      "external workspace binding is invalid",
+    );
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+it("accepts only the versioned binding with the provider's own normalized root", async () => {
+  const url = "wss://workspace-harness.example.svc.cluster.local:8443/";
+  const format = "external-workspace-v1";
+  const cases: [Record<string, string>, boolean][] = [
+    [{ format, url, workspaceRoot: "/srv/workspace", generationSha256 }, true],
+    [{ url, workspaceRoot, generationSha256 }, false],
+    [{ format: "external-workspace-v2", url, workspaceRoot, generationSha256 }, false],
+    [{ format, url, workspaceRoot: "/", generationSha256 }, false],
+    [{ format, url, workspaceRoot: "/srv/workspace/", generationSha256 }, false],
+    [{ format, url, workspaceRoot: "/srv/../workspace", generationSha256 }, false],
+    [{ format, url, workspaceRoot: "srv/workspace", generationSha256 }, false],
+  ];
+  for (const [binding, accepted] of cases) {
+    const root = await mkdtemp(join(tmpdir(), "openclaw-external-workspace-format-"));
+    try {
+      const directory = join(root, "etc", "owner");
+      await mkdir(directory, { recursive: true, mode: 0o755 });
+      await writeFile(join(directory, "binding.json"), JSON.stringify(binding), { mode: 0o444 });
+      await writeFile(join(directory, "ca.pem"), TEST_TLS_CERT_PEM, { mode: 0o444 });
+      const input = {
+        transport: "websocket",
+        url,
+        workspaceRoot: binding.workspaceRoot,
+        authToken,
+        computeUrl: url,
+        computeToken: authToken,
+        headers: {},
+      };
+      const read = () =>
+        readExternalWorkspaceOwner(input, {
+          root,
+          ancestry: ["etc", "owner"],
+          uid: process.getuid!(),
+        });
+      if (accepted) {
+        expect(read()).toMatchObject({ workspaceRoot: binding.workspaceRoot, generationSha256 });
+      } else {
+        expect(read, JSON.stringify(binding)).toThrow("external workspace binding is invalid");
+      }
+    } finally {
+      await rm(root, { recursive: true, force: true });
+    }
+  }
+});
+
+it("delivers native frames only on the CA-pinned original generation, including after withdrawal", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "openclaw-external-workspace-tls-"));
+  const certPath = join(directory, "cert.pem");
+  const keyPath = join(directory, "key.pem");
+  const [cert, key] = await (async () => {
+    try {
+      execFileSync(
+        "openssl",
+        [
+          "req",
+          "-new",
+          "-x509",
+          "-newkey",
+          "rsa:2048",
+          "-nodes",
+          "-days",
+          "1",
+          "-subj",
+          "/CN=External workspace test CA",
+          "-addext",
+          "basicConstraints=critical,CA:TRUE",
+          "-addext",
+          "subjectAltName=IP:127.0.0.1",
+          "-out",
+          certPath,
+          "-keyout",
+          keyPath,
+        ],
+        { stdio: "ignore" },
+      );
+      return await Promise.all([
+        readFile(certPath, "utf8"),
+        readFile(keyPath, "utf8"),
+      ]);
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  })();
+  const server = createServer({ cert, key });
+  const peer = new WebSocketServer({ server });
+  let generation = generationSha256;
+  const frames: string[] = [];
+  peer.on("headers", (headers) => headers.push(`${header}: ${generation}`));
+  peer.on("connection", (socket) =>
+    socket.on("message", (frame) => frames.push(frame.toString())),
+  );
+  try {
+    server.listen(0, "127.0.0.1");
+    await once(server, "listening");
+    const address = server.address();
+    if (!address || typeof address === "string") {
+      throw new Error("Expected the test's TLS listener.");
+    }
+    const url = `wss://127.0.0.1:${address.port}/`;
+    let current = true;
+    const start = {
+      transport: "websocket" as const,
+      url,
+      authToken,
+      headers: {},
+      command: "codex",
+      args: [],
+      externalWorkspaceOwner: {
+        url,
+        workspaceRoot,
+        generationSha256,
+        ca: cert,
+        assertCurrent() {
+          if (!current) throw new Error("external workspace binding is invalid");
+        },
+      },
+    };
+    const original = createWebSocketTransport(start);
+    const received = new Promise<void>((resolve, reject) => {
+      original.once("error", reject);
+      peer.once("connection", (socket, request) => {
+        expect(request.headers.authorization).toBe(`Bearer ${authToken}`);
+        socket.once("message", () => resolve());
+      });
+    });
+    original.stdin.write('{"id":1,"method":"initialize"}\n');
+    await received;
+    expect(frames).toHaveLength(1);
+    for (const frame of [
+      {
+        method: "command/exec",
+        params: {
+          cwd: workspaceRoot,
+          sandboxPolicy: { type: "dangerFullAccess" },
+        },
+      },
+      {
+        method: "turn/start",
+        params: {
+          cwd: "/tmp",
+          sandboxPolicy: {
+            type: "externalSandbox",
+            networkAccess: "restricted",
+          },
+        },
+      },
+    ]) {
+      const blocked = createWebSocketTransport(start);
+      const refused = new Promise<unknown>((resolve) =>
+        blocked.once("error", resolve),
+      );
+      blocked.stdin.write(JSON.stringify({ id: 3, ...frame }) + "\n");
+      await expect(refused).resolves.toEqual(
+        expect.objectContaining({
+          message: expect.stringContaining("request was refused"),
+        }),
+      );
+      expect(frames).toHaveLength(1);
+    }
+    const closed = new Promise<void>((resolve) =>
+      original.once("exit", () => resolve()),
+    );
+    current = false;
+    const revoked = new Promise<unknown>((resolve) =>
+      original.once("error", resolve),
+    );
+    original.stdin.write('{"id":4,"method":"thread/read","params":{}}\n');
+    await expect(revoked).resolves.toEqual(
+      expect.objectContaining({
+        message: expect.stringContaining("request was refused"),
+      }),
+    );
+    expect(frames).toHaveLength(1);
+    current = true;
+    for (const socket of peer.clients) {
+      socket.terminate();
+    }
+    await closed;
+    generation = "b".repeat(64);
+    const replacement = createWebSocketTransport(start);
+    const rejected = new Promise<unknown>((resolve) =>
+      replacement.once("error", resolve),
+    );
+    replacement.stdin.write('{"id":2,"method":"initialize"}\n');
+    await expect(rejected).resolves.toEqual(
+      expect.objectContaining({
+        message: expect.stringContaining("no longer serving"),
+      }),
+    );
+    expect(frames).toHaveLength(1);
+  } finally {
+    for (const socket of peer.clients) {
+      socket.terminate();
+    }
+    peer.close();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
