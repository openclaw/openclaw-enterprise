index 0000000..3b8d85d
--- /dev/null
+++ b/extensions/codex/src/app-server/external-workspace-owner.ts
@@ -0,0 +1,435 @@
+import { X509Certificate } from "node:crypto";
+import {
+  closeSync,
+  constants,
+  fstatSync,
+  lstatSync,
+  openSync,
+  readSync,
+  type BigIntStats,
+} from "node:fs";
+import type { IncomingMessage } from "node:http";
+import { posix } from "node:path";
+import { isDeepStrictEqual, TextDecoder } from "node:util";
+
+const GENERATION_HEADER = "x-openclaw-workspace-generation";
+const BINDING_FORMAT = "external-workspace-v1";
+const SHA256 = /^[a-f0-9]{64}$/;
+const DIRECTORY_FLAGS =
+  constants.O_RDONLY | constants.O_DIRECTORY | constants.O_NOFOLLOW;
+const FILE_FLAGS =
+  constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK;
+const BINDING_PATH = {
+  root: "/",
+  ancestry: ["etc", "openclaw-external-workspace"],
+  uid: 0,
+};
+const isAbsent = (error: unknown) =>
+  error instanceof Error && "code" in error && error.code === "ENOENT";
+
+// The provider's own root, as Compute validated it: absolute, normalized, never "/".
+function isWorkspaceRoot(value: unknown): value is string {
+  return (
+    typeof value === "string" &&
+    value !== "/" &&
+    posix.isAbsolute(value) &&
+    posix.normalize(value) === value &&
+    !value.endsWith("/") &&
+    [...value].every((char) => char >= " " && char !== "\u007f")
+  );
+}
+
+export type ExternalWorkspaceOwner = {
+  url: string;
+  workspaceRoot: string;
+  generationSha256: string;
+  ca: string;
+  assertCurrent: () => void;
+};
+
+function refusal(): never {
+  throw new Error("The dedicated Codex external workspace binding is invalid.");
+}
+
+function fileIdentity(stat: BigIntStats) {
+  return [
+    stat.dev,
+    stat.ino,
+    stat.uid,
+    stat.gid,
+    stat.mode,
+    stat.nlink,
+    stat.size,
+    stat.mtimeNs,
+    stat.ctimeNs,
+  ];
+}
+
+function directoryIdentity(stat: BigIntStats, uid: number): bigint[] {
+  if (
+    !stat.isDirectory() ||
+    stat.uid !== BigInt(uid) ||
+    (stat.mode & 0o022n) !== 0n
+  ) {
+    return refusal();
+  }
+  return [stat.dev, stat.ino, stat.uid, stat.gid, stat.mode];
+}
+
+function snapshot(
+  path: typeof BINDING_PATH,
+  expected: bigint[],
+  contents: boolean,
+) {
+  const descriptors: number[] = [];
+  const open = (file: string, flags: number) => {
+    const fd = openSync(file, flags);
+    descriptors.push(fd);
+    return fd;
+  };
+  try {
+    let directory = open(path.root, DIRECTORY_FLAGS);
+    const identify = (fd: number) =>
+      directoryIdentity(fstatSync(fd, { bigint: true }), path.uid);
+    const identities = [identify(directory)];
+    for (const component of path.ancestry) {
+      directory = open(
+        `/proc/self/fd/${directory}/${component}`,
+        DIRECTORY_FLAGS,
+      );
+      identities.push(identify(directory));
+    }
+    if (!isDeepStrictEqual(identities.at(-1), expected)) {
+      return refusal();
+    }
+    if (path === BINDING_PATH && process.geteuid?.() === 0) {
+      return refusal();
+    }
+    function read(name: string, limit: number) {
+      const fd = open(`/proc/self/fd/${directory}/${name}`, FILE_FLAGS);
+      const stat = fstatSync(fd, { bigint: true });
+      if (
+        !stat.isFile() ||
+        stat.uid !== BigInt(path.uid) ||
+        stat.nlink !== 1n ||
+        (stat.mode & 0o222n) !== 0n ||
+        stat.size <= 0n ||
+        stat.size > BigInt(limit)
+      ) {
+        return refusal();
+      }
+      const identity = fileIdentity(stat);
+      if (!contents) return { identity };
+      const bytes = Buffer.alloc(Number(stat.size) + 1);
+      let total = 0;
+      while (total < bytes.length) {
+        const count = readSync(fd, bytes, total, bytes.length - total, null);
+        if (count === 0) break;
+        total += count;
+      }
+      if (
+        total !== Number(stat.size) ||
+        !isDeepStrictEqual(
+          fileIdentity(fstatSync(fd, { bigint: true })),
+          identity,
+        )
+      ) {
+        return refusal();
+      }
+      return {
+        identity,
+        text: new TextDecoder("utf-8", { fatal: true }).decode(
+          bytes.subarray(0, total),
+        ),
+      };
+    }
+    const binding = read("binding.json", 4096);
+    const ca = read("ca.pem", 32_768);
+    return {
+      identities: [...identities, binding.identity, ca.identity],
+      binding: binding.text,
+      ca: ca.text,
+    };
+  } finally {
+    for (const fd of descriptors.reverse()) closeSync(fd);
+  }
+}
+
+/** Read only the operator's fixed immutable Gateway mount. Tests supply an isolated anchor. */
+export function readExternalWorkspaceOwner(
+  input: {
+    transport: string;
+    url?: string;
+    workspaceRoot?: string;
+    authToken?: string;
+    computeUrl?: string;
+    computeToken?: string;
+    headers: Record<string, string>;
+  },
+  path = BINDING_PATH,
+): ExternalWorkspaceOwner | undefined {
+  try {
+    let directory: BigIntStats;
+    try {
+      // A genuine absence is the only opt-out. Do this before checking owner
+      // UIDs, which may be unmapped in an ordinary rootless Gateway.
+      directory = lstatSync(posix.join(path.root, ...path.ancestry), {
+        bigint: true,
+      });
+    } catch (error) {
+      if (isAbsent(error)) return undefined;
+      return refusal();
+    }
+    if (process.platform !== "linux") return refusal();
+    const expected = directoryIdentity(directory, path.uid);
+    const selected = snapshot(path, expected, true);
+    const raw = selected.binding?.trim();
+    const ca = selected.ca;
+    if (!raw || !ca) return refusal();
+    const binding: unknown = JSON.parse(raw);
+    if (
+      !binding ||
+      typeof binding !== "object" ||
+      Array.isArray(binding) ||
+      JSON.stringify(binding) !== raw
+    ) {
+      return refusal();
+    }
+    const { format, url, workspaceRoot, generationSha256 } = binding as Record<string, unknown>;
+    if (
+      Object.keys(binding).length !== 4 ||
+      format !== BINDING_FORMAT ||
+      typeof url !== "string" ||
+      !isWorkspaceRoot(workspaceRoot) ||
+      typeof generationSha256 !== "string" ||
+      !SHA256.test(generationSha256) ||
+      input.transport !== "websocket" ||
+      input.url !== url ||
+      input.computeUrl !== url ||
+      input.workspaceRoot !== workspaceRoot ||
+      !input.authToken ||
+      input.computeToken !== input.authToken ||
+      Object.keys(input.headers).length !== 0
+    ) {
+      return refusal();
+    }
+    const origin = new URL(url);
+    if (
+      origin.protocol !== "wss:" ||
+      origin.pathname !== "/" ||
+      origin.username ||
+      origin.password ||
+      origin.search ||
+      origin.hash ||
+      origin.href !== url
+    ) {
+      return refusal();
+    }
+    const certificates = ca
+      .trim()
+      .match(
+        /-----BEGIN CERTIFICATE-----\r?\n(?:[a-zA-Z0-9+/=]+\r?\n)+-----END CERTIFICATE-----/g,
+      );
+    if (
+      !certificates ||
+      ca.trim() !== certificates.join(ca.includes("\r\n") ? "\r\n" : "\n")
+    ) {
+      return refusal();
+    }
+    for (const certificate of certificates) new X509Certificate(certificate);
+    return {
+      url,
+      workspaceRoot,
+      generationSha256,
+      ca,
+      assertCurrent() {
+        try {
+          if (
+            !isDeepStrictEqual(
+              snapshot(path, expected, false).identities,
+              selected.identities,
+            )
+          )
+            return refusal();
+        } catch {
+          return refusal();
+        }
+      },
+    };
+  } catch {
+    return refusal();
+  }
+}
+
+export function matchesExternalWorkspaceGeneration(
+  owner: ExternalWorkspaceOwner,
+  response: Pick<IncomingMessage, "rawHeaders">,
+): boolean {
+  const values: string[] = [];
+  for (let i = 0; i < response.rawHeaders.length; i += 2) {
+    if (response.rawHeaders[i]?.toLowerCase() === GENERATION_HEADER) {
+      values.push(response.rawHeaders[i + 1] ?? "");
+    }
+  }
+  return values.length === 1 && values[0] === owner.generationSha256;
+}
+
+const CHAT_CONTROL = new Set([
+  "initialize",
+  "initialized",
+  "thread/read",
+  "thread/list",
+  "thread/loaded/list",
+  "thread/unsubscribe",
+  "turn/steer",
+  "turn/interrupt",
+  "model/list",
+  "config/read",
+  "configRequirements/read",
+  "hooks/list",
+  "mcpServerStatus/list",
+  "plugin/list",
+  "plugin/installed",
+  "plugin/read",
+  "app/installed",
+  "account/read",
+  "account/rateLimits/read",
+  "modelProvider/capabilities/read",
+  "skills/list",
+  "thread/turns/list",
+  "thread/items/list",
+]);
+const THREAD_BINDING = new Set([
+  "thread/start",
+  "thread/resume",
+  "thread/fork",
+]);
+
+// Keep rejected method names closed over known protocol literals. An arbitrary
+// caller-provided name must never appear in a Gateway error or model reply.
+const knownDeniedRpcEntries = [
+  ["account/login/start", "rpc-account-login"],
+  ["app/read", "rpc-app-read"],
+  ["command/exec", "rpc-direct-exec"],
+  ["config/batchWrite", "rpc-config-write"],
+  ["config/mcpServer/reload", "rpc-mcp-reload"],
+  ["environment/add", "rpc-environment-add"],
+  ["environment/remove", "rpc-environment-remove"],
+  ["experimentalFeature/list", "rpc-experimental-features"],
+  ["marketplace/add", "rpc-marketplace-add"],
+  ["marketplace/remove", "rpc-marketplace-remove"],
+  ["thread/backgroundTerminals/list", "rpc-background-terminals"],
+  ["thread/goal/get", "rpc-thread-goal"],
+  ["thread/inject_items", "rpc-thread-inject-items"],
+  ["thread/metadata/update", "rpc-thread-metadata"],
+  ["thread/shellCommand", "rpc-thread-shell"],
+] as const;
+
+type ExternalWorkspaceKnownDeniedRpc = (typeof knownDeniedRpcEntries)[number][1];
+const KNOWN_DENIED_RPC_DIAGNOSTICS = new Map<string, ExternalWorkspaceKnownDeniedRpc>(
+  knownDeniedRpcEntries,
+);
+
+type ExternalWorkspaceRequestRefusal =
+  | "rpc-not-allowed"
+  | ExternalWorkspaceKnownDeniedRpc
+  | `thread/${"start" | "resume" | "fork"}:${"params" | "cwd" | "permissions" | "environments" | "roots" | "path" | "sandbox-policy" | "sandbox" | "config"}`
+  | `turn/start:${"params" | "cwd" | "permissions" | "environments" | "roots" | "sandbox" | "sandbox-policy" | "external-policy" | "read-only-policy" | "workspace-write-policy"}`;
+
+function isExternalWorkspaceThreadBinding(
+  method: string,
+): method is "thread/start" | "thread/resume" | "thread/fork" {
+  return THREAD_BINDING.has(method);
+}
+
+/** Check the fixed RPC set without reflecting method or argument data into failures. */
+export function externalWorkspaceRequestRefusal(
+  owner: Pick<ExternalWorkspaceOwner, "workspaceRoot">,
+  method: string,
+  params: unknown,
+): ExternalWorkspaceRequestRefusal | undefined {
+  if (CHAT_CONTROL.has(method)) return;
+  if (method !== "turn/start" && !isExternalWorkspaceThreadBinding(method)) {
+    return KNOWN_DENIED_RPC_DIAGNOSTICS.get(method) ?? "rpc-not-allowed";
+  }
+  if (!params || typeof params !== "object" || Array.isArray(params)) return `${method}:params`;
+  const {
+    cwd,
+    environments,
+    runtimeWorkspaceRoots,
+    sandbox,
+    sandboxPolicy,
+    permissions,
+    path,
+    config,
+  } = params as Record<string, unknown>;
+  const inside = (path: unknown): path is string =>
+    typeof path === "string" &&
+    !path.includes("\0") &&
+    posix.normalize(path) === path &&
+    (path === owner.workspaceRoot ||
+      path.startsWith(owner.workspaceRoot + "/"));
+  if (!inside(cwd)) return `${method}:cwd`;
+  if (permissions !== undefined) return `${method}:permissions`;
+  if (environments !== undefined && (!Array.isArray(environments) || environments.length !== 0)) {
+    return `${method}:environments`;
+  }
+  if (
+    runtimeWorkspaceRoots !== undefined &&
+    (!Array.isArray(runtimeWorkspaceRoots) || !runtimeWorkspaceRoots.every(inside))
+  ) {
+    return `${method}:roots`;
+  }
+  if (method !== "turn/start") {
+    if (path !== undefined) return `${method}:path`;
+    if (sandboxPolicy !== undefined) return `${method}:sandbox-policy`;
+    if (sandbox !== "read-only" && sandbox !== "workspace-write") return `${method}:sandbox`;
+    if (
+      config !== undefined &&
+      (config === null ||
+        typeof config !== "object" ||
+        Array.isArray(config) ||
+        Object.keys(config).some((key) =>
+          /^(?:default_permissions|permissions|sandbox_mode|sandbox_workspace_write)(?:\.|$)/.test(
+            key,
+          ),
+        ))
+    ) {
+      return `${method}:config`;
+    }
+    return;
+  }
+  if (sandbox !== undefined) return "turn/start:sandbox";
+  if (!sandboxPolicy || typeof sandboxPolicy !== "object" || Array.isArray(sandboxPolicy)) {
+    return "turn/start:sandbox-policy";
+  }
+  const { type, networkAccess, writableRoots } = sandboxPolicy as Record<string, unknown>;
+  if (type === "externalSandbox") {
+    return cwd === owner.workspaceRoot &&
+      networkAccess === "restricted" &&
+      runtimeWorkspaceRoots === undefined &&
+      Object.keys(sandboxPolicy).length === 2
+      ? undefined
+      : "turn/start:external-policy";
+  }
+  if (type === "readOnly") {
+    return typeof networkAccess === "boolean" && writableRoots === undefined
+      ? undefined
+      : "turn/start:read-only-policy";
+  }
+  return type === "workspaceWrite" &&
+    typeof networkAccess === "boolean" &&
+    Array.isArray(writableRoots) &&
+    writableRoots.every(inside)
+    ? undefined
+    : "turn/start:workspace-write-policy";
+}
+
+/** Authorize the fixed chat RPC set before sending it over the selected owner's WSS. */
+export function allowsExternalWorkspaceRequest(
+  owner: Pick<ExternalWorkspaceOwner, "workspaceRoot">,
+  method: string,
+  params: unknown,
+): boolean {
+  return externalWorkspaceRequestRefusal(owner, method, params) === undefined;
+}
