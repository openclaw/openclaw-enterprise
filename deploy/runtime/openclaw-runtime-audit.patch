@@ -0,0 +1,193 @@
+import { execFileSync } from "node:child_process";
+import { once } from "node:events";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { createServer } from "node:http";
+import { createServer as createHttpsServer } from "node:https";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it, vi } from "vitest";
+import {
+  admitOpenClawRuntimeAuditTurn,
+  blockOpenClawRuntimeAuditTurn,
+  initializeOpenClawRuntimeAudit,
+  recordOpenClawRuntimeAudit,
+  startOpenClawRuntimeAuditTurn,
+  withOpenClawRuntimeAuditTurn,
+} from "./openclaw-runtime-audit.js";
+
+it("delivers a turn to loopback with the same retry receipt and fences a refused admission", async () => {
+  const requests: Array<{ authorization?: string; source?: string | string[]; payload: string }> =
+    [];
+  let rejectAdmission = false;
+  const server = createServer(async (request, response) => {
+    const chunks: Buffer[] = [];
+    for await (const chunk of request) {
+      chunks.push(Buffer.from(chunk));
+    }
+    requests.push({
+      authorization: request.headers.authorization,
+      source: request.headers["x-openclaw-runtime-audit-source"],
+      payload: Buffer.concat(chunks).toString("utf8"),
+    });
+    const event = JSON.parse(requests.at(-1)!.payload) as { action: string };
+    const status =
+      requests.length === 1
+        ? 503
+        : rejectAdmission && event.action === "openclaw.runtime.turn.admitted"
+          ? 401
+          : 201;
+    response.writeHead(status).end();
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  try {
+    const address = server.address();
+    if (!address || typeof address === "string") {
+      throw new Error("Fixture failed to get a loopback address");
+    }
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_URL", `http://127.0.0.1:${address.port}/runtime-audit`);
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_TOKEN", "fixture-audit-token");
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_TOKEN_PATH", undefined);
+    vi.stubEnv("OPENCLAW_RUNTIME_AUDIT_CA_PATH", undefined);
+    initializeOpenClawRuntimeAudit();
+    expect(process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN).toBeUndefined();
+
+    const identity = { sessionId: "host-session", runId: "client-idempotency-key" };
+    await withOpenClawRuntimeAuditTurn(
+      identity,
+      async () => {
+        await admitOpenClawRuntimeAuditTurn(identity, "committed-transcript-entry");
+        await startOpenClawRuntimeAuditTurn(identity.runId);
+      },
+      () => "succeeded",
+    );
+    expect(requests).toHaveLength(4);
+    expect(requests[0]).toEqual(requests[1]);
+    expect(requests.map((request) => request.authorization)).toEqual(
+      Array<string>(4).fill("Bearer fixture-audit-token"),
+    );
+    expect(requests.map((request) => request.source)).toEqual(Array<string>(4).fill("openclaw"));
+    const events = requests.slice(1).map(({ payload }) => JSON.parse(payload));
+    expect(events.map(({ action }) => action)).toEqual([
+      "openclaw.runtime.turn.admitted",
+      "openclaw.runtime.turn.started",
+      "openclaw.runtime.turn.completed",
+    ]);
+    expect(events[0]).toMatchObject({
+      sessionId: "host-session",
+      messageId: "committed-transcript-entry",
+      turnId: expect.any(String),
+      eventId: expect.stringMatching(/^[0-9a-f-]{36}$/),
+    });
+    expect(events[0].turnId).not.toBe(identity.runId);
+    expect(events[2]).toMatchObject({ turnId: events[0].turnId, outcome: "succeeded" });
+
+    await withOpenClawRuntimeAuditTurn(
+      identity,
+      async () => {
+        blockOpenClawRuntimeAuditTurn(identity.runId);
+      },
+      () => "failed",
+    );
+    expect(requests).toHaveLength(5);
+    const [blocked] = requests.slice(4).map(({ payload }) => JSON.parse(payload));
+    expect(blocked).toMatchObject({
+      action: "openclaw.runtime.turn.completed",
+      outcome: "blocked",
+    });
+    expect(blocked).not.toHaveProperty("messageId");
+
+    rejectAdmission = true;
+    const effect = vi.fn();
+    await expect(
+      withOpenClawRuntimeAuditTurn(
+        identity,
+        async () => {
+          await admitOpenClawRuntimeAuditTurn(identity);
+          effect();
+        },
+        () => "succeeded",
+      ),
+    ).rejects.toThrow("runtime audit did not accept the event");
+    expect(effect).not.toHaveBeenCalled();
+
+    await recordOpenClawRuntimeAudit(
+      { action: "openclaw.runtime.turn.completed", outcome: "blocked" },
+      "codex",
+    );
+    expect(requests.at(-1)?.source).toBe("codex");
+  } finally {
+    vi.unstubAllEnvs();
+    await new Promise<void>((resolve, reject) => {
+      server.close((error) => (error ? reject(error) : resolve()));
+    });
+  }
+});
+
+it("uses the projected CA only for audit requests", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "openclaw-audit-ca-"));
+  const caPath = join(directory, "ca.pem");
+  const keyPath = join(directory, "key.pem");
+  try {
+    execFileSync(
+      "openssl",
+      [
+        "req",
+        "-x509",
+        "-newkey",
+        "rsa:2048",
+        "-noenc",
+        "-keyout",
+        keyPath,
+        "-out",
+        caPath,
+        "-days",
+        "1",
+        "-subj",
+        "/CN=Runtime Audit Test",
+        "-addext",
+        "subjectAltName=IP:127.0.0.1",
+      ],
+      { stdio: "ignore" },
+    );
+    const requests: Array<{ url?: string; authorization?: string }> = [];
+    const server = createHttpsServer(
+      { cert: await readFile(caPath), key: await readFile(keyPath) },
+      (request, response) => {
+        requests.push({ url: request.url, authorization: request.headers.authorization });
+        request.resume();
+        response.writeHead(204).end();
+      },
+    );
+    server.listen(0, "127.0.0.1");
+    await once(server, "listening");
+    try {
+      const address = server.address();
+      if (!address || typeof address === "string") {
+        throw new Error("Fixture failed to get a loopback address");
