@@ -0,0 +1,28 @@
+import { Type, type Static } from "typebox";
+import { Value } from "typebox/value";
+import { createProtocolValidator } from "../protocol-validator.js";
+import { closedObject } from "./closed-object.js";
+import { LiveIntegerSchema, workerResponseSchema } from "./worker-protocol-primitives.js";
+
+export const WORKER_MODEL_OBSERVATION_METHOD = "worker.model.observe";
+
+const ModelObservation = closedObject({
+  runEpoch: LiveIntegerSchema,
+  modelCallId: Type.String({
+    pattern: "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
+  }),
+  stage: Type.Enum(["started", "succeeded", "failed", "cancelled"]),
+});
+
+export type WorkerModelObservation = Static<typeof ModelObservation>;
+export type WorkerModelObserver = (call: Omit<WorkerModelObservation, "runEpoch">) => Promise<void>;
+
+export function validateWorkerModelObservation(input: unknown): input is WorkerModelObservation {
+  return Value.Check(ModelObservation, input);
+}
+
+const ResponseFrame = workerResponseSchema(closedObject({ recorded: Type.Literal(true) }));
+export const validateWorkerModelObservationResponse = createProtocolValidator(
+  ResponseFrame,
+  (input: unknown): input is Static<typeof ResponseFrame> => Value.Check(ResponseFrame, input),
+);
