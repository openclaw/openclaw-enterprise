+            OPENCLAW_RUNTIME_AUDIT_URL: url,
+            OPENCLAW_RUNTIME_AUDIT_SOURCE: "codex",
+          },
+          timeout: 10_000,
+          stdio: ["ignore", "ignore", "pipe"],
