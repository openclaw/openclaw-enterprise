+/** OpenClaw Enterprise runtime audit sender. */
+import { randomUUID } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { setTimeout as delay } from "node:timers/promises";
+import { Agent, fetch as fetchWithDispatcher } from "undici";
+import type { WorkerModelObserver } from "../../packages/gateway-protocol/src/schema/worker-model-observation.js";
+import type {
+  WorkerToolAuditObservation,
+  WorkerToolAuditObserver,
+} from "../../packages/gateway-protocol/src/schema/worker-tool-audit.js";
+import { AsyncContext } from "../shared/async-context.js";
+import {
+  createManagedAuditSender,
+  RejectedAuditDelivery,
+} from "./openclaw-runtime-audit-delivery.js";
+
+export type OpenClawRuntimeAuditOutcome =
+  | "succeeded"
+  | "failed"
+  | "cancelled"
+  | "blocked"
+  | "unknown";
+
+type TurnIds = { sessionId: string; turnId: string; messageId?: string };
+type EventIds = { eventId?: string; occurredAt?: string };
+type WorkerPolicyEvent = Extract<
+  WorkerToolAuditObservation,
+  { action: "openclaw.runtime.policy.decided" }
+>;
+export type RuntimeToolPolicy =
+  | WorkerPolicyEvent["policy"]
+  | "managed_mcp_policy"
+  | "codex_policy"
+  | "codex_guardian";
+type WorkerApprovalEvent = Extract<
+  WorkerToolAuditObservation,
+  { action: "openclaw.runtime.approval.resolved" }
+>;
+type ToolObservation =
+  | Exclude<WorkerToolAuditObservation, WorkerPolicyEvent | WorkerApprovalEvent>
+  | (Omit<WorkerPolicyEvent, "policy"> & { policy: RuntimeToolPolicy })
+  | (Omit<WorkerApprovalEvent, "decision"> & {
+      decision: WorkerApprovalEvent["decision"] | "allow-session";
+    });
+export type RuntimeToolOutcome = Extract<
+  ToolObservation,
+  { action: "openclaw.runtime.tool_attempt.completed" }
+>["outcome"];
+export type RuntimeApprovalDecision = Extract<
+  ToolObservation,
+  { action: "openclaw.runtime.approval.resolved" }
+>["decision"];
+
+export type OpenClawRuntimeAuditEvent =
+  | (ToolObservation & EventIds & TurnIds)
+  | {
+      action:
+        | "openclaw.runtime.session.started"
+        | "openclaw.runtime.session.ended"
+        | "openclaw.runtime.turn.admitted"
+        | "openclaw.runtime.turn.started"
+        | "openclaw.runtime.turn.completed"
+        | "openclaw.runtime.model_call.started"
+        | "openclaw.runtime.model_call.completed";
+      eventId?: string;
+      occurredAt?: string;
+      sessionId?: string;
+      nativeSessionId?: string;
+      turnId?: string;
+      messageId?: string;
+      modelCallId?: string;
+      model?: string;
+      provider?: string;
+      outcome?: OpenClawRuntimeAuditOutcome;
+    };
+
+type Destination = { url: URL; token: string };
+type AuditResponse = { ok: boolean; status: number; body: { cancel: () => Promise<void> } | null };
+type AuditPost = (
+  url: URL,
+  options: {
+    method: "POST";
+    headers: Record<string, string>;
+    body: string;
+    redirect: "error";
+    signal: AbortSignal;
+  },
+) => Promise<AuditResponse>;
+type RuntimeAuditSource = "openclaw" | "codex";
+type Turn = {
+  sessionId: string;
+  runId: string;
+  turnId: string;
+  messageId?: string;
+  admission?: Promise<void>;
+  started?: Promise<void>;
+  observations: Set<Promise<void>>;
+  blocked?: true;
+  active: boolean;
+};
+
+const state = {
+  source: "openclaw" as RuntimeAuditSource,
+  sender: undefined as ((body: string, source: RuntimeAuditSource) => Promise<void>) | undefined,
+  initialized: false,
+  initializationError: undefined as Error | undefined,
+  workerTool: new AsyncContext<WorkerToolAuditObserver>(
+    Symbol.for("openclaw.enterpriseRuntimeAudit.workerTool"),
+  ),
+  tool: new AsyncContext<ToolCall>(Symbol.for("openclaw.enterpriseRuntimeAudit.tool")),
+  turn: new AsyncContext<Turn>(Symbol.for("openclaw.enterpriseRuntimeAudit.turn")),
+};
+
+/** Consume the settings before the Gateway starts any turn. */
+export function initializeOpenClawRuntimeAudit(): void {
+  if (state.initializationError) {
+    throw state.initializationError;
+  }
+  if (state.initialized) {
+    return;
+  }
+  const source = process.env.OPENCLAW_RUNTIME_AUDIT_SOURCE ?? "openclaw";
+  const candidate = process.env.OPENCLAW_RUNTIME_AUDIT_URL;
+  const tokenValue = process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN;
+  const tokenPath = process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN_PATH;
+  const caPath = process.env.OPENCLAW_RUNTIME_AUDIT_CA_PATH;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_SOURCE;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_URL;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN_PATH;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_CA_PATH;
+  if (!candidate && !tokenValue && !tokenPath && !caPath) {
+    state.initialized = true;
+    return;
+  }
+  try {
+    const url = new URL(candidate ?? "");
+    const loopback = url.hostname === "127.0.0.1" || url.hostname === "[::1]";
+    if (
+      (source !== "openclaw" && source !== "codex") ||
+      (url.protocol !== "https:" && !(loopback && url.protocol === "http:")) ||
+      url.username ||
+      url.password ||
+      url.hash ||
+      url.search ||
+      (caPath && url.protocol !== "https:") ||
+      (tokenPath && tokenValue)
+    ) {
+      throw new Error("Invalid audit configuration");
+    }
+    const token = (tokenPath ? readFileSync(tokenPath, "utf8") : tokenValue)?.trim();
+    if (!token || !/^[A-Za-z0-9._~+/-]+=*$/.test(token)) {
+      throw new Error("Invalid audit credential");
+    }
+    let post: AuditPost = globalThis.fetch;
+    if (caPath) {
+      const dispatcher = new Agent({ connect: { ca: readFileSync(caPath, "utf8") } });
+      post = (url, options) => fetchWithDispatcher(url, { ...options, dispatcher });
+    }
+    state.source = source;
+    const destination = { url, token };
+    const deliver = (body: string, observedSource: RuntimeAuditSource) =>
+      deliverAuditEvent(destination, body, observedSource, post);
+    state.sender = tokenPath
+      ? createManagedAuditSender(source, destination, (body) => deliver(body, source))
+      : deliver;
+    state.initialized = true;
+  } catch {
+    // Neither parsing errors nor filesystem errors may disclose bootstrap configuration.
+    state.initializationError = new Error(
+      "Invalid OpenClaw Enterprise runtime audit configuration",
+    );
+    throw state.initializationError;
+  }
+}
+
+export function hasOpenClawRuntimeAudit(): boolean {
+  return state.sender !== undefined;
+}
+
+export async function recordGatewaySessionAudit(
+  action: "openclaw.runtime.session.started" | "openclaw.runtime.session.ended",
+  sessionId: string,
+): Promise<void> {
+  // Codex reports the start when it creates a native thread. The Gateway
+  // reports deletion for either harness and uses the same host session ID.
+  if (
+    !state.sender ||
+    (action === "openclaw.runtime.session.started" && state.source === "codex")
+  ) {
+    return;
+  }
+  await recordObservedOpenClawRuntimeAudit({ action, sessionId }, state.source);
+}
+
+export async function recordOpenClawRuntimeAudit(
+  event: OpenClawRuntimeAuditEvent,
+  source: RuntimeAuditSource = "openclaw",
+): Promise<void> {
+  if (!state.sender) {
+    return;
+  }
+  // Retry ambiguous writes with the same event ID and exact payload.
+  await state.sender(
+    JSON.stringify({
+      ...event,
+      eventId: event.eventId ?? randomUUID(),
+      occurredAt: event.occurredAt ?? new Date().toISOString(),
+    }),
+    source,
+  );
+}
+
+async function deliverAuditEvent(
+  destination: Destination,
+  body: string,
+  source: RuntimeAuditSource,
+  post: AuditPost,
+): Promise<void> {
+  for (const retryDelay of [0, 100, 300]) {
+    if (retryDelay) {
+      await delay(retryDelay);
+    }
+    let response: AuditResponse;
+    try {
+      response = await post(destination.url, {
+        method: "POST",
+        headers: {
+          Authorization: `Bearer ${destination.token}`,
+          "Content-Type": "application/json",
+          "X-OpenClaw-Runtime-Audit-Source": source,
+        },
+        body,
+        redirect: "error",
+        signal: AbortSignal.timeout(2_000),
+      });
+    } catch {
+      continue;
+    }
+    void response.body?.cancel().catch(() => undefined);
+    if (response.ok) {
+      return;
+    }
+    if (response.status !== 408 && response.status !== 429 && response.status < 500) {
+      throw new RejectedAuditDelivery("OpenClaw Enterprise runtime audit did not accept the event");
+    }
+  }
+  throw new Error("OpenClaw Enterprise runtime audit did not accept the event");
+}
+
+/** An observation cannot retroactively undo an operation that has already settled. */
+export async function recordObservedOpenClawRuntimeAudit(
+  event: OpenClawRuntimeAuditEvent,
+  source: RuntimeAuditSource = "openclaw",
+): Promise<void> {
+  try {
+    await recordOpenClawRuntimeAudit(event, source);
+  } catch {
+    process.emitWarning(`Failed to deliver runtime audit observation ${event.action}`, {
+      code: "OPENCLAW_RUNTIME_AUDIT_DELIVERY",
+    });
+  }
+}
+
+export async function withOpenClawRuntimeAuditTurn<T>(
+  identity: { sessionId: string; runId: string },
+  run: () => Promise<T>,
+  outcome: (result: T) => OpenClawRuntimeAuditOutcome,
+): Promise<T> {
+  if (!hasOpenClawRuntimeAudit() || readOpenClawRuntimeAuditTurnId(identity.runId)) {
+    return await run();
+  }
+  // Each reply execution owns a distinct ID regardless of the client-supplied run key.
+  const turn: Turn = {
+    ...identity,
+    turnId: randomUUID(),
+    active: true,
+    observations: new Set(),
+  };
+  let terminal: OpenClawRuntimeAuditOutcome = "failed";
+  try {
+    const result = await state.turn.run(turn, run);
+    terminal = outcome(result);
+    return result;
+  } finally {
+    turn.active = false;
+    await Promise.all(turn.observations);
+    if (turn.admission || turn.blocked) {
+      await recordObservedOpenClawRuntimeAudit({
+        action: "openclaw.runtime.turn.completed",
+        sessionId: turn.sessionId,
+        turnId: turn.turnId,
+        messageId: turn.messageId,
+        outcome: turn.blocked ? "blocked" : terminal,
+      });
+    }
+  }
+}
+
+export function blockOpenClawRuntimeAuditTurn(runId: string, sessionId?: string): void {
+  const turn = state.turn.getStore();
+  if (turn?.active && turn.runId === runId && !turn.admission) {
+    turn.blocked = true;
+    turn.sessionId = sessionId ?? turn.sessionId;
+  }
+}
+
+export async function admitOpenClawRuntimeAuditTurn(
+  identity: { runId: string; sessionId: string },
+  messageId?: string,
+): Promise<void> {
+  const turn = state.turn.getStore();
+  if (!turn?.active || turn.runId !== identity.runId || turn.blocked) {
+    return;
+  }
+  if (!turn.admission) {
+    turn.sessionId = identity.sessionId;
+    turn.messageId = messageId;
+  }
+  turn.admission ??= recordOpenClawRuntimeAudit({
+    action: "openclaw.runtime.turn.admitted",
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    messageId: turn.messageId,
+  });
+  await turn.admission;
+}
+
+export async function startOpenClawRuntimeAuditTurn(
+  runId: string,
+  messageId?: string,
+): Promise<void> {
+  const turn = state.turn.getStore();
+  if (!turn?.active || turn.runId !== runId || !turn.admission) {
+    return;
+  }
+  await turn.admission;
+  turn.messageId ??= messageId;
+  turn.started ??= recordObservedOpenClawRuntimeAudit({
+    action: "openclaw.runtime.turn.started",
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    messageId: turn.messageId,
+  });
+  await turn.started;
+}
+
+function readOpenClawRuntimeAuditTurnId(runId: string): string | undefined {
+  const turn = state.turn.getStore();
+  return turn?.active && turn.runId === runId ? turn.turnId : undefined;
+}
+
+/** Carry the private turn across a later Gateway RPC already bound to this execution. */
+export function captureOpenClawRuntimeAuditTurnScope(identity: {
+  runId: string;
+  sessionId: string;
+}) {
+  const turn = state.turn.getStore();
+  if (!turn?.active || turn.runId !== identity.runId) {
+    return undefined;
+  }
+  return <T>(run: () => T): T =>
+    state.turn.run(turn.active && turn.sessionId === identity.sessionId ? turn : undefined, run);
+}
+
+/** A nested action needs an active, admitted foreground turn owned by the core. */
+function captureTurn(runId: string | undefined): Turn | undefined {
+  const turn = state.turn.getStore();
+  return turn?.active && turn.runId === runId && turn.started ? turn : undefined;
+}
+
+/** Retain one event identity across retries on both the worker and OCC connections. */
+function retryableObservation(event: OpenClawRuntimeAuditEvent) {
+  const observation = { ...event, eventId: randomUUID(), occurredAt: new Date().toISOString() };
+  let write: Promise<void> | undefined;
+  return () => {
+    write ??= recordOpenClawRuntimeAudit(observation).catch((error) => {
+      write = undefined;
+      throw error;
+    });
+    return write;
+  };
+}
+
+type ToolCall = {
+  nativeId: string;
+  fields: { invocationId: string; toolName: string };
+  send: (event: ToolObservation) => Promise<void>;
+  attemptId?: string;
+  approvalId?: string;
+  approvals: Map<string, (decision: RuntimeApprovalDecision) => Promise<void>>;
+  executorOwnsCompletion: boolean;
+  blocked: boolean;
+  uncertain?: true;
+  active: boolean;
+};
+
+function turnIds(turn: Turn): TurnIds {
+  return {
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    ...(turn.messageId ? { messageId: turn.messageId } : {}),
+  };
+}
+
+/** The supervised worker receives no ledger bearer; the authenticated Gateway supplies turn scope. */
+export function withWorkerToolAudit<T>(
+  observer: WorkerToolAuditObserver | undefined,
+  work: () => T,
+): T {
+  return state.workerTool.run(observer, work);
+}
+
+export function bindWorkerToolAudit(runId: string): WorkerToolAuditObserver | undefined {
+  const turn = state.turn.getStore();
+  if (!turn?.active || turn.runId !== runId) {
+    return undefined;
+  }
+  return async ({ eventId, occurredAt, observation }) => {
+    if (!turn.active || !turn.admission) {
+      throw new Error("Worker tool audit requires an admitted turn");
+    }
+    await turn.admission;
+    await recordOpenClawRuntimeAudit({ ...observation, ...turnIds(turn), eventId, occurredAt });
+  };
+}
+
+const AUDIT_TOOL_NAME = /^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,255}$/;
+
+export async function withOpenClawRuntimeToolAudit<T>(
+  params: {
+    runId?: string;
+    nativeId: string;
+    toolName: string;
+    signal?: AbortSignal;
+  },
+  work: () => Promise<T>,
+  outcome: (result: T) => RuntimeToolOutcome,
+): Promise<T> {
+  const worker = state.workerTool.getStore();
+  const turn = captureTurn(params.runId);
+  if (!worker && !turn) {
+    return await work();
+  }
+  const previous = state.tool.getStore();
+  if (
+    previous?.active &&
+    previous.nativeId === params.nativeId &&
+    previous.fields.toolName === params.toolName
+  ) {
+    return await work();
+  }
+  if (!AUDIT_TOOL_NAME.test(params.toolName)) {
+    throw new Error("Invalid registered tool name for runtime audit");
+  }
+  const call: ToolCall = {
+    nativeId: params.nativeId,
+    fields: { invocationId: randomUUID(), toolName: params.toolName },
+    send: worker
+      ? (event) =>
+          worker({
+            eventId: randomUUID(),
+            occurredAt: new Date().toISOString(),
+            observation: event as WorkerToolAuditObservation,
+          })
+      : (event) => recordOpenClawRuntimeAudit({ ...event, ...turnIds(turn!) }),
+    approvals: new Map(),
+    executorOwnsCompletion: false,
+    blocked: false,
+    active: true,
+  };
+  await call.send({ action: "openclaw.runtime.tool_call.requested", ...call.fields });
+  params.signal?.throwIfAborted();
+  return await state.tool.run(call, async () => {
+    let terminal: RuntimeToolOutcome = "failed";
+    try {
+      const result = await work();
+      terminal = outcome(result);
+      return result;
+    } finally {
+      call.active = false;
+      if (call.attemptId && !call.executorOwnsCompletion) {
+        await observeToolAudit(call, {
+          action: "openclaw.runtime.tool_attempt.completed",
+          ...call.fields,
+          attemptId: call.attemptId,
+          outcome: call.uncertain
+            ? "unknown"
+            : call.blocked
+              ? "blocked"
+              : params.signal?.aborted
+                ? "cancelled"
+                : terminal,
+        });
+      }
+    }
+  });
+}
+
+function currentTool(nativeId?: string): ToolCall | undefined {
+  const call = state.tool.getStore();
+  return call?.active && (nativeId === undefined || call.nativeId === nativeId) ? call : undefined;
+}
+
+export function markRuntimeToolOutcomeUnknown(): void {
+  const call = currentTool();
+  if (call) {
+    call.uncertain = true;
+  }
+}
+
+export function isWorkerToolAuditRelay(): boolean {
+  return state.workerTool.getStore() !== undefined;
+}
+
+export function isRuntimeToolAudited(nativeId?: string): boolean {
+  return currentTool(nativeId) !== undefined;
+}
+
+async function observeToolAudit(call: ToolCall, event: ToolObservation): Promise<void> {
+  try {
+    await call.send(event);
+  } catch {
+    process.emitWarning(`Failed to deliver runtime audit observation ${event.action}`, {
+      code: "OPENCLAW_RUNTIME_AUDIT_DELIVERY",
+    });
+  }
+}
+
+export async function recordRuntimeToolPolicy(
+  policy: RuntimeToolPolicy,
+  decision: WorkerPolicyEvent["decision"],
+  nativeId?: string,
+): Promise<void> {
+  const call = currentTool(nativeId);
+  if (!call) {
+    return;
+  }
+  const event = {
+    action: "openclaw.runtime.policy.decided",
+    ...call.fields,
+    policy,
+    decision,
+    ...(call.attemptId ? { attemptId: call.attemptId } : {}),
+  } as const;
+  if (decision === "deny") {
+    call.blocked = true;
+    await observeToolAudit(call, event);
+  } else {
+    await call.send(event);
+  }
+}
+
+export async function beginRuntimeToolApproval(
+  policy: RuntimeToolPolicy,
+  nativeId?: string,
+  approvalId: string = randomUUID(),
+): Promise<((decision: RuntimeApprovalDecision) => Promise<void>) | undefined> {
+  const call = currentTool(nativeId);
+  if (!call) {
+    return undefined;
+  }
+  await recordRuntimeToolPolicy(policy, "require_approval", nativeId);
+  await call.send({ action: "openclaw.runtime.approval.requested", ...call.fields, approvalId });
+  let resolved = false;
+  const resolve = async (decision: RuntimeApprovalDecision) => {
+    if (resolved) {
+      return;
+    }
+    resolved = true;
+    call.approvals.delete(approvalId);
+    const record = {
+      action: "openclaw.runtime.approval.resolved",
+      ...call.fields,
+      approvalId,
+      decision,
+    } as const;
+    if (decision === "allow-once" || decision === "allow-always") {
+      await call.send(record);
+      call.approvalId = approvalId;
+    } else {
+      await observeToolAudit(call, record);
+    }
+  };
+  call.approvals.set(approvalId, resolve);
+  return resolve;
+}
+
+export function findRuntimeToolApproval(approvalId: string) {
+  return state.tool.getStore()?.approvals.get(approvalId);
+}
+
+async function admitToolAttempt(call: ToolCall): Promise<string> {
+  const attemptId = randomUUID();
+  await call.send({
+    action: "openclaw.runtime.tool_attempt.admitted",
+    ...call.fields,
+    attemptId,
+    ...(call.approvalId ? { approvalId: call.approvalId } : {}),
+  });
+  return attemptId;
+}
+
+/** A process owns completion after handoff even if the tool returns a continuation first. */
+export function captureRuntimeExecAttempt() {
+  const call = currentTool();
+  if (call?.fields.toolName !== "exec") {
+    return undefined;
+  }
+  return async () => {
+    const attemptId = await admitToolAttempt(call);
+    call.executorOwnsCompletion = true;
+    return (outcome: RuntimeToolOutcome) =>
+      observeToolAudit(call, {
+        action: "openclaw.runtime.tool_attempt.completed",
+        ...call.fields,
+        attemptId,
+        outcome,
+      });
+  };
+}
+
+export async function admitRuntimeToolAttempt(nativeId?: string): Promise<void> {
+  const call = currentTool(nativeId);
+  if (call && !call.attemptId) {
+    call.attemptId = await admitToolAttempt(call);
+  }
+}
+
+/** The worker supplies an attempt ID and stage. The Gateway owns all scope and model fields. */
+export function bindWorkerModelAudit(
+  runId: string,
+  model: { model: string; provider: string },
+): WorkerModelObserver | undefined {
+  const turn = state.turn.getStore();
+  if (!turn?.active || turn.runId !== runId) {
+    return undefined;
+  }
+  const calls = new Map<
+    string,
+    {
+      start: () => Promise<void>;
+      finish?: { outcome: string; write: () => Promise<void> };
+    }
+  >();
+  return async ({ modelCallId, stage }) => {
+    if (!turn.active || !turn.admission) {
+      throw new Error("Worker model observation requires an admitted turn");
+    }
+    await turn.admission;
+    const fields = {
+      sessionId: turn.sessionId,
+      turnId: turn.turnId,
+      model: model.model,
+      provider: model.provider,
+      modelCallId,
+    };
+    let call = calls.get(modelCallId);
+    if (stage === "started") {
+      if (!call) {
+        if (calls.size >= 4096) {
+          throw new Error("Worker model observation limit exceeded");
+        }
+        call = {
+          start: retryableObservation({ action: "openclaw.runtime.model_call.started", ...fields }),
+        };
+        calls.set(modelCallId, call);
+      }
+      if (call.finish) {
+        throw new Error("Worker model call has already finished");
+      }
+      await call.start();
+      return;
+    }
+    if (!call || (call.finish && call.finish.outcome !== stage)) {
+      throw new Error("Invalid worker model observation");
+    }
+    await call.start();
+    call.finish ??= {
+      outcome: stage,
+      write: retryableObservation({
+        action: "openclaw.runtime.model_call.completed",
+        ...fields,
+        outcome: stage,
+      }),
+    };
+    if (call.finish.outcome !== stage) {
+      throw new Error("Conflicting worker model observation");
+    }
+    await call.finish.write();
+  };
+}
+
+export function prepareOpenClawRuntimeAuditModelCall(
+  runId: string,
+  model: { id: string; provider: string },
+) {
+  const turn = captureTurn(runId);
+  if (!turn) {
+    return undefined;
+  }
+  const fields = {
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    modelCallId: randomUUID(),
+    model: model.id,
+    provider: model.provider,
+  };
+  let accepted = false;
+  return {
+    async start() {
+      await recordOpenClawRuntimeAudit({
+        action: "openclaw.runtime.model_call.started",
+        ...fields,
+      });
+      accepted = true;
+    },
+    complete(outcome: OpenClawRuntimeAuditOutcome) {
+      if (!accepted) {
+        return;
+      }
+      accepted = false;
+      const write = recordObservedOpenClawRuntimeAudit({
+        action: "openclaw.runtime.model_call.completed",
+        ...fields,
+        outcome,
+      });
+      turn.observations.add(write);
+      void write.finally(() => turn.observations.delete(write));
+      return write;
+    },
+  };
+}
