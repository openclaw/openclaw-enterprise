diff --git a/src/infra/openclaw-runtime-audit-delivery.ts b/src/infra/openclaw-runtime-audit-delivery.ts
new file mode 100644
index 0000000..703d365
--- /dev/null
+++ b/src/infra/openclaw-runtime-audit-delivery.ts
@@ -0,0 +1,180 @@
+// Keep observed metadata through a restart of this Pod's Gateway process.
+import { createHash } from "node:crypto";
+import { lstatSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { resolveStateDir } from "../config/state-dir.js";
+import { openNodeSqliteDatabase, resolveExistingSqliteFileUri } from "./node-sqlite.js";
+import { preparePrivateStoreFileSync } from "./private-store-file.js";
+
+const MAX_PENDING = 256;
+const REQUEST_BYTE_LIMIT = 4096;
+const RECOVERY_DELAY_MS = 15_000;
+
+export class RejectedAuditDelivery extends Error {}
+
+function openPendingDatabase() {
+  // The managed Gateway's state root is Pod-local. The "state" subdirectory
+  // is a shared PVC, so keep pending metadata in a separate private child.
+  const file = join(resolveStateDir(), "pending-runtime-audit", "observations.sqlite");
+  const directory = lstatSync(dirname(file), { throwIfNoEntry: false });
+  if (directory && (!directory.isDirectory() || directory.uid !== process.getuid?.())) {
+    throw new Error("Unsafe pending audit directory");
+  }
+  preparePrivateStoreFileSync(file, Boolean(directory));
+  const stat = lstatSync(file);
+  if (
+    !stat.isFile() ||
+    stat.nlink !== 1 ||
+    stat.uid !== process.getuid?.() ||
+    (stat.mode & 0o077) !== 0
+  ) {
+    throw new Error("Unsafe pending audit file");
+  }
+  const db = openNodeSqliteDatabase(resolveExistingSqliteFileUri(file));
+  try {
+    db.exec(`
+      PRAGMA page_size = 4096;
+      PRAGMA max_page_count = 1024;
+      PRAGMA journal_mode = DELETE;
+      PRAGMA synchronous = FULL;
+      CREATE TABLE IF NOT EXISTS pending (
+        scope TEXT NOT NULL,
+        body TEXT NOT NULL PRIMARY KEY CHECK(length(CAST(body AS BLOB)) <= ${REQUEST_BYTE_LIMIT})
+      ) STRICT;
+    `);
+    return db;
+  } catch (error) {
+    db.close();
+    throw error;
+  }
+}
+
+function replayable(body: string, source: string): boolean {
+  const { action, decision } = JSON.parse(body) as { action: string; decision?: unknown };
+  switch (action) {
+    case "openclaw.runtime.session.started":
+    case "openclaw.runtime.session.ended":
+    case "openclaw.runtime.turn.started":
+    case "openclaw.runtime.turn.completed":
+    case "openclaw.runtime.model_call.completed":
+    case "openclaw.runtime.tool_attempt.completed":
+      return true;
+    case "openclaw.runtime.policy.decided":
+      return decision === "deny";
+    case "openclaw.runtime.approval.resolved":
+      return (
+        decision === "deny" ||
+        decision === "expired" ||
+        decision === "cancelled" ||
+        decision === "unavailable"
+      );
+    case "openclaw.runtime.model_call.started":
+      // OpenClaw waits for this write before dispatch. Codex reports a
+      // transport attempt it has already started.
+      return source === "codex";
+    default:
+      return false;
+  }
+}
+
+export function createManagedAuditSender(
+  source: string,
+  destination: { url: URL; token: string },
+  send: (body: string) => Promise<void>,
+) {
+  const scope = createHash("sha256")
+    .update(JSON.stringify([source, destination.url.href, destination.token]))
+    .digest("hex");
+  const db = openPendingDatabase();
+  db.prepare("DELETE FROM pending WHERE scope <> ?").run(scope);
+  const insert = db.prepare(`
+    INSERT INTO pending(scope, body) SELECT ?, ? WHERE (SELECT count(*) FROM pending) < ${MAX_PENDING}
+  `);
+  const remove = db.prepare("DELETE FROM pending WHERE scope = ? AND body = ?");
+  const pending = new Map<string, Promise<void> | undefined>();
+  for (const { body } of db
+    .prepare("SELECT body FROM pending WHERE scope = ? ORDER BY rowid")
+    .all(scope)) {
+    if (typeof body !== "string" || !replayable(body, source)) {
+      throw new Error("Invalid pending audit observation");
+    }
+    pending.set(body, undefined);
+  }
+
+  let timer: NodeJS.Timeout | undefined;
+  let draining = false;
+  function scheduleRecovery() {
+    if (timer || draining || !pending.size) {
+      return;
+    }
+    timer = setTimeout(() => {
+      timer = undefined;
+      void recover();
+    }, RECOVERY_DELAY_MS);
+    timer.unref();
+  }
+  function discard(body: string) {
+    remove.run(scope, body);
+    pending.delete(body);
+  }
+  function deliver(body: string) {
+    const active = pending.get(body);
+    if (active) {
+      return active;
+    }
+    const request = send(body)
+      .then(() => discard(body))
+      .catch((error: unknown) => {
+        pending.set(body, undefined);
+        if (error instanceof RejectedAuditDelivery) {
+          discard(body);
+        }
+        throw error;
+      })
+      .finally(scheduleRecovery);
+    pending.set(body, request);
+    return request;
+  }
+  async function recover() {
+    draining = true;
+    try {
+      for (const body of pending.keys()) {
+        try {
+          await deliver(body);
+        } catch (error) {
+          if (!(error instanceof RejectedAuditDelivery)) {
+            break;
+          }
+          process.emitWarning("Gateway audit receiver rejected a pending observation", {
+            code: "OPENCLAW_RUNTIME_AUDIT_DELIVERY",
+          });
+        }
+      }
+    } finally {
+      draining = false;
+      scheduleRecovery();
+    }
+  }
+  void recover();
+
+  return async (body: string, observedSource: string) => {
+    if (observedSource !== source || Buffer.byteLength(body) > REQUEST_BYTE_LIMIT) {
+      throw new Error("Invalid managed audit observation");
+    }
+    if (pending.has(body)) {
+      return deliver(body);
+    }
+    if (pending.size >= MAX_PENDING) {
+      throw new Error("Pending audit observation limit reached");
+    }
+    if (!replayable(body, source)) {
+      // Positive gates belong to this execution. Only an immediate positive
+      // response may release the waiting turn, model request, or tool attempt.
+      return send(body);
+    }
+    if (insert.run(scope, body).changes !== 1) {
+      throw new Error("Pending audit observation limit reached");
+    }
+    return deliver(body);
+  };
+}
