@@ -0,0 +1,484 @@
+/** Protected OpenClaw Enterprise runtime audit sender. */
+import { randomUUID } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { setTimeout as delay } from "node:timers/promises";
+import { Agent, fetch as fetchWithDispatcher } from "undici";
+import { AsyncContext } from "../shared/async-context.js";
+import {
+  formatExecAutoReviewAssessment,
+  type ExecAutoReviewDecision,
+  type ExecAutoReviewInput,
+} from "./exec-auto-review.js";
+
+export type OpenClawRuntimeAuditOutcome =
+  | "succeeded"
+  | "failed"
+  | "denied"
+  | "cancelled"
+  | "blocked"
+  | "unknown";
+
+export type OpenClawRuntimeAuditEvent = {
+  action:
+    | "openclaw.runtime.session.started"
+    | "openclaw.runtime.session.ended"
+    | "openclaw.runtime.turn.admitted"
+    | "openclaw.runtime.turn.started"
+    | "openclaw.runtime.turn.completed"
+    | "openclaw.runtime.model_call.started"
+    | "openclaw.runtime.model_call.completed"
+    | "openclaw.runtime.tool_call.requested"
+    | "openclaw.runtime.tool_call.completed"
+    | "openclaw.runtime.review.decision"
+    | "openclaw.runtime.file.decision";
+  eventId?: string;
+  occurredAt?: string;
+  sessionId?: string;
+  nativeSessionId?: string;
+  turnId?: string;
+  messageId?: string;
+  toolCallId?: string;
+  toolName?: string;
+  modelCallId?: string;
+  model?: string;
+  provider?: string;
+  path?: string;
+  decision?: "allowed" | "denied" | "ask";
+  rationale?: string | null;
+  reviewId?: string;
+  outcome?: OpenClawRuntimeAuditOutcome;
+  blockedBy?: "auto_review" | "file_policy" | "network_policy";
+  reason?: string;
+};
+
+type Destination = { url: URL; token: string };
+type AuditResponse = { ok: boolean; status: number; body: { cancel: () => Promise<void> } | null };
+type AuditPost = (
+  url: URL,
+  options: {
+    method: "POST";
+    headers: Record<string, string>;
+    body: string;
+    redirect: "error";
+    signal: AbortSignal;
+  },
+) => Promise<AuditResponse>;
+type RuntimeAuditSource = "openclaw" | "codex";
+type AuditTool = {
+  fields: { sessionId: string; turnId: string; toolCallId: string; toolName: string };
+  nativeToolCallId: string;
+  active: boolean;
+  denied?: true;
+};
+
+type Turn = {
+  sessionId: string;
+  runId: string;
+  turnId: string;
+  messageId?: string;
+  admission?: Promise<void>;
+  started?: Promise<void>;
+  observations: Set<Promise<void>>;
+  blocked?: true;
+  active: boolean;
+};
+
+const SAFE_EXEC_REVIEW_SENTENCE = /^[a-z][a-z ,-]{0,218}[.!?]?$/i;
+const SAFE_EXEC_REVIEW_WORDS = new Set(
+  [
+    "a an and are as at be by can could for from has in is it may no not of on or only requires that the this to was will with without would",
+    "access action allowed approval approved authorized changes command contained content destructive denied does effect effects existing external file files human inspection inspect intended local low medium modification modify network operation permitted policy project public read review risk safe scope scoped state system trusted unauthorized unsafe user workspace write",
+  ].flatMap((words) => words.split(" ")),
+);
+
+const state = {
+  sender: undefined as ((body: string, source: RuntimeAuditSource) => Promise<void>) | undefined,
+  initialized: false,
+  initializationError: undefined as Error | undefined,
+  turn: new AsyncContext<Turn>(Symbol.for("openclaw.enterpriseRuntimeAudit.turn")),
+  tool: new AsyncContext<AuditTool>(Symbol.for("openclaw.enterpriseRuntimeAudit.tool")),
+};
+
+/** Read the bootstrap secret before Gateway starts any tool or plugin. */
+export function initializeOpenClawRuntimeAudit(): void {
+  if (state.initializationError) {
+    throw state.initializationError;
+  }
+  if (state.initialized) {
+    return;
+  }
+  const candidate = process.env.OPENCLAW_RUNTIME_AUDIT_URL;
+  const tokenValue = process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN;
+  const tokenPath = process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN_PATH;
+  const caPath = process.env.OPENCLAW_RUNTIME_AUDIT_CA_PATH;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_URL;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_TOKEN_PATH;
+  delete process.env.OPENCLAW_RUNTIME_AUDIT_CA_PATH;
+  if (!candidate && !tokenValue && !tokenPath && !caPath) {
+    state.initialized = true;
+    return;
+  }
+  try {
+    const url = new URL(candidate ?? "");
+    const loopback = url.hostname === "127.0.0.1" || url.hostname === "[::1]";
+    if (
+      (url.protocol !== "https:" && !(loopback && url.protocol === "http:")) ||
+      url.username ||
+      url.password ||
+      url.hash ||
+      url.search ||
+      (caPath && url.protocol !== "https:") ||
+      (tokenPath && tokenValue)
+    ) {
+      throw new Error("Invalid audit configuration");
+    }
+    const token = (tokenPath ? readFileSync(tokenPath, "utf8") : tokenValue)?.trim();
+    if (!token || !/^[A-Za-z0-9._~+/-]+=*$/.test(token)) {
+      throw new Error("Invalid audit credential");
+    }
+    let post: AuditPost = globalThis.fetch;
+    if (caPath) {
+      const dispatcher = new Agent({ connect: { ca: readFileSync(caPath, "utf8") } });
+      post = (url, options) => fetchWithDispatcher(url, { ...options, dispatcher });
+    }
+    state.sender = (body, source) => deliverAuditEvent({ url, token }, body, source, post);
+    state.initialized = true;
+  } catch {
+    // Neither parsing errors nor filesystem errors may disclose bootstrap configuration.
+    state.initializationError = new Error(
+      "Invalid OpenClaw Enterprise runtime audit configuration",
+    );
+    throw state.initializationError;
+  }
+}
+
+export function hasOpenClawRuntimeAudit(): boolean {
+  return state.sender !== undefined;
+}
+
+export async function recordOpenClawRuntimeAudit(
+  event: OpenClawRuntimeAuditEvent,
+  source: RuntimeAuditSource = "openclaw",
+): Promise<void> {
+  if (!state.sender) {
+    return;
+  }
+  // Retry ambiguous writes with the same event ID and exact payload.
+  await state.sender(
+    JSON.stringify({
+      ...event,
+      eventId: event.eventId ?? randomUUID(),
+      occurredAt: event.occurredAt ?? new Date().toISOString(),
+    }),
+    source,
+  );
+}
+
+async function deliverAuditEvent(
+  destination: Destination,
+  body: string,
+  source: RuntimeAuditSource,
+  post: AuditPost,
+): Promise<void> {
+  for (const retryDelay of [0, 100, 300]) {
+    if (retryDelay) {
+      await delay(retryDelay);
+    }
+    let response: AuditResponse;
+    try {
+      response = await post(destination.url, {
+        method: "POST",
+        headers: {
+          Authorization: `Bearer ${destination.token}`,
+          "Content-Type": "application/json",
+          "X-OpenClaw-Runtime-Audit-Source": source,
+        },
+        body,
+        redirect: "error",
+        signal: AbortSignal.timeout(2_000),
+      });
+    } catch {
+      continue;
+    }
+    void response.body?.cancel().catch(() => undefined);
+    if (response.ok) {
+      return;
+    }
+    if (response.status !== 408 && response.status !== 429 && response.status < 500) {
+      break;
+    }
+  }
+  throw new Error("OpenClaw Enterprise runtime audit did not accept the event");
+}
+
+/** An observation cannot retroactively undo an operation that has already settled. */
+export async function recordObservedOpenClawRuntimeAudit(
+  event: OpenClawRuntimeAuditEvent,
+  source: RuntimeAuditSource = "openclaw",
+): Promise<void> {
+  try {
+    await recordOpenClawRuntimeAudit(event, source);
+  } catch {
+    process.emitWarning(`Failed to deliver runtime audit observation ${event.action}`, {
+      code: "OPENCLAW_RUNTIME_AUDIT_DELIVERY",
+    });
+  }
+}
+
+export async function withOpenClawRuntimeAuditTurn<T>(
+  identity: { sessionId: string; runId: string },
+  run: () => Promise<T>,
+  outcome: (result: T) => OpenClawRuntimeAuditOutcome,
+): Promise<T> {
+  if (!hasOpenClawRuntimeAudit()) {
+    return await run();
+  }
+  // Each reply execution owns a distinct ID regardless of the client-supplied run key.
+  const turn: Turn = {
+    ...identity,
+    turnId: randomUUID(),
+    active: true,
+    observations: new Set(),
+  };
+  let terminal: OpenClawRuntimeAuditOutcome = "failed";
+  try {
+    const result = await state.turn.run(turn, run);
+    terminal = outcome(result);
+    return result;
+  } finally {
+    turn.active = false;
+    await Promise.all(turn.observations);
+    if (turn.admission || turn.blocked) {
+      await recordObservedOpenClawRuntimeAudit({
+        action: "openclaw.runtime.turn.completed",
+        sessionId: turn.sessionId,
+        turnId: turn.turnId,
+        messageId: turn.messageId,
+        outcome: turn.blocked ? "blocked" : terminal,
+        ...(turn.blocked ? { reason: "before-agent-run" } : {}),
+      });
+    }
+  }
+}
+
+export function blockOpenClawRuntimeAuditTurn(runId: string, sessionId?: string): void {
+  const turn = state.turn.getStore();
+  if (turn?.active && turn.runId === runId && !turn.admission) {
+    turn.blocked = true;
+    turn.sessionId = sessionId ?? turn.sessionId;
+  }
+}
+
+export async function admitOpenClawRuntimeAuditTurn(
+  identity: { runId: string; sessionId: string },
+  messageId?: string,
+): Promise<void> {
+  const turn = state.turn.getStore();
+  if (!turn?.active || turn.runId !== identity.runId || turn.blocked) {
+    return;
+  }
+  if (!turn.admission) {
+    turn.sessionId = identity.sessionId;
+    turn.messageId = messageId;
+  }
+  turn.admission ??= recordOpenClawRuntimeAudit({
+    action: "openclaw.runtime.turn.admitted",
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    messageId: turn.messageId,
+  });
+  await turn.admission;
+}
+
+export async function startOpenClawRuntimeAuditTurn(
+  runId: string,
+  messageId?: string,
+): Promise<void> {
+  const turn = state.turn.getStore();
+  if (!turn?.active || turn.runId !== runId || !turn.admission) {
+    return;
+  }
+  await turn.admission;
+  turn.messageId ??= messageId;
+  turn.started ??= recordObservedOpenClawRuntimeAudit({
+    action: "openclaw.runtime.turn.started",
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    messageId: turn.messageId,
+  });
+  await turn.started;
+}
+
+/** Carry the private turn across a later Gateway RPC already bound to this execution. */
+export function captureOpenClawRuntimeAuditTurnScope(identity: {
+  runId: string;
+  sessionId: string;
+}) {
+  const turn = state.turn.getStore();
+  if (!turn?.active || turn.runId !== identity.runId) {
+    return undefined;
+  }
+  return <T>(run: () => T): T =>
+    state.turn.run(turn.active && turn.sessionId === identity.sessionId ? turn : undefined, run);
+}
+
+/** A nested action needs an active, admitted foreground turn owned by the core. */
+function captureTurn(runId: string | undefined): Turn | undefined {
+  const turn = state.turn.getStore();
+  return turn?.active && turn.runId === runId && turn.started ? turn : undefined;
+}
+
+function readOpenClawRuntimeAuditExecRationale(
+  result: ExecAutoReviewDecision,
+  input: ExecAutoReviewInput,
+): string {
+  const rationale = result.rationale.trim();
+  const fallback = formatExecAutoReviewAssessment(result);
+  const lower = rationale.toLowerCase();
+  // Terminal normalization is not content redaction. Limit audit text to generic
+  // classification language and omit any request data that matches it.
+  if (
+    !SAFE_EXEC_REVIEW_SENTENCE.test(rationale) ||
+    lower.includes("--") ||
+    lower.match(/[a-z]+/g)?.some((word) => !SAFE_EXEC_REVIEW_WORDS.has(word))
+  ) {
+    return fallback;
+  }
+
+  const sourceTexts = [
+    input.command,
+    input.executionCommand,
+    input.resolvedPath,
+    input.cwd,
+    ...(input.argv ?? []),
+    ...(input.envKeys ?? []),
+    ...(input.transcript?.entries.map(({ text }) => text) ?? []),
+  ];
+  const phrase = lower.replace(/[.!?]$/u, "");
+  const echoesRequest = sourceTexts.some((value) => {
+    const source = value?.trim().toLowerCase();
+    return source && (source.includes(phrase) || (source.length > 2 && phrase.includes(source)));
+  });
+  return echoesRequest ? fallback : rationale;
+}
+
+export async function recordOpenClawRuntimeAuditExecReview(
+  runId: string | undefined,
+  result: ExecAutoReviewDecision,
+  input: ExecAutoReviewInput,
+  nativeToolCallId?: string,
+): Promise<boolean> {
+  const tool = nativeToolCallId ? captureOpenClawRuntimeAuditTool(nativeToolCallId) : undefined;
+  const turn = runId === undefined && tool ? state.turn.getStore() : captureTurn(runId);
+  if (!turn?.active || (nativeToolCallId && tool?.turnId !== turn.turnId)) {
+    return false;
+  }
+  const decision =
+    result.decision === "allow-once" ? "allowed" : result.decision === "deny" ? "denied" : "ask";
+  const event: OpenClawRuntimeAuditEvent = {
+    action: "openclaw.runtime.review.decision",
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    messageId: turn.messageId,
+    toolCallId: tool?.toolCallId,
+    reviewId: randomUUID(),
+    decision,
+    rationale: readOpenClawRuntimeAuditExecRationale(result, input),
+  };
+  if (decision === "allowed") {
+    await recordOpenClawRuntimeAudit(event);
+  } else {
+    await recordObservedOpenClawRuntimeAudit(event);
+  }
+  return true;
+}
+
+export function captureOpenClawRuntimeAuditTool(toolCallId: string | undefined) {
+  const tool = state.tool.getStore();
+  return tool?.active && tool.nativeToolCallId === toolCallId ? tool.fields : undefined;
+}
+
+export function markOpenClawRuntimeAuditToolDenied(toolCallId: string): void {
+  const tool = state.tool.getStore();
+  if (tool?.active && tool.nativeToolCallId === toolCallId) {
+    tool.denied = true;
+  }
+}
+
+export async function withOpenClawRuntimeAuditTool<T>(
+  identity: {
+    runId: string | undefined;
+    nativeToolCallId: string;
+    toolName: string;
+    signal?: AbortSignal;
+  },
+  run: () => Promise<T>,
+  classify: (result: T) => OpenClawRuntimeAuditOutcome,
+): Promise<T> {
+  const turn = captureTurn(identity.runId);
+  if (!turn) {
+    return await run();
+  }
+  const fields = {
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    toolCallId: randomUUID(),
+    toolName: identity.toolName,
+  };
+  await recordOpenClawRuntimeAudit({ action: "openclaw.runtime.tool_call.requested", ...fields });
+  const tool: AuditTool = { fields, nativeToolCallId: identity.nativeToolCallId, active: true };
+  let outcome: OpenClawRuntimeAuditOutcome = "failed";
+  try {
+    identity.signal?.throwIfAborted();
+    const result = await state.tool.run(tool, run);
+    outcome = classify(result);
+    return result;
+  } finally {
+    tool.active = false;
+    await recordObservedOpenClawRuntimeAudit({
+      action: "openclaw.runtime.tool_call.completed",
+      ...fields,
+      outcome: tool.denied ? "denied" : identity.signal?.aborted ? "cancelled" : outcome,
+    });
+  }
+}
+
+export function prepareOpenClawRuntimeAuditModelCall(
+  runId: string,
+  model: { id: string; provider: string },
+) {
+  const turn = captureTurn(runId);
+  if (!turn) {
+    return undefined;
+  }
+  const fields = {
+    sessionId: turn.sessionId,
+    turnId: turn.turnId,
+    modelCallId: randomUUID(),
+    model: model.id,
+    provider: model.provider,
+  };
+  let accepted = false;
+  return {
+    async start() {
+      await recordOpenClawRuntimeAudit({
+        action: "openclaw.runtime.model_call.started",
+        ...fields,
+      });
+      accepted = true;
+    },
+    complete(outcome: OpenClawRuntimeAuditOutcome) {
+      if (!accepted) {
+        return;
+      }
+      const write = recordObservedOpenClawRuntimeAudit({
+        action: "openclaw.runtime.model_call.completed",
+        ...fields,
+        outcome,
+      });
+      turn.observations.add(write);
+      void write.finally(() => turn.observations.delete(write));
+    },
+  };
+}
