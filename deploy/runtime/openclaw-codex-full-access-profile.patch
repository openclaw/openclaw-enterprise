+    const verifyPermissionProfile = (result: T): T => {
+      if (
+        (method !== "thread/start" &&
+          method !== "thread/resume" &&
+          method !== "thread/fork") ||
+        !isJsonObject(params)
+      ) {
+        return result;
+      }
+      let requestedProfile: string | undefined;
+      if (typeof params.permissions === "string") {
+        requestedProfile = params.permissions;
+      } else if (
+        isJsonObject(params.config) &&
+        typeof params.config.default_permissions === "string"
+      ) {
+        requestedProfile = params.config.default_permissions;
+      }
+      // Managed requirements can refuse an explicit profile or a loaded thread can
+      // retain its earlier profile. Do not expose that thread for a model turn.
+      if (requestedProfile === ":danger-full-access") {
+        if (
+          !(
+            isJsonObject(result) &&
+            isJsonObject(result.sandbox) &&
+            result.sandbox.type === "dangerFullAccess"
+          )
+        ) {
+          throw new Error(
+            method +
+              ": Codex did not grant the requested :danger-full-access profile",
+          );
+        }
+      } else if (
+        requestedProfile !== undefined &&
+        !(
+          isJsonObject(result) &&
+          isJsonObject(result.activePermissionProfile) &&
+          result.activePermissionProfile.id === requestedProfile
+        )
+      ) {
+        throw new Error(method + ": Codex did not grant the requested permission profile");
+      }
+      return result;
+    };
+    return this.requestWithOverloadRetry<T>(method, params, options).then(verifyPermissionProfile);
