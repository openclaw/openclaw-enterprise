 export function codexThreadSandboxOrPermissions(
-  appServer: Pick<CodexAppServerRuntimeOptions, "networkProxy" | "sandbox">,
-): Pick<CodexThreadStartParams, "sandbox"> {
+  appServer: Pick<
+    CodexAppServerRuntimeOptions,
+    "networkProxy" | "providerPermissionProfile" | "sandbox"
+  >,
+): Pick<CodexThreadStartParams, "permissions" | "sandbox"> {
   if (appServer.networkProxy) {
     return {};
   }
+  // Legacy sandbox can be superseded by managed default_permissions. Only an outer
+  // sandbox provider opts into the explicit profile; native requirements still take precedence.
+  if (
+    appServer.providerPermissionProfile &&
+    appServer.sandbox === "danger-full-access"
+  ) {
+    return { permissions: appServer.providerPermissionProfile };
+  }
   return { sandbox: appServer.sandbox };
 }
