[include]
	path = /etc/gitconfig
[credential]
	helper =
	useHttpPath = true
[credential "https://github.com"]
	helper = /usr/local/lib/oce/openshell-git-credential.cjs
[http]
	sslVerify = true
	followRedirects = false
[http "https://github.com"]
	sslCAInfo = /run/openshell-supervisor-ca/material/ca-bundle.crt
