--- /dev/null
+++ b/extensions/memory-core/src/index-gateway.runtime.ts
@@ -0,0 +1,49 @@
+import type { OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import type { MemoryCoreAcquireLocalService } from "./memory/embedding-local-service.js";
+import { withMemoryMaintenanceAuthority } from "./memory/maintenance-authority.js";
+import { getMemorySearchManager } from "./memory/search-manager.js";
+
+export async function indexMemoryOnGateway(params: {
+  cfg: OpenClawConfig;
+  agentId: string;
+  force: boolean;
+  assertCurrent: () => void;
+  signal?: AbortSignal;
+  acquireLocalService?: MemoryCoreAcquireLocalService;
+}) {
+  return withMemoryMaintenanceAuthority(
+    params.assertCurrent,
+    async () => {
+      const { manager, error } = await getMemorySearchManager({
+        cfg: params.cfg,
+        agentId: params.agentId,
+        purpose: "cli",
+        inspectSources: true,
+        acquireLocalService: params.acquireLocalService,
+      });
+      if (!manager) {
+        throw new Error(error ?? "Memory search is disabled.");
+      }
+      try {
+        params.assertCurrent();
+        if (!manager.sync) {
+          throw new Error("The memory manager does not support indexing.");
+        }
+        // The Gateway owns the remote workspace binding and the derived index.
+        // Reuse the same explicit maintenance operation as the local CLI.
+        await manager.sync({ reason: "cli", force: params.force });
+        params.assertCurrent();
+        if (!manager.statusAsync) {
+          throw new Error("Memory maintenance requires asynchronous status.");
+        }
+        const status = await manager.statusAsync();
+        params.signal?.throwIfAborted();
+        params.assertCurrent();
+        return status;
+      } finally {
+        await manager.close?.();
+      }
+    },
+    params.signal,
+  );
+}
diff --git a/extensions/memory-core/src/index-gateway.ts b/extensions/memory-core/src/index-gateway.ts
new file mode 100644
--- /dev/null
+++ b/extensions/memory-core/src/index-gateway.ts
@@ -0,0 +1,74 @@
+import { formatErrorMessage } from "openclaw/plugin-sdk/error-runtime";
+import { ErrorCodes, errorShape } from "openclaw/plugin-sdk/gateway-runtime";
+import { createLazyRuntimeModule } from "openclaw/plugin-sdk/lazy-runtime";
+import {
+  resolveConfiguredAgentId,
+  type OpenClawConfig,
+} from "openclaw/plugin-sdk/memory-core-host-runtime-core";
+import type { OpenClawPluginApi } from "openclaw/plugin-sdk/plugin-entry";
+
+const loadIndexRuntime = createLazyRuntimeModule(() => import("./index-gateway.runtime.js"));
+
+export function registerMemoryIndexGatewayMethod(api: OpenClawPluginApi): void {
+  api.registerGatewayMethod(
+    "memory.index",
+    async ({ params, respond, client, signal, hasCurrentClientAuthority }) => {
+      const cfg = api.runtime.config.current() as OpenClawConfig;
+      let agentId: string;
+      try {
+        if (
+          !params ||
+          Array.isArray(params) ||
+          Object.keys(params).some((key) => key !== "agentId" && key !== "force") ||
+          typeof params.agentId !== "string" ||
+          !params.agentId.trim() ||
+          (params.force !== undefined && typeof params.force !== "boolean")
+        ) {
+          throw new Error("memory.index requires agentId and an optional boolean force.");
+        }
+        agentId = resolveConfiguredAgentId(cfg, params.agentId);
+      } catch (error) {
+        respond(
+          false,
+          undefined,
+          errorShape(ErrorCodes.INVALID_REQUEST, formatErrorMessage(error)),
+        );
+        return;
+      }
+      const assertCurrent = () => {
+        signal?.throwIfAborted();
+        client?.connectionSignal?.throwIfAborted();
+        if (!client || client.invalidated || hasCurrentClientAuthority?.() !== true) {
+          throw new Error("Memory maintenance operator authority is no longer current.");
+        }
+        if (api.runtime.config.current() !== cfg) {
+          throw new Error(
+            "Memory configuration changed during maintenance; inspect status before retrying.",
+          );
+        }
+      };
+      try {
+        assertCurrent();
+        const { indexMemoryOnGateway } = await loadIndexRuntime();
+        assertCurrent();
+        const status = await indexMemoryOnGateway({
+          cfg,
+          agentId,
+          force: params.force === true,
+          assertCurrent,
+          signal: AbortSignal.any(
+            [signal, client?.connectionSignal].filter(
+              (value): value is AbortSignal => value !== undefined,
+            ),
+          ),
+          acquireLocalService: (...args) => api.runtime.llm.acquireLocalService(...args),
+        });
+        assertCurrent();
+        respond(true, { agentId, status });
+      } catch (error) {
+        respond(false, undefined, errorShape(ErrorCodes.UNAVAILABLE, formatErrorMessage(error)));
+      }
+    },
+    { scope: "operator.admin" },
+  );
+}
