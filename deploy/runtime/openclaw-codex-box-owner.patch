index 0000000..ceeb37a
--- /dev/null
+++ b/extensions/codex/src/app-server/provider-box-owner.test.ts
@@ -0,0 +1,634 @@
+import { execFileSync } from "node:child_process";
+import { once } from "node:events";
+import {
+  chmod,
+  mkdir,
+  mkdtemp,
+  readFile,
+  rename,
+  rm,
+  symlink,
+  writeFile,
+} from "node:fs/promises";
+import { createServer } from "node:https";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { WebSocketServer } from "ws";
+import { TEST_TLS_CERT_PEM } from "../../../../test/helpers/tls-fixture.js";
+import {
+  allowsProviderBoxRequest,
+  matchesProviderBoxOwner,
+  providerBoxRequestRefusal,
+  providerBoxRequestSnapshot,
+  readProviderBoxOwner,
+} from "./provider-box-owner.js";
+import { createWebSocketTransport } from "./transport-websocket.js";
+
+const workspaceRoot = "/home/node/workspace";
+it("describes a Box refusal with fixed codes without echoing caller data", () => {
+  const owner = { workspaceRoot };
+  const privateArgument = "/synthetic/caller-controlled";
+  expect(providerBoxRequestRefusal(owner, privateArgument, {})).toBe("rpc-not-allowed");
+  expect(providerBoxRequestRefusal(owner, "thread/inject_items", { input: privateArgument })).toBe(
+    "rpc-thread-inject-items",
+  );
+  expect(
+    providerBoxRequestRefusal(owner, "thread/start", {
+      cwd: privateArgument,
+      sandbox: "workspace-write",
+    }),
+  ).toBe("thread/start:cwd");
+  expect(
+    providerBoxRequestRefusal(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "restricted" },
+    }),
+  ).toBeUndefined();
+});
+
+const generationSha256 = "a".repeat(64);
+const authToken = "fixture-native-transport-capability";
+const header = "X-OpenClaw-Box-Owner";
+const owner = { workspaceRoot };
+
+it("does not inherit an earlier external policy on an implicit or global-danger turn", () => {
+  expect(allowsProviderBoxRequest(owner, "turn/start", {})).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      permissions: ":danger-full-access",
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "dangerFullAccess" },
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "enabled" },
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "restricted" },
+    }),
+  ).toBe(true);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot + "/nested",
+      sandboxPolicy: { type: "readOnly", networkAccess: false },
+    }),
+  ).toBe(true);
+  const policy = { type: "externalSandbox", networkAccess: "restricted" };
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: "/tmp",
+      sandboxPolicy: policy,
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: policy,
+      environments: [{ environmentId: "foreign" }],
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "command/exec", {
+      cwd: workspaceRoot,
+      sandboxPolicy: policy,
+    }),
+  ).toBe(false);
+  expect(allowsProviderBoxRequest(owner, "thread/shellCommand", {})).toBe(
+    false,
+  );
+  expect(allowsProviderBoxRequest(owner, "thread/read", {})).toBe(true);
+  expect(
+    allowsProviderBoxRequest(owner, "thread/start", {
+      cwd: workspaceRoot,
+      sandbox: "workspace-write",
+      environments: [],
+    }),
+  ).toBe(true);
+});
+
+it("uses only the closed provider mount for the exact Compute route and capability", async () => {
+  const root = await mkdtemp(join(tmpdir(), "openclaw-box-owner-"));
+  const parent = join(root, "etc");
+  const directory = join(parent, "owner");
+  const bindingPath = join(directory, "binding.json");
+  const caPath = join(directory, "ca.pem");
+  const scope = { root, ancestry: ["etc", "owner"], uid: process.getuid!() };
+  try {
+    const url = "wss://box-harness.pilot.svc.cluster.local:8443/";
+    const input = {
+      transport: "websocket",
+      url,
+      workspaceRoot,
+      authToken,
+      computeUrl: url,
+      computeToken: authToken,
+      headers: {},
+    };
+    await mkdir(parent, { mode: 0o755 });
+    expect(readProviderBoxOwner(input, scope)).toBeUndefined();
+    const unmapped = { ...scope, uid: scope.uid + 1 };
+    expect(readProviderBoxOwner(input, unmapped)).toBeUndefined();
+    await mkdir(directory, { mode: 0o755 });
+    expect(() => readProviderBoxOwner(input, scope)).toThrow(
+      "owner binding is invalid",
+    );
+    await writeFile(
+      bindingPath,
+      JSON.stringify({ url, workspaceRoot, generationSha256 }),
+      { mode: 0o444 },
+    );
+    expect(() => readProviderBoxOwner(input, scope)).toThrow(
+      "owner binding is invalid",
+    );
+    await writeFile(caPath, TEST_TLS_CERT_PEM, { mode: 0o444 });
+    const owner = readProviderBoxOwner(input, scope);
+    expect(() => readProviderBoxOwner(input, unmapped)).toThrow(
+      "owner binding is invalid",
+    );
+    expect(owner).toMatchObject({
+      url,
+      workspaceRoot,
+      generationSha256,
+      ca: TEST_TLS_CERT_PEM,
+    });
+    expect(() => owner!.assertCurrent()).not.toThrow();
+    for (const invalid of [
+      { url: "wss://elsewhere/" },
+      { transport: "stdio" },
+      { computeToken: "other" },
+      { workspaceRoot: "/home/node/other" },
+    ]) {
+      expect(() =>
+        readProviderBoxOwner({ ...input, ...invalid }, scope),
+      ).toThrow("owner binding is invalid");
+    }
+    expect(
+      matchesProviderBoxOwner(owner!, {
+        rawHeaders: [header, generationSha256, header, generationSha256],
+      }),
+    ).toBe(false);
+    await chmod(parent, 0o777);
+    expect(() => owner!.assertCurrent()).toThrow("owner binding is invalid");
+    expect(() => readProviderBoxOwner(input, scope)).toThrow(
+      "owner binding is invalid",
+    );
+    await chmod(parent, 0o755);
+    await rename(caPath, caPath + ".old");
+    await symlink("ca.pem.old", caPath);
+    expect(() => owner!.assertCurrent()).toThrow("owner binding is invalid");
+    expect(() => readProviderBoxOwner(input, scope)).toThrow(
+      "owner binding is invalid",
+    );
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+it("delivers native frames only on the CA-pinned original generation, including after withdrawal", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "openclaw-box-owner-tls-"));
+  const certPath = join(directory, "cert.pem");
+  const keyPath = join(directory, "key.pem");
+  const [cert, key] = await (async () => {
+    try {
+      execFileSync(
+        "openssl",
+        [
+          "req",
+          "-new",
+          "-x509",
+          "-newkey",
+          "rsa:2048",
+          "-nodes",
+          "-days",
+          "1",
+          "-subj",
+          "/CN=Box owner test CA",
+          "-addext",
+          "basicConstraints=critical,CA:TRUE",
+          "-addext",
+          "subjectAltName=IP:127.0.0.1",
+          "-out",
+          certPath,
+          "-keyout",
+          keyPath,
+        ],
+        { stdio: "ignore" },
+      );
+      return await Promise.all([
+        readFile(certPath, "utf8"),
+        readFile(keyPath, "utf8"),
+      ]);
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  })();
+  const server = createServer({ cert, key });
+  const peer = new WebSocketServer({ server });
+  let generation = generationSha256;
+  const frames: string[] = [];
+  peer.on("headers", (headers) => headers.push(`${header}: ${generation}`));
+  peer.on("connection", (socket) =>
+    socket.on("message", (frame) => frames.push(frame.toString())),
+  );
+  try {
+    server.listen(0, "127.0.0.1");
+    await once(server, "listening");
+    const address = server.address();
+    if (!address || typeof address === "string") {
+      throw new Error("Expected the test's TLS listener.");
+    }
+    const url = `wss://127.0.0.1:${address.port}/`;
+    let current = true;
+    const start = {
+      transport: "websocket" as const,
+      url,
+      authToken,
+      headers: {},
+      command: "codex",
+      args: [],
+      providerBoxOwner: {
+        url,
+        workspaceRoot,
+        generationSha256,
+        ca: cert,
+        assertCurrent() {
+          if (!current) throw new Error("owner binding is invalid");
+        },
+      },
+    };
+    const original = createWebSocketTransport(start);
+    const received = new Promise<void>((resolve, reject) => {
+      original.once("error", reject);
+      peer.once("connection", (socket, request) => {
+        expect(request.headers.authorization).toBe(`Bearer ${authToken}`);
+        socket.once("message", () => resolve());
+      });
+    });
+    original.stdin.write('{"id":1,"method":"initialize"}\n');
+    await received;
+    expect(frames).toHaveLength(1);
+    for (const frame of [
+      {
+        method: "command/exec",
+        params: {
+          cwd: workspaceRoot,
+          sandboxPolicy: { type: "dangerFullAccess" },
+        },
+      },
+      {
+        method: "turn/start",
+        params: {
+          cwd: "/tmp",
+          sandboxPolicy: {
+            type: "externalSandbox",
+            networkAccess: "restricted",
+          },
+        },
+      },
+    ]) {
+      const blocked = createWebSocketTransport(start);
+      const refused = new Promise<unknown>((resolve) =>
+        blocked.once("error", resolve),
+      );
+      blocked.stdin.write(JSON.stringify({ id: 3, ...frame }) + "\n");
+      await expect(refused).resolves.toEqual(
+        expect.objectContaining({
+          message: expect.stringContaining("request was refused"),
+        }),
+      );
+      expect(frames).toHaveLength(1);
+    }
+    const closed = new Promise<void>((resolve) =>
+      original.once("exit", () => resolve()),
+    );
+    current = false;
+    const revoked = new Promise<unknown>((resolve) =>
+      original.once("error", resolve),
+    );
+    original.stdin.write('{"id":4,"method":"thread/read","params":{}}\n');
+    await expect(revoked).resolves.toEqual(
+      expect.objectContaining({
+        message: expect.stringContaining("request was refused"),
+      }),
+    );
+    expect(frames).toHaveLength(1);
+    current = true;
+    for (const socket of peer.clients) {
+      socket.terminate();
+    }
+    await closed;
+    generation = "b".repeat(64);
+    const replacement = createWebSocketTransport(start);
+    const rejected = new Promise<unknown>((resolve) =>
+      replacement.once("error", resolve),
+    );
+    replacement.stdin.write('{"id":2,"method":"initialize"}\n');
+    await expect(rejected).resolves.toEqual(
+      expect.objectContaining({
+        message: expect.stringContaining("no longer serving"),
+      }),
+    );
+    expect(frames).toHaveLength(1);
+  } finally {
+    for (const socket of peer.clients) {
+      socket.terminate();
+    }
+    peer.close();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
+
+it("admits only the native hook relay credential file and refuses every other filesystem call", () => {
+  const relayId = `codex-${"0123456789abcdef".repeat(3).slice(0, 40)}`;
+  const generation = "3f2b8c1e-9d4a-4b7e-8c21-5a6f0e9d1b72";
+  const directory = "/home/node/.oce-native-hooks";
+  const path = `${directory}/${relayId}.${generation}.json`;
+  const url = `https://gateway.example.test:10443/namespaces/ns/agents/agent/node/__openclaw__/native-hook/${relayId}`;
+  const document = (value: unknown) => Buffer.from(JSON.stringify(value)).toString("base64");
+  const dataBase64 = document({ url, token: "7d9e2f4a-1b3c-4d5e-8f60-7a8b9c0d1e2f" });
+  // The fence reads the configured relay URL and directory from the Gateway's own rendered
+  // configuration (appServer.nativeHookRelay), never from the request; base is that URL without
+  // the relay-id suffix native-hook-relay-remote.ts appends.
+  const base = url.slice(0, url.length - `/${relayId}`.length);
+  const hookOwner = { workspaceRoot, nativeHookRelay: { url: base, credentialDirectory: directory } };
+  const write = (params: unknown) => providerBoxRequestRefusal(hookOwner, "fs/writeFile", params);
+  const remove = (params: unknown) => providerBoxRequestRefusal(hookOwner, "fs/remove", params);
+
+  // The two accepted forms, exactly as native-hook-relay-remote.ts sends them.
+  expect(write({ path, dataBase64 })).toBeUndefined();
+  expect(remove({ path, force: true, recursive: false })).toBeUndefined();
+
+  // Without the configured relay (owner has no nativeHookRelay), or with a directory that is not
+  // the fixed hook directory, nothing is admitted: the fence fails closed on misconfiguration.
+  expect(providerBoxRequestRefusal({ workspaceRoot }, "fs/writeFile", { path, dataBase64 })).toBe(
+    "fs/writeFile:unconfigured",
+  );
+  expect(
+    providerBoxRequestRefusal({ workspaceRoot }, "fs/remove", {
+      path,
+      force: true,
+      recursive: false,
+    }),
+  ).toBe("fs/remove:unconfigured");
+  expect(
+    providerBoxRequestRefusal(
+      { workspaceRoot, nativeHookRelay: { url: base, credentialDirectory: "/home/node/.other" } },
+      "fs/writeFile",
+      { path, dataBase64 },
+    ),
+  ).toBe("fs/writeFile:unconfigured");
+  // The URL is pinned to the configured relay: the same credential written under a different
+  // configured base is refused (the request cannot choose its own target).
+  expect(
+    providerBoxRequestRefusal(
+      {
+        workspaceRoot,
+        nativeHookRelay: {
+          url: "https://other.example.test:10443/namespaces/ns/agents/agent/node/__openclaw__/native-hook",
+          credentialDirectory: directory,
+        },
+      },
+      "fs/writeFile",
+      { path, dataBase64 },
+    ),
+  ).toBe("fs/writeFile:data");
+
+  // Paths: sibling directory, nested, prefix collision, relative, dot segments, trailing
+  // slash, NUL, symlink-looking or other names and extensions, the directory itself.
+  const name = `${relayId}.${generation}.json`;
+  for (const candidate of [
+    `/home/node/.oce-native-hooks-x/${name}`,
+    `/home/node/.oce-native-hooksx/${name}`,
+    `/home/node/${name}`,
+    `/home/node/workspace/${name}`,
+    `/home/other/.oce-native-hooks/${name}`,
+    `${directory}/nested/${name}`,
+    `${directory}/../.oce-native-hooks/${name}`,
+    `${directory}/./${name}`,
+    `${directory}//${name}`,
+    `${directory}/${name}/`,
+    `${directory}/${name}\0`,
+    `.oce-native-hooks/${name}`,
+    `~/.oce-native-hooks/${name}`,
+    `${directory}/${relayId}.${generation}.json.lnk`,
+    `${directory}/${relayId}.${generation}.jsonx`,
+    `${directory}/${relayId}.${generation}.toml`,
+    `${directory}/${relayId}.${generation}`,
+    `${directory}/gateway-ca.pem`,
+    `${directory}/${relayId.toUpperCase()}.${generation}.json`,
+    `${directory}/codex-${"a".repeat(39)}.${generation}.json`,
+    `${directory}/${relayId}.${generation.toUpperCase()}.json`,
+    `${directory}/${relayId}.current.json`,
+    `${directory}/${relayId}%2F..%2F.${generation}.json`,
+    directory,
+    `${directory}/`,
+    undefined,
+    7,
+  ]) {
+    expect(write({ path: candidate, dataBase64 })).not.toBeUndefined();
+    expect(remove({ path: candidate, force: true, recursive: false })).not.toBeUndefined();
+  }
+
+  // Parameters: missing, extra, inherited or of another form.
+  expect(write(undefined)).toBe("fs/writeFile:params");
+  expect(write([path, dataBase64])).toBe("fs/writeFile:params");
+  expect(write({ path })).toBe("fs/writeFile:params");
+  expect(write({ path, dataBase64, append: true })).toBe("fs/writeFile:params");
+  expect(write(Object.assign(Object.create({ dataBase64 }), { path }))).toBe("fs/writeFile:params");
+  expect(remove({ path, force: true })).toBe("fs/remove:params");
+  expect(remove({ path, force: true, recursive: true })).toBe("fs/remove:params");
+  expect(remove({ path, force: false, recursive: false })).toBe("fs/remove:params");
+  expect(remove({ path, force: "true", recursive: false })).toBe("fs/remove:params");
+  expect(remove({ path, force: true, recursive: false, extra: 1 })).toBe("fs/remove:params");
+
+  // Data: only the canonical credential document for the relay the file names.
+  for (const data of [
+    "",
+    "not base64!",
+    `${dataBase64}\n`,
+    dataBase64.slice(0, -1),
+    `${dataBase64.slice(0, -2)}=${dataBase64.slice(-1)}`,
+    Buffer.from("x".repeat(5000)).toString("base64"),
+    document({ token: "7d9e2f4a-1b3c-4d5e-8f60-7a8b9c0d1e2f", url }),
+    document({ url, token: "7d9e2f4a-1b3c-4d5e-8f60-7a8b9c0d1e2f", extra: true }),
