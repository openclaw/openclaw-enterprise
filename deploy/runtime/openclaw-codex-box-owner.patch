+// Keep rejected method names closed over known protocol literals. An arbitrary
+// caller-provided name must never appear in a Gateway error or model reply.
+const knownDeniedRpcEntries = [
+  ["account/login/start", "rpc-account-login"],
+  ["app/read", "rpc-app-read"],
+  ["command/exec", "rpc-direct-exec"],
+  ["config/batchWrite", "rpc-config-write"],
+  ["config/mcpServer/reload", "rpc-mcp-reload"],
+  ["environment/add", "rpc-environment-add"],
+  ["environment/remove", "rpc-environment-remove"],
+  ["experimentalFeature/list", "rpc-experimental-features"],
+  ["marketplace/add", "rpc-marketplace-add"],
+  ["marketplace/remove", "rpc-marketplace-remove"],
+  ["thread/backgroundTerminals/list", "rpc-background-terminals"],
+  ["thread/goal/get", "rpc-thread-goal"],
+  ["thread/inject_items", "rpc-thread-inject-items"],
+  ["thread/metadata/update", "rpc-thread-metadata"],
+  ["thread/shellCommand", "rpc-thread-shell"],
+] as const;
+
+type ProviderBoxKnownDeniedRpc = (typeof knownDeniedRpcEntries)[number][1];
+const KNOWN_DENIED_RPC_DIAGNOSTICS = new Map<string, ProviderBoxKnownDeniedRpc>(
+  knownDeniedRpcEntries,
+);
+
+type ProviderBoxRequestRefusal =
+  | "rpc-not-allowed"
+  | ProviderBoxKnownDeniedRpc
+  | `thread/${"start" | "resume" | "fork"}:${"params" | "cwd" | "permissions" | "environments" | "roots" | "path" | "sandbox-policy" | "sandbox" | "config"}`
+  | `turn/start:${"params" | "cwd" | "permissions" | "environments" | "roots" | "sandbox" | "sandbox-policy" | "external-policy" | "read-only-policy" | "workspace-write-policy"}`;
+
+function isProviderBoxThreadBinding(
+  method: string,
+): method is "thread/start" | "thread/resume" | "thread/fork" {
+  return THREAD_BINDING.has(method);
+}
+
+/** Check the fixed RPC set without reflecting method or argument data into failures. */
+export function providerBoxRequestRefusal(
+  owner: Pick<ProviderBoxOwner, "workspaceRoot">,
+  method: string,
+  params: unknown,
+): ProviderBoxRequestRefusal | undefined {
+  if (CHAT_CONTROL.has(method)) return;
+  if (method !== "turn/start" && !isProviderBoxThreadBinding(method)) {
+    return KNOWN_DENIED_RPC_DIAGNOSTICS.get(method) ?? "rpc-not-allowed";
+  }
+  if (!params || typeof params !== "object" || Array.isArray(params)) return `${method}:params`;
+  const {
+    cwd,
+    environments,
+    runtimeWorkspaceRoots,
+    sandbox,
+    sandboxPolicy,
+    permissions,
+    path,
+    config,
+  } = params as Record<string, unknown>;
+  const inside = (path: unknown): path is string =>
+    typeof path === "string" &&
+    !path.includes("\0") &&
+    posix.normalize(path) === path &&
+    (path === owner.workspaceRoot ||
+      path.startsWith(owner.workspaceRoot + "/"));
+  if (!inside(cwd)) return `${method}:cwd`;
+  if (permissions !== undefined) return `${method}:permissions`;
+  if (environments !== undefined && (!Array.isArray(environments) || environments.length !== 0)) {
+    return `${method}:environments`;
+  }
+  if (
+    runtimeWorkspaceRoots !== undefined &&
+    (!Array.isArray(runtimeWorkspaceRoots) || !runtimeWorkspaceRoots.every(inside))
+  ) {
+    return `${method}:roots`;
+  }
+  if (method !== "turn/start") {
+    if (path !== undefined) return `${method}:path`;
+    if (sandboxPolicy !== undefined) return `${method}:sandbox-policy`;
+    if (sandbox !== "read-only" && sandbox !== "workspace-write") return `${method}:sandbox`;
+    if (
+      config !== undefined &&
+      (config === null ||
+        typeof config !== "object" ||
+        Array.isArray(config) ||
+        Object.keys(config).some((key) =>
+          /^(?:default_permissions|permissions|sandbox_mode|sandbox_workspace_write)(?:\.|$)/.test(
+            key,
+          ),
+        ))
+    ) {
+      return `${method}:config`;
+    }
+    return;
+  }
+  if (sandbox !== undefined) return "turn/start:sandbox";
+  if (!sandboxPolicy || typeof sandboxPolicy !== "object" || Array.isArray(sandboxPolicy)) {
+    return "turn/start:sandbox-policy";
+  }
+  const { type, networkAccess, writableRoots } = sandboxPolicy as Record<string, unknown>;
+  if (type === "externalSandbox") {
+    return cwd === owner.workspaceRoot &&
+      networkAccess === "restricted" &&
+      runtimeWorkspaceRoots === undefined &&
+      Object.keys(sandboxPolicy).length === 2
+      ? undefined
+      : "turn/start:external-policy";
+  }
+  if (type === "readOnly") {
+    return typeof networkAccess === "boolean" && writableRoots === undefined
+      ? undefined
+      : "turn/start:read-only-policy";
+  }
+  return type === "workspaceWrite" &&
+    typeof networkAccess === "boolean" &&
+    Array.isArray(writableRoots) &&
+    writableRoots.every(inside)
+    ? undefined
+    : "turn/start:workspace-write-policy";
+}
+
+/** Authorize the fixed chat RPC set before sending it over the selected owner's WSS. */
+export function allowsProviderBoxRequest(
+  owner: Pick<ProviderBoxOwner, "workspaceRoot">,
+  method: string,
+  params: unknown,
+): boolean {
+  return providerBoxRequestRefusal(owner, method, params) === undefined;
+}
