+      );
+    if (
+      !certificates ||
+      ca.trim() !== certificates.join(ca.includes("\r\n") ? "\r\n" : "\n")
+    ) {
+      return refusal();
+    }
+    for (const certificate of certificates) new X509Certificate(certificate);
+    return {
+      url,
+      workspaceRoot,
+      generationSha256,
+      ca,
+      assertCurrent() {
+        try {
+          if (
+            !isDeepStrictEqual(
+              snapshot(path, expected, false).identities,
+              selected.identities,
+            )
+          )
+            return refusal();
+        } catch {
+          return refusal();
+        }
+      },
+    };
+  } catch {
+    return refusal();
+  }
+}
+
+export function matchesProviderBoxOwner(
+  owner: ProviderBoxOwner,
+  response: Pick<IncomingMessage, "rawHeaders">,
+): boolean {
+  const values: string[] = [];
+  for (let i = 0; i < response.rawHeaders.length; i += 2) {
+    if (response.rawHeaders[i]?.toLowerCase() === OWNER_HEADER) {
+      values.push(response.rawHeaders[i + 1] ?? "");
+    }
+  }
+  return values.length === 1 && values[0] === owner.generationSha256;
+}
+
+const CHAT_CONTROL = new Set([
+  "initialize",
+  "initialized",
+  "thread/read",
+  "thread/list",
+  "thread/loaded/list",
+  "thread/unsubscribe",
+  "turn/steer",
+  "turn/interrupt",
+  "model/list",
+  "config/read",
+  "configRequirements/read",
+  "hooks/list",
+  "mcpServerStatus/list",
+  "plugin/list",
+  "plugin/installed",
+  "plugin/read",
+  "app/installed",
+  "account/read",
+  "account/rateLimits/read",
+  "modelProvider/capabilities/read",
+  "skills/list",
+  "thread/turns/list",
+  "thread/items/list",
+]);
+const THREAD_BINDING = new Set([
+  "thread/start",
+  "thread/resume",
+  "thread/fork",
+]);
