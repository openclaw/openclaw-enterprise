@@ -0,0 +1,349 @@
+import { execFileSync } from "node:child_process";
+import { once } from "node:events";
+import {
+  chmod,
+  mkdir,
+  mkdtemp,
+  readFile,
+  rename,
+  rm,
+  symlink,
+  writeFile,
+} from "node:fs/promises";
+import { createServer } from "node:https";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { WebSocketServer } from "ws";
+import { TEST_TLS_CERT_PEM } from "../../../../test/helpers/tls-fixture.js";
+import {
+  allowsProviderBoxRequest,
+  matchesProviderBoxOwner,
+  providerBoxRequestRefusal,
+  readProviderBoxOwner,
+} from "./provider-box-owner.js";
+import { createWebSocketTransport } from "./transport-websocket.js";
+
+const workspaceRoot = "/home/node/workspace";
+it("describes a Box refusal with fixed codes without echoing caller data", () => {
+  const owner = { workspaceRoot };
+  const privateArgument = "/synthetic/caller-controlled";
+  expect(providerBoxRequestRefusal(owner, privateArgument, {})).toBe("rpc-not-allowed");
+  expect(providerBoxRequestRefusal(owner, "thread/inject_items", { input: privateArgument })).toBe(
+    "rpc-thread-inject-items",
+  );
+  expect(
+    providerBoxRequestRefusal(owner, "thread/start", {
+      cwd: privateArgument,
+      sandbox: "workspace-write",
+    }),
+  ).toBe("thread/start:cwd");
+  expect(
+    providerBoxRequestRefusal(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "restricted" },
+    }),
+  ).toBeUndefined();
+});
+
+const generationSha256 = "a".repeat(64);
+const authToken = "fixture-native-transport-capability";
+const header = "X-OpenClaw-Box-Owner";
+const owner = { workspaceRoot };
+
+it("does not inherit an earlier external policy on an implicit or global-danger turn", () => {
+  expect(allowsProviderBoxRequest(owner, "turn/start", {})).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      permissions: ":danger-full-access",
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "dangerFullAccess" },
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "enabled" },
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: { type: "externalSandbox", networkAccess: "restricted" },
+    }),
+  ).toBe(true);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot + "/nested",
+      sandboxPolicy: { type: "readOnly", networkAccess: false },
+    }),
+  ).toBe(true);
+  const policy = { type: "externalSandbox", networkAccess: "restricted" };
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: "/tmp",
+      sandboxPolicy: policy,
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "turn/start", {
+      cwd: workspaceRoot,
+      sandboxPolicy: policy,
+      environments: [{ environmentId: "foreign" }],
+    }),
+  ).toBe(false);
+  expect(
+    allowsProviderBoxRequest(owner, "command/exec", {
+      cwd: workspaceRoot,
+      sandboxPolicy: policy,
+    }),
+  ).toBe(false);
+  expect(allowsProviderBoxRequest(owner, "thread/shellCommand", {})).toBe(
+    false,
+  );
+  expect(allowsProviderBoxRequest(owner, "thread/read", {})).toBe(true);
+  expect(
+    allowsProviderBoxRequest(owner, "thread/start", {
+      cwd: workspaceRoot,
+      sandbox: "workspace-write",
+      environments: [],
+    }),
+  ).toBe(true);
+});
+
+it("uses only the closed provider mount for the exact Compute route and capability", async () => {
+  const root = await mkdtemp(join(tmpdir(), "openclaw-box-owner-"));
+  const parent = join(root, "etc");
+  const directory = join(parent, "owner");
+  const bindingPath = join(directory, "binding.json");
+  const caPath = join(directory, "ca.pem");
+  const scope = { root, ancestry: ["etc", "owner"], uid: process.getuid!() };
+  try {
+    const url = "wss://box-harness.pilot.svc.cluster.local:8443/";
+    const input = {
+      transport: "websocket",
+      url,
+      workspaceRoot,
+      authToken,
+      computeUrl: url,
+      computeToken: authToken,
+      headers: {},
+    };
+    await mkdir(parent, { mode: 0o755 });
+    expect(readProviderBoxOwner(input, scope)).toBeUndefined();
+    const unmapped = { ...scope, uid: scope.uid + 1 };
+    expect(readProviderBoxOwner(input, unmapped)).toBeUndefined();
+    await mkdir(directory, { mode: 0o755 });
+    expect(() => readProviderBoxOwner(input, scope)).toThrow(
+      "owner binding is invalid",
+    );
+    await writeFile(
+      bindingPath,
+      JSON.stringify({ url, workspaceRoot, generationSha256 }),
+      { mode: 0o444 },
+    );
+    expect(() => readProviderBoxOwner(input, scope)).toThrow(
+      "owner binding is invalid",
+    );
+    await writeFile(caPath, TEST_TLS_CERT_PEM, { mode: 0o444 });
+    const owner = readProviderBoxOwner(input, scope);
+    expect(() => readProviderBoxOwner(input, unmapped)).toThrow(
+      "owner binding is invalid",
+    );
+    expect(owner).toMatchObject({
+      url,
+      workspaceRoot,
+      generationSha256,
+      ca: TEST_TLS_CERT_PEM,
+    });
+    expect(() => owner!.assertCurrent()).not.toThrow();
+    for (const invalid of [
+      { url: "wss://elsewhere/" },
+      { transport: "stdio" },
+      { computeToken: "other" },
+      { workspaceRoot: "/home/node/other" },
+    ]) {
+      expect(() =>
+        readProviderBoxOwner({ ...input, ...invalid }, scope),
+      ).toThrow("owner binding is invalid");
+    }
+    expect(
+      matchesProviderBoxOwner(owner!, {
+        rawHeaders: [header, generationSha256, header, generationSha256],
+      }),
+    ).toBe(false);
+    await chmod(parent, 0o777);
+    expect(() => owner!.assertCurrent()).toThrow("owner binding is invalid");
+    expect(() => readProviderBoxOwner(input, scope)).toThrow(
+      "owner binding is invalid",
+    );
+    await chmod(parent, 0o755);
+    await rename(caPath, caPath + ".old");
+    await symlink("ca.pem.old", caPath);
+    expect(() => owner!.assertCurrent()).toThrow("owner binding is invalid");
+    expect(() => readProviderBoxOwner(input, scope)).toThrow(
+      "owner binding is invalid",
+    );
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
+
+it("delivers native frames only on the CA-pinned original generation, including after withdrawal", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "openclaw-box-owner-tls-"));
+  const certPath = join(directory, "cert.pem");
+  const keyPath = join(directory, "key.pem");
+  const [cert, key] = await (async () => {
+    try {
+      execFileSync(
+        "openssl",
+        [
+          "req",
+          "-new",
+          "-x509",
+          "-newkey",
+          "rsa:2048",
+          "-nodes",
+          "-days",
+          "1",
+          "-subj",
+          "/CN=Box owner test CA",
+          "-addext",
+          "basicConstraints=critical,CA:TRUE",
+          "-addext",
+          "subjectAltName=IP:127.0.0.1",
+          "-out",
+          certPath,
+          "-keyout",
+          keyPath,
+        ],
+        { stdio: "ignore" },
+      );
+      return await Promise.all([
+        readFile(certPath, "utf8"),
+        readFile(keyPath, "utf8"),
+      ]);
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  })();
+  const server = createServer({ cert, key });
+  const peer = new WebSocketServer({ server });
+  let generation = generationSha256;
+  const frames: string[] = [];
+  peer.on("headers", (headers) => headers.push(`${header}: ${generation}`));
+  peer.on("connection", (socket) =>
+    socket.on("message", (frame) => frames.push(frame.toString())),
+  );
+  try {
+    server.listen(0, "127.0.0.1");
+    await once(server, "listening");
+    const address = server.address();
+    if (!address || typeof address === "string") {
+      throw new Error("Expected the test's TLS listener.");
+    }
+    const url = `wss://127.0.0.1:${address.port}/`;
+    let current = true;
+    const start = {
+      transport: "websocket" as const,
+      url,
+      authToken,
+      headers: {},
+      command: "codex",
+      args: [],
+      providerBoxOwner: {
+        url,
+        workspaceRoot,
+        generationSha256,
+        ca: cert,
+        assertCurrent() {
+          if (!current) throw new Error("owner binding is invalid");
+        },
+      },
+    };
+    const original = createWebSocketTransport(start);
+    const received = new Promise<void>((resolve, reject) => {
+      original.once("error", reject);
+      peer.once("connection", (socket, request) => {
+        expect(request.headers.authorization).toBe(`Bearer ${authToken}`);
+        socket.once("message", () => resolve());
+      });
+    });
+    original.stdin.write('{"id":1,"method":"initialize"}\n');
+    await received;
+    expect(frames).toHaveLength(1);
+    for (const frame of [
+      {
+        method: "command/exec",
+        params: {
+          cwd: workspaceRoot,
+          sandboxPolicy: { type: "dangerFullAccess" },
+        },
+      },
+      {
+        method: "turn/start",
+        params: {
+          cwd: "/tmp",
+          sandboxPolicy: {
+            type: "externalSandbox",
+            networkAccess: "restricted",
+          },
+        },
+      },
+    ]) {
+      const blocked = createWebSocketTransport(start);
+      const refused = new Promise<unknown>((resolve) =>
+        blocked.once("error", resolve),
+      );
+      blocked.stdin.write(JSON.stringify({ id: 3, ...frame }) + "\n");
+      await expect(refused).resolves.toEqual(
+        expect.objectContaining({
+          message: expect.stringContaining("request was refused"),
+        }),
+      );
+      expect(frames).toHaveLength(1);
+    }
+    const closed = new Promise<void>((resolve) =>
+      original.once("exit", () => resolve()),
+    );
+    current = false;
+    const revoked = new Promise<unknown>((resolve) =>
+      original.once("error", resolve),
+    );
+    original.stdin.write('{"id":4,"method":"thread/read","params":{}}\n');
+    await expect(revoked).resolves.toEqual(
+      expect.objectContaining({
+        message: expect.stringContaining("request was refused"),
+      }),
+    );
+    expect(frames).toHaveLength(1);
+    current = true;
+    for (const socket of peer.clients) {
+      socket.terminate();
+    }
+    await closed;
+    generation = "b".repeat(64);
+    const replacement = createWebSocketTransport(start);
+    const rejected = new Promise<unknown>((resolve) =>
+      replacement.once("error", resolve),
+    );
+    replacement.stdin.write('{"id":2,"method":"initialize"}\n');
+    await expect(rejected).resolves.toEqual(
+      expect.objectContaining({
+        message: expect.stringContaining("no longer serving"),
+      }),
+    );
+    expect(frames).toHaveLength(1);
+  } finally {
+    for (const socket of peer.clients) {
+      socket.terminate();
+    }
+    peer.close();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
diff --git a/extensions/codex/src/app-server/provider-box-owner.ts b/extensions/codex/src/app-server/provider-box-owner.ts
new file mode 100644
index 0000000..732a641
--- /dev/null
+++ b/extensions/codex/src/app-server/provider-box-owner.ts
@@ -0,0 +1,424 @@
+import { X509Certificate } from "node:crypto";
+import {
+  closeSync,
+  constants,
+  fstatSync,
+  lstatSync,
+  openSync,
+  readSync,
+  type BigIntStats,
+} from "node:fs";
+import type { IncomingMessage } from "node:http";
+import { posix } from "node:path";
+import { isDeepStrictEqual, TextDecoder } from "node:util";
+
+const OWNER_HEADER = "x-openclaw-box-owner";
+const SHA256 = /^[a-f0-9]{64}$/;
+const DIRECTORY_FLAGS =
+  constants.O_RDONLY | constants.O_DIRECTORY | constants.O_NOFOLLOW;
+const FILE_FLAGS =
+  constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK;
+const BINDING_PATH = {
+  root: "/",
+  ancestry: ["etc", "openclaw-box-owner"],
+  uid: 0,
+};
+const isAbsent = (error: unknown) =>
+  error instanceof Error && "code" in error && error.code === "ENOENT";
+
+export type ProviderBoxOwner = {
+  url: string;
+  workspaceRoot: string;
+  generationSha256: string;
+  ca: string;
+  assertCurrent: () => void;
+};
+
+function refusal(): never {
+  throw new Error("The dedicated Codex provider Box owner binding is invalid.");
+}
+
+function fileIdentity(stat: BigIntStats) {
+  return [
+    stat.dev,
+    stat.ino,
+    stat.uid,
+    stat.gid,
+    stat.mode,
+    stat.nlink,
+    stat.size,
+    stat.mtimeNs,
+    stat.ctimeNs,
+  ];
+}
+
+function directoryIdentity(stat: BigIntStats, uid: number): bigint[] {
+  if (
+    !stat.isDirectory() ||
+    stat.uid !== BigInt(uid) ||
+    (stat.mode & 0o022n) !== 0n
+  ) {
+    return refusal();
+  }
+  return [stat.dev, stat.ino, stat.uid, stat.gid, stat.mode];
+}
+
+function snapshot(
+  path: typeof BINDING_PATH,
+  expected: bigint[],
+  contents: boolean,
+) {
+  const descriptors: number[] = [];
+  const open = (file: string, flags: number) => {
+    const fd = openSync(file, flags);
+    descriptors.push(fd);
+    return fd;
+  };
+  try {
+    let directory = open(path.root, DIRECTORY_FLAGS);
+    const identify = (fd: number) =>
+      directoryIdentity(fstatSync(fd, { bigint: true }), path.uid);
+    const identities = [identify(directory)];
+    for (const component of path.ancestry) {
+      directory = open(
+        `/proc/self/fd/${directory}/${component}`,
+        DIRECTORY_FLAGS,
+      );
+      identities.push(identify(directory));
+    }
+    if (!isDeepStrictEqual(identities.at(-1), expected)) {
+      return refusal();
+    }
+    if (path === BINDING_PATH && process.geteuid?.() === 0) {
+      return refusal();
+    }
+    function read(name: string, limit: number) {
+      const fd = open(`/proc/self/fd/${directory}/${name}`, FILE_FLAGS);
+      const stat = fstatSync(fd, { bigint: true });
+      if (
+        !stat.isFile() ||
+        stat.uid !== BigInt(path.uid) ||
+        stat.nlink !== 1n ||
+        (stat.mode & 0o222n) !== 0n ||
+        stat.size <= 0n ||
+        stat.size > BigInt(limit)
+      ) {
+        return refusal();
+      }
+      const identity = fileIdentity(stat);
+      if (!contents) return { identity };
+      const bytes = Buffer.alloc(Number(stat.size) + 1);
+      let total = 0;
+      while (total < bytes.length) {
+        const count = readSync(fd, bytes, total, bytes.length - total, null);
+        if (count === 0) break;
+        total += count;
+      }
+      if (
+        total !== Number(stat.size) ||
+        !isDeepStrictEqual(
+          fileIdentity(fstatSync(fd, { bigint: true })),
+          identity,
+        )
+      ) {
+        return refusal();
+      }
+      return {
+        identity,
+        text: new TextDecoder("utf-8", { fatal: true }).decode(
+          bytes.subarray(0, total),
+        ),
+      };
+    }
+    const binding = read("binding.json", 4096);
+    const ca = read("ca.pem", 32_768);
+    return {
+      identities: [...identities, binding.identity, ca.identity],
+      binding: binding.text,
+      ca: ca.text,
+    };
+  } finally {
+    for (const fd of descriptors.reverse()) closeSync(fd);
+  }
+}
+
+/** Read only the operator's fixed immutable Gateway mount. Tests supply an isolated anchor. */
+export function readProviderBoxOwner(
+  input: {
+    transport: string;
+    url?: string;
+    workspaceRoot?: string;
+    authToken?: string;
+    computeUrl?: string;
+    computeToken?: string;
+    headers: Record<string, string>;
+  },
+  path = BINDING_PATH,
+): ProviderBoxOwner | undefined {
+  try {
+    let directory: BigIntStats;
+    try {
+      // A genuine absence is the only opt-out. Do this before checking owner
+      // UIDs, which may be unmapped in an ordinary rootless Gateway.
+      directory = lstatSync(posix.join(path.root, ...path.ancestry), {
+        bigint: true,
+      });
+    } catch (error) {
+      if (isAbsent(error)) return undefined;
+      return refusal();
+    }
+    if (process.platform !== "linux") return refusal();
+    const expected = directoryIdentity(directory, path.uid);
+    const selected = snapshot(path, expected, true);
+    const raw = selected.binding?.trim();
+    const ca = selected.ca;
+    if (!raw || !ca) return refusal();
+    const binding: unknown = JSON.parse(raw);
+    if (
+      !binding ||
+      typeof binding !== "object" ||
+      Array.isArray(binding) ||
+      JSON.stringify(binding) !== raw
+    ) {
+      return refusal();
+    }
+    const { url, workspaceRoot, generationSha256 } = binding as Record<
+      string,
+      unknown
+    >;
+    if (
+      Object.keys(binding).length !== 3 ||
+      typeof url !== "string" ||
+      workspaceRoot !== "/home/node/workspace" ||
+      typeof generationSha256 !== "string" ||
+      !SHA256.test(generationSha256) ||
+      input.transport !== "websocket" ||
+      input.url !== url ||
+      input.computeUrl !== url ||
+      input.workspaceRoot !== workspaceRoot ||
+      !input.authToken ||
+      input.computeToken !== input.authToken ||
+      Object.keys(input.headers).length !== 0
+    ) {
+      return refusal();
+    }
+    const origin = new URL(url);
+    if (
+      origin.protocol !== "wss:" ||
+      origin.pathname !== "/" ||
+      origin.username ||
+      origin.password ||
+      origin.search ||
+      origin.hash ||
+      origin.href !== url
+    ) {
+      return refusal();
+    }
+    const certificates = ca
+      .trim()
+      .match(
