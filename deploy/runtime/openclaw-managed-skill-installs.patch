@@ -0,0 +1,9 @@
+import { isTruthyEnvValue } from "../../infra/env.js";
+
+/** The deployment sets this in the Gateway child after delivering its selected skills. */
+export function skillInstallDisabledMessage(): string | undefined {
+  if (isTruthyEnvValue(process.env.OPENCLAW_DISABLE_SKILL_INSTALLS)) {
+    return "Skill installation and publication are disabled on this managed Gateway.";
+  }
+  return undefined;
+}
