diff --git a/test/es-module/test-require-module-worker-termination.js b/test/es-module/test-require-module-worker-termination.js
new file mode 100644
index 00000000..008a28be
--- /dev/null
+++ b/test/es-module/test-require-module-worker-termination.js
@@ -0,0 +1,32 @@
+// Flags: --experimental-require-module
+'use strict';
+const common = require('../common');
+const assert = require('assert');
+const { once } = require('events');
+const { setTimeout } = require('timers/promises');
+const { Worker, parentPort, workerData } = require('worker_threads');
+
+if (workerData === 'require-loop') {
+  const filename = require.resolve('../fixtures/es-modules/worker-require-default.mjs');
+  common.expectRequiredModule(require(filename), { default: 42, value: 1 });
+  parentPort.postMessage('ready');
+  // Evict only the CJS entry so each require creates a new ESM facade.
+  for (;;) {
+    delete require.cache[filename];
+    require(filename);
+  }
+} else {
+  async function test() {
+    // Exercise interruption during facade creation without requiring a precise
+    // scheduling point. Terminating a Worker must never abort its parent.
+    for (let i = 0; i < 100; i++) {
+      const worker = new Worker(__filename, { workerData: 'require-loop' });
+      worker.on('error', common.mustNotCall());
+      const [message] = await once(worker, 'message');
+      assert.strictEqual(message, 'ready');
+      await setTimeout(1 + i % 5);
+      assert.strictEqual(await worker.terminate(), 1);
+    }
+  }
+  test().then(common.mustCall());
+}
