abi <abi/4.0>,

profile oce-strands-box-v0.3.1 flags=(attach_disconnected,mediate_deleted) {
  file,
  network,
  signal (receive),
  signal (send) peer=oce-strands-box-v0.3.1,
  ptrace peer=oce-strands-box-v0.3.1,
  userns,
  capability sys_admin,
  capability net_admin,
  capability setpcap,
  mount fstype=proc -> /tmp/.strands-box-view.*/proc/,
  mount fstype=tmpfs -> /tmp/.strands-box-view.*/,
  remount /tmp/.strands-box-view.*/,
  mount fstype=tmpfs -> /tmp/.strands-box-view.*/**,
  mount options=(rprivate) -> /,
  mount options=(rbind) -> /tmp/.strands-box-view.*/**,
  mount options=(bind) /tmp/.strands-box-view.*/.strands-box-empty -> /tmp/.strands-box-view.*/proc/{interrupts,kcore,keys,latency_stats,sched_debug,timer_list,timer_stats},
  remount /tmp/.strands-box-view.*/**,
  umount /.old-root/,
  pivot_root oldroot=/tmp/.strands-box-view.*/.old-root/ /tmp/.strands-box-view.*/,

  deny /proc/{acpi,asound,interrupts,kcore,keys,latency_stats,sched_debug,scsi,timer_list,timer_stats}{,/**} mrwklx,
  deny /proc/{bus,fs,irq,sys,sysrq-trigger}{,/**} wklx,
  deny /proc/[^0-9]*{,/**} wklx,
  deny /proc/*/attr/** wklx,
  deny /sys/** wklx,
  deny /sys/{firmware,devices/virtual/powercap}{,/**} mr,
}
