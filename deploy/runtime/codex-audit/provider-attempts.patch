@@ -0,0 +1,122 @@
+use std::ffi::OsStr;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use codex_protocol::protocol::Event;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::RuntimeToolAuditEvent;
+use codex_protocol::protocol::RuntimeToolAuditFact;
+use codex_protocol::protocol::RuntimeToolAuditObservation;
+use codex_protocol::protocol::RuntimeToolAuditOutcome;
+use codex_protocol::protocol::SessionSource;
+use codex_tools::ToolName;
+use tokio::sync::oneshot;
+use uuid::Uuid;
+
+use crate::function_tool::FunctionCallError;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use crate::tools::flat_tool_name;
+
+pub(crate) struct RuntimeToolAudit<'a> {
+    session: &'a Session,
+    turn_id: &'a str,
+    invocation_id: &'a str,
+    tool_name: String,
+}
+
+impl<'a> RuntimeToolAudit<'a> {
+    pub(crate) fn new(
+        session: &'a Session,
+        turn: &'a TurnContext,
+        invocation_id: &'a str,
+        tool_name: &ToolName,
+    ) -> Option<Self> {
+        // The managed foreground thread has an audit receipt in OpenClaw.
+        // Internal tasks and subagents have no such route on this connection.
+        if std::env::var_os("CODEX_PROVIDER_ATTEMPT_AUDIT").as_deref() != Some(OsStr::new("1"))
+            || matches!(
+                turn.session_source,
+                SessionSource::Internal(_) | SessionSource::SubAgent(_)
+            )
+        {
+            return None;
+        }
+        Some(Self {
+            session,
+            turn_id: &turn.sub_id,
+            invocation_id,
+            tool_name: flat_tool_name(tool_name).into_owned(),
+        })
+    }
+
+    pub(crate) async fn record(&self, fact: RuntimeToolAuditFact) -> Result<(), FunctionCallError> {
+        let (tx, rx) = oneshot::channel();
+        let occurred_at_ms = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_millis()
+            .try_into()
+            .unwrap_or(u64::MAX);
+        let event = Event {
+            id: self.turn_id.to_owned(),
+            msg: EventMsg::RuntimeToolAudit(RuntimeToolAuditEvent {
+                observation: RuntimeToolAuditObservation {
+                    event_id: Uuid::new_v4().to_string(),
+                    occurred_at_ms,
+                    invocation_id: self.invocation_id.to_owned(),
+                    tool_name: self.tool_name.clone(),
+                    fact,
+                },
+                acknowledgement: Arc::new(Mutex::new(Some(tx))),
+            }),
+        };
+        let acknowledgement = async {
+            if self.session.get_tx_event().send(event).await.is_ok() {
+                rx.await.unwrap_or(false)
+            } else {
+                false
+            }
+        };
+        if matches!(
+            tokio::time::timeout(Duration::from_secs(15), acknowledgement).await,
+            Ok(true)
+        ) {
+            Ok(())
+        } else {
+            Err(FunctionCallError::RespondToModel(
+                "Runtime audit could not confirm this tool operation".to_string(),
+            ))
+        }
+    }
+
+    pub(crate) async fn admit(
+        &self,
+        approval_id: Option<String>,
+    ) -> Result<String, FunctionCallError> {
+        let attempt_id = Uuid::new_v4().to_string();
+        self.record(RuntimeToolAuditFact::Admitted {
+            attempt_id: attempt_id.clone(),
+            approval_id,
+        })
+        .await?;
+        Ok(attempt_id)
+    }
+
+    pub(crate) async fn complete(&self, attempt_id: String, outcome: RuntimeToolAuditOutcome) {
+        self.observe(RuntimeToolAuditFact::Completed {
+            attempt_id,
+            outcome,
+        })
+        .await;
+    }
+
+    pub(crate) async fn observe(&self, fact: RuntimeToolAuditFact) {
+        if self.record(fact).await.is_err() {
+            tracing::warn!(target: "codex_runtime_audit", "Codex tool audit observation was not delivered");
+        }
+    }
+}
