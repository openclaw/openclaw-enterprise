diff --git a/codex-rs/codex-api/src/model_attempt.rs b/codex-rs/codex-api/src/model_attempt.rs
new file mode 100644
index 0000000..0eacd80
--- /dev/null
+++ b/codex-rs/codex-api/src/model_attempt.rs
@@ -0,0 +1,29 @@
+use codex_protocol::protocol::ProviderModelAttemptStage;
+use std::sync::Arc;
+
+pub type ProviderModelAttemptObserver = Arc<dyn Fn() -> ProviderModelAttempt + Send + Sync>;
+
+/// Holds the native observation until the call has an outcome or the caller drops it.
+pub struct ProviderModelAttempt(Option<Box<dyn FnOnce(ProviderModelAttemptStage) + Send + Sync>>);
+
+impl ProviderModelAttempt {
+    pub fn new(observe: impl FnOnce(ProviderModelAttemptStage) + Send + Sync + 'static) -> Self {
+        Self(Some(Box::new(observe)))
+    }
+
+    pub(crate) fn finish(attempt: &mut Option<Self>, stage: ProviderModelAttemptStage) {
+        if let Some(mut attempt) = attempt.take()
+            && let Some(observe) = attempt.0.take()
+        {
+            observe(stage);
+        }
+    }
+}
+
+impl Drop for ProviderModelAttempt {
+    fn drop(&mut self) {
+        if let Some(observe) = self.0.take() {
+            observe(ProviderModelAttemptStage::Cancelled);
+        }
+    }
+}
