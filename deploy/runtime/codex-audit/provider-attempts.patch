+fn audit_approval_decision(decision: &ReviewDecision) -> RuntimeToolAuditApprovalDecision {
+    match decision {
+        ReviewDecision::Approved => RuntimeToolAuditApprovalDecision::AllowOnce,
+        ReviewDecision::ApprovedForSession => RuntimeToolAuditApprovalDecision::AllowSession,
+        ReviewDecision::ApprovedExecpolicyAmendment { .. }
+        | ReviewDecision::ApprovedMcpPolicyAmendment => {
+            RuntimeToolAuditApprovalDecision::AllowAlways
+        }
+        ReviewDecision::NetworkPolicyAmendment {
+            network_policy_amendment,
+        } => match network_policy_amendment.action {
+            NetworkPolicyRuleAction::Allow => RuntimeToolAuditApprovalDecision::AllowAlways,
+            NetworkPolicyRuleAction::Deny => RuntimeToolAuditApprovalDecision::Deny,
+        },
+        ReviewDecision::Denied { .. } => RuntimeToolAuditApprovalDecision::Deny,
+        ReviewDecision::TimedOut => RuntimeToolAuditApprovalDecision::Expired,
+        ReviewDecision::Abort => RuntimeToolAuditApprovalDecision::Cancelled,
+    }
+}
+
