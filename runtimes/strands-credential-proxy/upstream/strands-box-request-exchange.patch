+//! The post-policy sender is terminal, including on cancellation, refusal and uncertain dispatch.
+use super::*;
+use egress_gateway::{DelegatedFailure, DelegatedReply, DelegatedRequest, RequestExchange};
+use std::io::{Read, Write};
+use std::net::Ipv4Addr;
+
+mod receipt;
+
+#[test]
+fn confirmed_receipt_is_released_but_receiver_data_and_caller_credentials_are_not() {
+    receipt_case(receipt::REPLY, None, "receipt confirmed");
+}
+
+#[test]
+fn incomplete_receipt_is_indeterminate_and_is_not_retried_or_released() {
+    receipt_case(
+        &receipt::REPLY[..receipt::REPLY.len() - 1],
+        None,
+        "dispatch is uncertain",
+    );
+}
+
+#[test]
+fn response_policy_can_withhold_the_confirmed_receipt() {
+    receipt_case(receipt::REPLY, Some(EffectKind::ResponseRelease), "403");
+}
+
+fn receipt_case(wire: &'static [u8], deny: Option<EffectKind>, expected: &str) {
+    let host = "receipt.test";
+    let receiver = TlsUpstream::start_with_response(host, wire);
+    let events = Arc::new(Mutex::new(Vec::new()));
+    let policy = RecordingInterceptor {
+        events: events.clone(),
+        deny,
+        fail_recording: None,
+    };
+    let handle = MitmInterceptor::start_with_request_exchange(
+        config_for(host, &receiver),
+        Arc::new(policy),
+        Arc::new(receipt::ReceiptExchange::new(
+            receiver.port(),
+            &receiver.ca_pem(),
+        )),
+    )
+    .unwrap();
+    let mut client = WorkloadClient::connect(proxy_port(&handle), host, receiver.port());
+    client.send_request(
+        "GET",
+        "/%72eceipt",
+        &[("Authorization", "Bearer caller-private")],
+        &[],
+    );
+    let reply = client.read_response();
+    let ok = deny.is_none() && wire == receipt::REPLY;
+    assert!(reply.contains(expected), "{reply}");
+    assert_eq!(reply.contains("receipt confirmed"), ok);
+    assert!(!reply.contains("receiver-"));
+    let request = receiver.last_request().raw;
+    assert!(request.starts_with("GET /receipt HTTP/1.1"));
+    assert!(!request.contains("caller-private"));
+    assert_eq!(receiver.request_count(), 1);
+    let events = events.lock().unwrap();
+    assert_eq!(
+        &event_names(&events)[..5],
+        [
+            "attempt:resolve",
+            "attempt:request",
+            "attempt:connect",
+            "outcome:connect",
+            "outcome:request"
+        ]
+    );
+    let port = receiver.port();
+    let address = (Ipv4Addr::LOCALHOST, port).into();
+    assert_eq!(
+        events[2],
+        Event::Attempt(AttemptSnapshot::Connect {
+            host: host.to_owned(),
+            port,
+            address,
+            http_visibility: true,
+        })
+    );
+    assert_eq!(
+        events[3],
+        Event::Outcome(EffectKind::Connect, EffectOutcome::Connected(address))
+    );
+    if wire != receipt::REPLY {
+        assert!(matches!(
+            events[4],
+            Event::Outcome(
+                EffectKind::HttpRequest,
+                EffectOutcome::Indeterminate {
+                    accepted_bytes: 1..
+                }
+            )
+        ));
+        assert_eq!(events.len(), 5, "no release follows the incomplete reply");
+    }
+}
+
+type Reply = Result<DelegatedReply, DelegatedFailure>;
+struct Sender(fn(DelegatedRequest<'_>) -> Reply);
+impl RequestExchange for Sender {
+    fn exchange(&self, request: DelegatedRequest<'_>) -> Reply {
+        (self.0)(request)
+    }
+}
+
+#[test]
+fn denied_host_request_or_address_never_opens_an_origin_and_sender_refusal_has_no_fallback() {
+    use EffectKind::{Connect, HttpRequest, Resolve};
+    for deny in [Some(Resolve), Some(HttpRequest), Some(Connect), None] {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let host = "no-origin.test";
+        // A direct-send fallback would reach this listener.
+        let config = MitmConfig {
+            dns_overrides: vec![(host.into(), Ipv4Addr::LOCALHOST.into())],
+            ..MitmConfig::default()
+        };
+        let sender = Sender(match deny {
+            Some(Connect) => |req| {
+                let error = runtime()
+                    .block_on(req.origin.connect(Ipv4Addr::LOCALHOST.into()))
+                    .unwrap_err();
+                assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+                Err(DelegatedFailure::Refused)
+            },
+            None => |_| Err(DelegatedFailure::Refused),
+            _ => |_| panic!("sender called before the policy decision"),
+        });
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let policy = RecordingInterceptor {
+            events: events.clone(),
+            deny,
+            fail_recording: None,
+        };
+        let handle = MitmInterceptor::start_with_request_exchange(
+            config,
+            Arc::new(policy),
+            Arc::new(sender),
+        )
+        .unwrap();
+        let reply = if deny == Some(Resolve) {
+            WorkloadClient::connect_raw(proxy_port(&handle)).raw_connect(host, port)
+        } else {
+            let mut client = WorkloadClient::connect(proxy_port(&handle), host, port);
+            client.send_request("POST", "/once", &[], b"one");
+            client.read_response()
+        };
+        assert!(
+            reply.contains("403") && !reply.contains("200 Connection Established"),
+            "{reply:?}"
+        );
+        listener.set_nonblocking(true).unwrap();
+        assert_eq!(
+            listener.accept().unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        let events = events.lock().unwrap();
+        let want = match deny {
+            Some(Resolve) => 1,
+            Some(HttpRequest) => 2,
+            Some(Connect) => 4,
+            None => 3,
+            _ => unreachable!(),
+        };
+        assert_eq!(events.len(), want, "{events:?}");
+    }
+}
+
+fn runtime() -> tokio::runtime::Runtime {
+    tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap()
+}
+
+#[test]
+fn canceled_real_connect_can_reach_the_peer_and_records_exactly_one_indeterminate() {
+    use std::{
+        future::{Future, poll_fn},
+        task::Poll,
+    };
+    let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+    let events = Arc::new(Mutex::new(Vec::new()));
+    let sender = Sender(|req| {
+        runtime().block_on(async {
+            let mut dial = Box::pin(req.origin.connect(Ipv4Addr::LOCALHOST.into()));
+            poll_fn(|cx| {
+                assert!(
+                    dial.as_mut().poll(cx).is_pending(),
+                    "exercise cancellation at a real pending connect"
+                );
+                Poll::Ready(())
+            })
+            .await;
+            drop(dial); // Equivalent to the enclosing deadline canceling this future at Pending.
+        });
+        Err(DelegatedFailure::Unavailable) // We sent no HTTP request.
+    });
+    let handle = MitmInterceptor::start_with_request_exchange(
+        MitmConfig::default(),
+        Arc::new(RecordingInterceptor::allowing(events.clone())),
+        Arc::new(sender),
+    )
+    .unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let mut client = WorkloadClient::connect(proxy_port(&handle), "cancel.test", port);
+    client.send_request("POST", "/once", &[], b"one");
+    assert_eq!(client.read_status(), 502);
+
+    listener.set_nonblocking(true).unwrap();
+    let (mut peer, _) = listener
+        .accept()
+        .expect("the canceled connect reached this peer");
+    assert_eq!(
+        peer.read(&mut [0]).unwrap(),
+        0,
+        "no HTTP bytes accepted by the peer"
+    );
+    assert_eq!(
+        listener.accept().unwrap_err().kind(),
+        io::ErrorKind::WouldBlock,
+        "no second dial"
+    );
+    assert_eq!(
+        event_names(&events.lock().unwrap()),
+        [
+            "attempt:resolve",
+            "attempt:request",
+            "attempt:connect",
+            "indeterminate:connect",
+            "outcome:request"
+        ]
+    );
+}
+
+#[test]
+fn unix_client_cannot_bypass_request_policy_and_plain_tcp_is_refused() {
+    use rustls::pki_types::{CertificateDer, ServerName, pem::PemObject};
+    use std::{
+        io::{BufRead, BufReader},
+        os::unix::net::UnixStream,
+    };
+    let dir = std::env::temp_dir().join(format!("box-exchange-test-{}", std::process::id()));
+    std::fs::create_dir(&dir).unwrap();
+    let path = dir.join("egress.sock");
+    let policy = Arc::new(RecordingInterceptor::denying(
+        Arc::default(),
+        EffectKind::HttpRequest,
+    ));
+    let sender = Arc::new(Sender(|_| panic!("denial called the sender")));
+    let config = MitmConfig {
+        unix_socket_path: Some(path.clone()),
+        intercept_ca_dir: Some(dir.clone()),
+        ..MitmConfig::default()
+    };
+    let handle =
+        MitmInterceptor::start_with_request_exchange(config, policy.clone(), sender.clone())
+            .unwrap();
+    let mut client = UnixStream::connect(&path).unwrap();
+    client
+        .write_all(b"CONNECT unix.test:443 HTTP/1.1\r\n\r\n")
+        .unwrap();
+    let mut head = String::new();
+    let mut reader = BufReader::new(&client);
+    while !head.ends_with("\r\n\r\n") {
+        assert_ne!(reader.read_line(&mut head).unwrap(), 0);
+    }
+    assert!(head.contains("200 Connection Established"));
+    let mut roots = rustls::RootCertStore::empty();
+    roots
+        .add(CertificateDer::from_pem_file(handle.intercept_ca_path().unwrap()).unwrap())
+        .unwrap();
+    let cfg = rustls::ClientConfig::builder()
+        .with_root_certificates(roots)
+        .with_no_client_auth();
+    let conn =
+        rustls::ClientConnection::new(cfg.into(), ServerName::try_from("unix.test").unwrap())
+            .unwrap();
+    let mut tls = rustls::StreamOwned::new(conn, client);
+    tls.write_all(b"GET /unix HTTP/1.1\r\nHost: unix.test\r\n\r\n")
+        .unwrap();
+    let mut reply = String::new();
+    BufReader::new(&mut tls).read_line(&mut reply).unwrap();
+    assert!(reply.contains("403"), "{reply:?}");
+    handle.shutdown();
+    std::fs::remove_dir_all(dir).unwrap();
+
+    let handle =
+        MitmInterceptor::start_with_request_exchange(MitmConfig::default(), policy, sender)
+            .unwrap();
+    let mut plain =
+        std::net::TcpStream::connect((Ipv4Addr::LOCALHOST, proxy_port(&handle))).unwrap();
+    plain
+        .write_all(b"GET http://plain.test/ HTTP/1.1\r\nHost: plain.test\r\n\r\n")
+        .unwrap();
+    let mut reply = String::new();
+    BufReader::new(plain).read_line(&mut reply).unwrap();
+    assert!(reply.contains("403 TLS inspection required"), "{reply:?}");
+}
