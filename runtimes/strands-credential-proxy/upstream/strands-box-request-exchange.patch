new file mode 100644
index 0000000..350f65f
--- /dev/null
+++ b/crates/egress-gateway/src/intercept/mitm/exchange.rs
@@ -0,0 +1,144 @@
+//! The trusted terminal sender for one inspected HTTPS request.
+
+use super::SharedState;
+use super::connect::ConnectRequest;
+use super::http1::{MAX_HEAD_BYTES, ParsedResponse, is_token_byte};
+use super::listener::claim_address;
+use crate::{EffectOutcome, HeaderMap, RequestId, Target};
+use std::io;
+use std::net::{IpAddr, SocketAddr};
+use tokio::net::TcpStream;
+
+/// A trusted sender that authenticates TLS, bounds I/O, sends at most once and returns only releasable bytes.
+pub trait RequestExchange: Send + Sync {
+    /// Complete one exchange on the supplied origin, without redirects, retries or another connection.
+    fn exchange(&self, request: DelegatedRequest<'_>) -> Result<DelegatedReply, DelegatedFailure>;
+}
+
+/// The complete canonical request after CONNECT binding, request controls and policy admission.
+pub struct DelegatedRequest<'a> {
+    /// The inspected authority, path and query.
+    pub target: &'a Target,
+    /// The admitted HTTP method.
+    pub method: &'a str,
+    /// End-to-end headers, without the client's proxy authorization or transport framing.
+    pub headers: &'a HeaderMap,
+    /// The complete request body after canonicalization.
+    pub body: &'a [u8],
+    /// The only origin connection opportunity for this request.
+    pub origin: ExchangeOrigin<'a>,
+}
+
+/// A single-use connection opportunity bound to the inspected host and port.
+pub struct ExchangeOrigin<'a> {
+    pub(super) state: &'a SharedState,
+    pub(super) connect: &'a ConnectRequest,
+    pub(super) correlation: &'a RequestId,
+}
+
+impl ExchangeOrigin<'_> {
+    /// Authorize and dial exactly this pinned address, marking the connect indeterminate if canceled.
+    pub async fn connect(self, ip: IpAddr) -> io::Result<TcpStream> {
+        let address = SocketAddr::new(ip, self.connect.port);
+        let permit = claim_address(self.state, self.connect, address, self.correlation)?;
+        let stream = match TcpStream::connect(address).await {
+            Ok(stream) => stream,
+            Err(error) => {
+                permit.record_outcome(EffectOutcome::ConnectFailed(error.kind()))?;
+                return Err(error);
+            }
+        };
+        let peer = stream.peer_addr()?;
+        if peer != address {
+            return Err(io::Error::other(
+                "origin peer differs from the admitted address",
+            ));
+        }
+        permit.record_outcome(EffectOutcome::Connected(peer))?;
+        Ok(stream)
+    }
+}
+
+/// A complete sender-approved response, still subject to the gateway's response controls and release permit.
+pub struct DelegatedReply {
+    /// A final HTTP status in 200 through 599.
+    pub status: u16,
+    /// End-to-end response headers, without transport framing.
+    pub headers: HeaderMap,
+    /// The bounded body approved for this workload.
+    pub body: Vec<u8>,
+    /// Request bytes accepted by the origin transport, not a claim that the server acted on them.
+    pub accepted_bytes: usize,
+}
+
+impl DelegatedReply {
+    pub(super) fn into_response(
+        self,
+        max_body: usize,
+    ) -> Result<(ParsedResponse, usize), DelegatedFailure> {
+        let Self {
+            status,
+            headers,
+            body,
+            accepted_bytes,
+        } = self;
+        let mut head_bytes = 64;
+        let valid = (200..=599).contains(&status)
+            && body.len() <= max_body
+            && headers.iter().all(|(n, v)| {
+                head_bytes += n.len() + v.len() + 4;
+                head_bytes <= MAX_HEAD_BYTES
+                    && !n.is_empty()
+                    && n.bytes().all(is_token_byte)
+                    && v.bytes().all(|b| b == b'\t' || (b >= 0x20 && b != 0x7f))
+            });
+        if !valid {
+            return Err(DelegatedFailure::Uncertain { accepted_bytes });
+        }
+        Ok((
+            ParsedResponse {
+                status,
+                headers,
+                body,
+            },
+            accepted_bytes,
+        ))
+    }
+}
+
+/// A definite failure before HTTP dispatch or an indeterminate dispatch that must not be retried.
+pub enum DelegatedFailure {
+    /// Refused before sending any HTTP bytes.
+    Refused,
+    /// Unavailable before sending any HTTP bytes.
+    Unavailable,
+    /// Dispatch was possible, but no complete response was approved for release.
+    Uncertain {
+        /// Known accepted request bytes, possibly zero even when dispatch cannot be excluded.
+        accepted_bytes: usize,
+    },
+}
+
+impl DelegatedFailure {
+    pub(super) fn disposition(self) -> (EffectOutcome, u16, &'static [u8]) {
+        let (error_kind, status) = match self {
+            Self::Refused => (io::ErrorKind::PermissionDenied, 403),
+            Self::Unavailable => (io::ErrorKind::NotConnected, 502),
+            Self::Uncertain { accepted_bytes } => {
+                return (
+                    EffectOutcome::Indeterminate { accepted_bytes },
+                    502,
+                    b"origin dispatch is uncertain; the gateway did not retry",
+                );
+            }
+        };
+        (
+            EffectOutcome::Failed {
+                accepted_bytes: 0,
+                error_kind,
+            },
+            status,
+            b"request not sent",
+        )
+    }
+}
