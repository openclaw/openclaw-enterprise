+#[test]
+fn each_request_calls_the_sender_and_unavailable_never_falls_back() {
+    let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+    let port = listener.local_addr().unwrap().port();
+    let events = Arc::new(Mutex::new(Vec::new()));
