+    )
+    .unwrap();
+    for _ in 0..2 {
+        let mut client = WorkloadClient::connect(proxy_port(&handle), "unavailable.test", port);
+        client.send_request("POST", "/once", &[], b"one");
+        assert_eq!(client.read_status(), 502);
