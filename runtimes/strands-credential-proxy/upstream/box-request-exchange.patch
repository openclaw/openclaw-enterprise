+#[cfg(feature = "request-exchange")]
+pub(crate) fn refuse_delegated_credentials(record: &Record) -> Result<(), BoxError> {
+    if record
+        .egress
+        .values()
+        .chain(record.remote_mcp.values())
+        .any(|entry| entry.secret.is_some())
+    {
+        return Err(DaemonError::Refused {
+            reason: "delegated exchange cannot use Box credential routes".into(),
+        }
+        .into());
+    }
+    Ok(())
+}
