new file mode 100644
index 0000000..5ff6b59
--- /dev/null
+++ b/crates/egress-gateway/tests/effect_interception/terminal_exchange/receipt.rs
@@ -0,0 +1,157 @@
+//! Reference embedding for a fixed HTTPS receipt endpoint; only its confirmation may leave the gateway.
+
+use egress_gateway::{
+    DelegatedFailure, DelegatedReply, DelegatedRequest, HeaderMap, RequestExchange,
+};
+use rustls::pki_types::{CertificateDer, ServerName, pem::PemObject};
+use std::{
+    io::{self, Read, Write},
+    net::{Ipv4Addr, TcpStream},
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+pub(super) const REPLY: &[u8] =
+    b"HTTP/1.1 200 OK\r\nContent-Length: 16\r\nConnection: close\r\n\r\nreceiver-private";
+
+pub(super) struct ReceiptExchange {
+    port: u16,
+    tls: Arc<rustls::ClientConfig>,
+}
+
+impl ReceiptExchange {
+    pub(super) fn new(port: u16, receiver_ca: &str) -> Self {
+        let mut roots = rustls::RootCertStore::empty();
+        roots
+            .add(CertificateDer::from_pem_slice(receiver_ca.as_bytes()).unwrap())
+            .unwrap();
+        let tls = rustls::ClientConfig::builder()
+            .with_root_certificates(roots)
+            .with_no_client_auth();
+        Self {
+            port,
+            tls: Arc::new(tls),
+        }
+    }
+}
+
+impl RequestExchange for ReceiptExchange {
+    fn exchange(&self, req: DelegatedRequest<'_>) -> Result<DelegatedReply, DelegatedFailure> {
+        let target = req.target;
+        if target.host != "receipt.test"
+            || target.port != self.port
+            || target.path != "/receipt"
+            || !target.query.is_empty()
+            || req.method != "GET"
+            || !req.body.is_empty()
+        {
+            return Err(DelegatedFailure::Refused);
+        }
+        let mut tls = self.open(req)?;
+        let request = format!(
+            "GET /receipt HTTP/1.1\r\nHost: receipt.test:{}\r\nConnection: close\r\n\r\n",
+            self.port
+        );
+        let mut sent = 0;
+        while sent < request.len() {
+            let wrote = tls
+                .write(&request.as_bytes()[sent..])
+                .map_err(|_| uncertain(sent))?;
+            if wrote == 0 {
+                return Err(uncertain(sent));
+            }
+            sent += wrote;
+        }
+        tls.flush().map_err(|_| uncertain(sent))?;
+        let mut reply = [0u8; REPLY.len()];
+        tls.read_exact(&mut reply).map_err(|_| uncertain(sent))?;
+        if reply != REPLY {
+            return Err(uncertain(sent));
+        }
+        Ok(DelegatedReply {
+            accepted_bytes: sent,
+            status: 200,
+            headers: HeaderMap::new(),
+            body: b"receipt confirmed".to_vec(),
+        })
+    }
+}
+
+impl ReceiptExchange {
+    fn open(
+        &self,
+        req: DelegatedRequest<'_>,
+    ) -> Result<rustls::StreamOwned<rustls::ClientConnection, DeadlineStream>, DelegatedFailure>
+    {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let socket = req
+            .origin
+            .connect(Ipv4Addr::LOCALHOST.into(), deadline)
+            .map_err(|error| {
+                if error.kind() == io::ErrorKind::PermissionDenied {
+                    DelegatedFailure::Refused
+                } else {
+                    DelegatedFailure::Unavailable
+                }
+            })?;
+        let name = ServerName::try_from(req.target.host.as_str())
+            .unwrap()
+            .to_owned();
+        let mut connection = rustls::ClientConnection::new(self.tls.clone(), name)
+            .map_err(|_| DelegatedFailure::Unavailable)?;
+        let mut socket = DeadlineStream { socket, deadline };
+        while connection.is_handshaking() {
+            connection
+                .complete_io(&mut socket)
+                .map_err(|_| DelegatedFailure::Unavailable)?;
+        }
+        socket
+            .remaining()
+            .map_err(|_| DelegatedFailure::Unavailable)?;
+        Ok(rustls::StreamOwned::new(connection, socket))
+    }
+
+    #[allow(dead_code)] // Shared with the hosted byte-oracle control.
+    pub(super) fn prefix(
+        &self,
+        req: DelegatedRequest<'_>,
+    ) -> Result<DelegatedReply, DelegatedFailure> {
+        let mut tls = self.open(req)?;
+        tls.write_all(b"G")
+            .and_then(|()| tls.flush())
+            .map_err(|_| uncertain(0))?;
+        Err(uncertain(1))
+    }
+}
+
+struct DeadlineStream {
+    socket: TcpStream,
+    deadline: Instant,
+}
+impl DeadlineStream {
+    fn remaining(&self) -> io::Result<Duration> {
+        self.deadline
+            .checked_duration_since(Instant::now())
+            .filter(|duration| !duration.is_zero())
+            .ok_or_else(|| io::Error::new(io::ErrorKind::TimedOut, "receipt deadline elapsed"))
+    }
+}
+impl Read for DeadlineStream {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        self.socket.set_read_timeout(Some(self.remaining()?))?;
+        self.socket.read(bytes)
+    }
+}
+impl Write for DeadlineStream {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.socket.set_write_timeout(Some(self.remaining()?))?;
+        self.socket.write(bytes)
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        self.remaining()?;
+        self.socket.flush()
+    }
+}
+fn uncertain(accepted_bytes: usize) -> DelegatedFailure {
+    DelegatedFailure::Uncertain { accepted_bytes }
+}
