+    .unwrap();
+    let mut client = WorkloadClient::connect(
+        proxy_port(&handle),
+        "pinned.test",
+        listener.local_addr().unwrap().port(),
+    );
+    client.send_request("POST", "/once", &[], b"one");
+    assert_eq!(client.read_status(), 403);
+    listener.set_nonblocking(true).unwrap();
+    assert_eq!(
+        listener.accept().unwrap_err().kind(),
+        io::ErrorKind::WouldBlock
+    );
+}
+
+#[test]
+fn expired_origin_deadline_and_missing_pin_never_dial() {
+    for pinned in [false, true] {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let config = MitmConfig {
+            dns_overrides: if pinned {
+                vec![("no-dns.invalid".into(), Ipv4Addr::LOCALHOST.into())]
+            } else {
+                vec![]
+            },
+            ..MitmConfig::default()
+        };
+        let sender = Sender(if pinned {
+            |req| {
+                let error = req
+                    .origin
+                    .connect(Ipv4Addr::LOCALHOST.into(), Instant::now())
+                    .unwrap_err();
+                assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+                Err(DelegatedFailure::Unavailable)
+            }
+        } else {
+            |req| {
+                let error = req
+                    .origin
+                    .connect(
+                        Ipv4Addr::LOCALHOST.into(),
+                        Instant::now() + Duration::from_secs(5),
+                    )
+                    .unwrap_err();
+                assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+                Err(DelegatedFailure::Unavailable)
+            }
+        });
+        let handle = MitmInterceptor::start_with_request_exchange(
+            config,
+            Arc::new(RecordingInterceptor::allowing(events.clone())),
+            Arc::new(sender),
+        )
+        .unwrap();
+        let mut client = WorkloadClient::connect(
+            proxy_port(&handle),
+            "no-dns.invalid",
+            listener.local_addr().unwrap().port(),
+        );
+        client.send_request("GET", "/", &[], &[]);
+        assert_eq!(client.read_status(), 502);
+        client.await_proxy_close();
+        listener.set_nonblocking(true).unwrap();
+        assert_eq!(
+            listener.accept().unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        assert_eq!(
+            event_names(&events.lock().unwrap()),
+            ["attempt:resolve", "attempt:request", "outcome:request"]
+        );
+    }
+}
