+//! The hosted composition keeps Box policy ahead of the exclusive sender.
+use super::*;
+use egress_gateway::{DelegatedFailure, DelegatedReply, DelegatedRequest, RequestExchange};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[path = "../../../egress-gateway/tests/harness/byte_origin.rs"]
+mod byte_origin;
+#[allow(unreachable_pub)]
+#[path = "../../../egress-gateway/tests/harness/mod.rs"]
+mod harness;
+#[path = "../../../egress-gateway/tests/effect_interception/terminal_exchange/receipt.rs"]
+mod receipt;
+
+struct Sender {
+    calls: Arc<AtomicUsize>,
+    refuse: bool,
+    prefix: bool,
+    inner: receipt::ReceiptExchange,
+}
+impl RequestExchange for Sender {
+    fn exchange(&self, request: DelegatedRequest<'_>) -> Result<DelegatedReply, DelegatedFailure> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        if self.refuse {
+            Err(DelegatedFailure::Refused)
+        } else if self.prefix {
+            self.inner.prefix(request)
+        } else {
+            self.inner.exchange(request)
+        }
+    }
+}
+
+#[test]
+fn protected_route_admission() {
+    for (box_allow, sender_allow, prefix) in [
+        (true, true, false),
+        (false, true, false),
+        (true, false, false),
+        (true, true, true), // Independent control: one byte without any HTTP request line.
+    ] {
+        let dir = tempfile::tempdir().unwrap();
+        let origin = byte_origin::ByteOrigin::start("receipt.test", receipt::REPLY);
+        let text = format!(
+            "permit(principal, action == Box::Action::\"net:connect\", resource); {}",
+            if box_allow {
+                "permit(principal, action == Box::Action::\"http:request\", resource);"
+            } else {
+                ""
+            }
+        );
+        let policy = Arc::new(
+            PolicyEngine::open(
+                vec![policy::Policy {
+                    origin: dir.path().join("policy.dw"),
+                    text,
+                }],
+                &dir.path().join("history.redb"),
+            )
+            .unwrap()
+            .observed_by(Arc::new(telemetry::PolicyDecisionObserver)),
+        );
+        let interceptor = EgressPolicyInterceptor::into_handle(
+            policy,
+            Principal::agent(),
+            GovernedBox::assigned("original-execution"),
+        );
+        let recorder = telemetry::DecisionRecorder::discarding();
+        let ca = std::fs::File::create(dir.path().join("cert.pem")).unwrap();
+        let calls = Arc::new(AtomicUsize::new(0));
+        let gateway = start_gateway(
+            MitmConfig {
+                intercept_ca_dir: Some(dir.path().to_path_buf()),
+                dns_overrides: vec![("receipt.test".into(), std::net::Ipv4Addr::LOCALHOST.into())],
+                ..MitmConfig::default()
+            },
+            CapabilitySet::default(),
+            interceptor,
+            Box::new(telemetry::EgressDecisionRecorder::over(recorder)),
+            &ca,
+            Some(Arc::new(Sender {
+                calls: calls.clone(),
+                refuse: !sender_allow,
+                prefix,
+                inner: receipt::ReceiptExchange::new(origin.port(), &origin.ca_pem()),
+            })),
+        )
+        .unwrap();
+        let mut client = harness::WorkloadClient::connect(
+            gateway.port().unwrap(),
+            "receipt.test",
+            origin.port(),
+        );
+        client.send_request("GET", "/receipt", &[], &[]);
+        let response = client.read_response();
+        assert_eq!(calls.load(Ordering::SeqCst), usize::from(box_allow));
+        client.await_proxy_close();
+        let port = origin.port();
+        let observed: Vec<_> = origin
+            .finish()
+            .into_iter()
+            .filter(|bytes| !bytes.is_empty())
+            .collect();
+        let expected = if prefix {
+            vec![b"G".to_vec()]
+        } else if box_allow && sender_allow {
+            vec![format!("GET /receipt HTTP/1.1\r\nHost: receipt.test:{port}\r\nConnection: close\r\n\r\n").into_bytes()]
+        } else {
+            Vec::new()
+        };
+        assert_eq!(observed, expected);
+        assert_eq!(
+            response.contains("receipt confirmed"),
+            box_allow && sender_allow && !prefix
+        );
+        if prefix {
+            assert!(response.contains("502"), "{response}");
+        }
+        if !box_allow || !sender_allow {
+            assert!(response.contains("403"), "{response}");
+        }
+        gateway.shutdown();
+    }
+}
+
