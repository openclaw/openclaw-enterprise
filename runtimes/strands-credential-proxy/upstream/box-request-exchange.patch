+        MitmConfig {
+            dns_overrides: vec![("unavailable.test".into(), Ipv4Addr::LOCALHOST.into())],
+            ..MitmConfig::default()
+        },
+        Arc::new(RecordingInterceptor::allowing(events.clone())),
