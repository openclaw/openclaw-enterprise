@@ -0,0 +1,122 @@
+//! A controlled TLS origin that records all plaintext and drains before reporting it.
+use rustls::pki_types::{CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer};
+use std::io::{self, Read, Write};
+use std::net::{TcpListener, TcpStream};
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+};
+use std::thread::JoinHandle;
+use std::time::Duration;
+
+pub(crate) struct ByteOrigin {
+    port: u16,
+    ca: String,
+    stop: Arc<AtomicBool>,
+    worker: JoinHandle<Vec<Vec<u8>>>,
+}
+impl ByteOrigin {
+    pub(crate) fn start(host: &str, response: &'static [u8]) -> Self {
+        let cert = rcgen::generate_simple_self_signed(vec![host.into()]).unwrap();
+        let ca = cert.cert.pem();
+        let config = Arc::new(
+            rustls::ServerConfig::builder()
+                .with_no_client_auth()
+                .with_single_cert(
+                    vec![CertificateDer::from(cert.cert.der().to_vec())],
+                    PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(
+                        cert.signing_key.serialize_der(),
+                    )),
+                )
+                .unwrap(),
+        );
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let stop = Arc::new(AtomicBool::new(false));
+        let stopping = stop.clone();
+        let worker = std::thread::spawn(move || {
+            let mut handlers = Vec::new();
+            loop {
+                match listener.accept() {
+                    Ok((socket, _)) => {
+                        let config = config.clone();
+                        handlers.push(std::thread::spawn(move || {
+                            capture(socket, config, response)
+                        }));
+                    }
+                    Err(error)
+                        if stopping.load(Ordering::SeqCst)
+                            && error.kind() == io::ErrorKind::WouldBlock =>
+                    {
+                        break;
+                    }
+                    Err(error) => panic!("origin accept failed: {error}"),
+                }
+                if stopping.load(Ordering::SeqCst) {
+                    listener.set_nonblocking(true).unwrap();
+                }
+            }
+            handlers
+                .into_iter()
+                .map(|handler| handler.join().expect("origin capture panicked"))
+                .collect()
+        });
+        Self {
+            port,
+            ca,
+            stop,
+            worker,
+        }
+    }
+    pub(crate) fn port(&self) -> u16 {
+        self.port
+    }
+    pub(crate) fn ca_pem(&self) -> &str {
+        &self.ca
+    }
+
+    /// Call only after the sending gateway has closed its client exchange.
+    pub(crate) fn finish(self) -> Vec<Vec<u8>> {
+        self.stop.store(true, Ordering::SeqCst);
+        // Wake accept; all attributable connects precede the caller's close barrier.
+        drop(TcpStream::connect(("127.0.0.1", self.port)));
+        self.worker.join().expect("origin drain panicked")
+    }
+}
+fn capture(socket: TcpStream, config: Arc<rustls::ServerConfig>, response: &[u8]) -> Vec<u8> {
+    socket
+        .set_read_timeout(Some(Duration::from_secs(5)))
+        .unwrap();
+    socket
+        .set_write_timeout(Some(Duration::from_secs(5)))
+        .unwrap();
+    let mut tls = rustls::StreamOwned::new(rustls::ServerConnection::new(config).unwrap(), socket);
+    let mut bytes = Vec::new();
+    let mut replied = false;
+    let mut chunk = [0; 4096];
+    loop {
+        match tls.read(&mut chunk) {
+            Ok(0) => break,
+            Ok(count) => {
+                // Record before examining any HTTP framing, including incomplete prefixes.
+                bytes.extend_from_slice(&chunk[..count]);
+                assert!(bytes.len() <= 1024 * 1024, "unexpected origin payload size");
+                if !replied && bytes.windows(4).any(|window| window == b"\r\n\r\n") {
+                    tls.write_all(response).unwrap();
+                    tls.flush().unwrap();
+                    replied = true;
+                }
+            }
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    io::ErrorKind::UnexpectedEof | io::ErrorKind::ConnectionReset
+                ) =>
+            {
+                break;
+            }
+            Err(error) => panic!("origin capture failed, not a zero-byte result: {error}"),
+        }
+    }
+    bytes
+}
