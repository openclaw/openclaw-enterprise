{
  "name": "@openclaw-enterprise/utils",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "prepack.ts",
    "src",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false",
    "prepack": "node prepack.ts",
    "typecheck": "tsc --build tsconfig.json --pretty false"
  }
}
