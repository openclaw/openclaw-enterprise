#!/bin/sh
# OPENCLAW_ENTERPRISE_MANAGED_PRE_PUSH_HOOK

set -eu

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

if ! command -v bun >/dev/null 2>&1; then
  printf '%s\n' 'Bun is unavailable; install the version in .bun-version before pushing.' >&2
  exit 1
fi

expected_bun_version="$(cat .bun-version)"
actual_bun_version="$(bun --version)"
if [ "$actual_bun_version" != "$expected_bun_version" ]; then
  printf 'Bun %s is required by .bun-version; found %s. Refusing to push.\n' \
    "$expected_bun_version" "$actual_bun_version" >&2
  exit 1
fi

exec bun run format:check
